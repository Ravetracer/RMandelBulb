formula "_IntPowRotateC" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _IntPowRotateC. Upon an idea from Aexion to also rotate the adding constant in addition to a bulb formula."
    de numeric
    transform
    alias "_IntPowRotateC"
    param o0_flip_cxy_0_1 "Flip Cxy (0,1)" = 0.0 [-2.0, 2.0] int
    param o1_rotation_1_power "Rotation 1 power" = 8.0 [-8.0, 24.0] int
    param o2_rotation_1_type "Rotation 1 type" = 0.0 [-2.0, 2.0] int
    param o3_enable_rotation_2 "Enable rotation 2" = 1.0 [-1.0, 3.0] int
    param o4_rotation_2_power "Rotation 2 power" = 8.0 [-8.0, 24.0] int
    param o5_rotation_2_type "Rotation 2 type" = 3.0 [-3.0, 9.0] int
    param o6_enable_rotation_3 "Enable rotation 3" = 0.0 [-2.0, 2.0] int
    param o7_rotation_3_power "Rotation 3 power" = 8.0 [-8.0, 24.0] int
    param o8_rotation_3_type "Rotation 3 type" = 0.0 [-2.0, 2.0] int
    param o9_cz_multiplier "Cz multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k52 = o9_cz_multiplier
        let k44 = round(o8_rotation_3_type)
        let k40 = round(o7_rotation_3_power)
        let k36 = round(o6_enable_rotation_3)
        let k32 = round(o5_rotation_2_type)
        let k28 = round(o4_rotation_2_power)
        let k24 = round(o3_enable_rotation_2)
        let k20 = round(o2_rotation_1_type)
        let k16 = round(o1_rotation_1_power)
        let k12 = round(o0_flip_cxy_0_1)
    }
    iter {
        let ft = 0.0
        let cfl = 0.0
        let r_ecx = 0.0
        let r_edx = 0.0
        let r_ebx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x2l = 0.0
        let x2h = 0.0
        let x3l = 0.0
        let x3h = 0.0
        let x4l = 0.0
        let x4h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let x6l = 0.0
        let x6h = 0.0
        x6l = 0.0
        x6h = (-0.0)
        x0l = cx
        x0h = cy
        x1l = cz
        x1h = 0.0
        x3l = x0l
        x3h = x0h
        x5l = x1l
        ft = x3h * x3h
        x3l = x3l * x3l
        x3h = ft
        x5l = x5l * x5l
        ft = x3l + x3h
        x3l = x3l + x3h
        x3h = ft
        x5l = x5l + x3l
        x2l = 1.0
        x2h = 0.0
        x5l = sqrt(x5l)
        x2l = x2l / x5l
        ft = x2l
        x2h = ft
        ft = x0h * x2h
        x0l = x0l * x2l
        x0h = ft
        x1l = x1l * x2l
        if k12 == 0.0 {
        } else {
            ft = x0l
            x0l = x0h
            x0h = ft
        }
        cy = x5l
        r_edx = k16
        r_ebx = k20
        if r_ebx < 6.0 {
            r_ecx = 0.0
        } else {
            cfl = sel(r_ebx < 6.0, 1.0, 0.0)
            r_ebx = r_ebx - 6.0
            r_ecx = 1.0
        }
        cfl = sel(r_ebx < 1.0, 1.0, 0.0)
        r_ebx = r_ebx - 1.0
        if r_ebx >= 0.0 {
            cfl = sel(r_ebx < 1.0, 1.0, 0.0)
            r_ebx = r_ebx - 1.0
            if r_ebx >= 0.0 {
                cfl = sel(r_ebx < 1.0, 1.0, 0.0)
                r_ebx = r_ebx - 1.0
                if r_ebx >= 0.0 {
                    cfl = sel(r_ebx < 1.0, 1.0, 0.0)
                    r_ebx = r_ebx - 1.0
                    if r_ebx >= 0.0 {
                        cfl = sel(r_ebx < 1.0, 1.0, 0.0)
                        r_ebx = r_ebx - 1.0
                        if r_ebx >= 0.0 {
                            cz = x0l
                            ft = x1l
                            x1h = ft
                            ft = x1h
                            x0l = x0h
                            x0h = ft
                            x5l = x0l
                            x5h = x0h
                            ft = x0h * x0h
                            x0l = x0l * x0l
                            x0h = ft
                            ft = x0l + x0h
                            x0l = x0l + x0h
                            x0h = ft
                            x0l = sqrt(x0l)
                            cx = x0l
                            x0h = cz
                            if r_ecx == 0.0 {
                            } else {
                                ft = x0l
                                x0l = x0h
                                x0h = ft
                            }
                            x1l = x0l
                            x1h = x0h
                            ft = x0l
                            x2l = x0h
                            x2h = ft
                            ft = x0h * x1h
                            x0l = x0l * x1l
                            x0h = ft
                            ft = x2h * x1h
                            x2l = x2l * x1l
                            x2h = ft
                            x0h = -x0h
                            ft = x2l + x2h
                            x0l = x0l + x0h
                            x0h = ft
                            if r_edx <= 2.0 {
                            } else {
                                x3l = x1l
                                x3h = x1h
                                if r_edx < 4.0 {
                                } else {
                                    x4l = x0l
                                    x4h = x0h
                                    x1l = x0l
                                    x1h = x0h
                                    ft = x0l
                                    x2l = x0h
                                    x2h = ft
                                    ft = x0h * x1h
                                    x0l = x0l * x1l
                                    x0h = ft
                                    ft = x2h * x1h
                                    x2l = x2l * x1l
                                    x2h = ft
                                    x0h = -x0h
                                    ft = x2l + x2h
                                    x0l = x0l + x0h
                                    x0h = ft
                                    if r_edx < 8.0 {
                                        if r_edx < 6.0 {
                                        } else {
                                            x1l = x4l
                                            x1h = x4h
                                            ft = x0l
                                            x2l = x0h
                                            x2h = ft
                                            ft = x0h * x1h
                                            x0l = x0l * x1l
                                            x0h = ft
                                            ft = x2h * x1h
                                            x2l = x2l * x1l
                                            x2h = ft
                                            x0h = -x0h
                                            ft = x2l + x2h
                                            x0l = x0l + x0h
                                            x0h = ft
                                        }
                                    } else {
                                        x1l = x0l
                                        x1h = x0h
                                        ft = x0l
                                        x2l = x0h
                                        x2h = ft
                                        ft = x0h * x1h
                                        x0l = x0l * x1l
                                        x0h = ft
                                        ft = x2h * x1h
                                        x2l = x2l * x1l
                                        x2h = ft
                                        x0h = -x0h
                                        ft = x2l + x2h
                                        x0l = x0l + x0h
                                        x0h = ft
                                        if r_edx < 10.0 {
                                        } else {
                                            x1l = x4l
                                            x1h = x4h
                                            ft = x0l
                                            x2l = x0h
                                            x2h = ft
                                            ft = x0h * x1h
                                            x0l = x0l * x1l
                                            x0h = ft
                                            ft = x2h * x1h
                                            x2l = x2l * x1l
                                            x2h = ft
                                            x0h = -x0h
                                            ft = x2l + x2h
                                            x0l = x0l + x0h
                                            x0h = ft
                                        }
                                    }
                                }
                                cfl = sel(floor(r_edx / 1.0) - 2.0 * floor(r_edx / 2.0) > 0.5, 1.0, 0.0)
                                r_edx = floor(r_edx / 2.0)
                                if !(cfl > 0.5) {
                                } else {
                                    x1l = x3l
                                    x1h = x3h
                                    ft = x0l
                                    x2l = x0h
                                    x2h = ft
                                    ft = x0h * x1h
                                    x0l = x0l * x1l
                                    x0h = ft
                                    ft = x2h * x1h
                                    x2l = x2l * x1l
                                    x2h = ft
                                    x0h = -x0h
                                    ft = x2l + x2h
                                    x0l = x0l + x0h
                                    x0h = ft
                                }
                            }
                            if r_ecx == 0.0 {
                            } else {
                                ft = x0l
                                x0l = x0h
                                x0h = ft
                            }
                            x1l = x0l
                            x1h = x0h
                            x1l = x1l / cx
                            ft = x1l
                            x1h = ft
                            ft = x1h * x5h
                            x1l = x1l * x5l
                            x1h = ft
                            ft = x0h
                            x0l = x0h
                            x0h = ft
                            ft = x1l
                            x0h = ft
                            ft = x1h
                            x1l = x1h
                            x1h = ft
                        } else {
                            cz = x0h
                            ft = x1l
                            x0h = ft
                            x5l = x0l
                            x5h = x0h
