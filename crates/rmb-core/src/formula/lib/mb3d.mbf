        f0 = f0 - f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 - f1
        f1 = x
        f1 = f1 * y
        f1 = f1 + f1
        f2 = 1.0
        f3 = z
        f3 = f3 * f3
        if k12 <= 0.0 {
            if k12 == 0.0 {
            } else {
                f4 = z
                f5 = 0.0
                fc_a = f5
                fc_b = f4
                if fc_a < fc_b {
                } else {
                    f3 = -f3
                }
            }
        } else {
            f3 = -f3
        }
        f4 = x
        f4 = f4 * f4
        f5 = y
        f5 = f5 * f5
        f4 = f4 + f5
        f5 = k24
        f5 = abs(f5)
        f4 = f4 + f5
        f3 = f3 / f4
        f2 = f2 + f3
        f1 = f1 * f2
        f2 = x
        f2 = f2 * z
        f2 = f2 + f2
        f3 = 1.0
        f4 = y
        f4 = f4 * f4
        if k16 <= 0.0 {
            if k16 == 0.0 {
            } else {
                f5 = y
                f6 = 0.0
                fc_a = f6
                fc_b = f5
                if fc_a < fc_b {
                } else {
                    f4 = -f4
                }
            }
        } else {
            f4 = -f4
        }
        f5 = x
        f5 = f5 * f5
        f6 = z
        f6 = f6 * f6
        f5 = f5 + f6
        f6 = k24
        f6 = abs(f6)
        f5 = f5 + f6
        f4 = f4 / f5
        f3 = f3 + f4
        f2 = f2 * f3
        f2 = f2 + cz
        z = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cx
        x = f0
    }
}

