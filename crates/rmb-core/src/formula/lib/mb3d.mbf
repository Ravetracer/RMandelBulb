        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        x0l = y
        x0h = z
        x1l = x
        x1h = 0.0
        ft = x0h * k40
        x0l = x0l * k48
        x0h = ft
        x1l = x1l * k48
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k72
        if k108 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k48
            y = x0l
            z = x0h
            x = x1l
            a0 = x5l
        }
        m28 = x0l
        m20 = x0h
        m12 = x1l
        f0 = m28
        f0 = abs(f0)
        f1 = m20
        f1 = abs(f1)
        f2 = m12
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        m12 = f2
        m20 = f1
        m28 = f0
        f0 = m28
        f0 = f0 * k80
        f1 = m12
        f1 = f1 * k88
        f0 = f0 + f1
        f1 = m28
        f1 = f1 * k88
        f2 = m12
        f2 = f2 * k80
        f2 = -f2
        f1 = f1 + f2
        m28 = f1
        m12 = f0
        f0 = m28
        f0 = f0 * k96
        f1 = m20
        f1 = f1 * k104
        f0 = f0 + f1
        f1 = m28
        f1 = f1 * k104
        f2 = m20
        f2 = f2 * k96
        f2 = -f2
        f1 = f1 + f2
        m28 = f1
        m20 = f0
        f0 = m20
        f0 = f0 - k24
        m20 = f0
        f0 = f0 * f0
        f1 = m12
        f1 = f1 - k32
        m12 = f1
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k16
        f1 = m28
        f1 = abs(f1)
        f1 = f1 - k116
        f1 = f1 * f1
        f2 = m20
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = m12
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
