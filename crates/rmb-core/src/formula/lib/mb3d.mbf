        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * k16
        f1 = x
        f1 = f1 * f1
        f2 = k48
        f2 = f2 - k24
        f1 = f1 * f2
        f0 = f0 + f1
        f1 = y
        f1 = f1 * f1
        f2 = k56
        f2 = f2 - k32
        f1 = f1 * f2
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f2 = k64
        f2 = f2 - k40
        f1 = f1 * f2
        f0 = f0 + f1
        f1 = y
        f1 = f1 * k16
        f2 = x
        f2 = f2 * f2
        f3 = k64
        f3 = f3 - k24
        f2 = f2 * f3
        f1 = f1 + f2
        f2 = y
        f2 = f2 * f2
        f3 = k48
        f3 = f3 - k32
        f2 = f2 * f3
        f1 = f1 + f2
        f2 = z
        f2 = f2 * f2
        f3 = k56
        f3 = f3 - k40
        f2 = f2 * f3
        f1 = f1 + f2
        f2 = z
        f2 = f2 * k16
        f3 = x
        f3 = f3 * f3
        f4 = k56
        f4 = f4 - k24
        f3 = f3 * f4
        f2 = f2 + f3
        f3 = y
        f3 = f3 * f3
        f4 = k64
        f4 = f4 - k32
        f3 = f3 * f4
        f2 = f2 + f3
        f3 = z
        f3 = f3 * f3
        f4 = k48
        f4 = f4 - k40
        f3 = f3 * f4
        f2 = f2 + f3
        z = f2
        y = f1
        x = f0
    }
}

formula "_rabinovich-f" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _rabinovich-f. Rabinovich-Fabrikant chaotic system in 3D - variation with four parameters and strength"
    de numeric
    transform
    alias "_rabinovich-f"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 1.0 [-1.0, 3.0] 
    param o2_beta "Beta" = 3.0 [-3.0, 9.0] 
    param o3_gamma "Gamma" = 0.87 [-1.13, 2.87] 
    param o4_delta "Delta" = 1.1 [-1.1, 3.3000000000000003] 
    init {
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = z
        f0 = f0 - k24
        f1 = x
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * y
        f1 = x
        f1 = f1 * k40
        f0 = f0 + f1
        f0 = f0 * k16
        f1 = z
        f1 = f1 * k32
        f1 = f1 + k24
        f2 = x
        f2 = f2 * f2
        f2 = -f2
        f1 = f1 + f2
        f1 = f1 * x
        f2 = y
        f2 = f2 * k40
        f1 = f1 + f2
        f1 = f1 * k16
        f2 = k24
        f2 = f2 - k32
        f2 = f2 * z
        f3 = k48
        f4 = x
        f4 = f4 * y
        f3 = f3 + f4
        f2 = f2 * f3
        f2 = f2 * k16
        z = f2
        y = f1
        x = f0
    }
}

formula "_recFold" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _recFold. As the name states, this creates many copies of your fractal, arranged in a rectangle shape. Screws up coords a bit, too."
    de numeric
    transform
    alias "_recFold"
    param o0_foldx "FoldX" = 1.0 [-1.0, 3.0] 
    param o1_asymm "Asymm" = -3.0 [-9.0, 3.0] 
    param o2_p "P" = 10.0 [-10.0, 30.0] 
    param o3_q "Q" = 1.0 [-1.0, 3.0] 
    param o4_iterations_max_1000 "#Iterations (max 1000)" = 4.0 [-4.0, 12.0] int
    init {
        let k44 = round(o4_iterations_max_1000)
        let k40 = o3_q
        let k32 = o2_p
        let k24 = o1_asymm
        let k16 = o0_foldx
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let r_eax = 0.0
        f0 = x
        f0 = abs(f0)
        f1 = z
        f1 = abs(f1)
        f2 = f1
        f2 = f2 + f0
        f3 = f1
        f3 = f3 - f0
        f3 = f3 - k24
        x = f3
        f2 = f2 - k32
        z = f2
        f0 = x
        f0 = abs(f0)
        f0 = -f0
        f1 = z
        f2 = f1
        f2 = f0 - f2
        f3 = f1
        f3 = f3 + f0
        f3 = -f3
        f3 = f3 - k40
        f3 = f3 * 0.5
        x = f3
        f2 = f2 - k40
        f2 = f2 * 0.5
        z = f2
        f0 = k16
        f1 = x
        fc_a = f1
        fc_b = 0.0
        if fc_a < fc_b {
            r_eax = sel(fc_a < fc_b, 6144.0, sel(fc_a == fc_b, 14336.0, 6144.0))
        } else {
            r_eax = k44
            r_eax = r_eax - 1.0
            if r_eax <= 0.0 {
            } else {
                if r_eax > 999.0 {
                } else {
                    loop {
                        f1 = f0 - f1
                        f1 = abs(f1)
                        f1 = f0 - f1
                        f1 = abs(f1)
                        r_eax = r_eax - 1.0
                        if r_eax > 0.0 {
                            continue
                        } else {
                            break
                        }
                    }
                }
            }
        }
        f0 = f1
        x = f0
    }
}

formula "_reciprocalX" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _reciprocalX. Computes the reciprocal of x:"
    de numeric
    transform
    alias "_reciprocalX"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        f0 = x
        f1 = 1.0
        f0 = f1 / f0
        x = f0
    }
}

formula "_reciprocalX2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _reciprocalX2. Computes the reciprocal of x:"
    de numeric
    transform
    alias "_reciprocalX2"
    param o0_limiter "Limiter" = 0.5 [-1.5, 2.5] 
    init {
        let k16 = o0_limiter
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let sv1 = 0.0
        f0 = x
        sv1 = x
        f0 = abs(f0)
        f0 = f0 + k16
        f1 = 1.0
        f0 = f1 / f0
        x = f0
        x = sel(sv1 < 0.0, -x, x)
    }
}

formula "_reciprocalX3" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _reciprocalX3. Computes the reciprocal of x with a different (continuous) function:"
    de numeric
    transform
    alias "_reciprocalX3"
    param o0_limiter "Limiter" = 0.5 [-1.5, 2.5] 
    init {
        let k24 = 1.0 / max(1.0e-40, o0_limiter)
        let k16 = o0_limiter
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let sv1 = 0.0
        f0 = x
        sv1 = x
        f0 = abs(f0)
        f0 = f0 + k16
        f1 = 1.0
        f0 = f1 / f0
        f0 = -f0
        f0 = f0 + k24
        x = f0
        x = sel(sv1 < 0.0, -x, x)
    }
}

formula "_reciprocalX3b" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _reciprocalX3b. Computes a reciprocal-style function of x with a different (continuous) function,"
    de numeric
    transform
    alias "_reciprocalX3b"
    param o0_limiter1 "Limiter1" = 0.67 [-1.33, 2.67] 
    param o1_limiter2 "Limiter2" = 0.67 [-1.33, 2.67] 
    param o2_mul1 "mul1" = 1.0 [-1.0, 3.0] 
    param o3_mul2 "mul2" = 1.0 [-1.0, 3.0] 
