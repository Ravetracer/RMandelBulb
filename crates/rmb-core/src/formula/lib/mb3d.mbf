        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = abs(f0)
        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        f3 = f2
        f3 = f3 * f3
        f4 = f1
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = k72
        f4 = f4 * k88
        fc_a = f4
        fc_b = f3
        if fc_a >= fc_b {
            f4 = k80
            f4 = f4 * k88
            fc_a = f4
            fc_b = f3
            if fc_a < fc_b {
            } else {
                f3 = k80
                f3 = f3 * k88
            }
            f4 = k72
