formula "_Translate" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _Translate. "
    de numeric
    transform
    alias "_Translate"
    param o0_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o1_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    init {
        let k32 = o2_z_add
        let k24 = o1_y_add
        let k16 = o0_x_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = z
        f1 = y
        f2 = x
        f2 = f2 + k16
        x = f2
        f1 = f1 + k24
        y = f1
        f0 = f0 + k32
        z = f0
    }
}

formula "_TranslateC4d" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _TranslateC4d. Add a constant to the 4d vector and C components:"
    de numeric
    transform
    alias "_TranslateC4d"
    param o0_x_add "x add" = 0.0 [-2.0, 2.0] 
    param o1_y_add "y add" = 0.0 [-2.0, 2.0] 
    param o2_z_add "z add" = 0.0 [-2.0, 2.0] 
    param o3_w_add "w add" = 0.0 [-2.0, 2.0] 
    param o4_cx_add "Cx add" = 0.0 [-2.0, 2.0] 
    param o5_cy_add "Cy add" = 0.0 [-2.0, 2.0] 
    param o6_cz_add "Cz add" = 0.0 [-2.0, 2.0] 
    param o7_cw_add "Cw add" = 0.0 [-2.0, 2.0] 
    init {
        let k72 = o7_cw_add
        let k64 = o6_cz_add
        let k56 = o5_cy_add
        let k48 = o4_cx_add
        let k40 = o3_w_add
        let k32 = o2_z_add
        let k24 = o1_y_add
        let k16 = o0_x_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = dr
        f1 = z
        f2 = y
        f3 = x
        f3 = f3 + k16
        x = f3
        f2 = f2 + k24
        y = f2
        f1 = f1 + k32
        z = f1
        f0 = f0 + k40
        dr = f0
        f0 = cw
        f1 = cz
        f2 = cy
        f3 = cx
        f3 = f3 + k48
        cx = f3
        f2 = f2 + k56
        cy = f2
        f1 = f1 + k64
        cz = f1
        f0 = f0 + k72
        cw = f0
    }
}

formula "_YplusSinZ" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _YplusSinZ. y' = y + sin(z)"
    de numeric
    transform
    alias "_YplusSinZ"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        f0 = y
        f1 = z
        f1 = sin(f1)
        f0 = f0 + f1
        y = f0
    }
}

formula "_YplusSinZ2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _YplusSinZ2. A groovy waveform function that distorts nicely your fractal;"
    de numeric
    transform
    alias "_YplusSinZ2"
    param o0_h_phase "h (phase)" = 3.0 [-3.0, 9.0] 
    param o1_k_ampli "k (ampli)" = 1.0 [-1.0, 3.0] 
    init {
        let k24 = o1_k_ampli
        let k16 = o0_h_phase
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        f0 = z
        f0 = f0 * k16
        f1 = 3.141592653589793
        f0 = f0 * f1
        f0 = cos(f0)
        f0 = f0 * k24
        f0 = f0 - k24
        f0 = f0 + 2.0
        f0 = f0 * 0.5
        f1 = z
        f1 = sin(f1)
        f0 = f0 * f1
        f0 = f0 + y
        y = f0
    }
}

formula "_addC" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _addC. "
    de numeric
    transform
    alias "_addC"
    param o0_cx_multiplier "Cx multiplier" = 1.0 [-1.0, 3.0] 
    param o1_cy_multiplier "Cy multiplier" = 1.0 [-1.0, 3.0] 
    param o2_cz_multiplier "Cz multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k32 = o2_cz_multiplier
        let k24 = o1_cy_multiplier
        let k16 = o0_cx_multiplier
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = cx
        f3 = f3 * k16
        f2 = f2 + f3
        x = f2
        f2 = cy
        f2 = f2 * k24
        f1 = f1 + f2
        y = f1
        f1 = cz
        f1 = f1 * k32
        f0 = f0 + f1
        z = f0
    }
}

formula "_asdamTrans" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _asdamTrans. A cool 3D transform suggested by Asdam in the forums;"
    de numeric
    transform
    alias "_asdamTrans"
    param o0_term_rotation_x "Term Rotation X" = 0.0 [-180.0, 180.0] angle
    param o1_term_rotation_y "Term Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o2_term_rotation_z "Term Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o3_term_scale "Term Scale" = 0.5 [-1.5, 2.5] 
    init {
        let k52 = o3_term_scale
        let k44 = single(cos(o0_term_rotation_x * pi / 180.0) * cos(o1_term_rotation_y * pi / 180.0))
        let k40 = single(cos(o0_term_rotation_x * pi / 180.0) * sin(o1_term_rotation_y * pi / 180.0) * sin(o2_term_rotation_z * pi / 180.0) + sin(o0_term_rotation_x * pi / 180.0) * cos(o2_term_rotation_z * pi / 180.0))
        let k36 = single(sin(o0_term_rotation_x * pi / 180.0) * sin(o2_term_rotation_z * pi / 180.0) - cos(o0_term_rotation_x * pi / 180.0) * sin(o1_term_rotation_y * pi / 180.0) * cos(o2_term_rotation_z * pi / 180.0))
        let k32 = single(-sin(o0_term_rotation_x * pi / 180.0) * cos(o1_term_rotation_y * pi / 180.0))
        let k28 = single(cos(o0_term_rotation_x * pi / 180.0) * cos(o2_term_rotation_z * pi / 180.0) - sin(o0_term_rotation_x * pi / 180.0) * sin(o1_term_rotation_y * pi / 180.0) * sin(o2_term_rotation_z * pi / 180.0))
        let k24 = single(sin(o0_term_rotation_x * pi / 180.0) * sin(o1_term_rotation_y * pi / 180.0) * cos(o2_term_rotation_z * pi / 180.0) + cos(o0_term_rotation_x * pi / 180.0) * sin(o2_term_rotation_z * pi / 180.0))
        let k20 = single(sin(o1_term_rotation_y * pi / 180.0))
        let k16 = single(-cos(o1_term_rotation_y * pi / 180.0) * sin(o2_term_rotation_z * pi / 180.0))
        let k12 = single(cos(o1_term_rotation_y * pi / 180.0) * cos(o2_term_rotation_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let ft = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = k52
        f0 = f1 / f0
        f1 = z
        f1 = f1 * f0
        f2 = y
        f2 = f2 * f0
        f3 = x
        f3 = f3 * f0
        f4 = f3
        f4 = f4 * k36
        f5 = f2
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f1
        f5 = f5 * k44
        f4 = f4 + f5
        f5 = f3
        f5 = f5 * k12
        f6 = f2
        f6 = f6 * k16
        f5 = f5 + f6
        f6 = f1
        f6 = f6 * k20
        f5 = f5 + f6
        ft = f5
        f5 = f3
        f3 = ft
        f5 = f5 * k24
        ft = f5
        f5 = f2
        f2 = ft
        f5 = f5 * k28
        f2 = f2 + f5
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k32
        f2 = f2 + f4
        f3 = f3 + x
        x = f3
        f2 = f2 + y
        y = f2
        f1 = f1 + z
        z = f1
    }
}

formula "_boxtiling" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _boxtiling. 4D tiling, the entire space will be filled with copies of a box with center in the origin and desired dimensions."
    de numeric
    transform
    descale 10.0
    alias "_boxtiling"
    param o0_x_size "x size" = 5.0 [-5.0, 15.0] 
    param o1_y_size "y size" = 5.0 [-5.0, 15.0] 
    param o2_z_size "z size" = 5.0 [-5.0, 15.0] 
    param o3_w_size "w size" = 5.0 [-5.0, 15.0] 
    init {
        let k40 = o3_w_size
        let k32 = o2_z_size
        let k24 = o1_y_size
        let k16 = o0_x_size
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = k40
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = dr
            f1 = f0
            f1 = f1 / k40
            f1 = round(f1)
            f1 = f1 * k40
            f0 = f0 - f1
            dr = f0
        }
        f0 = k32
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = z
            f1 = f0
            f1 = f1 / k32
            f1 = round(f1)
            f1 = f1 * k32
            f0 = f0 - f1
            z = f0
        }
        f0 = k24
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = y
            f1 = f0
            f1 = f1 / k24
            f1 = round(f1)
            f1 = f1 * k24
            f0 = f0 - f1
            y = f0
        }
        f0 = k16
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = x
            f1 = f0
            f1 = f1 / k16
            f1 = round(f1)
            f1 = f1 * k16
            f0 = f0 - f1
            x = f0
        }
    }
}

