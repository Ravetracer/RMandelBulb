        let k88 = single(sin(o8_rotation1_x * pi / 180.0) * sin(o9_rotation1_y * pi / 180.0) * cos(o10_rotation1_z * pi / 180.0) + cos(o8_rotation1_x * pi / 180.0) * sin(o10_rotation1_z * pi / 180.0))
        let k84 = single(sin(o9_rotation1_y * pi / 180.0))
        let k80 = single(-cos(o9_rotation1_y * pi / 180.0) * sin(o10_rotation1_z * pi / 180.0))
