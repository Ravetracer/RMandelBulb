formula "ASurfMod1" {
    category "MB3D 3D"
    description "Mandelbulb3D formula ASurfMod1. Combination of Kali's ideas; Amazing Surface & AboxMod1."
    de linear
    alias "ASurfMod1"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_min_r "Min R" = 0.0 [-2.0, 2.0] 
    param o2_fold "Fold" = 2.0 [-2.0, 6.0] 
    param o3_scale_vary "Scale vary" = 0.0 [-2.0, 2.0] 
    param o4_foldxmod "FoldXMod" = 0.0 [-2.0, 2.0] 
    param o5_foldymod "FoldYMod" = 0.0 [-2.0, 2.0] 
    param o6_1_radius "1/Radius" = 1.0 [-1.0, 3.0] 
    param o7_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k108 = single(cos(o7_rotation1_x * pi / 180.0) * cos(o8_rotation1_y * pi / 180.0))
        let k104 = single(cos(o7_rotation1_x * pi / 180.0) * sin(o8_rotation1_y * pi / 180.0) * sin(o9_rotation1_z * pi / 180.0) + sin(o7_rotation1_x * pi / 180.0) * cos(o9_rotation1_z * pi / 180.0))
        let k100 = single(sin(o7_rotation1_x * pi / 180.0) * sin(o9_rotation1_z * pi / 180.0) - cos(o7_rotation1_x * pi / 180.0) * sin(o8_rotation1_y * pi / 180.0) * cos(o9_rotation1_z * pi / 180.0))
        let k96 = single(-sin(o7_rotation1_x * pi / 180.0) * cos(o8_rotation1_y * pi / 180.0))
        let k92 = single(cos(o7_rotation1_x * pi / 180.0) * cos(o9_rotation1_z * pi / 180.0) - sin(o7_rotation1_x * pi / 180.0) * sin(o8_rotation1_y * pi / 180.0) * sin(o9_rotation1_z * pi / 180.0))
