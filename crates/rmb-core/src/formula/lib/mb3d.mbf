    de numeric
    alias "Makin-NSR-tri"
    param o0_power "Power" = 3.0 [-3.0, 9.0] 
    param o1_z_mul "z-Mul" = 1.0 [-1.0, 3.0] 
    init {
        let k24 = o1_z_mul
        let k16 = o0_power
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        f0 = y
        f1 = x
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m20 = f1
        m12 = f0
        f0 = z
        f1 = y
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m36 = f1
        m28 = f0
        f0 = x
        f1 = z
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m52 = f1
        m44 = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = k16
        ft = f1
        f1 = f0
        f0 = ft
        f1 = abs(f1)
        f0 = f0 * log(f1) * 1.4426950408889634
        f1 = 1.0
        f2 = f0
        f2 = f2 % f1
        f2 = pow(2.0, f2) - 1.0
        f1 = f1 + f2
        f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
        ft = f1
        f1 = f0
        f0 = ft
        m60 = f0
        f0 = m28
        f0 = f0 * m52
        z = f0
        f0 = m20
        f0 = f0 * m44
        x = f0
        f0 = m12
        f0 = f0 * m36
        y = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = m60 / f0
        f1 = x
        f1 = f1 * f0
        f1 = f1 + cx
        x = f1
        f1 = y
        f1 = f1 * f0
        f1 = f1 + cy
        y = f1
        f1 = z
        f0 = f0 * f1
        f0 = f0 * k24
        f0 = f0 + cz
        z = f0
    }
}

