        f0 = f0 + cz
        z = f0
    }
}

formula "Riemann2" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Riemann2. Generalized from a msltoe formula;"
    de numeric
    alias "Riemann2"
    param o0_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o1_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o2_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o3_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o4_rpow "RPow" = 2.0 [-2.0, 6.0] 
    param o5_r_shift "r-Shift" = -0.25 [-2.25, 1.75] 
    param o6_s_shift "s-Shift" = 0.0 [-2.0, 2.0] 
    param o7_t_shift "t-Shift" = 0.0 [-2.0, 2.0] 
    param o8_x_shift "x-Shift" = 1.0 [-1.0, 3.0] 
