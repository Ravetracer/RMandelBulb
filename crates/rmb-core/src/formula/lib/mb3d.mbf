        let k40 = single(cos(o0_rotation_x * pi / 180.0) * sin(o1_rotation_y * pi / 180.0) * sin(o2_rotation_z * pi / 180.0) + sin(o0_rotation_x * pi / 180.0) * cos(o2_rotation_z * pi / 180.0))
        let k36 = single(sin(o0_rotation_x * pi / 180.0) * sin(o2_rotation_z * pi / 180.0) - cos(o0_rotation_x * pi / 180.0) * sin(o1_rotation_y * pi / 180.0) * cos(o2_rotation_z * pi / 180.0))
