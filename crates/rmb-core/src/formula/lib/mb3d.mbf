formula "_RotateBack" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _RotateBack. You generally don't need to use this. This transform is 'specialistic'..."
    de numeric
    transform
    alias "_RotateBack"
    param o0_undo_rotation_x "Undo rotation X" = 0.0 [-180.0, 180.0] angle
    param o1_undo_rotation_y "Undo rotation Y" = 0.0 [-180.0, 180.0] angle
    param o2_undo_rotation_z "Undo rotation Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k44 = single(cos(o0_undo_rotation_x * pi / 180.0) * cos(o1_undo_rotation_y * pi / 180.0))
        let k40 = single(cos(o0_undo_rotation_x * pi / 180.0) * sin(o1_undo_rotation_y * pi / 180.0) * sin(o2_undo_rotation_z * pi / 180.0) + sin(o0_undo_rotation_x * pi / 180.0) * cos(o2_undo_rotation_z * pi / 180.0))
        let k36 = single(sin(o0_undo_rotation_x * pi / 180.0) * sin(o2_undo_rotation_z * pi / 180.0) - cos(o0_undo_rotation_x * pi / 180.0) * sin(o1_undo_rotation_y * pi / 180.0) * cos(o2_undo_rotation_z * pi / 180.0))
        let k32 = single(-sin(o0_undo_rotation_x * pi / 180.0) * cos(o1_undo_rotation_y * pi / 180.0))
        let k28 = single(cos(o0_undo_rotation_x * pi / 180.0) * cos(o2_undo_rotation_z * pi / 180.0) - sin(o0_undo_rotation_x * pi / 180.0) * sin(o1_undo_rotation_y * pi / 180.0) * sin(o2_undo_rotation_z * pi / 180.0))
        let k24 = single(sin(o0_undo_rotation_x * pi / 180.0) * sin(o1_undo_rotation_y * pi / 180.0) * cos(o2_undo_rotation_z * pi / 180.0) + cos(o0_undo_rotation_x * pi / 180.0) * sin(o2_undo_rotation_z * pi / 180.0))
        let k20 = single(sin(o1_undo_rotation_y * pi / 180.0))
        let k16 = single(-cos(o1_undo_rotation_y * pi / 180.0) * sin(o2_undo_rotation_z * pi / 180.0))
        let k12 = single(cos(o1_undo_rotation_y * pi / 180.0) * cos(o2_undo_rotation_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k20
        f4 = f1
        f4 = f4 * k32
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k24
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k36
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k16
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k40
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
    }
