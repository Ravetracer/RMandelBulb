        let q5_1_21 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_01 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_21
        let q5_1_22 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_02 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_22
        let q5_1_23 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_03 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_23
