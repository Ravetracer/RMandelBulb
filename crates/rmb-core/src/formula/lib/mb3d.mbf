        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = -f2
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f1
        f3 = f3 * k104
        f4 = f2
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f1
        f4 = f4 * k80
        f5 = f2
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
