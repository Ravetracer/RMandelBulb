        let k120 = single(sin(o11_rotation_x * pi / 180.0) * sin(o12_rotation_y * pi / 180.0) * cos(o13_rotation_z * pi / 180.0) + cos(o11_rotation_x * pi / 180.0) * sin(o13_rotation_z * pi / 180.0))
