        f5 = f5 * k16
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k20
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k32
        f1 = f1 + f3
        f2 = f2 * k52
        f2 = f2 + k60
        x = f2
        f1 = f1 * k52
        f1 = f1 + k68
        y = f1
        f0 = f0 * k52
        f0 = f0 + k76
        z = f0
        f0 = dr
        f0 = f0 * k52
        dr = f0
        f0 = x
        f1 = cx
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        cx = f1
        x = f0
        f0 = y
        f1 = cy
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
