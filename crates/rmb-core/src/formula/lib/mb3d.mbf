        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        m36 = f0
        f0 = x
        f0 = f0 * 0.5
        f1 = dr
        f1 = f1 * 0.8660254037844387
        f0 = f0 + f1
        f0 = abs(f0)
