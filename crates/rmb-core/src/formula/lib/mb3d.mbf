            ft = f2
            f2 = f1
            f1 = ft
            f3 = f2
            f3 = f3 * f3
            ft = f3
            f3 = f0
            f0 = ft
            f4 = f3
            f4 = f4 * f4
            f0 = f0 + f4
            ft = f3
            f3 = f1
            f1 = ft
