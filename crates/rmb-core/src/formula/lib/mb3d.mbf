        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = px
        f0 = f0 - k16
        f1 = py
        f1 = f1 - k24
        f2 = pz
        f2 = f2 - k32
        f3 = f0
        f3 = f3 * f3
        f4 = f1
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        fc_a = f3
        fc_b = k40
        if fc_a <= fc_b {
            fc_a = f3
            fc_b = f2
            fc_a = f1
            fc_b = f0
        } else {
            f4 = f3
            f4 = f4 - k40
            f5 = f3
            f5 = abs(f5)
            fc_a = f5
            fc_b = 1e-10
            if fc_a > fc_b {
            } else {
                ft = f4
                f4 = f3
                f3 = ft
                f5 = 0.0
                fc_a = f5
                fc_b = f4
                f4 = 1e-10
                if fc_a <= fc_b {
                } else {
                    f4 = -f4
                }
                ft = f4
                f4 = f3
                f3 = ft
            }
