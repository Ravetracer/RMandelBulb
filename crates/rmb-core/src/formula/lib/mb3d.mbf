        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f1 = k32
        f0 = f0 * f1
        f1 = k16
        f0 = f0 + f1
        x = f0
        fc_a = x
        fc_b = 0.0
        f0 = abs(f0)
