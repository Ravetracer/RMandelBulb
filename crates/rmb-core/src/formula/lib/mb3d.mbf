            f0 = -f0
            if k76 != 0.0 {
            } else {
                f0 = f0 / k32
            }
            rout = f0
            r_eax = sel(fc_a < fc_b, 0.0, sel(fc_a == fc_b, 8192.0, 0.0))
        }
    }
}

formula "greekIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula greekIFS. Iso-surface made of a grid of tubes arranged in a 'greek spiral' pattern."
    de difs
    alias "greekIFS"
    param o0_radiusmod "RadiusMod" = 0.2 [-1.8, 2.2] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_squared "Squared" = 0.0 [-2.0, 2.0] int
    param o6_reverse "Reverse" = 0.0 [-2.0, 2.0] int
    param o7_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o8_planerot_x "PlaneRot X" = 0.0 [-180.0, 180.0] angle
    param o9_planerot_y "PlaneRot Y" = 0.0 [-180.0, 180.0] angle
    param o10_planerot_z "PlaneRot Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o8_planerot_x * pi / 180.0) * cos(o9_planerot_y * pi / 180.0))
        let k108 = single(cos(o8_planerot_x * pi / 180.0) * sin(o9_planerot_y * pi / 180.0) * sin(o10_planerot_z * pi / 180.0) + sin(o8_planerot_x * pi / 180.0) * cos(o10_planerot_z * pi / 180.0))
        let k104 = single(sin(o8_planerot_x * pi / 180.0) * sin(o10_planerot_z * pi / 180.0) - cos(o8_planerot_x * pi / 180.0) * sin(o9_planerot_y * pi / 180.0) * cos(o10_planerot_z * pi / 180.0))
        let k100 = single(-sin(o8_planerot_x * pi / 180.0) * cos(o9_planerot_y * pi / 180.0))
        let k96 = single(cos(o8_planerot_x * pi / 180.0) * cos(o10_planerot_z * pi / 180.0) - sin(o8_planerot_x * pi / 180.0) * sin(o9_planerot_y * pi / 180.0) * sin(o10_planerot_z * pi / 180.0))
        let k92 = single(sin(o8_planerot_x * pi / 180.0) * sin(o9_planerot_y * pi / 180.0) * cos(o10_planerot_z * pi / 180.0) + cos(o8_planerot_x * pi / 180.0) * sin(o10_planerot_z * pi / 180.0))
        let k88 = single(sin(o9_planerot_y * pi / 180.0))
        let k84 = single(-cos(o9_planerot_y * pi / 180.0) * sin(o10_planerot_z * pi / 180.0))
        let k80 = single(cos(o9_planerot_y * pi / 180.0) * cos(o10_planerot_z * pi / 180.0))
        let k76 = round(o7_apply_scale_add)
        let k72 = round(o6_reverse)
        let k68 = round(o5_squared)
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_radiusmod
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m64 = 0.0
        let m72 = 0.0
        let m80 = 0.0
        let sv1 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m80 = x0l
        m72 = x0h
        m64 = x1l
        f0 = m64
        f1 = m72
        f2 = m80
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        m80 = f2
        m72 = f1
        m64 = f0
        sv1 = m80
        f0 = m80
        f0 = abs(f0)
        f1 = m72
        if k72 != 0.0 {
            r_edx = sel(sv1 < 0.0, 191.0, sel(sv1 == 0.0, 0.0, 63.0))
        } else {
            r_edx = sel(sv1 < 0.0, 63.0, sel(sv1 == 0.0, 128.0, 191.0))
        }
        r_edx = ((floor(r_edx / 128.0) - 2.0 * floor(r_edx / 256.0)) * 128.0)
        if r_edx != 0.0 {
            f1 = f1 - 0.5
        } else {
            f1 = f1 + 0.5
        }
        f1 = abs(f1)
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            f0 = f1
        }
        f0 = f0 - 0.5
        f1 = f0
        f1 = round(f1)
        f0 = f0 - f1
        if k68 == 0.0 {
            f0 = f0 * f0
            f1 = m64
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
        } else {
            f0 = abs(f0)
            f1 = m64
            f1 = abs(f1)
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = f1
            }
        }
        f0 = f0 - k16
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "gumdropIFS" {
