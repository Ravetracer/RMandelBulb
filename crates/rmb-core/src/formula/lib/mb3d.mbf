formula "_ngon" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _ngon. Variation of PolyFolding; gets nearly identical results"
    de numeric
    transform
    alias "_ngon"
    param o0_order "Order" = 4.0 [-4.0, 12.0] 
    param o1_shift_deg "Shift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_shift_x "Shift x" = 0.0 [-2.0, 2.0] 
    param o3_shift_y "Shift y" = 0.0 [-2.0, 2.0] 
    param o4_skew_deg "Skew (deg)" = 0.0 [-2.0, 2.0] 
    param o5_no_yfold "No yfold" = 0.0 [-2.0, 2.0] int
    init {
        let k52 = round(o5_no_yfold)
        let k48 = o4_skew_deg
        let k40 = o3_shift_y
        let k32 = o2_shift_x
        let k24 = o1_shift_deg
        let k16 = o0_order
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let r_eax = 0.0
        let m36 = 0.0
        let m48 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k48
        f1 = f1 + k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m36 = f0
        m48 = round(f0)
        f0 = m48
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f2 = f2 * f1
        f3 = y
        f3 = f3 * f0
        f2 = f3 - f2
        f3 = m36
        r_eax = k52
        if r_eax != 0.0 {
        } else {
            f4 = m48
            f4 = -f4
            f3 = f3 + f4
            r_eax = m48
            r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
            if r_eax != 0.0 {
            } else {
                f3 = -f3
            }
        }
        f3 = f3 / k16
        f3 = f3 * 6.283185307
        f3 = f3 - k40
        y = f3
        f2 = f2 - k32
        x = f2
    }
}

formula "_ngon2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _ngon2. Variation of PolyFolding."
    de numeric
    transform
    alias "_ngon2"
    param o0_order "Order" = 4.0 [-4.0, 12.0] 
    param o1_shift_deg "Shift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_shift_x "Shift x" = 0.0 [-2.0, 2.0] 
    param o3_shift_y "Shift y" = 0.0 [-2.0, 2.0] 
    param o4_skew_deg "Skew (deg)" = 0.0 [-2.0, 2.0] 
    init {
        let k48 = o4_skew_deg
        let k40 = o3_shift_y
        let k32 = o2_shift_x
        let k24 = o1_shift_deg
        let k16 = o0_order
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let r_eax = 0.0
        let m36 = 0.0
        let m48 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k48
        f1 = f1 + k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m36 = f0
        m48 = round(f0)
        f0 = m48
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = y
        f2 = f2 * f1
        f3 = x
        f3 = f3 * f0
        f2 = f2 + f3
        r_eax = m48
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax != 0.0 {
        } else {
            f2 = -f2
        }
        f3 = y
        f3 = f3 * f3
        f4 = x
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        f3 = f3 / k16
        f3 = f3 * 6.283185307
        f3 = f3 - k40
        y = f3
        f2 = f2 - k32
        x = f2
    }
}

formula "_planeFold" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _planeFold. A folding on a arbitrary plane with normal N:"
    de numeric
    transform
    alias "_planeFold"
    param o0_normal_x "Normal X" = 1.0 [-1.0, 3.0] 
    param o1_normal_y "Normal Y" = 0.0 [-2.0, 2.0] 
    param o2_normal_z "Normal Z" = 0.0 [-2.0, 2.0] 
    init {
        let k32 = o2_normal_z
        let k24 = o1_normal_y
        let k16 = o0_normal_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let f7 = 0.0
        f0 = k32
        f1 = k24
        f2 = k16
        f3 = z
        f4 = y
        f5 = x
        f6 = f5
        f6 = f6 * f2
        f7 = f4
        f7 = f7 * f1
        f6 = f6 + f7
        f7 = f3
        f7 = f7 * f0
        f6 = f6 + f7
        f6 = f6 + f6
        f2 = f2 * f6
        f1 = f1 * f6
        f0 = f0 * f6
        f2 = f5 - f2
        f1 = f4 - f1
        f0 = f3 - f0
        x = f2
        y = f1
        z = f0
    }
}

formula "_poincare" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _poincare. Poincarè metric in 3D with selectable radius and center."
    de numeric
    transform
    alias "_poincare"
    param o0_x_center "X center" = 0.0 [-2.0, 2.0] 
    param o1_y_center "Y center" = 0.0 [-2.0, 2.0] 
    param o2_z_center "Z center" = 0.0 [-2.0, 2.0] 
    param o3_radius "Radius" = 1.0 [-1.0, 3.0] 
    param o4_p_radius "P-Radius" = 1.0 [-1.0, 3.0] 
    init {
        let k48 = o4_p_radius
        let k40 = o3_radius
        let k32 = o2_z_center
        let k24 = o1_y_center
        let k16 = o0_x_center
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f2 = f2 + k16
        x = f2
        f1 = f1 + k24
        y = f1
        f0 = f0 + k32
        z = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = -f0
        f1 = k48
        f0 = f0 + f1
        f0 = abs(f0)
        f1 = x
        f1 = abs(f1)
        f1 = f1 / f0
        f2 = k40
        f1 = f1 * f2
        f1 = f1 - k16
        x = f1
        f1 = y
        f1 = abs(f1)
        f1 = f1 / f0
        f2 = k40
        f1 = f1 * f2
        f1 = f1 - k24
        y = f1
        f1 = z
        f1 = abs(f1)
        ft = f1
        f1 = f0
        f0 = ft
        f0 = f0 / f1
        f1 = k40
        f0 = f0 * f1
        f0 = f0 - k32
        z = f0
    }
}

