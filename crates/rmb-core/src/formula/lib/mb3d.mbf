formula "_invbisp" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _invbisp. Inverse bi-spherical coords"
    de numeric
    transform
    alias "_invbisp"
    param o0_scale "Scale" = 1.0 [-1.0, 3.0] 
    init {
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        m20 = f0
        f1 = k16
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * f0
        f1 = k16
        f1 = f1 * z
        f1 = f1 + f1
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f0 = abs(f0)
        f0 = sqrt(f0)
        m28 = f0
        f0 = m20
        f1 = k16
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = k16
        f1 = f1 * z
        f1 = f1 + f1
        m36 = f1
        m20 = f0
        f0 = y
        f1 = x
        f0 = atan2(f0, f1)
        z = f0
        f0 = m28
        f0 = f0 * f0
        f1 = m20
        f1 = f1 * f1
        f0 = f0 - f1
        f0 = sqrt(f0)
        f1 = m20
        f0 = atan2(f0, f1)
        f0 = 1.5707963267948966 - f0
        x = f0
        f0 = m36
        f0 = f0 / m28
        f1 = f0
        f1 = f1 * f1
        f2 = 1.0
        f1 = f1 + f2
        f1 = sqrt(f1)
        f0 = f0 + f1
        f1 = 1.4426950408889634
        ft = f1
        f1 = f0
        f0 = ft
        f0 = f0 * log(f1) * 1.4426950408889634
        y = f0
    }
}

formula "_invcylindrical" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _invcylindrical. Inverse cylindrical coords, very easy transform"
    de numeric
    transform
    alias "_invcylindrical"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = y
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f0 = f0 * f2
        f1 = f1 * f2
        x = f1
        y = f0
    }
}

formula "_invspherical" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _invspherical. Inverse spherical coords. Fast conversion without parameters."
    de numeric
    transform
    alias "_invspherical"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let ft = 0.0
        f0 = y
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = z
        f3 = cos(f2)
        f2 = sin(f2)
        ft = f3
        f3 = f1
        f1 = ft
        f3 = f3 * x
        z = f3
        ft = f2
        f2 = f0
        f0 = ft
        f1 = f1 * f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * x
        ft = f2
        f2 = f0
        f0 = ft
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * x
        f1 = f1 * f2
        y = f1
        x = f0
    }
}

formula "_invtorical" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _invtorical. Reversed torical (generalized) coords."
    de numeric
    transform
    alias "_invtorical"
    param o0_r "R" = 2.0 [-2.0, 6.0] 
    init {
        let k16 = o0_r
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = x
        f0 = -f0
        f0 = f0 + k16
        f0 = abs(f0)
        f1 = y
        f1 = cos(f1)
        f1 = abs(f1)
        f0 = f0 * f1
        x = f0
        f1 = y
        f1 = tan(f1)
        f2 = 1.0
        f1 = f1 * f2
        f0 = f0 * f1
        y = f0
    }
}

formula "_invtorical2" {
