        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        m70 = f2
        m62 = f1
        m54 = f0
        f0 = m54
        f0 = f0 * f0
        f0 = f0 * 8.0
        f0 = f0 + k16
        f0 = abs(f0)
        m46 = f0
        f0 = m62
        f0 = f0 * 4.0
        f0 = cos(f0)
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 + m46
            m46 = f0
        } else {
            f0 = m38 - f0
            m38 = f0
        }
        f0 = m70
        f0 = f0 * 3.46410162
        f1 = m62
        f1 = f1 * 2.0
        f0 = f0 - f1
        f0 = cos(f0)
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 + m46
            m46 = f0
        } else {
            f0 = m38 - f0
            m38 = f0
        }
        f0 = m70
        f0 = f0 * 3.46410162
        f1 = m62
        f1 = f1 * 2.0
        f0 = f0 + f1
        f0 = cos(f0)
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 + m46
            m46 = f0
        } else {
            f0 = m38 - f0
            m38 = f0
        }
        f0 = m70
        f0 = f0 * 6.92820323
        f0 = cos(f0)
        f0 = f0 * k72
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 + m46
            m46 = f0
        } else {
            f0 = m38 - f0
            m38 = f0
        }
        f0 = m70
