        m20 = f0
        f1 = k16
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * f0
        f1 = k16
        f1 = f1 * z
        f1 = f1 + f1
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f0 = abs(f0)
