formula "_helispiral" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _helispiral. 1)Rotates the reference axis by selected angles"
    de numeric
    transform
    alias "_helispiral"
    param o0_reference_rotation_x "Reference rotation X" = 0.0 [-180.0, 180.0] angle
    param o1_reference_rotation_y "Reference rotation Y" = 0.0 [-180.0, 180.0] angle
    param o2_reference_rotation_z "Reference rotation Z" = 0.0 [-180.0, 180.0] angle
    param o3_helix "Helix" = 0.03 [-1.97, 2.03] 
    param o4_spiral "Spiral" = 0.03 [-1.97, 2.03] 
    param o5_rotbyc_h "RotByC (H)" = 0.0 [-2.0, 2.0] int
    param o6_rotbyc_s "RotByC (S)" = 0.0 [-2.0, 2.0] int
    param o7_fixrot_deg "FixRot (deg)" = 0.0 [-2.0, 2.0] 
    init {
        let k76 = o7_fixrot_deg
        let k68 = round(o6_rotbyc_s)
        let k64 = round(o5_rotbyc_h)
        let k60 = o4_spiral
        let k52 = o3_helix
        let k44 = single(cos(o0_reference_rotation_x * pi / 180.0) * cos(o1_reference_rotation_y * pi / 180.0))
        let k40 = single(cos(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0) + sin(o0_reference_rotation_x * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0))
        let k36 = single(sin(o0_reference_rotation_x * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0) - cos(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0))
        let k32 = single(-sin(o0_reference_rotation_x * pi / 180.0) * cos(o1_reference_rotation_y * pi / 180.0))
        let k28 = single(cos(o0_reference_rotation_x * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0) - sin(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0))
        let k24 = single(sin(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0) + cos(o0_reference_rotation_x * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0))
        let k20 = single(sin(o1_reference_rotation_y * pi / 180.0))
        let k16 = single(-cos(o1_reference_rotation_y * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0))
        let k12 = single(cos(o1_reference_rotation_y * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k36
        f4 = f1
        f4 = f4 * k40
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k16
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k20
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k32
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        f0 = y
        f1 = x
        if k68 != 1.0 {
            f2 = f1
            f2 = f2 * f2
            f3 = y
        } else {
            f2 = cx
            f2 = f2 * f2
            f3 = cy
        }
        f3 = f3 * f3
        f2 = f2 + f3
        f2 = sqrt(f2)
        f3 = k60
        f2 = f2 * f3
        if k64 != 1.0 {
            f3 = z
        } else {
            f3 = cz
        }
        f4 = k52
        f3 = f3 * f4
        f2 = f2 + f3
        f3 = k76
        f3 = f3 * 0.017453293
        f2 = f2 + f3
        f3 = cos(f2)
        f2 = sin(f2)
        f4 = f3
        f4 = f4 * f1
        f5 = f2
        f5 = f5 * f0
        f4 = f4 + f5
        x = f4
        f0 = f0 * f3
        f1 = f1 * f2
        f0 = f0 - f1
        y = f0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k20
        f4 = f1
        f4 = f4 * k32
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k24
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k36
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k16
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k40
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
    }
}

formula "_hopalm2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _hopalm2. Hopalong (modified) system in 3D - variation with five parameters and strength"
    de numeric
    transform
    alias "_hopalm2"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = -0.4 [-2.4, 1.6] 
    param o2_beta "Beta" = 1.0 [-1.0, 3.0] 
    param o3_gamma "Gamma" = 0.1 [-1.9, 2.1] 
    param o4_delta "Delta" = 0.1 [-1.9, 2.1] 
    param o5_epsilon "Epsilon" = 0.2 [-1.8, 2.2] 
    init {
        let k56 = o5_epsilon
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = x
        f0 = f0 * k32
        f1 = z
        f1 = f1 * k40
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 + k48
        f1 = 1.0
        f0 = atan2(f0, f1)
        f0 = f0 + y
        f1 = k24
        f1 = f1 - x
        f1 = f1 * k16
        f2 = k24
        f2 = f2 * y
        f3 = x
        f3 = f3 * k32
        f3 = -f3
        f2 = f2 + f3
        f2 = f2 * k56
        f2 = f2 + z
        z = f2
        y = f1
        x = f0
    }
}

formula "_hopalong" {
