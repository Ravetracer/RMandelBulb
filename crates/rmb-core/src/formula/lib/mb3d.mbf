formula "_PolyFold-sym" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _PolyFold-sym. Useful to get symmetric poly and star effects. Sym because on even orders it is a continue symmetrical transform."
    de numeric
    transform
    alias "_PolyFold-sym"
    param o0_order "Order" = 4.0 [-4.0, 12.0] 
    param o1_shift_deg "Shift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_shift_x "Shift x" = 0.0 [-2.0, 2.0] 
    param o3_shift_y "Shift y" = 0.0 [-2.0, 2.0] 
    param o4_skew_deg "Skew (deg)" = 0.0 [-2.0, 2.0] 
    init {
        let k48 = o4_skew_deg
        let k40 = o3_shift_y
        let k32 = o2_shift_x
        let k24 = o1_shift_deg
        let k16 = o0_order
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let r_eax = 0.0
        let m32 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k48
        f1 = f1 + k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m32 = round(f0)
        f0 = m32
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f2 = f2 * f1
        f3 = y
        f3 = f3 * f0
        f2 = f3 - f2
        f3 = x
        f3 = f3 * f0
        f4 = y
        f4 = f4 * f1
        f3 = f3 + f4
        r_eax = m32
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax != 0.0 {
        } else {
            f3 = -f3
        }
        f3 = f3 - k40
        y = f3
        f2 = f2 - k32
        x = f2
    }
}

