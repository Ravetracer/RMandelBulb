        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
