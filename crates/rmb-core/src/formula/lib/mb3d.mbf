formula "MengerHyper" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MengerHyper. A combination of FoldingOct, SphereInv, MengerIFS for hyperbolic"
    de linear
    descale 0.4
    alias "MengerHyper"
    param o0_scale "Scale" = 3.0 [-3.0, 9.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
