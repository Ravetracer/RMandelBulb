        let k104 = single(sin(o7_mitrerot_x * pi / 180.0) * sin(o9_mitrerot_z * pi / 180.0) - cos(o7_mitrerot_x * pi / 180.0) * sin(o8_mitrerot_y * pi / 180.0) * cos(o9_mitrerot_z * pi / 180.0))
        let k100 = single(-sin(o7_mitrerot_x * pi / 180.0) * cos(o8_mitrerot_y * pi / 180.0))
        let k96 = single(cos(o7_mitrerot_x * pi / 180.0) * cos(o9_mitrerot_z * pi / 180.0) - sin(o7_mitrerot_x * pi / 180.0) * sin(o8_mitrerot_y * pi / 180.0) * sin(o9_mitrerot_z * pi / 180.0))
        let k92 = single(sin(o7_mitrerot_x * pi / 180.0) * sin(o8_mitrerot_y * pi / 180.0) * cos(o9_mitrerot_z * pi / 180.0) + cos(o7_mitrerot_x * pi / 180.0) * sin(o9_mitrerot_z * pi / 180.0))
        let k88 = single(sin(o8_mitrerot_y * pi / 180.0))
