formula "_FoldingIcosa" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _FoldingIcosa. Just like IcosahedronIFS, just dropped anything but the rotation and the dodeca-fold."
    de numeric
    transform
    alias "_FoldingIcosa"
    param o0_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o1_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o2_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k44 = single(cos(o0_rotation1_x * pi / 180.0) * cos(o1_rotation1_y * pi / 180.0))
        let k40 = single(cos(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0) + sin(o0_rotation1_x * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0))
        let k36 = single(sin(o0_rotation1_x * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0) - cos(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0))
        let k32 = single(-sin(o0_rotation1_x * pi / 180.0) * cos(o1_rotation1_y * pi / 180.0))
        let k28 = single(cos(o0_rotation1_x * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0) - sin(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0))
        let k24 = single(sin(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0) + cos(o0_rotation1_x * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0))
        let k20 = single(sin(o1_rotation1_y * pi / 180.0))
        let k16 = single(-cos(o1_rotation1_y * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0))
        let k12 = single(cos(o1_rotation1_y * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k36
        f4 = f1
        f4 = f4 * k40
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f3 = abs(f3)
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k16
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k20
        f4 = f4 + f5
        f4 = abs(f4)
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k32
        f1 = f1 + f3
        ft = f2
        f2 = f1
        f1 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f2
        f3 = f3 * 0.309016994374947
        f4 = f1
        f4 = f4 * (-0.5)
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * (-0.809016994374947)
        f3 = f3 + f4
        fc_a = f3
        fc_b = 0.0
        if fc_a >= fc_b {
        } else {
            f3 = f3 + f3
            f4 = (-0.5)
            f5 = 0.309016994374947
            f6 = (-0.809016994374947)
            ft = f6
            f6 = f3
            f3 = ft
            f3 = f3 * f6
            f4 = f4 * f6
            f5 = f5 * f6
            f2 = f2 - f5
            f1 = f1 - f4
            f0 = f0 - f3
        }
        ft = f2
        f2 = f1
        f1 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f0
        f0 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f0
        f0 = ft
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f2
        f3 = f3 * 0.309016994374947
        f4 = f1
        f4 = f4 * (-0.5)
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * (-0.809016994374947)
        f3 = f3 + f4
        fc_a = f3
        fc_b = 0.0
        if fc_a >= fc_b {
        } else {
            f3 = f3 + f3
            f4 = (-0.5)
            f5 = 0.309016994374947
            f6 = (-0.809016994374947)
            ft = f6
            f6 = f3
            f3 = ft
            f3 = f3 * f6
            f4 = f4 * f6
            f5 = f5 * f6
            f2 = f2 - f5
            f1 = f1 - f4
            f0 = f0 - f3
        }
        ft = f2
        f2 = f1
        f1 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f0
        f0 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f0
        f0 = ft
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f2
        f3 = f3 * 0.309016994374947
        f4 = f1
        f4 = f4 * (-0.5)
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * (-0.809016994374947)
        f3 = f3 + f4
        fc_a = f3
        fc_b = 0.0
        if fc_a >= fc_b {
        } else {
            f3 = f3 + f3
            f4 = (-0.5)
            f5 = 0.309016994374947
            f6 = (-0.809016994374947)
            ft = f6
            f6 = f3
            f3 = ft
            f3 = f3 * f6
            f4 = f4 * f6
            f5 = f5 * f6
            f2 = f2 - f5
            f1 = f1 - f4
            f0 = f0 - f3
        }
        ft = f2
        f2 = f1
        f1 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f0
        f0 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f0
        f0 = ft
        y = f2
        x = f1
        z = f0
    }
}

formula "_FoldingInfy" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _FoldingInfy. Continuous, seamless folding of 4D space. Boxtiling 'enhanced' version."
    de numeric
    transform
    descale 10.0
    alias "_FoldingInfy"
    param o0_x_fold "x Fold" = 5.0 [-5.0, 15.0] 
    param o1_y_fold "y Fold" = 5.0 [-5.0, 15.0] 
    param o2_z_fold "z Fold" = 5.0 [-5.0, 15.0] 
    param o3_w_fold "w Fold" = 5.0 [-5.0, 15.0] 
    init {
        let k40 = o3_w_fold
        let k32 = o2_z_fold
        let k24 = o1_y_fold
        let k16 = o0_x_fold
    }
    iter {
        let f0 = 0.0
