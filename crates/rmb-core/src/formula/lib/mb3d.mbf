formula "SphCageIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula SphCageIFS. Draws a cage of toruses, they are of two different styles like in 'world maps';"
    de difs
    alias "SphCageIFS"
    param o0_sphradius "SphRadius" = 0.5 [-1.5, 2.5] 
    param o1_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_cageradius "CageRadius" = 0.01 [-1.99, 2.01] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_parals_2_to_1000 "Parals (2 to 1000)" = 8.0 [-8.0, 24.0] int
    param o8_merids "Merids" = 20.0 [-20.0, 60.0] int
    init {
        let k84 = round(o8_merids)
        let k80 = round(o7_parals_2_to_1000)
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_cageradius
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_sphradius
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let cfl = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
