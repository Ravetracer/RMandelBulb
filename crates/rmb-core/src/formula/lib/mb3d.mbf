        f1 = -f1
        f0 = f0 + f1
        m20 = f0
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = m20
        f0 = f0 * 0.5773502691896258
        f1 = z
        f1 = f1 * 0.816496580927726
        f0 = f0 + f1
        f0 = abs(f0)
        f1 = m12
        f2 = y
        f2 = f2 * 0.7071067811865475
        f2 = -f2
        f1 = f1 + f2
        f1 = abs(f1)
        f2 = m12
        f3 = y
        f3 = f3 * 0.7071067811865475
        f2 = f2 + f3
        f2 = abs(f2)
        y = f2
        x = f1
        z = f0
        f0 = x
        f0 = f0 + y
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = x
        f0 = -f0
        f0 = f0 + y
        f0 = f0 * 0.7071067811865475
        y = f0
        f0 = m12
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f0 = f0 + f1
        m20 = f0
        f1 = m12
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f2 = z
        f2 = f2 * 0.816496580927726
        f1 = f1 + f2
        z = f1
        f0 = f0 * 0.5
        f0 = -f0
        f1 = m28
        f1 = f1 * 0.8660254037844387
        f0 = f0 + f1
        dr = f0
        f0 = m20
        f0 = f0 * 0.8660254037844387
        f1 = m28
        f1 = f1 * 0.5
        f0 = f0 + f1
        m12 = f0
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = m36 / f0
        m20 = f0
        f0 = f0 * m12
        f0 = f0 * k16
        f0 = f0 - k24
        x = f0
        f0 = y
        f0 = f0 * k16
        f0 = f0 * m20
        y = f0
        f0 = z
        f0 = f0 * k16
        f0 = f0 * m20
        z = f0
    }
}

formula "_BT1_Transform1" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BT1_Transform1. Cool??  :D  absolute value xyz transform;"
    de numeric
    transform
    alias "_BT1_Transform1"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_xoff "xOff" = 2.0 [-2.0, 6.0] 
    init {
        let k24 = o1_xoff
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let m12 = 0.0
        f0 = x
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = x
        f0 = f0 * 0.5773502691896258
        f1 = z
        f1 = f1 * 0.816496580927726
        f0 = f0 + f1
        f0 = abs(f0)
        f1 = m12
        f2 = y
        f2 = f2 * 0.7071067811865475
        f2 = -f2
        f1 = f1 + f2
        f1 = abs(f1)
        f2 = m12
        f3 = y
        f3 = f3 * 0.7071067811865475
        f2 = f2 + f3
        f2 = abs(f2)
        y = f2
        x = f1
        z = f0
        f0 = x
        f0 = f0 + y
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = x
        f0 = -f0
        f0 = f0 + y
        f0 = f0 * 0.7071067811865475
        f1 = m12
        f1 = f1 * 0.816496580927726
        f2 = z
        f2 = f2 * 0.5773502691896258
        f1 = f1 + f2
        f2 = m12
        f2 = f2 * 0.5773502691896258
        f2 = -f2
        f3 = z
        f3 = f3 * 0.816496580927726
        f2 = f2 + f3
        z = f2
        x = f1
        y = f0
        f0 = x
        f0 = f0 * k16
        f0 = f0 - k24
        x = f0
        f0 = y
        f0 = f0 * k16
        y = f0
        f0 = z
        f0 = f0 * k16
        z = f0
    }
}

formula "_BT2_Transform2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BT2_Transform2. This is one of the 'hollowing' out transforms I wrote to combine with the T1 Pine Tree Mandelbulb.  Use sparingly (ever few iterations, maybe the next to last iteration you want to increase the detail"
    de numeric
    transform
    alias "_BT2_Transform2"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_xoff "xOff" = 2.0 [-2.0, 6.0] 
    init {
        let k24 = o1_xoff
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let m12 = 0.0
        let m20 = 0.0
        f0 = x
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * 0.7071067811865475
