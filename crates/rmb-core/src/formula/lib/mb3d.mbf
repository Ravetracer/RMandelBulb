        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f0 = f0 * k32
        f0 = f0 + k16
        f1 = f0
        f1 = abs(f1)
        f1 = sqrt(f1)
        ft = f1
        f1 = f0
        f0 = ft
        f2 = 0.0
        fc_a = f2
        fc_b = f1
        if fc_a <= fc_b {
        } else {
            f0 = -f0
        }
        f0 = f0 / k40
        f0 = f0 + k24
        x = f0
    }
}

