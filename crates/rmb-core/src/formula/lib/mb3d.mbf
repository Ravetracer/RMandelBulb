formula "_rabinovich-f" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _rabinovich-f. Rabinovich-Fabrikant chaotic system in 3D - variation with four parameters and strength"
    de numeric
    transform
    alias "_rabinovich-f"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 1.0 [-1.0, 3.0] 
