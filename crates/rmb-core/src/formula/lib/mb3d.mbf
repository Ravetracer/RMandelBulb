    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * f1
        f3 = f3 * f0
        f3 = f3 * k24
        f3 = f3 + cy
        y = f3
        f2 = f2 * f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * f2
        ft = f2
        f2 = f0
