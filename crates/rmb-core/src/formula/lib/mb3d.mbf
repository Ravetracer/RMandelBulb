        ft = f2
        f2 = f1
        f1 = ft
        m68 = f1
        f1 = x
        f1 = abs(f1)
        f1 = f1 * m20
        f2 = f0
        ft = f2
        f2 = f1
        f1 = ft
        f1 = atan2(f1, f2)
        m28 = f1
        f1 = y
        f1 = abs(f1)
        f1 = f1 * m20
        f2 = f0
        ft = f2
        f2 = f1
        f1 = ft
        f1 = atan2(f1, f2)
        m36 = f1
        f1 = z
        f1 = abs(f1)
        f1 = f1 * m20
        f2 = f0
        ft = f2
        f2 = f1
        f1 = ft
