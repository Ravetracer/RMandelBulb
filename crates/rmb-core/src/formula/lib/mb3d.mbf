            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k40
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k40
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            dr = f0
        }
        f0 = k32
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k32
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = z
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
            f2 = f2 * f0
            f1 = f1 - f2
            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k32
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k32
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            z = f0
        }
        f0 = k24
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k24
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = y
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
            f2 = f2 * f0
            f1 = f1 - f2
            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k24
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k24
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            y = f0
        }
        f0 = k16
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k16
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = x
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
            f2 = f2 * f0
            f1 = f1 - f2
            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k16
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k16
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            x = f0
        }
    }
}

formula "_FoldingOct" {
