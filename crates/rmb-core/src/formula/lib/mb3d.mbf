        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let ft = 0.0
        f0 = 1.0
        f0 = f0 + i
        f0 = f0 * k16
        f1 = rout
        f2 = f1
        f2 = sqrt(f2)
        f2 = z / f2
        f3 = 1.0
        f4 = f2
        f4 = f4 * f4
        f3 = f3 - f4
        f3 = sqrt(f3)
        f2 = atan2(f2, f3)
        f2 = f2 * f0
        f3 = y
        f4 = x
        f3 = atan2(f3, f4)
        f0 = f0 * f3
        f3 = cos(f2)
        f2 = sin(f2)
        ft = f3
        f3 = f0
        f0 = ft
        f4 = cos(f3)
        f3 = sin(f3)
        ft = f4
        f4 = f1
        f1 = ft
        f5 = 1.0
        f5 = k16 - f5
        ft = f5
        f5 = f4
        f4 = ft
        f6 = 0.6931471805599453
        ft = f6
        f6 = f5
        f5 = ft
        f5 = f5 * log(f6) * 1.4426950408889634
        ft = f5
        f5 = f4
        f4 = ft
        f4 = f4 * f5
        f5 = 1.4426950408889634
        f4 = f4 * f5
        f5 = f4
        f5 = round(f5)
        f4 = f4 - f5
        ft = f5
        f5 = f4
        f4 = ft
        f5 = pow(2.0, f5) - 1.0
        f6 = 1.0
        f5 = f5 + f6
        f5 = f5 * pow(2.0, sel(f4 < 0.0, -floor(-f4), floor(f4)))
        f4 = f5
        f2 = f2 * f4
        f0 = f0 * f4
        f3 = f3 * f0
        f3 = f3 * k24
        f3 = f3 + cy
        y = f3
        f2 = cz - f2
        z = f2
        f0 = f0 * f1
        f0 = f0 + cx
        x = f0
    }
}

formula "GenIntPower" {
    category "MB3D 3D"
    description "Mandelbulb3D formula GenIntPower. Derived from an idea from Aexion to also rotate the adding constant in addition to a bulb formula."
    de numeric
    alias "GenIntPower"
    param o0_r_power_2_11 "R power (2..11)" = 8.0 [-8.0, 24.0] int
    param o1_rotation_1_power "Rotation 1 power" = 8.0 [-8.0, 24.0] int
    param o2_rotation_1_type "Rotation 1 type" = 0.0 [-2.0, 2.0] int
    param o3_enable_rotation_2 "Enable rotation 2" = 1.0 [-1.0, 3.0] int
    param o4_rotation_2_power "Rotation 2 power" = 8.0 [-8.0, 24.0] int
    param o5_rotation_2_type "Rotation 2 type" = 3.0 [-3.0, 9.0] int
    param o6_enable_rotation_3 "Enable rotation 3" = 0.0 [-2.0, 2.0] int
    param o7_rotation_3_power "Rotation 3 power" = 8.0 [-8.0, 24.0] int
    param o8_rotation_3_type "Rotation 3 type" = 0.0 [-2.0, 2.0] int
    param o9_z_multiplier "Z multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k52 = o9_z_multiplier
        let k44 = round(o8_rotation_3_type)
        let k40 = round(o7_rotation_3_power)
        let k36 = round(o6_enable_rotation_3)
        let k32 = round(o5_rotation_2_type)
        let k28 = round(o4_rotation_2_power)
        let k24 = round(o3_enable_rotation_2)
        let k20 = round(o2_rotation_1_type)
        let k16 = round(o1_rotation_1_power)
        let k12 = round(o0_r_power_2_11)
    }
    iter {
        let ft = 0.0
        let cfl = 0.0
        let r_edx = 0.0
        let r_ebx = 0.0
        let r_esi = 0.0
