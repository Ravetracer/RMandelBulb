        f2 = f2 - f0
        f2 = abs(f2)
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 - k24
        f2 = abs(f2)
        f1 = f2 - f1
        f1 = f1 + y
        f1 = f1 - f0
        y = f1
        f1 = x
        f2 = f1
        f2 = f2 - f0
        f2 = abs(f2)
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 - k24
        f2 = abs(f2)
        f1 = f2 - f1
        f1 = f1 + x
        f0 = f1 - f0
        x = f0
    }
}

