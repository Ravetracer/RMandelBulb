formula "Hopf4D" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Hopf4D. Hopf fibration squaring formula, from Bugman."
    de numeric
    alias "Hopf4D"
    param o0_w_add "w add" = 0.0 [-2.0, 2.0] 
    param o1_z_mul "z mul" = -1.0 [-3.0, 1.0] 
    init {
        let k24 = o1_z_mul
