            r_eax = sel(fc_a < fc_b, 6144.0, sel(fc_a == fc_b, 14336.0, 6144.0))
            r_edx = sel(sv2 < 0.0, 2147483648.0, sel(sv2 == 0.0, 0.0, 0.0))
        } else {
            f0 = f0 * f0
            f1 = m32
            sv3 = k80
            if sv3 < 0.0 {
            } else {
                f1 = k80 - f1
                f1 = abs(f1)
                f1 = k80 - f1
            }
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f0 = f0 - k16
            if sv3 >= 0.0 {
            } else {
                f1 = m40
                f1 = f1 * f1
                f2 = k80
                f2 = f2 + k24
                f1 = f1 * f2
                f0 = f0 - f1
            }
            r_edx = sel(sv3 < 0.0, 2147483648.0, sel(sv3 == 0.0, 0.0, 0.0))
        }
        f1 = m40
        f1 = abs(f1)
        f1 = f1 - k32
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k112 != 0.0 {
        } else {
