            f2 = f3 / f2
            f2 = -f2
            f3 = 1.0
            f2 = f2 + f3
            f3 = x
            f3 = f3 * f3
            f4 = y
            f4 = f4 * f4
            f3 = f3 - f4
            f3 = f3 * f2
            f4 = x
            f4 = f4 * y
        }
        f4 = f4 + f4
        f4 = f4 * f2
        y = f4
        x = f3
        w = f1
        z = f0
        f0 = x
        f0 = f0 * z
        f1 = y
        f1 = f1 * w
        f0 = f0 - f1
        f0 = f0 + f0
        f1 = x
        f1 = f1 * w
        f2 = y
        f2 = f2 * z
        f1 = f1 + f2
        f1 = f1 + f1
        f2 = x
        f2 = f2 * f2
        f3 = y
        f3 = f3 * f3
        f2 = f2 + f3
        f3 = z
        f3 = f3 * f3
        f4 = w
        f4 = f4 * f4
        f3 = f3 + f4
        fc_a = f3
        fc_b = f2
        if fc_a >= fc_b {
            f2 = f2 / f3
            f3 = 1.0
            f3 = -f3
            f2 = f2 + f3
            f3 = z
            f3 = f3 * f3
            f4 = w
            f4 = f4 * f4
            f3 = f3 - f4
            f3 = f3 * f2
            f4 = z
            f4 = f4 * w
        } else {
            f2 = f3 / f2
            f2 = -f2
            f3 = 1.0
            f2 = f2 + f3
            f3 = x
            f3 = f3 * f3
            f4 = y
            f4 = f4 * f4
            f3 = f3 - f4
            f3 = f3 * f2
            f4 = x
            f4 = f4 * y
        }
        f4 = f4 + f4
        f4 = f4 * f2
        y = f4
        x = f3
        w = f1
        z = f0
        f0 = cx
        f0 = f0 + x
        x = f0
        f0 = cy
        f0 = f0 + y
        y = f0
        f0 = cz
        f0 = f0 + z
        z = f0
        f0 = cw
        f0 = f0 + k16
        f0 = f0 + w
        w = f0
    }
}

formula "Makin4D p8b" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Makin4D p8b. Formula proposed by David Makin at the forums ( July 21, 2014 )."
    de numeric
    alias "Makin4D p8b"
    param o0_w_add "w add" = 0.0 [-2.0, 2.0] 
    param o1_xy_mul "xy mul" = 0.0 [-2.0, 2.0] 
    init {
        let k16 = o0_w_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f2 = w
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = x
        f1 = f1 * z
        f2 = y
        f2 = f2 * w
        f1 = f1 - f2
        f1 = f1 + f1
        f2 = x
        f2 = f2 * w
        f3 = y
        f3 = f3 * z
        f2 = f2 + f3
        f2 = f2 + f2
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 - f4
        f3 = f3 + f3
        f4 = x
        f4 = f4 * y
        f4 = f4 + f4
        f4 = f4 + f4
        y = f4
        x = f3
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        f3 = f0 / f3
        f3 = -f3
        f4 = 1.0
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f3
        x = f4
        f4 = y
        f3 = f3 * f4
        y = f3
        w = f2
        z = f1
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f2 = w
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = x
        f1 = f1 * z
        f2 = y
        f2 = f2 * w
        f1 = f1 - f2
        f1 = f1 + f1
        f2 = x
        f2 = f2 * w
        f3 = y
        f3 = f3 * z
        f2 = f2 + f3
        f2 = f2 + f2
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 - f4
        f3 = f3 + f3
        f4 = x
        f4 = f4 * y
        f4 = f4 + f4
        f4 = f4 + f4
        y = f4
        x = f3
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        f3 = f0 / f3
        f3 = -f3
        f4 = 1.0
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f3
        x = f4
        f4 = y
        f3 = f3 * f4
        y = f3
        w = f2
        z = f1
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f2 = w
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = x
        f1 = f1 * z
        f2 = y
        f2 = f2 * w
        f1 = f1 - f2
        f1 = f1 + f1
        f2 = x
        f2 = f2 * w
        f3 = y
        f3 = f3 * z
        f2 = f2 + f3
        f2 = f2 + f2
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 - f4
        f3 = f3 + f3
        f4 = x
        f4 = f4 * y
        f4 = f4 + f4
        f4 = f4 + f4
        y = f4
        x = f3
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        f3 = f0 / f3
        f3 = -f3
        f4 = 1.0
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f3
        x = f4
        f4 = y
        f3 = f3 * f4
        y = f3
        w = f2
        z = f1
        f0 = cx
        f0 = f0 + x
        x = f0
        f0 = cy
        f0 = f0 + y
        y = f0
        f0 = cz
        f0 = f0 + z
        z = f0
        f0 = cw
        f0 = f0 + k16
        f0 = f0 + w
        w = f0
    }
}

formula "Mandel4DBiC" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Mandel4DBiC. The good old 4D Mandelbrot in a basic bicomplex system."
    de numeric
    alias "Mandel4DBiC"
    param o0_w_add "w add" = 0.0 [-2.0, 2.0] 
    init {
        let k16 = o0_w_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 - f1
        f0 = f0 + cx
        f1 = x
        f1 = f1 * y
        f1 = f1 + f1
        f1 = f1 + cy
        f2 = z
        f2 = f2 * f2
        f3 = w
        f3 = f3 * f3
        f2 = f2 - f3
        f2 = f2 + cz
        f3 = z
        f3 = f3 * w
        f3 = f3 + f3
        f3 = f3 + cw
        f3 = f3 + k16
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "MandelView" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MandelView. A complicated Mandelbulb-like formula that uses three 'atan2() angles', and does a particular multiplication of them."
    de numeric
    alias "MandelView"
    param o0_power "Power" = 8.0 [-8.0, 24.0] 
    param o1_z_mul "z-Mul" = -1.0 [-3.0, 1.0] 
    init {
        let k24 = o1_z_mul
        let k16 = o0_power
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        f0 = y
        f1 = x
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m20 = f1
        m12 = f0
        f0 = z
        f1 = y
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m36 = f1
        m28 = f0
        f0 = z
        f1 = x
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m52 = f1
        m44 = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = k16
        ft = f1
        f1 = f0
        f0 = ft
        f1 = abs(f1)
        f0 = f0 * log(f1) * 1.4426950408889634
        f1 = 1.0
        f2 = f0
        f2 = f2 % f1
        f2 = pow(2.0, f2) - 1.0
        f1 = f1 + f2
        f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
        ft = f1
        f1 = f0
        f0 = ft
        m60 = f0
        f0 = m20
        f0 = f0 * m52
        f1 = m28
        f1 = f1 * m44
        f1 = f1 * m12
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * m60
        f0 = f0 + cx
        x = f0
        f0 = m12
        f0 = f0 * m36
        f0 = f0 * m60
        f0 = f0 + cy
        y = f0
        f0 = m28
        f0 = f0 * m52
        f0 = f0 * m12
        f1 = m20
        f1 = f1 * m44
        f0 = f0 + f1
        f0 = f0 * m60
        f0 = f0 * k24
        f0 = f0 + cz
        z = f0
    }
}

formula "MandyCousin" {
    category "MB3D 4D"
    description "Mandelbulb3D formula MandyCousin. A formula from David Makin. Found on http://bugman123.com/Hypercomplex/index.html"
    de numeric
    alias "MandyCousin"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul_1 "Z mul 1" = 2.0 [-2.0, 6.0] 
    param o3_z_mul_2 "Z mul 2" = 2.0 [-2.0, 6.0] 
    param o4_w_mul "W mul" = 2.0 [-2.0, 6.0] 
    param o5_w_add "W add" = 0.0 [-2.0, 2.0] 
    init {
        let k56 = o5_w_add
        let k48 = o4_w_mul
        let k40 = o3_z_mul_2
        let k32 = o2_z_mul_1
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = w
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * k16
        f0 = f0 + cx
        f1 = x
        f1 = f1 * y
        f2 = z
        f2 = f2 * w
        f1 = f1 + f2
        f1 = f1 * k24
        f1 = f1 + cy
        f2 = x
        f2 = f2 * z
        f2 = f2 * k32
        f3 = y
        f3 = f3 * w
        f3 = f3 * k40
        f2 = f2 + f3
        f2 = f2 + cz
        f3 = x
        f3 = f3 * w
        f4 = y
        f4 = f4 * z
        f3 = f3 + f4
        f3 = f3 * k48
        f3 = f3 + cw
        f3 = f3 + k56
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "MandyCousin2" {
    category "MB3D 4D"
    description "Mandelbulb3D formula MandyCousin2. A formula from Stig Pettersson. Found on sp.ufm - it is very similar to Mandy Cousin, only two terms with different sign."
    de numeric
    alias "MandyCousin2"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul_1 "Z mul 1" = 2.0 [-2.0, 6.0] 
    param o3_z_mul_2 "Z mul 2" = -2.0 [-6.0, 2.0] 
    param o4_w_mul "W mul" = 2.0 [-2.0, 6.0] 
    param o5_w_add "W add" = 0.0 [-2.0, 2.0] 
    init {
        let k56 = o5_w_add
        let k48 = o4_w_mul
        let k40 = o3_z_mul_2
        let k32 = o2_z_mul_1
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = w
        f1 = f1 * f1
        f0 = f0 - f1
        f0 = f0 * k16
        f0 = f0 + cx
        f1 = x
        f1 = f1 * y
        f2 = z
        f2 = f2 * w
        f1 = f1 - f2
        f1 = f1 * k24
        f1 = f1 + cy
        f2 = x
        f2 = f2 * z
        f2 = f2 * k32
        f3 = y
        f3 = f3 * w
        f3 = f3 * k40
        f2 = f2 + f3
        f2 = f2 + cz
        f3 = x
        f3 = f3 * w
        f4 = y
        f4 = f4 * z
        f3 = f3 + f4
        f3 = f3 * k48
        f3 = f3 + cw
        f3 = f3 + k56
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "MandyCousin3" {
    category "MB3D 4D"
    description "Mandelbulb3D formula MandyCousin3. Complexified quaternions; this formula was found in T. Gintz's site."
    de numeric
    alias "MandyCousin3"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul_1 "Z mul 1" = 2.0 [-2.0, 6.0] 
    param o3_z_mul_2 "Z mul 2" = -2.0 [-6.0, 2.0] 
    param o4_w_mul "W mul" = 2.0 [-2.0, 6.0] 
    param o5_w_add "W add" = 0.0 [-2.0, 2.0] 
    init {
        let k56 = o5_w_add
        let k48 = o4_w_mul
        let k40 = o3_z_mul_2
        let k32 = o2_z_mul_1
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = w
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * k16
        f0 = f0 + cx
        f1 = x
        f1 = f1 * y
        f2 = z
        f2 = f2 * w
        f1 = f1 + f2
        f1 = f1 * k24
        f1 = f1 + cy
        f2 = x
        f2 = f2 * z
        f2 = f2 * k32
        f3 = y
        f3 = f3 * w
        f3 = f3 * k40
        f2 = f2 + f3
        f2 = f2 + cz
        f3 = x
        f3 = f3 * w
        f4 = y
        f4 = f4 * z
        f3 = f3 - f4
        f3 = f3 * k48
        f3 = f3 + cw
        f3 = f3 + k56
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "Menger3" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Menger3. "
    de linear
    alias "Menger3"
    param o0_scale "Scale" = 3.0 [-3.0, 9.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
        let k8 = 0.5
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        fc_a = z
        fc_b = 0.0
        z = abs(z)
        fc_a = y
        fc_b = 0.0
        y = abs(y)
        fc_a = x
        fc_b = 0.0
        x = abs(x)
        f0 = z
        f1 = y
