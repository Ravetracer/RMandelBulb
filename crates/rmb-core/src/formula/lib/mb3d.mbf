        f0 = abs(f0)
        m24 = f0
        f0 = m32
        f0 = f0 * (-0.866025)
        f1 = m24
        f1 = f1 * (-0.5)
        f0 = f0 + f1
        f0 = f0 + 0.4330125
        f1 = f0
        f1 = abs(f1)
        f1 = -f1
        f0 = f0 + f1
        m8 = f0
        f1 = f0
        f1 = f1 * (-0.866025)
        f1 = -f1
        f1 = f1 + m32
        m32 = f1
        f0 = f0 * (-0.5)
        f0 = -f0
        f0 = f0 + m24
        m24 = f0
        f0 = m32
        f1 = m24
        y = f1
        x = f0
    }
}

formula "foldinginfyIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula foldinginfyIFS. Continuous tiling of 3D space. Similar to plain 'tiling' but without cuts."
    de difs
    transform
    alias "foldinginfyIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o6_fold_x "Fold X" = 2.0 [-2.0, 6.0] 
    param o7_fold_y "Fold Y" = 2.0 [-2.0, 6.0] 
    param o8_fold_z "Fold Z" = 0.0 [-2.0, 2.0] 
    init {
        let k92 = o8_fold_z
        let k84 = o7_fold_y
        let k76 = o6_fold_x
        let k68 = single(cos(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k64 = single(cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) + sin(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k60 = single(sin(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) - cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k56 = single(-sin(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k52 = single(cos(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) - sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k48 = single(sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) + cos(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k44 = single(sin(o4_rotation_y * pi / 180.0))
        let k40 = single(-cos(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k36 = single(cos(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k32 = o2_add_z
        let k24 = o1_add_y
        let k16 = o0_add_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        f0 = k76
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k76
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = x
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
            f2 = f2 * f0
            f1 = f1 - f2
            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k76
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k76
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            x = f0
        }
        f0 = k84
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k84
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = y
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
            f2 = f2 * f0
            f1 = f1 - f2
            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k84
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k84
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            y = f0
        }
        f0 = k92
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k92
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = z
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
            f2 = f2 * f0
            f1 = f1 - f2
            f0 = f1
            f0 = -f0
            f1 = f0
            f1 = -f1
            f1 = f1 + k92
            f1 = abs(f1)
            f2 = f0
            f2 = -f2
            f2 = f2 - k92
            f2 = abs(f2)
            f2 = -f2
            f1 = f1 + f2
            f0 = f0 + f1
            z = f0
        }
    }
}

formula "foldingoctIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula foldingoctIFS. Based on _foldingoct. Adapted for dIFS mode."
    de difs
    transform
    alias "foldingoctIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = -1.0 [-3.0, 1.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 5.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 5.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 5.0 [-180.0, 180.0] angle
    param o6_absx_do1stswap_0_3 "AbsX/Do1stSwap 0...3" = 3.0 [-3.0, 9.0] int
    param o7_absy_do2ndswap_0_3 "AbsY/Do2ndSwap 0...3" = 3.0 [-3.0, 9.0] int
    param o8_absz_do3rdswap_0_3 "AbsZ/Do3rdSwap 0...3" = 3.0 [-3.0, 9.0] int
    init {
        let k80 = round(o8_absz_do3rdswap_0_3)
        let k76 = round(o7_absy_do2ndswap_0_3)
        let k72 = round(o6_absx_do1stswap_0_3)
        let k68 = single(cos(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k64 = single(cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) + sin(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k60 = single(sin(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) - cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k56 = single(-sin(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k52 = single(cos(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) - sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k48 = single(sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) + cos(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k44 = single(sin(o4_rotation_y * pi / 180.0))
        let k40 = single(-cos(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k36 = single(cos(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k32 = o2_add_z
        let k24 = o1_add_y
        let k16 = o0_add_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        let r_edx = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        r_edx = k72
        r_edx = (r_edx - 2.0 * floor(r_edx / 2.0))
        if r_edx == 0.0 {
        } else {
            f2 = abs(f2)
        }
        x = f2
        r_edx = k76
        r_edx = (r_edx - 2.0 * floor(r_edx / 2.0))
        if r_edx == 0.0 {
        } else {
            f1 = abs(f1)
        }
        y = f1
        r_edx = k80
        r_edx = (r_edx - 2.0 * floor(r_edx / 2.0))
        if r_edx == 0.0 {
        } else {
            f0 = abs(f0)
        }
        f1 = y
        f2 = x
        r_edx = k72
        r_edx = ((floor(r_edx / 2.0) - 2.0 * floor(r_edx / 4.0)) * 2.0)
        if r_edx == 0.0 {
            r_eax = 0.0
        } else {
            fc_a = f2
            fc_b = f1
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f1
                f1 = ft
            }
            r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
        }
        r_edx = k76
        r_edx = ((floor(r_edx / 2.0) - 2.0 * floor(r_edx / 4.0)) * 2.0)
        if r_edx == 0.0 {
        } else {
            fc_a = f2
            fc_b = f0
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
        }
        ft = f2
        f2 = f1
        f1 = ft
        r_edx = k80
        r_edx = ((floor(r_edx / 2.0) - 2.0 * floor(r_edx / 4.0)) * 2.0)
        if r_edx == 0.0 {
        } else {
            fc_a = f2
            fc_b = f0
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
        }
        x = f2
        y = f1
        z = f0
    }
}

formula "gear2IFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula gear2IFS. Attempt to replicate the Incendia's gear-like baseshape..."
    de difs
    alias "gear2IFS"
    param o0_angle_max_360 "Angle (max 360)" = 30.0 [-30.0, 90.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 2.0 [-2.0, 6.0] 
    param o5_cyl_radius "Cyl-Radius" = 1.0 [-1.0, 3.0] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_repeatangle_max_720 "RepeatAngle (max 720)" = 120.0 [-120.0, 360.0] 
    param o8_thick1 "Thick1" = 0.4 [-1.6, 2.4] 
    param o9_thickz "ThickZ" = 0.2 [-1.8, 2.2] 
    param o10_d_angle "D-Angle" = 60.0 [-60.0, 180.0] 
    param o11_thick2 "Thick2" = 0.1 [-1.9, 2.1] 
    init {
        let k116 = o11_thick2
        let k108 = o10_d_angle
        let k100 = o9_thickz
        let k92 = o8_thick1
        let k84 = o7_repeatangle_max_720
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_cyl_radius
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_angle_max_360
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m48 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m48 = x0l
        m40 = x0h
        m32 = x1l
        f0 = m48
        f0 = f0 * f0
        f1 = m40
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k72
        m24 = f0
        f0 = m40
        f1 = m48
        f0 = atan2(f0, f1)
        f0 = f0 * 114.591559
        f1 = m24
        fc_a = f1
        fc_b = 0.0
        if fc_a >= fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
            f1 = f1 - k108
            ft = f1
            f1 = f0
            f0 = ft
        }
        f0 = f0 / k84
        f1 = f0
        f1 = round(f1)
        f0 = f0 - f1
        f0 = f0 * k84
        f0 = abs(f0)
        f0 = f0 / k16
        f1 = 1.0
        f0 = f0 - f1
        f0 = f0 * k16
        f0 = f0 * 0.008726646
        f0 = -f0
        f1 = m24
        f1 = abs(f1)
        f1 = f1 - k92
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m24
        f1 = abs(f1)
        f1 = f1 - k116
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
            f0 = f1
        }
        f1 = m32
        f1 = abs(f1)
        f1 = f1 - k100
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "gearIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula gearIFS. Funny tool that generates 'gear' shapes. For mechanical fractals!"
    de difs
    alias "gearIFS"
    param o0_angle_max_360 "Angle (max 360)" = 30.0 [-30.0, 90.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 2.0 [-2.0, 6.0] 
    param o5_cyl_radius "Cyl-Radius" = 1.0 [-1.0, 3.0] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_repeatangle_max_720 "RepeatAngle (max 720)" = 120.0 [-120.0, 360.0] 
    param o8_thick1 "Thick1" = 0.2 [-1.8, 2.2] 
    param o9_thickz "ThickZ" = 0.2 [-1.8, 2.2] 
    param o10_cyl_r2 "Cyl-R2" = 0.8 [-1.2, 2.8] 
    param o11_thick2 "Thick2" = 0.1 [-1.9, 2.1] 
    init {
        let k116 = o11_thick2
        let k108 = o10_cyl_r2
        let k100 = o9_thickz
        let k92 = o8_thick1
        let k84 = o7_repeatangle_max_720
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_cyl_radius
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_angle_max_360
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m48 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m48 = x0l
        m40 = x0h
        m32 = x1l
        f0 = m40
        f1 = m48
        f0 = atan2(f0, f1)
        f0 = f0 * 114.591559
        f0 = f0 / k84
        f1 = f0
        f1 = round(f1)
        f0 = f0 - f1
        f0 = f0 * k84
        f0 = abs(f0)
        f0 = f0 / k16
        f1 = 1.0
        f0 = f0 - f1
        f0 = f0 * k16
        f0 = f0 * 0.008726646
        f0 = -f0
        f1 = m48
        f1 = f1 * f1
        f2 = m40
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        m24 = f1
        f1 = f1 - k72
        f1 = f1 + k92
        f1 = abs(f1)
        f1 = f1 - k92
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m24
        f1 = f1 - k108
        f1 = f1 + k116
        f1 = abs(f1)
        f1 = f1 - k116
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
            f0 = f1
        }
        f1 = m32
        f1 = abs(f1)
        f1 = f1 - k100
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "genIFS" {
    category "MB3D 3D"
    description "Mandelbulb3D formula genIFS. A more general IFS based on an idea from Kali at fractalforums."
    de linear
    descale 0.5
    alias "genIFS"
