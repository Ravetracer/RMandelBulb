        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
