        f2 = f2 + f3
        f3 = y
        f3 = f3 * k48
        f3 = sin(f3)
        f3 = -f3
        f3 = f3 * k32
        f2 = f2 + f3
        f2 = f2 * k16
        z = f2
        y = f1
        x = f0
    }
}

