        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        m20 = f0
        f0 = z
        f0 = f0 * f0
        f0 = f0 / m20
        f0 = -f0
        f1 = 1.0
        f0 = f0 + f1
        m28 = f0
        f0 = x
