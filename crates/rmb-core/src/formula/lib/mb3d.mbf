        f3 = f2
        f2 = ft
        f3 = f3 * f2
        ft = f3
        f3 = f1
        f1 = ft
        f3 = f3 * f2
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * f2
        f2 = f3
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
