formula "TrifoxComplexAngles" {
    category "MB3D 3D"
    description "Mandelbulb3D formula TrifoxComplexAngles. As suggested by Christian Kleinhuis, theta and phi are raised to a complex power."
    de numeric
    alias "TrifoxComplexAngles"
    param o0_integer_power_r "Integer power R" = 2.0 [-2.0, 6.0] int
    param o1_angle_scale "Angle scale" = 0.75 [-1.25, 2.75] 
    param o2_flip_theta_phi_0_1 "Flip Theta-Phi (0,1)" = 0.0 [-2.0, 2.0] int
    param o3_integer_power_angle "Integer power Angle" = 2.0 [-2.0, 6.0] int
    param o4_reciprocal_r_angle_0_1 "Reciprocal R angle (0,1)" = 0.0 [-2.0, 2.0] int
    param o5_reciprocal_fixing "Reciprocal fixing" = 0.1 [-1.9, 2.1] 
    param o6_z_multiplier "Z multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k40 = single(o6_z_multiplier)
        let k36 = single(o5_reciprocal_fixing)
        let k32 = round(o4_reciprocal_r_angle_0_1)
        let k28 = round(o3_integer_power_angle)
        let k24 = round(o2_flip_theta_phi_0_1)
        let k20 = single(1.0 / max(1.0e-30, o1_angle_scale))
        let k16 = single(o1_angle_scale)
        let k12 = round(o0_integer_power_r)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let f7 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let cfl = 0.0
        let r_eax = 0.0
        f0 = 1.0
        r_eax = k12
        f1 = rout
        f1 = sqrt(f1)
        loop {
            cfl = sel(floor(r_eax / 1.0) - 2.0 * floor(r_eax / 2.0) > 0.5, 1.0, 0.0)
            r_eax = floor(r_eax / 2.0)
            if !(cfl > 0.5) {
                f1 = f1 * f1
                continue
            }
            f0 = f0 * f1
            if r_eax != 0.0 {
                f1 = f1 * f1
                continue
            } else {
                break
            }
        }
        f1 = 0.0
        f2 = 1.0
        f3 = x
        f4 = y
        f5 = z
        f6 = f3
        f6 = f6 * f6
        f7 = f4
        f7 = f7 * f7
        f6 = f6 + f7
        f6 = sqrt(f6)
        f5 = atan2(f5, f6)
        ft = f5
        f5 = f3
        f3 = ft
        f4 = atan2(f4, f5)
        f5 = k16
        f3 = f3 * f5
        f4 = f4 * f5
        if k24 == 0.0 {
        } else {
            ft = f4
            f4 = f3
            f3 = ft
        }
        if k32 == 0.0 {
        } else {
            f5 = f3
            f5 = f5 * f5
            f6 = f4
            f6 = f6 * f6
            f5 = f5 + f6
            f5 = f5 + k36
            f6 = 1.0
            f5 = f6 / f5
            f3 = f3 * f5
            f4 = f4 * f5
        }
        r_eax = k28
        loop {
            cfl = sel(floor(r_eax / 1.0) - 2.0 * floor(r_eax / 2.0) > 0.5, 1.0, 0.0)
            r_eax = floor(r_eax / 2.0)
            if !(cfl > 0.5) {
                f5 = f3
                f5 = f5 * f4
                f5 = f5 + f5
                ft = f5
                f5 = f3
                f3 = ft
                f5 = f5 * f5
                ft = f5
                f5 = f4
                f4 = ft
                f5 = f5 * f5
                f4 = f5 - f4
                continue
            }
            f5 = f2
            f5 = f5 * f4
            f6 = f1
            f6 = f6 * f3
            f5 = f5 - f6
            ft = f5
            f5 = f2
            f2 = ft
            f5 = f5 * f3
            f6 = f4
            f1 = f1 * f6
            f1 = f1 + f5
            if r_eax != 0.0 {
                f5 = f3
                f5 = f5 * f4
                f5 = f5 + f5
                ft = f5
                f5 = f3
                f3 = ft
                f5 = f5 * f5
                ft = f5
                f5 = f4
                f4 = ft
                f5 = f5 * f5
                f4 = f5 - f4
                continue
            } else {
                break
            }
        }
        fc_a = f4
        fc_b = f3
        f3 = k20
        f1 = f1 * f3
        f2 = f2 * f3
        f3 = cos(f2)
        f2 = sin(f2)
        ft = f3
        f3 = f1
        f1 = ft
        f4 = cos(f3)
        f3 = sin(f3)
        f4 = f4 * f1
        f4 = f4 * f0
        f4 = f4 + cx
        x = f4
        f1 = f1 * f3
        f2 = f2 * f0
        f2 = f2 * k40
        f2 = f2 + cz
        z = f2
        f0 = f0 * f1
        f0 = f0 + cy
        y = f0
    }
}

formula "UmbrellaIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula UmbrellaIFS. A cubic curve modified, its basic equation is very simple;"
    de difs
    alias "UmbrellaIFS"
    param o0_cutboxsz "CutBoxSz" = 2.0 [-2.0, 6.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_thickness "Thickness" = 0.01 [-1.99, 2.01] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_flip_xz "Flip XZ" = 0.0 [-2.0, 2.0] int
    param o8_otrapondist "OTrapOnDist" = 0.1 [-1.9, 2.1] 
    param o9_otraponits "OTrapOnIts" = 0.1 [-1.9, 2.1] 
    param o10_otrapoffset "OTrapOffset" = 0.0 [-2.0, 2.0] 
    init {
        let k104 = o10_otrapoffset
        let k96 = o9_otraponits
        let k88 = o8_otrapondist
        let k80 = round(o7_flip_xz)
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_thickness
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_cutboxsz
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m28 = x0l
        m20 = x0h
        m12 = x1l
        if k80 == 0.0 {
        } else {
            f0 = m28
            f1 = m12
            m28 = f1
            m12 = f0
        }
        f0 = m12
        f0 = f0 * m20
        f0 = f0 * m20
        f1 = m28
        f1 = f1 * f1
        f0 = f1 - f0
        f0 = f0 + k72
        f0 = abs(f0)
        f0 = f0 - k72
        f0 = f0 * 0.1
        f1 = 1.0
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            f0 = sqrt(f0)
            f0 = sqrt(f0)
        }
        f1 = m28
        f1 = abs(f1)
        f1 = f1 - k16
        f2 = m20
        f2 = abs(f2)
        f2 = f2 - k16
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        f2 = m12
        f2 = abs(f2)
        f2 = f2 - k16
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
        f0 = m20
        f0 = f0 * m28
        f0 = f0 - m12
        f0 = f0 * k88
        f1 = i
        f1 = f1 * k96
        f0 = f0 + f1
        f0 = f0 + k104
        f0 = abs(f0)
        a2 = f0
    }
}

