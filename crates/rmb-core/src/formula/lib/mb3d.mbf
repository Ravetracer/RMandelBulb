formula "hyperd_1" {
    category "MB3D 4D"
    description "Mandelbulb3D formula hyperd_1. This formula was inspired by:"
    de numeric
    alias "hyperd_1"
    param o0_w_add "w add" = 0.0 [-2.0, 2.0] 
    param o1_intpower_2_to_16 "IntPower (2 to 16)" = 8.0 [-8.0, 24.0] int
    param o2_zw_mul "ZW mul" = 0.0 [-2.0, 2.0] 
    param o3_yw_mul "YW mul" = 1.0 [-1.0, 3.0] 
    param o4_yz_mul "YZ mul" = 1.0 [-1.0, 3.0] 
    init {
        let k44 = o4_yz_mul
        let k36 = o3_yw_mul
        let k28 = o2_zw_mul
        let k20 = round(o1_intpower_2_to_16)
        let k16 = o0_w_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let r_eax = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        r_eax = k20
        if r_eax < 17.0 {
            if r_eax >= 1.0 {
            } else {
                r_eax = 2.0
            }
        } else {
            r_eax = 2.0
        }
        f0 = x
        m12 = f0
        f0 = y
        m20 = f0
        f0 = z
        m28 = f0
        f0 = w
        f0 = f0 + k16
        m36 = f0
        r_eax = r_eax - 1.0
        loop {
            r_eax = r_eax - 1.0
            f0 = x
            f0 = f0 * m12
            f1 = y
            f1 = f1 * m20
            f0 = f0 - f1
            f1 = z
            f1 = f1 * m28
            f2 = w
            f2 = f2 * m36
            f1 = f1 + f2
            f0 = f0 - f1
            f1 = z
            f1 = f1 * m36
            f2 = w
            f2 = f2 * m28
            f1 = f1 + f2
            f1 = f1 * k28
            f0 = f0 + f1
            f1 = x
            f1 = f1 * m20
            f2 = y
            f2 = f2 * m12
            f1 = f1 + f2
            f2 = x
            f2 = f2 * m28
            f3 = z
            f3 = f3 * m12
            f2 = f2 + f3
            f3 = y
            f3 = f3 * m36
            f4 = w
            f4 = f4 * m20
            f3 = f3 + f4
            f3 = f3 * k36
            f2 = f2 + f3
            f3 = x
            f3 = f3 * m36
            f4 = w
            f4 = f4 * m12
            f3 = f3 + f4
            f4 = y
            f4 = f4 * m28
            f5 = z
            f5 = f5 * m20
            f4 = f4 + f5
            f4 = f4 * k44
            f3 = f3 + f4
            if r_eax <= 0.0 {
                break
            } else {
                m36 = f3
                m28 = f2
                m20 = f1
                m12 = f0
                continue
            }
        }
        f3 = f3 + cw
        w = f3
        f2 = f2 + cz
        z = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cx
        x = f0
    }
}

formula "koch_cube" {
    category "MB3D 3D"
    description "Mandelbulb3D formula koch_cube. Cubic Koch fractal. Inspired from a Wikipedia image ( http://en.wikipedia.org/wiki/File:Quadratic_Koch_3D_(type1_stage2).png )"
    de linear
    alias "koch_cube"
    param o0_post_scale "Post-scale" = 1.0 [-1.0, 3.0] 
    param o1_xy_stretch "XY Stretch" = 1.0 [-1.0, 3.0] 
    param o2_z_fold "Z Fold" = 1.0 [-1.0, 3.0] 
    param o3_x_add "X Add" = 0.0 [-2.0, 2.0] 
    param o4_y_add "Y Add" = 0.0 [-2.0, 2.0] 
    param o5_z_add "Z Add" = 0.0 [-2.0, 2.0] 
    param o6_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o7_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o8_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k92 = single(cos(o6_rotation_x * pi / 180.0) * cos(o7_rotation_y * pi / 180.0))
        let k88 = single(cos(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * sin(o8_rotation_z * pi / 180.0) + sin(o6_rotation_x * pi / 180.0) * cos(o8_rotation_z * pi / 180.0))
        let k84 = single(sin(o6_rotation_x * pi / 180.0) * sin(o8_rotation_z * pi / 180.0) - cos(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * cos(o8_rotation_z * pi / 180.0))
        let k80 = single(-sin(o6_rotation_x * pi / 180.0) * cos(o7_rotation_y * pi / 180.0))
        let k76 = single(cos(o6_rotation_x * pi / 180.0) * cos(o8_rotation_z * pi / 180.0) - sin(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * sin(o8_rotation_z * pi / 180.0))
        let k72 = single(sin(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * cos(o8_rotation_z * pi / 180.0) + cos(o6_rotation_x * pi / 180.0) * sin(o8_rotation_z * pi / 180.0))
        let k68 = single(sin(o7_rotation_y * pi / 180.0))
        let k64 = single(-cos(o7_rotation_y * pi / 180.0) * sin(o8_rotation_z * pi / 180.0))
        let k60 = single(cos(o7_rotation_y * pi / 180.0) * cos(o8_rotation_z * pi / 180.0))
        let k56 = o5_z_add
        let k48 = o4_y_add
        let k40 = o3_x_add
        let k32 = o2_z_fold
        let k24 = o1_xy_stretch
        let k16 = o0_post_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = x
        f0 = abs(f0)
        f0 = f0 * 3.0
        x = f0
        f0 = y
        f0 = abs(f0)
        f0 = f0 * 3.0
        y = f0
        f0 = z
        f0 = abs(f0)
        f0 = f0 * 3.0
        z = f0
        f0 = dr
        f0 = f0 * 3.0
        f0 = f0 / k24
        f0 = f0 * k16
        dr = f0
        f0 = x
        f1 = y
        fc_a = f1
        fc_b = f0
        if fc_a <= fc_b {
        } else {
            f0 = x
            f1 = y
            x = f1
            y = f0
        }
        f0 = x
        f1 = z
        fc_a = f1
        fc_b = f0
        if fc_a <= fc_b {
        } else {
            f0 = x
            f1 = z
            x = f1
            z = f0
        }
        f0 = z
        f1 = y
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
        } else {
            f0 = z
            f1 = y
            z = f1
            y = f0
        }
        f0 = z
        f0 = f0 + k56
        f1 = y
        f1 = f1 + k48
        f2 = x
        f2 = f2 + k40
        f3 = f2
        f3 = f3 * k84
        f4 = f1
        f4 = f4 * k88
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k92
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k60
        f5 = f1
        f5 = f5 * k64
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k68
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k72
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k76
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k80
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        f0 = k32
        f0 = f0 - z
        f0 = abs(f0)
        f0 = -f0
        f0 = f0 + k32
        z = f0
        f0 = 3.0
        f1 = f0
        f2 = k24
        f1 = f1 + f2
        m28 = f1
        f1 = k24
        f0 = f0 - f1
        m36 = f0
        f0 = x
        f0 = f0 - m36
        m12 = f0
        f0 = x
        f0 = f0 - m28
        m20 = f0
        f0 = m12
        f1 = y
        fc_a = f1
        fc_b = f0
        if fc_a <= fc_b {
            f0 = m20
            f1 = y
            fc_a = f1
            fc_b = f0
            if fc_a > fc_b {
                f0 = y
                f1 = m20
                y = f1
                x = f0
            } else {
                f0 = m20
                x = f0
            }
        } else {
            f0 = m12
            x = f0
            f0 = y
            f0 = f0 - m36
            y = f0
        }
        f0 = x
        f0 = f0 * k16
        f0 = f0 / k24
        x = f0
        f0 = y
        f0 = f0 * k16
        f0 = f0 / k24
        y = f0
        f0 = z
        f0 = f0 * k16
        z = f0
    }
}

formula "koch_oct" {
    category "MB3D 3D"
    description "Mandelbulb3D formula koch_oct. Modified from OctahedronIFS."
    de linear
    alias "koch_oct"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 0.0 [-2.0, 2.0] 
    param o2_cscale_y "CScale Y" = 0.0 [-2.0, 2.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    param o10_fold "Fold" = 0.5 [-1.5, 2.5] 
    init {
        let k120 = o10_fold
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = abs(f0)
        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f1
        f3 = f3 * k104
        f4 = f2
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f1
        f4 = f4 * k80
        f5 = f2
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k96
        f2 = f2 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f2 = f2 + f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        ft = f3
        f3 = f2
        f2 = ft
        f4 = k120
        f4 = f4 + f3
        f4 = abs(f4)
        f5 = k120
        f5 = f5 - f3
        f5 = abs(f5)
        f5 = -f5
        f4 = f4 + f5
        f3 = f4 - f3
        ft = f3
        f3 = f2
        f2 = ft
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f5 = f4
        f5 = f5 * k32
        f1 = f1 - f5
        f4 = f4 * k24
        f2 = f2 - f4
        f3 = f3 * k40
        f0 = f0 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "koch_surf" {
    category "MB3D 3D"
    description "Mandelbulb3D formula koch_surf. From a Knighty's script, modified a bit;"
    de linear
    alias "koch_surf"
    param o0_pforder "PFOrder" = 4.0 [-4.0, 12.0] 
    param o1_pfshift_deg "PFShift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_pfshift_x "PFShift x" = 0.0 [-2.0, 2.0] 
    param o3_pfshift_y "PFShift y" = 0.0 [-2.0, 2.0] 
    param o4_yoff1 "YOff1" = 0.3333333333 [-1.6666666667, 2.3333333333] 
    param o5_yoff2 "YOff2" = 0.3333333333 [-1.6666666667, 2.3333333333] 
    param o6_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o7_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o8_cscale_y "CScale Y" = 0.0 [-2.0, 2.0] 
    param o9_cscale_x "CScale X" = 0.3333333333 [-1.6666666667, 2.3333333333] 
    param o10_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o11_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o12_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o13_variation "Variation" = 0.0 [-2.0, 2.0] int
    init {
        let k128 = round(o13_variation)
        let k124 = single(cos(o10_rotation_x * pi / 180.0) * cos(o11_rotation_y * pi / 180.0))
        let k120 = single(cos(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * sin(o12_rotation_z * pi / 180.0) + sin(o10_rotation_x * pi / 180.0) * cos(o12_rotation_z * pi / 180.0))
        let k116 = single(sin(o10_rotation_x * pi / 180.0) * sin(o12_rotation_z * pi / 180.0) - cos(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * cos(o12_rotation_z * pi / 180.0))
        let k112 = single(-sin(o10_rotation_x * pi / 180.0) * cos(o11_rotation_y * pi / 180.0))
        let k108 = single(cos(o10_rotation_x * pi / 180.0) * cos(o12_rotation_z * pi / 180.0) - sin(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * sin(o12_rotation_z * pi / 180.0))
        let k104 = single(sin(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * cos(o12_rotation_z * pi / 180.0) + cos(o10_rotation_x * pi / 180.0) * sin(o12_rotation_z * pi / 180.0))
        let k100 = single(sin(o11_rotation_y * pi / 180.0))
        let k96 = single(-cos(o11_rotation_y * pi / 180.0) * sin(o12_rotation_z * pi / 180.0))
        let k92 = single(cos(o11_rotation_y * pi / 180.0) * cos(o12_rotation_z * pi / 180.0))
        let k88 = o9_cscale_x
        let k80 = o8_cscale_y
        let k72 = o7_cscale_z
        let k64 = o6_scale
        let k56 = o5_yoff2
        let k48 = o4_yoff1
        let k40 = o3_pfshift_y
        let k32 = o2_pfshift_x
        let k24 = o1_pfshift_deg
        let k16 = o0_pforder
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        let m12 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m12 = round(f0)
        f0 = m12
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f2 = f2 * f1
        f3 = y
        f3 = f3 * f0
        f2 = f3 - f2
        f3 = x
        f3 = f3 * f0
        f4 = y
        f4 = f4 * f1
        f3 = f3 + f4
        r_eax = k128
        r_eax = ((floor(r_eax / 2.0) - 2.0 * floor(r_eax / 4.0)) * 2.0)
        if r_eax == 0.0 {
            r_eax = m12
            r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
            if r_eax != 0.0 {
            } else {
                f3 = -f3
            }
        } else {
            f3 = abs(f3)
        }
        f3 = f3 - k40
        f3 = f3 - k48
        f3 = abs(f3)
        f3 = -f3
        f3 = f3 + k48
        y = f3
        f2 = f2 - k32
        f3 = z
        f4 = k56
        f2 = f2 + f4
        fc_a = f3
        fc_b = f2
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f2
            f2 = ft
        }
        f4 = k56
        f2 = f2 - f4
        r_eax = k128
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax == 0.0 {
            f2 = f2 - f4
            fc_a = f3
            fc_b = f2
            if fc_a < fc_b {
            } else {
                ft = f3
                f3 = f2
                f2 = ft
            }
            f4 = k56
            f2 = f2 + f4
        } else {
            f2 = f2 + f4
            fc_a = f3
            fc_b = f2
            if fc_a < fc_b {
            } else {
                ft = f3
                f3 = f2
                f2 = ft
            }
            f4 = k56
            f2 = f2 - f4
        }
        z = f3
        x = f2
        f0 = z
        f0 = f0 + k72
        f1 = y
        f1 = f1 + k80
        f2 = x
        f2 = f2 + k88
        f3 = f2
        f3 = f3 * k116
        f4 = f1
        f4 = f4 * k120
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k124
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k92
        f5 = f1
        f5 = f5 * k96
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k100
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k104
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k108
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k112
        f1 = f1 + f3
        f3 = k64
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f2 = f2 - k88
        x = f2
        f1 = f1 - k80
        y = f1
        f0 = f0 - k72
        z = f0
    }
}

formula "lidinoidIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula lidinoidIFS. Here density affects the surface shape too, so it's better use"
    de difs
    alias "lidinoidIFS"
    param o0_size "Size" = 6.0 [-6.0, 18.0] 
    param o1_scale "Scale" = 6.0 [-6.0, 18.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_density "Density" = 2.0 [-2.0, 6.0] 
    param o6_apply_scale_add "Apply scale+add" = 0.0 [-2.0, 2.0] int
    param o7_lnrot_x "LNRot X" = 0.0 [-180.0, 180.0] angle
    param o8_lnrot_y "LNRot Y" = 0.0 [-180.0, 180.0] angle
    param o9_lnrot_z "LNRot Z" = 0.0 [-180.0, 180.0] angle
    param o10_trapcolor_density "TrapColor Density" = 1.0 [-1.0, 3.0] 
    init {
        let k120 = o10_trapcolor_density
        let k112 = single(cos(o7_lnrot_x * pi / 180.0) * cos(o8_lnrot_y * pi / 180.0))
        let k108 = single(cos(o7_lnrot_x * pi / 180.0) * sin(o8_lnrot_y * pi / 180.0) * sin(o9_lnrot_z * pi / 180.0) + sin(o7_lnrot_x * pi / 180.0) * cos(o9_lnrot_z * pi / 180.0))
        let k104 = single(sin(o7_lnrot_x * pi / 180.0) * sin(o9_lnrot_z * pi / 180.0) - cos(o7_lnrot_x * pi / 180.0) * sin(o8_lnrot_y * pi / 180.0) * cos(o9_lnrot_z * pi / 180.0))
        let k100 = single(-sin(o7_lnrot_x * pi / 180.0) * cos(o8_lnrot_y * pi / 180.0))
        let k96 = single(cos(o7_lnrot_x * pi / 180.0) * cos(o9_lnrot_z * pi / 180.0) - sin(o7_lnrot_x * pi / 180.0) * sin(o8_lnrot_y * pi / 180.0) * sin(o9_lnrot_z * pi / 180.0))
        let k92 = single(sin(o7_lnrot_x * pi / 180.0) * sin(o8_lnrot_y * pi / 180.0) * cos(o9_lnrot_z * pi / 180.0) + cos(o7_lnrot_x * pi / 180.0) * sin(o9_lnrot_z * pi / 180.0))
        let k88 = single(sin(o8_lnrot_y * pi / 180.0))
        let k84 = single(-cos(o8_lnrot_y * pi / 180.0) * sin(o9_lnrot_z * pi / 180.0))
        let k80 = single(cos(o8_lnrot_y * pi / 180.0) * cos(o9_lnrot_z * pi / 180.0))
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_density
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_size
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m16 = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m48 = 0.0
        let m56 = 0.0
        let m64 = 0.0
        let m72 = 0.0
        let m80 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m80 = x0l
        m72 = x0h
        m64 = x1l
        f0 = m64
        f1 = m72
        f2 = m80
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        m80 = f2
        m72 = f1
        m64 = f0
        f0 = m64
        f0 = f0 * k72
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = m72
        f2 = f2 * k72
        f3 = cos(f2)
        f2 = sin(f2)
        f4 = m80
        f4 = f4 * k72
        f5 = cos(f4)
        f4 = sin(f4)
        m56 = f5
        m48 = f4
        m40 = f3
        m32 = f2
        m24 = f1
        m16 = f0
        f0 = m64
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = m72
        f3 = cos(f2)
        f2 = sin(f2)
        f4 = m80
        f5 = cos(f4)
        f4 = sin(f4)
        f5 = f5 * m48
        f2 = f2 * f5
        f4 = f4 * m16
        f1 = f1 * f4
        f3 = f3 * m32
        f0 = f0 * f3
        f3 = f2
        f3 = f3 - f1
        f3 = f3 - f0
        f3 = f3 * k120
        f3 = abs(f3)
        a2 = f3
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = m56
        f1 = f1 * m40
        f2 = m40
        f2 = f2 * m24
        f3 = m24
        f3 = f3 * m56
        f2 = f2 + f3
        f1 = f1 + f2
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * 0.5
        f0 = f0 + 0.15
        f1 = m64
        f1 = abs(f1)
        f2 = m72
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        f2 = m80
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        f1 = f1 - k16
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f0 = f0 / k72
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "logspIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula logspIFS. Logarithmic spiral. Probably the most elegant of all."
    de difs
    alias "logspIFS"
    param o0_tightness "Tightness" = 0.66666666 [-1.33333334, 2.6666666599999997] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_zadd "Zadd" = 0.0 [-2.0, 2.0] 
    param o3_yadd "Yadd" = 0.0 [-2.0, 2.0] 
    param o4_xadd_mobtweak "Xadd (MobTweak)" = 0.0 [-2.0, 2.0] 
    param o5_radius_for_mobius "Radius (- for Mobius)" = 0.25 [-1.75, 2.25] 
    param o6_apply_scale_add "Apply scale+add" = 0.0 [-2.0, 2.0] int
    param o7_n_spirals "N spirals" = 1.0 [-1.0, 3.0] int
    param o8_z_mul "z-Mul" = 0.3 [-1.7, 2.3] 
    param o9_style_0_to_3 "Style (0 to 3)" = 0.0 [-2.0, 2.0] int
    param o10_lsprot_x "LSpRot X" = 0.0 [-180.0, 180.0] angle
    param o11_lsprot_y "LSpRot Y" = 0.0 [-180.0, 180.0] angle
    param o12_lsprot_z "LSpRot Z" = 0.0 [-180.0, 180.0] angle
    param o13_mobrho "MobRho" = 0.0 [-180.0, 180.0] angle
    init {
        let k136 = single(cos(o13_mobrho * pi / 180.0))
        let k132 = single(sin(o13_mobrho * pi / 180.0))
        let k128 = single(cos(o10_lsprot_x * pi / 180.0) * cos(o11_lsprot_y * pi / 180.0))
        let k124 = single(cos(o10_lsprot_x * pi / 180.0) * sin(o11_lsprot_y * pi / 180.0) * sin(o12_lsprot_z * pi / 180.0) + sin(o10_lsprot_x * pi / 180.0) * cos(o12_lsprot_z * pi / 180.0))
        let k120 = single(sin(o10_lsprot_x * pi / 180.0) * sin(o12_lsprot_z * pi / 180.0) - cos(o10_lsprot_x * pi / 180.0) * sin(o11_lsprot_y * pi / 180.0) * cos(o12_lsprot_z * pi / 180.0))
        let k116 = single(-sin(o10_lsprot_x * pi / 180.0) * cos(o11_lsprot_y * pi / 180.0))
        let k112 = single(cos(o10_lsprot_x * pi / 180.0) * cos(o12_lsprot_z * pi / 180.0) - sin(o10_lsprot_x * pi / 180.0) * sin(o11_lsprot_y * pi / 180.0) * sin(o12_lsprot_z * pi / 180.0))
        let k108 = single(sin(o10_lsprot_x * pi / 180.0) * sin(o11_lsprot_y * pi / 180.0) * cos(o12_lsprot_z * pi / 180.0) + cos(o10_lsprot_x * pi / 180.0) * sin(o12_lsprot_z * pi / 180.0))
        let k104 = single(sin(o11_lsprot_y * pi / 180.0))
        let k100 = single(-cos(o11_lsprot_y * pi / 180.0) * sin(o12_lsprot_z * pi / 180.0))
        let k96 = single(cos(o11_lsprot_y * pi / 180.0) * cos(o12_lsprot_z * pi / 180.0))
        let k92 = round(o9_style_0_to_3)
        let k88 = o8_z_mul
        let k80 = round(o7_n_spirals)
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_radius_for_mobius
        let k64 = o4_xadd_mobtweak
        let k56 = o3_yadd
        let k48 = o2_zadd
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_tightness
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m16 = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let sv1 = 0.0
        let sv2 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m40 = x0l
        m32 = x0h
        m24 = x1l
        f0 = m24
        f1 = m32
        f2 = m40
        f3 = f2
        f3 = f3 * k120
        f4 = f1
        f4 = f4 * k124
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k128
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k96
        f5 = f1
        f5 = f5 * k100
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k104
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k108
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k112
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k116
        f1 = f1 + f3
        m40 = f2
        m32 = f1
        m24 = f0
        sv1 = k72
        if sv1 >= 0.0 {
        } else {
            f0 = m40
            f1 = 1.0
            f0 = f0 + f1
            f0 = f0 * f0
            f1 = m32
            f1 = f1 * f1
            f0 = f0 + f1
            f1 = 1.0
            f0 = f1 / f0
            f1 = f0
            f2 = m40
            f2 = f2 * f2
            f3 = m32
            f3 = f3 * f3
            f2 = f2 + f3
            f3 = 1.0
            f2 = f2 - f3
            f1 = f1 * f2
            f2 = m32
            f2 = -f2
            f2 = f2 + f2
            f0 = f0 * f2
            f1 = f1 + k64
            m32 = f1
            m40 = f0
            f0 = m40
            f0 = f0 * k132
            f1 = m32
            f1 = f1 * k136
            f1 = -f1
            f0 = f0 + f1
            f1 = m40
            f1 = f1 * k136
            f2 = m32
            f2 = f2 * k132
            f1 = f1 + f2
            m40 = f1
            m32 = f0
        }
        f0 = m40
        f0 = f0 * f0
        f1 = m32
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = k16
        if k92 != 1.0 {
            if k92 != 2.0 {
                if k92 != 3.0 {
                    ft = f1
                    f1 = f0
                    f0 = ft
                    f0 = f0 * log(f1) * 1.4426950408889634
                    r_edx = sel(sv1 < 0.0, 2147483648.0, sel(sv1 == 0.0, 0.0, 0.0))
                } else {
                    ft = f1
                    f1 = f0
                    f0 = ft
                    f0 = f0 * log(f1) * 1.4426950408889634
                    m16 = f0
                    f0 = abs(f0)
                    f0 = f0 + 0.05
                    sv2 = m16
                    if sv2 >= 0.0 {
                    } else {
                        f0 = -f0
                    }
                    f1 = 1.0
                    f0 = f1 / f0
                    r_edx = sel(sv2 < 0.0, 2147483648.0, sel(sv2 == 0.0, 0.0, 0.0))
                }
            } else {
                ft = f1
                f1 = f0
                f0 = ft
                f0 = f0 * log(f1) * 1.4426950408889634
                f0 = f0 * f0
                f0 = -f0
                r_edx = sel(sv1 < 0.0, 2147483648.0, sel(sv1 == 0.0, 0.0, 0.0))
            }
        } else {
            f0 = f1 / f0
            r_edx = sel(sv1 < 0.0, 2147483648.0, sel(sv1 == 0.0, 0.0, 0.0))
        }
        f1 = m40
        f2 = m32
        f1 = atan2(f1, f2)
        f1 = f1 * (-0.159154943)
        f1 = f1 * k80
        f0 = f0 + f1
        f1 = f0
        f1 = round(f1)
        f0 = f1 - f0
        f0 = abs(f0)
        f0 = f0 * k88
        f1 = m24
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = k72
        f1 = abs(f1)
        f0 = f0 - f1
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "loxodrome2IFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula loxodrome2IFS. Mix between 'loxodrome' and 'quadrics' to get new cool shapes"
    de difs
    alias "loxodrome2IFS"
    param o0_angle_max_360 "Angle (max 360)" = 30.0 [-30.0, 90.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 2.0 [-2.0, 6.0] 
    param o5_spiral_speed "Spiral speed" = 0.7 [-1.3, 2.7] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_repeatangle_max_720 "RepeatAngle (max 720)" = 120.0 [-120.0, 360.0] 
    param o8_atan_add "Atan Add" = 0.0 [-2.0, 2.0] 
    param o9_thickness "Thickness" = 0.01 [-1.99, 2.01] 
    param o10_zmul "zMul" = -2.5 [-7.5, 2.5] 
    param o11_zeroz_radius "ZeroZ radius" = 0.2 [-1.8, 2.2] 
    param o12_style_pos_or_neg "Style (pos or neg)" = 0.0 [-2.0, 2.0] int
    init {
        let k120 = round(o12_style_pos_or_neg)
        let k116 = o11_zeroz_radius
        let k108 = o10_zmul
        let k100 = o9_thickness
        let k92 = o8_atan_add
        let k84 = o7_repeatangle_max_720
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_spiral_speed
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_angle_max_360
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m16 = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m8 = 0.0
        let sv1 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m40 = x0l
        m32 = x0h
        m24 = x1l
        f0 = m24
        f0 = abs(f0)
        f1 = 0.999999999
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            if k120 >= 0.0 {
            } else {
                f0 = f0 * 3.142
                f0 = sin(f0)
            }
            if k120 == 1.0 {
            } else {
                if k120 == (-1.0) {
                } else {
                    f0 = -f0
                    f1 = 1.0
                    f0 = f0 + f1
                }
            }
            f1 = k72
            ft = f1
            f1 = f0
            f0 = ft
            f0 = f0 * log(f1) * 1.4426950408889634
            sv1 = m24
            if sv1 >= 0.0 {
            } else {
                f0 = -f0
            }
            f0 = f0 + k92
            f1 = cos(f0)
            f0 = sin(f0)
            m8 = f1
            m16 = f0
            f0 = m40
            f0 = f0 * m16
            f1 = m32
            f1 = f1 * m8
            f1 = -f1
            f0 = f0 + f1
            f1 = m40
            f1 = f1 * m8
            f2 = m32
            f2 = f2 * m16
            f1 = f1 + f2
            f0 = atan2(f0, f1)
            f0 = f0 * 114.591559
            f0 = f0 / k84
            f1 = f0
            f1 = round(f1)
            f0 = f0 - f1
            f0 = f0 * k84
            f0 = abs(f0)
            f0 = f0 / k16
            f1 = 1.0
            f0 = f0 - f1
            f0 = f0 * k16
            f0 = f0 * 0.008726646
            f0 = -f0
            r_edx = sel(sv1 < 0.0, 2147483648.0, sel(sv1 == 0.0, 0.0, 0.0))
        } else {
            f0 = (-0.1)
            r_edx = 0.0
        }
        f1 = m40
        f1 = f1 * f1
        f2 = m32
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = m24
        f2 = f2 * f2
        f2 = f2 * k108
        f1 = f1 + f2
        f1 = f1 - k116
        f1 = abs(f1)
        f1 = sqrt(f1)
        f1 = f1 - k100
        f1 = f1 * 0.05
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m24
        f1 = abs(f1)
        f1 = f1 - 1.02
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "pyramIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula pyramIFS. Pyramid based on Quadray coords plus some funny shape mangling."
    de difs
    alias "pyramIFS"
    param o0_length "Length" = 2.0 [-2.0, 6.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_pinch_punch "Pinch/Punch" = 0.0 [-2.0, 2.0] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_ztwist "ZTwist" = 0.0 [-2.0, 2.0] 
    init {
        let k84 = o7_ztwist
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_pinch_punch
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_length
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m16 = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m8 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m40 = x0l
        m32 = x0h
        m24 = x1l
        f0 = m24
        f0 = f0 * k84
        f1 = cos(f0)
        f0 = sin(f0)
        m8 = f1
        m16 = f0
        f0 = m40
        f0 = f0 * m16
        f1 = m32
        f1 = f1 * m8
        f1 = -f1
        f0 = f0 + f1
        f1 = m40
        f1 = f1 * m8
        f2 = m32
        f2 = f2 * m16
        f1 = f1 + f2
        m32 = f1
        m40 = f0
        f0 = m40
        f0 = f0 + m32
        f0 = f0 + m24
        f1 = m40
        f1 = f1 - m32
        f1 = f1 - m24
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m32
        f1 = f1 - m40
        f1 = f1 - m24
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m24
        f1 = f1 - m40
        f1 = f1 - m32
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        m16 = f0
        f0 = f0 - k16
        f1 = m40
        f1 = f1 * f1
        f2 = m32
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = m24
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 * k72
        f0 = f0 + f1
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "roomclrIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula roomclrIFS. An empty room, it's interesting because it has three selectable colors for the walls."
    de difs
    alias "roomclrIFS"
    param o0_roomthick "RoomThick" = 0.1 [-1.9, 2.1] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_pinch_punch "Pinch / Punch" = 0.1 [-1.9, 2.1] 
    param o6_apply_scale_add "Apply scale+add" = 0.0 [-2.0, 2.0] int
    param o7_x_halfwidth "X halfwidth" = 1.0 [-1.0, 3.0] 
    param o8_y_halfwidth "Y halfwidth" = 1.0 [-1.0, 3.0] 
    param o9_z_halfwidth "Z halfwidth" = 1.0 [-1.0, 3.0] 
    param o10_otclr_l "OTClr L" = 2.0 [-2.0, 6.0] 
    param o11_otclr_r "OTClr R" = 0.0 [-2.0, 2.0] 
    param o12_otclr "OTClr" = 1.0 [-1.0, 3.0] 
    init {
        let k124 = o12_otclr
        let k116 = o11_otclr_r
        let k108 = o10_otclr_l
        let k100 = o9_z_halfwidth
        let k92 = o8_y_halfwidth
        let k84 = o7_x_halfwidth
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_pinch_punch
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_roomthick
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m28 = x0l
        m20 = x0h
        m12 = x1l
        f0 = m12
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f1 = k116
        } else {
            f1 = k108
        }
        a2 = f1
        f0 = abs(f0)
        f0 = f0 - k100
        f1 = m20
        f1 = abs(f1)
        f1 = f1 - k92
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            f0 = f1
            f1 = k124
            a2 = f1
        }
        f1 = m28
        f1 = abs(f1)
        f1 = f1 - k84
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            f0 = f1
            f1 = k124
            a2 = f1
        }
        f1 = m28
        f1 = f1 * f1
        f2 = m20
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = m12
        f2 = f2 * f2
        f1 = f1 + f2
