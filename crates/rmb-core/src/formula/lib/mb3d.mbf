        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m28 = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        x = f2
        y = f1
        f0 = f0 * k76
        z = f0
        f0 = k76
        f0 = abs(f0)
        f0 = f0 * a0
        a0 = f0
        f0 = x
        f0 = f0 * f0
        m12 = f0
        f1 = y
        f1 = f1 * f1
        f2 = f1
        f2 = f2 - m12
        f2 = f2 + f2
        m12 = f2
        f2 = f1
        f2 = f2 * f0
        f2 = f2 + f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * f2
        ft = f2
        f2 = f0
        f0 = ft
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        m28 = f0
        f1 = 1.0
        f0 = f0 - f1
        f1 = m28
        f2 = y
