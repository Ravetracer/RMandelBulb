        }
        rout = f0
    }
}

formula "tilingbrick2IFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula tilingbrick2IFS. Different style of tiling, with an 'inclination' that makes the patterns more interesting."
    de difs
    transform
    alias "tilingbrick2IFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o6_fold_x "Fold X" = 4.0 [-4.0, 12.0] 
    param o7_fold_y "Fold Y" = 3.0 [-3.0, 9.0] 
    param o8_inclination "Inclination" = 0.75 [-1.25, 2.75] 
    init {
        let k92 = o8_inclination
        let k84 = o7_fold_y
        let k76 = o6_fold_x
        let k68 = single(cos(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k64 = single(cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) + sin(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k60 = single(sin(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) - cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k56 = single(-sin(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k52 = single(cos(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) - sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k48 = single(sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) + cos(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k44 = single(sin(o4_rotation_y * pi / 180.0))
        let k40 = single(-cos(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k36 = single(cos(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k32 = o2_add_z
        let k24 = o1_add_y
        let k16 = o0_add_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        let m8 = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        f0 = k84
        f1 = y
        f2 = f1
        f2 = f2 / f0
        m8 = round(f2)
        f2 = m8
        f2 = f2 * f0
        f1 = f1 - f2
        f0 = f1
        f1 = k76
        f2 = k92
        f2 = f2 * m8
        f2 = f2 + x
        f3 = f2
        f3 = f3 / f1
        f3 = round(f3)
        f3 = f3 * f1
        f2 = f2 - f3
        f1 = f2
        x = f1
        y = f0
    }
}

formula "tilingbrickIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula tilingbrickIFS. Different style of tiling, that creates rhombic/hexagonal patterns if iterated."
    de difs
    transform
    alias "tilingbrickIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o6_fold_x "Fold X" = 4.0 [-4.0, 12.0] 
    param o7_fold_y "Fold Y" = 3.0 [-3.0, 9.0] 
    param o8_odd_even_add "Odd/Even add" = 2.0 [-2.0, 6.0] 
    init {
        let k92 = o8_odd_even_add
        let k84 = o7_fold_y
        let k76 = o6_fold_x
        let k68 = single(cos(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k64 = single(cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) + sin(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k60 = single(sin(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) - cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k56 = single(-sin(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k52 = single(cos(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) - sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k48 = single(sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) + cos(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k44 = single(sin(o4_rotation_y * pi / 180.0))
        let k40 = single(-cos(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k36 = single(cos(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k32 = o2_add_z
        let k24 = o1_add_y
        let k16 = o0_add_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let m8 = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        f0 = k84
        f1 = y
        f2 = f1
        f2 = f2 / f0
        m8 = round(f2)
        f2 = m8
        r_edx = m8
        f2 = f2 * f0
        f1 = f1 - f2
        f0 = f1
        f1 = k76
        f2 = x
        r_edx = m8
        r_edx = (r_edx - 2.0 * floor(r_edx / 2.0))
        if r_edx != 0.0 {
        } else {
            f2 = f2 + k92
        }
        f3 = f2
        f3 = f3 / f1
        f3 = round(f3)
        f3 = f3 * f1
        f2 = f2 - f3
        f1 = f2
        x = f1
        y = f0
    }
}

formula "totoricalIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula totoricalIFS. Torical (generalized) coords for DIFS. Useful as pretransform!"
    de difs
    transform
    alias "totoricalIFS"
    param o0_r "R" = 2.0 [-2.0, 6.0] 
    param o1_mula1 "mulA1" = 8.0 [-8.0, 24.0] 
    param o2_suba1 "subA1" = 0.0 [-2.0, 2.0] 
    param o3_mula2 "mulA2" = 4.0 [-4.0, 12.0] 
    param o4_suba1 "subA1" = 0.0 [-2.0, 2.0] 
    param o5_mulradius "mulRadius" = -1.0 [-3.0, 1.0] 
    param o6_subradius "subRadius" = -1.0 [-3.0, 1.0] 
    param o7_fixato1 "FixATo1" = 1.0 [-1.0, 3.0] int
    param o8_foldangles_if_nonzero "FoldAngles (if nonzero)" = 0.5 [-1.5, 2.5] 
    init {
        let k76 = o8_foldangles_if_nonzero
        let k68 = round(o7_fixato1)
        let k64 = o6_subradius
        let k56 = o5_mulradius
        let k48 = o4_suba1
        let k40 = o3_mula2
        let k32 = o2_suba1
        let k24 = o1_mula1
        let k16 = o0_r
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = z
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k16
        f1 = f0
        f1 = f1 * f1
        f2 = x
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f2 = f0
        f3 = x
        f3 = -f3
        f2 = atan2(f2, f3)
        f2 = f2 - 1.5707963267948966
        f2 = abs(f2)
        f3 = y
        f4 = z
        f3 = atan2(f3, f4)
        f3 = abs(f3)
        if k68 != 0.0 {
            f4 = 0.3183098861837907
            f3 = f3 * f4
            f2 = f2 * f4
        }
        f3 = f3 * k24
        f3 = f3 - k32
        f4 = k76
        fc_a = f4
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            x = f3
            f3 = k76
            f3 = f3 + f3
            f3 = f3 + f3
            f4 = x
            f5 = f4
            f5 = f5 / f3
            f5 = round(f5)
            f5 = f5 * f3
            f4 = f4 - f5
            f3 = f4
            f3 = -f3
            f4 = f3
            f4 = -f4
            f4 = f4 + k76
            f4 = abs(f4)
            f5 = f3
            f5 = -f5
            f5 = f5 - k76
            f5 = abs(f5)
            f5 = -f5
            f4 = f4 + f5
            f3 = f3 + f4
        }
        x = f3
        f2 = f2 * k40
        f2 = f2 - k48
        f3 = k76
        fc_a = f3
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            y = f2
            f2 = k76
            f2 = f2 + f2
            f2 = f2 + f2
            f3 = y
            f4 = f3
            f4 = f4 / f2
            f4 = round(f4)
            f4 = f4 * f2
            f3 = f3 - f4
            f2 = f3
            f2 = -f2
            f3 = f2
            f3 = -f3
            f3 = f3 + k76
            f3 = abs(f3)
            f4 = f2
            f4 = -f4
            f4 = f4 - k76
            f4 = abs(f4)
            f4 = -f4
            f3 = f3 + f4
            f2 = f2 + f3
        }
        y = f2
        f1 = f1 * k56
        f1 = f1 - k64
        z = f1
    }
}

formula "toupieIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula toupieIFS. Toupie is an isosurface defined as follows;"
    de difs
    alias "toupieIFS"
    param o0_pseudo_radius "Pseudo Radius" = 1.0 [-1.0, 3.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_r_mul "R-mul" = 1.0 [-1.0, 3.0] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_toupierot_x "ToupieRot X" = 0.0 [-180.0, 180.0] angle
    param o8_toupierot_y "ToupieRot Y" = 0.0 [-180.0, 180.0] angle
    param o9_toupierot_z "ToupieRot Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_toupierot_x * pi / 180.0) * cos(o8_toupierot_y * pi / 180.0))
        let k108 = single(cos(o7_toupierot_x * pi / 180.0) * sin(o8_toupierot_y * pi / 180.0) * sin(o9_toupierot_z * pi / 180.0) + sin(o7_toupierot_x * pi / 180.0) * cos(o9_toupierot_z * pi / 180.0))
        let k104 = single(sin(o7_toupierot_x * pi / 180.0) * sin(o9_toupierot_z * pi / 180.0) - cos(o7_toupierot_x * pi / 180.0) * sin(o8_toupierot_y * pi / 180.0) * cos(o9_toupierot_z * pi / 180.0))
        let k100 = single(-sin(o7_toupierot_x * pi / 180.0) * cos(o8_toupierot_y * pi / 180.0))
        let k96 = single(cos(o7_toupierot_x * pi / 180.0) * cos(o9_toupierot_z * pi / 180.0) - sin(o7_toupierot_x * pi / 180.0) * sin(o8_toupierot_y * pi / 180.0) * sin(o9_toupierot_z * pi / 180.0))
        let k92 = single(sin(o7_toupierot_x * pi / 180.0) * sin(o8_toupierot_y * pi / 180.0) * cos(o9_toupierot_z * pi / 180.0) + cos(o7_toupierot_x * pi / 180.0) * sin(o9_toupierot_z * pi / 180.0))
        let k88 = single(sin(o8_toupierot_y * pi / 180.0))
        let k84 = single(-cos(o8_toupierot_y * pi / 180.0) * sin(o9_toupierot_z * pi / 180.0))
        let k80 = single(cos(o8_toupierot_y * pi / 180.0) * cos(o9_toupierot_z * pi / 180.0))
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_r_mul
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_pseudo_radius
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m44 = x0l
        m36 = x0h
        m28 = x1l
        f0 = m28
        f1 = m36
        f2 = m44
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        m44 = f2
        m36 = f1
        m28 = f0
        f0 = m44
        f0 = f0 * f0
        f1 = m36
        f1 = f1 * f1
        f0 = f0 + f1
        m44 = f0
        f0 = sqrt(f0)
        m20 = f0
        f0 = sqrt(f0)
        f0 = f0 * k72
        f1 = m28
        f1 = abs(f1)
        f1 = k16 - f1
        f0 = f0 - f1
        f1 = m20
        f1 = f1 - k72
        f1 = f1 - k72
        f1 = f1 - k72
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m28
        f1 = abs(f1)
        f1 = f1 - k72
        f1 = f1 - k72
        f1 = f1 - k72
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "trans-qIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula trans-qIFS. Non-conformal quadratic transformation of x and y (plus z if there is a rotation)."
    de difs
    transform
    alias "trans-qIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o6_quadratic_x "Quadratic X" = 2.0 [-2.0, 6.0] 
    param o7_quadratic_y "Quadratic Y" = 2.0 [-2.0, 6.0] 
    init {
        let k84 = o7_quadratic_y
        let k76 = o6_quadratic_x
        let k68 = single(cos(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k64 = single(cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) + sin(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k60 = single(sin(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) - cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k56 = single(-sin(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k52 = single(cos(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) - sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k48 = single(sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) + cos(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k44 = single(sin(o4_rotation_y * pi / 180.0))
        let k40 = single(-cos(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k36 = single(cos(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k32 = o2_add_z
        let k24 = o1_add_y
        let k16 = o0_add_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
