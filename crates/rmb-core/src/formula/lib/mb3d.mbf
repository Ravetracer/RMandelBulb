        f1 = f0
        f1 = f1 * f1
        ft = f1
        f1 = f0
        f0 = ft
        f1 = -f1
        f0 = f0 + f1
        f1 = m34
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = abs(f0)
        f0 = sqrt(f0)
        f0 = f0 * 0.5
        f0 = f0 - k72
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "KleinBotTIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula KleinBotTIFS. A torical Klein Bottle; note that you can 'enter inside' it, even if it has not inside or outside."
    de difs
    alias "KleinBotTIFS"
    param o0_maxtradius "MaxTRadius" = 0.6 [-1.4, 2.6] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_mintradius "MinTRadius" = 0.2 [-1.8, 2.2] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_bottle_thickness "Bottle thickness" = 0.05 [-1.95, 2.05] 
    init {
        let k84 = o7_bottle_thickness
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_mintradius
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_maxtradius
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m26 = 0.0
        let m34 = 0.0
        let m42 = 0.0
        let m50 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m50 = x0l
        m42 = x0h
        m34 = x1l
        f0 = 0.0
        m26 = f0
        f0 = m50
        f1 = m42
        fc_a = f1
        fc_b = 0.0
        if fc_a >= fc_b {
            f2 = 1.0
            f2 = -f2
            r_edx = (-1.0)
        } else {
            f2 = 1.0
            r_edx = 1.0
        }
        f1 = f2
        f0 = f0 + f1
        m50 = f0
        f0 = m50
        f0 = f0 * f0
        f1 = m42
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - 1.0
        f0 = f0 * f0
        f1 = m34
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k16
        f0 = abs(f0)
        f0 = f0 - k84
        rout = f0
        m50 = x0l
        m42 = x0h
        m34 = x1l
        if r_edx != 1.0 {
            f0 = m42
            f1 = m34
            f2 = m50
            f2 = f2 + 2.0
            m50 = f2
            m42 = f1
            m34 = f0
            f0 = m50
            f0 = f0 * f0
            f1 = m42
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f0 = f0 + k72
            f0 = f0 - k16
            f0 = f0 * f0
            f1 = m34
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f0 = f0 - k72
            f0 = abs(f0)
            f0 = f0 - k84
        } else {
            f0 = m50
            f0 = f0 * f0
            f1 = m42
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f1 = m42
            f2 = m50
            f1 = atan2(f1, f2)
            f1 = f1 * 0.3183
            f2 = k72
            f2 = f2 + f2
            f1 = f1 * f2
            f1 = f1 + k16
            m42 = f1
            f0 = f0 - 2.0
            f0 = f0 * f0
            f1 = m34
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f0 = f0 - m42
            m26 = f0
            f0 = abs(f0)
            f0 = f0 - k84
        }
        f1 = rout
        f2 = m26
        f3 = f2
        f3 = abs(f3)
        f2 = f3 - f2
        f1 = f1 + f2
        rout = f1
        fc_a = f0
        fc_b = rout
        if fc_a >= fc_b {
            f0 = rout
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "Knots2IFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula Knots2IFS. Tool for plotting customized torus knots. As always, it's best to use it using the real-time Navi preview."
    de difs
    alias "Knots2IFS"
    param o0_radius_1 "Radius 1" = 2.0 [-2.0, 6.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_radius_2 "Radius 2" = 0.25 [-1.75, 2.25] 
    param o6_apply_scale_add "Apply scale+add" = 0.0 [-2.0, 2.0] int
    param o7_order "Order" = -3.0 [-9.0, 3.0] int
    param o8_mobius_x "Mobius X" = 2.0 [-2.0, 6.0] int
    param o9_mobius_y "Mobius Y" = 4.0 [-4.0, 12.0] int
    param o10_radius_3 "Radius 3" = -1.0 [-3.0, 1.0] 
    param o11_change_this_to_close "Change this to close" = 3.0 [-3.0, 9.0] int
    init {
        let k100 = round(o11_change_this_to_close)
        let k96 = o10_radius_3
        let k88 = round(o9_mobius_y)
        let k84 = round(o8_mobius_x)
        let k80 = round(o7_order)
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_radius_2
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_radius_1
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m26 = 0.0
        let m34 = 0.0
        let m42 = 0.0
        let m50 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m50 = x0l
        m42 = x0h
        m34 = x1l
        f0 = m42
        f1 = m50
        f0 = atan2(f0, f1)
        f1 = m42
        f1 = f1 * f1
        f2 = m50
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        m50 = f1
        m42 = f0
        f0 = 10000000000.0
        rout = f0
        r_edx = k100
        loop {
            f0 = m42
            f0 = f0 + 6.283185307
            m42 = f0
            f0 = f0 / k80
            m26 = f0
            f0 = f0 * k84
            f0 = cos(f0)
            f0 = f0 * k96
            f0 = f0 + m50
            f0 = f0 - k16
            f0 = f0 * f0
            f1 = m26
            f1 = f1 * k88
            f1 = sin(f1)
            f1 = f1 * k96
            f1 = f1 + m34
            f1 = f1 - k16
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            fc_a = f0
            fc_b = rout
            if fc_a >= fc_b {
            } else {
                rout = f0
            }
            r_edx = r_edx - 1.0
            if r_edx > 0.0 {
                continue
            } else {
                break
            }
        }
        f0 = rout
        f0 = f0 - k72
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

