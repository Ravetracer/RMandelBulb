formula "_CelticMode" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _CelticMode. This effect works at best with every formula that at z=0 show a Mandelbrot set, and if it's at power 2."
    de numeric
    transform
    alias "_CelticMode"
    param o0_good_rune "Good rune" = -1.0 [-3.0, 1.0] 
    param o1_evil_rune "Evil rune" = 0.0 [-2.0, 2.0] 
    param o2_mystic_rune "Mystic rune" = 0.0 [-2.0, 2.0] 
    param o3_heretic_rune "Heretic rune" = 0.0 [-2.0, 2.0] 
    init {
        let k40 = o3_heretic_rune
        let k32 = o2_mystic_rune
        let k24 = o1_evil_rune
        let k16 = o0_good_rune
    }
    iter {
        let f0 = 0.0
