        let f5 = 0.0
        let f6 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = x
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 + 1e-10
        f0 = f0 / f1
        f1 = x
        f1 = f1 * f1
        f2 = y
        f2 = f2 * f2
        f2 = -f2
        f1 = f1 + f2
        f2 = x
        f2 = f2 * f2
        f3 = y
        f3 = f3 * f3
        f2 = f2 + f3
        f2 = f2 + 1e-10
        f1 = f1 / f2
        f1 = f1 * f0
        f2 = x
        f2 = abs(f2)
        f1 = f1 * f2
        f1 = f1 * k16
        f1 = f1 + cx
        f2 = x
        f2 = f2 * y
        f3 = x
        f3 = abs(f3)
        f2 = f2 * f3
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = f3 + 1e-10
        f2 = f2 / f3
        f2 = f2 * f0
        f2 = f2 * k24
        f2 = f2 + cy
        f3 = z
        f4 = x
        f4 = f4 * f4
        f5 = y
        f5 = f5 * f5
        f6 = z
        f6 = f6 * f6
        f5 = f5 + f6
        f4 = f4 + f5
        f4 = sqrt(f4)
        f3 = f3 * f4
        f3 = f3 * k32
        f4 = cz
        f4 = abs(f4)
        f4 = f4 * k40
        f3 = f3 + f4
        z = f3
        y = f2
        x = f1
    }
}

formula "Ruckerbulb" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Ruckerbulb. The Rudy Rucker's formula for 3D Mandelbrot."
    de numeric
    descale 1.5
    alias "Ruckerbulb"
    param o0_power "Power" = 2.0 [-2.0, 6.0] 
    param o1_z_anglepow "z-AnglePow" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "z-Mul" = -1.0 [-3.0, 1.0] 
    param o3_mode "Mode" = 0.0 [-2.0, 2.0] int
    param o4_atan2mode "Atan2Mode" = 0.0 [-2.0, 2.0] int
    init {
        let k40 = round(o4_atan2mode)
        let k36 = round(o3_mode)
        let k32 = o2_z_mul
        let k24 = o1_z_anglepow
        let k16 = o0_power
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        let m68 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        m68 = f0
        f1 = k16
        ft = f1
        f1 = f0
        f0 = ft
        f1 = abs(f1)
        f0 = f0 * log(f1) * 1.4426950408889634
        f1 = 1.0
        f2 = f0
        f2 = f2 % f1
        f2 = pow(2.0, f2) - 1.0
        f1 = f1 + f2
        f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
        ft = f1
        f1 = f0
        f0 = ft
        m12 = f0
        if k36 != 0.0 {
            f0 = m68
            f1 = k24
            ft = f1
            f1 = f0
            f0 = ft
            f1 = abs(f1)
            f0 = f0 * log(f1) * 1.4426950408889634
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            m68 = f0
        } else {
            f0 = m12
            m68 = f0
        }
        f0 = x
        f0 = -f0
        f1 = z
        f0 = atan2(f0, f1)
        if k40 != 0.0 {
        } else {
            f1 = x
            f2 = 0.0
            fc_a = f2
            fc_b = f1
            if fc_a <= fc_b {
            } else {
                f1 = z
                f2 = 0.0
                fc_a = f2
                fc_b = f1
                f1 = 3.141592653589793
                f1 = f1 * 1.0
                f0 = f0 - f1
            }
        }
        f0 = f0 * k24
        f1 = cos(f0)
        f0 = sin(f0)
        m20 = f1
        m28 = f0
        f0 = y
        f1 = x
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m36 = f1
        m44 = f0
        f0 = m12
        f0 = f0 * m20
        f0 = f0 * m36
        f0 = -f0
        f0 = f0 + cx
        m52 = f0
        f0 = m12
        f0 = f0 * m20
        f0 = f0 * m44
        f0 = -f0
        f0 = f0 + cy
        m60 = f0
        f0 = m68
        f0 = f0 * m28
        f0 = f0 * k32
        f0 = f0 + cz
        m68 = f0
        f0 = m52
        f1 = m60
        f2 = m68
        z = f2
        y = f1
        x = f0
    }
}

formula "SierpHilbert" {
    category "MB3D 3D"
    description "Mandelbulb3D formula SierpHilbert. This fractal is an hybridation of Sierpinski and Hilbert axioms, with these parameters."
    de linear
    alias "SierpHilbert"
    param o0_scale "Scale" = 3.0 [-3.0, 9.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    param o10_edge1 "Edge1" = 2.0 [-2.0, 6.0] 
    param o11_edge2 "Edge2" = 1.0 [-1.0, 3.0] 
    init {
        let k128 = o11_edge2
        let k120 = o10_edge1
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        f2 = -f2
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = -f2
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f3 = k120
        f4 = 0.0
        fc_a = f4
        fc_b = f3
        if fc_a >= fc_b {
        } else {
            f3 = f3 - f1
            f3 = abs(f3)
            f3 = -f3
            f3 = f3 + k120
            ft = f3
            f3 = f1
            f1 = ft
        }
        f3 = k128
        f4 = 0.0
        fc_a = f4
        fc_b = f3
        if fc_a >= fc_b {
        } else {
            f3 = f3 - f2
            f3 = abs(f3)
            f3 = -f3
            f3 = f3 + k128
            ft = f3
            f3 = f2
            f2 = ft
        }
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f4 = f4 * k40
        f0 = f0 - f4
        f4 = f3
        f4 = f4 * k32
        f1 = f1 - f4
        f3 = f3 * k24
        f2 = f2 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "Sierpinski3" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Sierpinski3. "
    de linear
    alias "Sierpinski3"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        f2 = -f2
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = -f2
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f4 = f4 * k40
        f0 = f0 - f4
        f4 = f3
        f4 = f4 * k32
        f1 = f1 - f4
        f3 = f3 * k24
        f2 = f2 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "Sierpinski3alt" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Sierpinski3alt. Alternate version of Sierpinski3."
    de linear
    alias "Sierpinski3alt"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_rot_dx "Rot. dX" = 0.5 [-1.5, 2.5] 
    param o5_rot_dy "Rot. dY" = 0.5 [-1.5, 2.5] 
    param o6_rot_dz "Rot. dZ" = 0.5 [-1.5, 2.5] 
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k100 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k88 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k84 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k76 = single(sin(o8_rotation2_y * pi / 180.0))
        let k72 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k68 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k64 = o6_rot_dz
        let k56 = o5_rot_dy
        let k48 = o4_rot_dx
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f2 = -f2
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = -f2
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f3 = k48
        f2 = f2 + f3
        f3 = k56
        f1 = f1 + f3
        f3 = k64
        f0 = f0 + f3
        f3 = f2
        f3 = f3 * k92
        f4 = f1
        f4 = f4 * k96
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k100
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k68
        f5 = f1
        f5 = f5 * k72
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k76
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k80
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k84
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k88
        f1 = f1 + f3
        f3 = k48
        f2 = f2 - f3
        f3 = k56
        f1 = f1 - f3
        f3 = k64
        f0 = f0 - f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f4 = f4 * k40
        f0 = f0 - f4
        f4 = f3
        f4 = f4 * k32
        f1 = f1 - f4
        f3 = f3 * k24
        f2 = f2 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "Sierpinski4" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Sierpinski4. Thanks a lot (I mean a lot) to Syntopia for this formula."
    de linear
    descale 1.1
    alias "Sierpinski4"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_cscale_w "CScale W" = 1.0 [-1.0, 3.0] 
    param o5_rotation_yz "Rotation YZ" = 0.0 [-180.0, 180.0] angle
    param o6_rotation_xz "Rotation XZ" = 0.0 [-180.0, 180.0] angle
    param o7_rotation_xy "Rotation XY" = 0.0 [-180.0, 180.0] angle
    param o8_rotation_xw "Rotation XW" = 0.0 [-180.0, 180.0] angle
    param o9_rotation_yw "Rotation YW" = 0.0 [-180.0, 180.0] angle
    param o10_rotation_zw "Rotation ZW" = 0.0 [-180.0, 180.0] angle
    init {
        let q5_0_00 = 1.0
        let q5_0_01 = 0.0
        let q5_0_02 = 0.0
        let q5_0_03 = 0.0
        let q5_0_10 = 0.0
        let q5_0_11 = (cos(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_12 = (-sin(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_13 = 0.0
        let q5_0_20 = 0.0
        let q5_0_21 = (sin(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_22 = (cos(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_23 = 0.0
        let q5_0_30 = 0.0
        let q5_0_31 = 0.0
        let q5_0_32 = 0.0
        let q5_0_33 = 1.0
        let q5_1_00 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_00 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_20
        let q5_1_01 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_01 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_21
        let q5_1_02 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_02 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_22
        let q5_1_03 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_03 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_23
        let q5_1_10 = q5_0_10
        let q5_1_11 = q5_0_11
