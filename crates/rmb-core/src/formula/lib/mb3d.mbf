            f6 = f6 * f6
            f5 = f5 + f6
            f5 = sqrt(f5)
            f5 = f5 * k120
            f4 = f4 + f5
            f4 = f4 * f0
            f3 = f3 + f4
            y = f3
            x = f2
        }
    }
}

formula "_lorenz" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _lorenz. Lorenz hyperchaotic system in 4D - variation with four parameters and strength"
    de numeric
    transform
    alias "_lorenz"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 0.5 [-1.5, 2.5] 
    param o2_beta "Beta" = -2.0 [-6.0, 2.0] 
    param o3_gamma "Gamma" = 1.0 [-1.0, 3.0] 
    param o4_r "r" = -1.5 [-4.5, 1.5] 
    init {
        let k48 = o4_r
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = y
        f0 = f0 - x
        f0 = f0 * k24
        f0 = f0 + dr
        f0 = f0 * k16
        f1 = x
        f1 = f1 * k40
        f1 = f1 - y
        f2 = x
        f2 = f2 * z
        f2 = -f2
        f1 = f1 + f2
        f1 = f1 * k16
        f2 = x
        f2 = f2 * y
        f3 = z
        f3 = f3 * k32
        f3 = -f3
        f2 = f2 + f3
        f2 = f2 * k16
        f3 = dr
        f3 = f3 * k48
        f4 = y
        f4 = f4 * z
        f4 = -f4
        f3 = f3 + f4
        f3 = f3 * k16
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "_mulC3D" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _mulC3D. Multiplies current vector by a vector V defined as follows"
    de numeric
    descale 0.1
    alias "_mulC3D"
    param o0_cadd_scale "CAdd-Scale" = 0.25 [-1.75, 2.25] 
    param o1_xyzadd_scale "xyzAdd-Scale" = 0.0 [-2.0, 2.0] 
    param o2_const_real_x "Const real-x" = 1.0 [-1.0, 3.0] 
    param o3_const_imag_y "Const imag-y" = 0.0 [-2.0, 2.0] 
    param o4_const_imag_z "Const imag-z" = 0.0 [-2.0, 2.0] 
    param o5_rot_for_c_xyz_x "Rot. for C,xyz X" = 0.0 [-180.0, 180.0] angle
    param o6_rot_for_c_xyz_y "Rot. for C,xyz Y" = 0.0 [-180.0, 180.0] angle
    param o7_rot_for_c_xyz_z "Rot. for C,xyz Z" = 0.0 [-180.0, 180.0] angle
    param o8_z_multiplier "Z multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k92 = o8_z_multiplier
        let k84 = single(cos(o5_rot_for_c_xyz_x * pi / 180.0) * cos(o6_rot_for_c_xyz_y * pi / 180.0))
        let k80 = single(cos(o5_rot_for_c_xyz_x * pi / 180.0) * sin(o6_rot_for_c_xyz_y * pi / 180.0) * sin(o7_rot_for_c_xyz_z * pi / 180.0) + sin(o5_rot_for_c_xyz_x * pi / 180.0) * cos(o7_rot_for_c_xyz_z * pi / 180.0))
        let k76 = single(sin(o5_rot_for_c_xyz_x * pi / 180.0) * sin(o7_rot_for_c_xyz_z * pi / 180.0) - cos(o5_rot_for_c_xyz_x * pi / 180.0) * sin(o6_rot_for_c_xyz_y * pi / 180.0) * cos(o7_rot_for_c_xyz_z * pi / 180.0))
        let k72 = single(-sin(o5_rot_for_c_xyz_x * pi / 180.0) * cos(o6_rot_for_c_xyz_y * pi / 180.0))
        let k68 = single(cos(o5_rot_for_c_xyz_x * pi / 180.0) * cos(o7_rot_for_c_xyz_z * pi / 180.0) - sin(o5_rot_for_c_xyz_x * pi / 180.0) * sin(o6_rot_for_c_xyz_y * pi / 180.0) * sin(o7_rot_for_c_xyz_z * pi / 180.0))
        let k64 = single(sin(o5_rot_for_c_xyz_x * pi / 180.0) * sin(o6_rot_for_c_xyz_y * pi / 180.0) * cos(o7_rot_for_c_xyz_z * pi / 180.0) + cos(o5_rot_for_c_xyz_x * pi / 180.0) * sin(o7_rot_for_c_xyz_z * pi / 180.0))
        let k60 = single(sin(o6_rot_for_c_xyz_y * pi / 180.0))
        let k56 = single(-cos(o6_rot_for_c_xyz_y * pi / 180.0) * sin(o7_rot_for_c_xyz_z * pi / 180.0))
        let k52 = single(cos(o6_rot_for_c_xyz_y * pi / 180.0) * cos(o7_rot_for_c_xyz_z * pi / 180.0))
        let k48 = o4_const_imag_z
        let k40 = o3_const_imag_y
        let k32 = o2_const_real_x
        let k24 = o1_xyzadd_scale
        let k16 = o0_cadd_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        let m68 = 0.0
        let m76 = 0.0
        f0 = x
        m20 = f0
        f0 = y
        m28 = f0
        f0 = z
        m36 = f0
        f0 = cz
        f0 = f0 * k16
        f1 = m36
        f1 = f1 * k24
        f0 = f0 + f1
        f1 = cy
        f1 = f1 * k16
        f2 = m28
        f2 = f2 * k24
        f1 = f1 + f2
        f2 = cx
        f2 = f2 * k16
        f3 = m20
        f3 = f3 * k24
        f2 = f2 + f3
        f3 = f2
        f3 = f3 * k76
        f4 = f1
        f4 = f4 * k80
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k84
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k52
        f5 = f1
        f5 = f5 * k56
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k60
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k64
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k68
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k72
        f1 = f1 + f3
        f2 = f2 + k32
        m60 = f2
        f1 = f1 + k40
        m68 = f1
        f0 = f0 + k48
        m76 = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        m44 = f0
        f0 = m60
        f0 = f0 * f0
        f1 = m68
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        m52 = f0
        f0 = m44
        f0 = f0 * m76
        f1 = m52
        f1 = f1 * m36
        f0 = f0 + f1
        f0 = f0 * k92
        z = f0
        f0 = m36
        f0 = f0 * m76
        f0 = f0 / m44
        f0 = f0 / m52
        f0 = -f0
        f1 = 1.0
        f0 = f0 + f1
        m44 = f0
        f1 = m20
        f1 = f1 * m60
        f2 = m28
        f2 = f2 * m68
        f1 = f1 - f2
        f0 = f0 * f1
        x = f0
        f0 = m60
        f0 = f0 * m28
        f1 = m20
        f1 = f1 * m68
        f0 = f0 + f1
        f0 = f0 * m44
        y = f0
    }
}

formula "_ngon" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _ngon. Variation of PolyFolding; gets nearly identical results"
    de numeric
    transform
    alias "_ngon"
    param o0_order "Order" = 4.0 [-4.0, 12.0] 
    param o1_shift_deg "Shift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_shift_x "Shift x" = 0.0 [-2.0, 2.0] 
    param o3_shift_y "Shift y" = 0.0 [-2.0, 2.0] 
    param o4_skew_deg "Skew (deg)" = 0.0 [-2.0, 2.0] 
    param o5_no_yfold "No yfold" = 0.0 [-2.0, 2.0] int
    init {
        let k52 = round(o5_no_yfold)
        let k48 = o4_skew_deg
        let k40 = o3_shift_y
        let k32 = o2_shift_x
        let k24 = o1_shift_deg
        let k16 = o0_order
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let r_eax = 0.0
        let m36 = 0.0
        let m48 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k48
        f1 = f1 + k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m36 = f0
        m48 = round(f0)
        f0 = m48
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f2 = f2 * f1
        f3 = y
        f3 = f3 * f0
        f2 = f3 - f2
        f3 = m36
        r_eax = k52
        if r_eax != 0.0 {
        } else {
            f4 = m48
            f4 = -f4
            f3 = f3 + f4
            r_eax = m48
            r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
            if r_eax != 0.0 {
            } else {
                f3 = -f3
            }
        }
        f3 = f3 / k16
        f3 = f3 * 6.283185307
        f3 = f3 - k40
        y = f3
        f2 = f2 - k32
        x = f2
    }
}

