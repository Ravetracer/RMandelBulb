    param o3_rotation_xw "Rotation XW" = 0.0 [-180.0, 180.0] angle
    param o4_rotation_yw "Rotation YW" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_zw "Rotation ZW" = 0.0 [-180.0, 180.0] angle
    init {
        let q0_0_00 = 1.0
        let q0_0_01 = 0.0
        let q0_0_02 = 0.0
        let q0_0_03 = 0.0
        let q0_0_10 = 0.0
        let q0_0_11 = (cos(o0_rotation_yz * pi / 180.0)) * 1.0
        let q0_0_12 = (-sin(o0_rotation_yz * pi / 180.0)) * 1.0
        let q0_0_13 = 0.0
        let q0_0_20 = 0.0
        let q0_0_21 = (sin(o0_rotation_yz * pi / 180.0)) * 1.0
        let q0_0_22 = (cos(o0_rotation_yz * pi / 180.0)) * 1.0
        let q0_0_23 = 0.0
