        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        y = f2
        x = f1
        z = f0
    }
}

formula "_FoldingTetra3d" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _FoldingTetra3d. Note that this code does NOT affect the Menger-type formulas."
    de numeric
    transform
    alias "_FoldingTetra3d"
    param o0_fold_1st_half "Fold 1st half" = 1.0 [-1.0, 3.0] int
    param o1_fold_2nd_half "Fold 2nd half" = 1.0 [-1.0, 3.0] int
    init {
        let k16 = round(o1_fold_2nd_half)
        let k12 = round(o0_fold_1st_half)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        if k12 == 0.0 {
            f0 = x
            f0 = f0 - y
            f1 = 0.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = x
                f1 = y
                x = f1
                y = f0
            }
            f0 = x
            f0 = f0 - z
            f1 = 0.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = x
                f1 = z
                x = f1
                z = f0
            }
            f0 = y
            f0 = f0 - z
            f1 = 0.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = y
                f1 = z
                y = f1
                z = f0
            }
        } else {
            f0 = x
            f0 = f0 + y
            f1 = 0.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = x
                f0 = -f0
                f1 = y
                f1 = -f1
                x = f1
                y = f0
            }
            f0 = x
            f0 = f0 + z
            f1 = 0.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = x
                f0 = -f0
                f1 = z
                f1 = -f1
                x = f1
                z = f0
            }
            f0 = z
            f0 = f0 + y
            f1 = 0.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
            } else {
                f0 = z
                f0 = -f0
                f1 = y
                f1 = -f1
                z = f1
                y = f0
            }
            if k16 == 0.0 {
            } else {
                f0 = x
                f0 = f0 - y
                f1 = 0.0
                fc_a = f1
                fc_b = f0
                if fc_a < fc_b {
                } else {
                    f0 = x
                    f1 = y
                    x = f1
                    y = f0
                }
                f0 = x
                f0 = f0 - z
                f1 = 0.0
                fc_a = f1
                fc_b = f0
                if fc_a < fc_b {
                } else {
                    f0 = x
                    f1 = z
                    x = f1
                    z = f0
                }
                f0 = y
                f0 = f0 - z
                f1 = 0.0
                fc_a = f1
                fc_b = f0
                if fc_a < fc_b {
                } else {
                    f0 = y
                    f1 = z
                    y = f1
                    z = f0
                }
            }
        }
    }
}

