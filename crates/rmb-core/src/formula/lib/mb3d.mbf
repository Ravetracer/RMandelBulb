formula "IdesFormula" {
    category "MB3D 3D"
    description "Mandelbulb3D formula IdesFormula. A formula made by Trafassel, the original Ide's Formula thread:"
    de numeric
    alias "IdesFormula"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = 1.0 [-1.0, 3.0] 
    param o3_xsub_mul "Xsub mul" = 0.5 [-1.5, 2.5] 
