                                f1 = f1 * f1
                                f2 = z
                                f2 = f2 - k32
                                f2 = f2 * f2
                                f1 = f1 + f2
                                f0 = f0 + f1
                                f0 = sqrt(f0)
                                f0 = f0 / k40
                            } else {
                                f0 = z
                                f0 = f0 - k32
                                f1 = 0.0
                                fc_a = f1
                                fc_b = f0
                                if fc_a > fc_b {
                                    f0 = 1.0
                                } else {
                                    f0 = x
                                    f0 = f0 - k16
                                    f0 = abs(f0)
                                    f1 = y
                                    f1 = f1 - k24
                                    f1 = abs(f1)
                                    fc_a = f1
                                    fc_b = f0
