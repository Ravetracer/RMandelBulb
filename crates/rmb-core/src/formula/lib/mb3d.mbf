formula "_FoldingIcosa" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _FoldingIcosa. Just like IcosahedronIFS, just dropped anything but the rotation and the dodeca-fold."
    de numeric
    transform
    alias "_FoldingIcosa"
    param o0_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o1_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o2_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k44 = single(cos(o0_rotation1_x * pi / 180.0) * cos(o1_rotation1_y * pi / 180.0))
        let k40 = single(cos(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0) + sin(o0_rotation1_x * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0))
        let k36 = single(sin(o0_rotation1_x * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0) - cos(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0))
        let k32 = single(-sin(o0_rotation1_x * pi / 180.0) * cos(o1_rotation1_y * pi / 180.0))
        let k28 = single(cos(o0_rotation1_x * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0) - sin(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0))
        let k24 = single(sin(o0_rotation1_x * pi / 180.0) * sin(o1_rotation1_y * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0) + cos(o0_rotation1_x * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0))
        let k20 = single(sin(o1_rotation1_y * pi / 180.0))
        let k16 = single(-cos(o1_rotation1_y * pi / 180.0) * sin(o2_rotation1_z * pi / 180.0))
        let k12 = single(cos(o1_rotation1_y * pi / 180.0) * cos(o2_rotation1_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
