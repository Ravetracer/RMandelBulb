        f1 = f1 * f2
        f0 = f0 + f1
        f1 = y
        f1 = f1 * k16
        f2 = x
        f2 = f2 * f2
        f3 = k64
        f3 = f3 - k24
        f2 = f2 * f3
        f1 = f1 + f2
        f2 = y
        f2 = f2 * f2
        f3 = k48
