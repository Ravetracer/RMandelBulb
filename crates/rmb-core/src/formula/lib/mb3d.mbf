                f0 = f0 - k16
                x = f0
                f0 = y
                f0 = f0 * k40
                f0 = f0 - k24
                y = f0
                f0 = z
                f0 = f0 * k40
                f0 = f0 - k32
                z = f0
            }
        }
    }
}

