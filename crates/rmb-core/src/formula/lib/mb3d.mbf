formula "MitreIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula MitreIFS. Simple finite quartic surface. Added rotation and customizers"
    de difs
    alias "MitreIFS"
    param o0_yz_add "YZ add" = 4.1 [-4.1, 12.299999999999999] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_x2r_mul "X2R mul" = 1.6 [-1.6, 4.800000000000001] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_mitrerot_x "MitreRot X" = 90.0 [-180.0, 180.0] angle
    param o8_mitrerot_y "MitreRot Y" = 90.0 [-180.0, 180.0] angle
    param o9_mitrerot_z "MitreRot Z" = 90.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_mitrerot_x * pi / 180.0) * cos(o8_mitrerot_y * pi / 180.0))
