        let k48 = o2_mul1
        let k40 = 1.0 / max(1.0e-40, o1_limiter2)
        let k32 = o1_limiter2
        let k24 = 1.0 / max(1.0e-40, o0_limiter1)
        let k16 = o0_limiter1
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let sv1 = 0.0
        f0 = x
        sv1 = x
        f0 = f0 * k48
        f0 = abs(f0)
        f0 = f0 + k16
        f1 = 1.0
        f0 = f1 / f0
        f0 = -f0
        f0 = f0 + k24
        f1 = x
        f1 = f1 * f1
        f1 = f1 * k56
        f1 = abs(f1)
        f1 = f1 + k32
        f2 = 1.0
        f1 = f2 / f1
        f1 = -f1
        f1 = f1 + k40
        f0 = f0 + f1
        x = f0
        x = sel(sv1 < 0.0, -x, x)
    }
}

