        f3 = f3 * f4
        f4 = f3
        f4 = round(f4)
        f3 = f3 - f4
        ft = f4
        f4 = f3
        f3 = ft
        f4 = pow(2.0, f4) - 1.0
        f5 = 1.0
        f4 = f4 + f5
        f4 = f4 * pow(2.0, sel(f3 < 0.0, -floor(-f3), floor(f3)))
