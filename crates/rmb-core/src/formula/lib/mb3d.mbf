formula "OctahedronIFS" {
    category "MB3D 3D"
    description "Mandelbulb3D formula OctahedronIFS. "
    de linear
    alias "OctahedronIFS"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 0.0 [-2.0, 2.0] 
    param o3_cscale_z "CScale Z" = 0.0 [-2.0, 2.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        f2 = -f2
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        f2 = -f2
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f2 = -f2
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f1
        f3 = f3 * k104
        f4 = f2
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f1
        f4 = f4 * k80
        f5 = f2
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k96
        f2 = f2 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f2 = f2 + f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f5 = f4
        f5 = f5 * k24
        f1 = f1 - f5
        f4 = f4 * k32
        f2 = f2 - f4
        f3 = f3 * k40
        f0 = f0 - f3
        y = f2
        x = f1
        z = f0
    }
}

formula "PG-bulb" {
    category "MB3D 4D"
    description "Mandelbulb3D formula PG-bulb. This formula comes from Pseudogenius:"
    de numeric
    alias "PG-bulb"
    param o0_w_add "w add" = 0.0 [-2.0, 2.0] 
    param o1_intpower_2_to_16 "IntPower (2 to 16)" = 8.0 [-8.0, 24.0] int
    param o2_old_angles "Old angles" = 1.0 [-1.0, 3.0] int
    init {
        let k24 = round(o2_old_angles)
        let k20 = round(o1_intpower_2_to_16)
        let k16 = o0_w_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let r_eax = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        r_eax = k20
        if r_eax < 17.0 {
            if r_eax >= 1.0 {
            } else {
                r_eax = 2.0
            }
        } else {
            r_eax = 2.0
        }
        f0 = x
        m12 = f0
        f0 = y
        m20 = f0
        f0 = z
        m28 = f0
        f0 = w
        f0 = f0 + k16
        m36 = f0
        if k24 != 0.0 {
            f0 = cx
            f0 = f0 * f0
            f1 = cy
            f1 = f1 * f1
            f0 = f0 + f1
            f1 = cx
            f1 = f1 * f1
            f2 = cy
            f2 = f2 * f2
            f1 = f1 - f2
            f1 = f1 / f0
            m44 = f1
            f1 = cx
            f1 = f1 * cy
            f1 = f1 / f0
            m52 = f1
        } else {
            f0 = x
            f0 = f0 * f0
            f1 = y
            f1 = f1 * f1
            f0 = f0 + f1
            f1 = x
            f1 = f1 * f1
            f2 = y
            f2 = f2 * f2
            f1 = f1 - f2
            f1 = f1 / f0
            m44 = f1
            f1 = x
            f1 = f1 * y
            f1 = f1 / f0
            m52 = f1
        }
        r_eax = r_eax - 1.0
        loop {
            r_eax = r_eax - 1.0
            f0 = m12
            f0 = f0 * x
            f1 = m20
            f1 = f1 * y
            f0 = f0 - f1
            f1 = m44
            f1 = f1 * m28
            f1 = f1 * z
            f0 = f0 - f1
            f1 = m28
            f1 = f1 * w
            f2 = m36
            f2 = f2 * z
            f1 = f1 + f2
            f1 = f1 * m52
            f0 = f0 + f1
            f1 = m44
            f1 = f1 * m36
            f1 = f1 * w
            f0 = f0 + f1
            f1 = m12
            f1 = f1 * y
            f2 = m20
            f2 = f2 * x
            f1 = f1 + f2
            f2 = m52
            f2 = f2 * m28
            f2 = f2 * z
            f1 = f1 - f2
            f2 = m28
            f2 = f2 * w
            f3 = m36
            f3 = f3 * z
            f2 = f2 + f3
            f2 = f2 * m44
            f1 = f1 - f2
            f2 = m52
            f2 = f2 * m36
            f2 = f2 * w
            f1 = f1 + f2
            f2 = m12
            f2 = f2 * z
            f3 = m28
            f3 = f3 * x
            f2 = f2 + f3
            f3 = m20
            f3 = f3 * w
            f2 = f2 - f3
            f3 = m36
            f3 = f3 * y
            f2 = f2 - f3
            f3 = m12
            f3 = f3 * w
            f4 = m36
            f4 = f4 * x
            f3 = f3 + f4
            f4 = m20
            f4 = f4 * z
            f3 = f3 + f4
            f4 = m28
            f4 = f4 * y
            f3 = f3 + f4
            if r_eax <= 0.0 {
                break
            } else {
                m36 = f3
                m28 = f2
                m20 = f1
                m12 = f0
                continue
            }
        }
        f3 = f3 + cw
        w = f3
        f2 = f2 + cz
        z = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cx
        x = f0
    }
}

formula "PSphereIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula PSphereIFS. Pretty 3D 'surface' generated from the implicit expression of the tractrix. Similar to QCylinder."
    de difs
    alias "PSphereIFS"
    param o0_pseudo_radius "Pseudo Radius" = 3.0 [-3.0, 9.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_max_radius "Max Radius" = 2.85 [-2.85, 8.55] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_thickness "Thickness" = 0.001 [-1.999, 2.001] 
    param o8_min_radius "Min Radius" = 0.1 [-1.9, 2.1] 
    param o9_flip_xz_yz "Flip XZ / YZ" = 0.0 [-2.0, 2.0] int
    param o10_upside_down "Upside down" = 0.0 [-2.0, 2.0] int
    init {
        let k100 = round(o10_upside_down)
        let k96 = round(o9_flip_xz_yz)
        let k92 = o8_min_radius
        let k84 = o7_thickness
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_max_radius
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_pseudo_radius
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m54 = 0.0
        let m62 = 0.0
        let m70 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m70 = x0l
        m62 = x0h
        m54 = x1l
        if k96 != 1.0 {
        } else {
            f0 = m70
            f1 = m54
            m70 = f1
            m54 = f0
        }
        if k96 != (-1.0) {
        } else {
            f0 = m62
            f1 = m54
            m62 = f1
            m54 = f0
        }
        if k100 == 0.0 {
        } else {
            f0 = m54
            f0 = -f0
            m54 = f0
        }
        f0 = m70
        f0 = f0 * f0
        f1 = m62
        f1 = f1 * f1
