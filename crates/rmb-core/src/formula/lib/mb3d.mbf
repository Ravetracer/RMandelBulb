    de linear
    alias "AmazingBox2"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_min_r "Min R" = 0.5 [-1.5, 2.5] 
    param o2_fold "Fold" = 1.0 [-1.0, 3.0] 
