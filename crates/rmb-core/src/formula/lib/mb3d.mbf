    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f1 = z
        f2 = y
        f3 = f1
        f3 = abs(f3)
        f4 = f2
        f4 = abs(f4)
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f1
        ft = f2
        f2 = f0
        f0 = ft
        if fc_a < fc_b {
        } else {
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
        }
        f3 = f1
        f3 = f3 * f3
        f3 = f3 / rout
        f4 = 1.0
        f3 = f4 - f3
        f4 = f2
        f4 = f4 * f4
        f5 = f0
        f5 = f5 * f5
        f6 = f4
        f6 = f6 - f5
        f6 = f6 * f3
        f6 = f6 + cx
        x = f6
        f4 = f4 + f5
        f4 = sqrt(f4)
        f1 = f1 * f4
        f2 = f2 * f3
        f0 = f0 * f2
        f1 = f1 + f1
        f1 = f1 + cz
        z = f1
        f0 = f0 + f0
        f0 = f0 * k16
        f0 = f0 + cy
        y = f0
    }
}

formula "MsltoeSym4" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MsltoeSym4. A formula made by Msltoe at fractalforums.com, one iteration:"
    de numeric
    alias "MsltoeSym4"
    param o0_xz_sym_mul "XZ sym-mul" = 1.0 [-1.0, 3.0] 
    param o1_xy_sym_mul "XY sym-mul" = 1.0 [-1.0, 3.0] 
    param o2_yz_sym_mul "YZ sym-mul" = 1.0 [-1.0, 3.0] 
    init {
        let k20 = single(o2_yz_sym_mul)
        let k16 = single(o1_xy_sym_mul)
        let k12 = single(o0_xz_sym_mul)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f1 = z
        f2 = f1
        f2 = abs(f2)
        f2 = f2 * k12
        f3 = f0
        f3 = abs(f3)
        fc_a = f3
        fc_b = f2
        if fc_a > fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        f2 = y
        f3 = f2
        f3 = abs(f3)
        f3 = f3 * k16
        f4 = f0
        f4 = abs(f4)
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f3 = f1
        f3 = abs(f3)
        f3 = f3 * k20
        f4 = f1
        f4 = abs(f4)
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        f3 = f1
        f3 = f3 * f0
        fc_a = f3
        fc_b = 0.0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
        }
        f3 = f2
        f3 = f3 * f0
        fc_a = f3
        fc_b = 0.0
        if fc_a < fc_b {
        } else {
            f2 = -f2
        }
        f3 = f0
        f3 = f3 * f3
        f4 = f2
        f4 = f4 * f4
        f3 = f3 - f4
        f4 = f1
        f4 = f4 * f4
        f3 = f3 - f4
        f3 = f3 + cx
        x = f3
        f2 = f2 * f0
        f2 = f2 + f2
        f2 = f2 + cy
        y = f2
        f0 = f0 * f1
        f0 = f0 + f0
        f0 = f0 + cz
        z = f0
    }
}

formula "OctKoch" {
    category "MB3D 3D"
    description "Mandelbulb3D formula OctKoch. Octahedral version of the cute fractal I called 'MengerKochV2'. This has nothing to do with Menger though."
    de linear
    alias "OctKoch"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = -0.75 [-2.75, 1.25] 
    param o2_cscale_y "CScale Y" = 0.25 [-1.75, 2.25] 
    param o3_cscale_z "CScale Z" = 0.25 [-1.75, 2.25] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    param o10_fold_x "Fold X" = 1.0 [-1.0, 3.0] 
    param o11_sub_x "Sub X" = 2.0 [-2.0, 6.0] 
    param o12_do_abs_after_fold "Do Abs after Fold" = 0.0 [-2.0, 2.0] int
    init {
        let k132 = round(o12_do_abs_after_fold)
        let k128 = o11_sub_x
        let k120 = o10_fold_x
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        fc_a = z
        fc_b = 0.0
        z = abs(z)
        fc_a = y
        fc_b = 0.0
        y = abs(y)
        fc_a = x
        fc_b = 0.0
        x = abs(x)
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        fc_a = f2
        fc_b = f1
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        y = f2
        x = f1
        z = f0
        f0 = 1.0
        f0 = k16 - f0
        f0 = f0 * k128
        f1 = x
        f0 = f1 - f0
        x = f0
        f0 = 1.0
        f0 = k16 - f0
        f0 = f0 * k120
        f1 = x
        f1 = f1 + f0
        f1 = abs(f1)
        f2 = x
        f2 = f2 - f0
        f2 = abs(f2)
        f2 = -f2
        f2 = f2 - x
        f1 = f1 + f2
        if k132 == 0.0 {
        } else {
            f1 = abs(f1)
        }
        x = f1
        f0 = z
        f1 = x
        f2 = y
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f3 = f1
        f3 = f3 * k104
        f4 = f2
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f1
        f4 = f4 * k80
        f5 = f2
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k96
        f2 = f2 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f2 = f2 + f3
        f3 = k16
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f5 = f4
        f5 = f5 * k24
        f1 = f1 - f5
        f4 = f4 * k32
        f2 = f2 - f4
        f3 = f3 * k40
        f0 = f0 - f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        y = f2
        x = f1
        z = f0
    }
}

formula "OctaFullIFS" {
    category "MB3D 3D"
    description "Mandelbulb3D formula OctaFullIFS. "
    de linear
    alias "OctaFullIFS"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 0.0 [-2.0, 2.0] 
    param o3_cscale_z "CScale Z" = 0.0 [-2.0, 2.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
