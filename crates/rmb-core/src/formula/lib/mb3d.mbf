        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let m16 = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        f3 = f1
        f4 = f2
        f3 = atan2(f3, f4)
        f3 = k80 - f3
        f3 = f3 * 0.159154943
        f3 = f3 * k72
        f3 = round(f3)
        m16 = round(f3)
        r_edx = m16
        f3 = f3 / k72
        f3 = f3 * 6.283185307
        f4 = cos(f3)
        f3 = sin(f3)
        f5 = f1
        f5 = f5 * f4
        f6 = f2
        f6 = f6 * f3
        f5 = f5 + f6
        r_edx = (r_edx - 2.0 * floor(r_edx / 2.0))
        if r_edx != 0.0 {
        } else {
