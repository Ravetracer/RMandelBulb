formula "JITBenesiPineTree" {
    category "MB3D 3D"
    description "Mandelbulb3D formula JITBenesiPineTree. "
    de numeric
    alias "JITBenesiPineTree"
    param o0_offset "Offset" = 2.0 [-2.0, 6.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    iter {
        let v_temp_x = 0.0
        let v_temp_y = 0.0
        let v_temp_z = 0.0
        let v_temp = 0.0
        let v_new_x = 0.0
        let v_new_y = 0.0
        let v_new_z = 0.0
        let v_x_temp = 0.0
        let v_y_temp = 0.0
        let v_z_temp = 0.0
        v_temp_x = ((x * 0.816496580927726) - (z * 0.577350269189626))
        v_new_z = ((x * 0.577350269189626) + (z * 0.816496580927726))
        v_new_x = (((v_temp_x - y)) * 0.707106781186548)
        v_new_y = (((v_temp_x + y)) * 0.707106781186548)
        v_new_x = abs(v_new_x)
        v_new_y = abs(v_new_y)
        v_new_z = abs(v_new_z)
        v_temp_x = (((v_new_x + v_new_y)) * 0.707106781186548)
        v_new_y = ((((-v_new_x) + v_new_y)) * 0.707106781186548)
        v_new_x = ((v_temp_x * 0.816496580927726) + (v_new_z * 0.577350269189626))
        v_new_z = (((-v_temp_x) * 0.577350269189626) + (v_new_z * 0.816496580927726))
        x = ((o1_scale * v_new_x) - o0_offset)
        y = (o1_scale * v_new_y)
        z = (o1_scale * v_new_z)
        v_x_temp = (x * x)
        v_y_temp = (y * y)
        v_z_temp = (z * z)
        v_temp = (((x + x)) / sqrt((v_y_temp + v_z_temp)))
        v_new_x = ((v_x_temp - v_y_temp) - v_z_temp)
        v_new_z = (v_temp * ((v_y_temp - v_z_temp)))
        v_new_y = (((v_temp * 2.0) * y) * z)
        x = (v_new_x + cx)
        y = v_new_y
        z = v_new_z
    }
}

