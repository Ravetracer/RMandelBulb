formula "PolyFold-symIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula PolyFold-symIFS. Poly fold reflects objects belonging to a quadrant to all other quadrants."
    de difs
    transform
    alias "PolyFold-symIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
