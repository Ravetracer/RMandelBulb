                f0 = 0.0
                x = f0
                y = f0
                m36 = f0
                m44 = f0
                f0 = z
                m52 = f0
                a1 = a1 + 1.0
            }
        }
        f0 = m36
        f1 = cx
        f1 = f1 * k24
        f0 = f0 + f1
        f1 = k40
        f0 = f0 + f1
        m36 = f0
        f0 = m44
        f1 = cy
        f1 = f1 * k24
        f0 = f0 + f1
        m44 = f0
        f0 = m52
        f1 = cz
        f1 = f1 * k24
        f0 = f0 + f1
        m52 = f0
        f0 = x
        f0 = f0 * 2.0
        f1 = k40
        f2 = 1.0
        f2 = -f2
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = cx
        f1 = f1 * k32
        f0 = f0 + f1
        m60 = f0
        f0 = y
        f0 = f0 * 2.0
        f1 = cy
