        let k24 = single(sin(o0_rotate_x * pi / 180.0) * sin(o1_rotate_y * pi / 180.0) * cos(o2_rotate_z * pi / 180.0) + cos(o0_rotate_x * pi / 180.0) * sin(o2_rotate_z * pi / 180.0))
