formula "BPine_only" {
    category "MB3D 3D"
    description "Mandelbulb3D formula BPine_only. Change pixel components around if you want.  Using just the x pixel component (pixel_y=0 and pixel_z=0) works well in combination with the various transforms (transform 1 through 5b...) and some of th"
    de numeric
    alias "BPine_only"
    param o0_pixel_x "pixel_x" = 1.0 [-1.0, 3.0] 
    param o1_pixel_y "pixel_y" = 1.0 [-1.0, 3.0] 
    param o2_pixel_z "pixel_z" = 1.0 [-1.0, 3.0] 
    init {
        let k32 = o2_pixel_z
        let k24 = o1_pixel_y
        let k16 = o0_pixel_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = x
        f0 = f0 * f0
        m12 = f0
        f0 = y
        f0 = f0 * f0
        m20 = f0
        f0 = z
        f0 = f0 * f0
        m28 = f0
        f0 = x
        f0 = f0 + f0
        f1 = m20
        f1 = f1 + m28
        f1 = sqrt(f1)
        f0 = f0 / f1
        m36 = f0
        f0 = m12
        f0 = f0 - m20
        f0 = f0 - m28
        f1 = m36
        f2 = m20
        f2 = f2 - m28
        f1 = f1 * f2
