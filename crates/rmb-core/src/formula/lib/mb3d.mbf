        f2 = f2 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "Sierpinski4" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Sierpinski4. Thanks a lot (I mean a lot) to Syntopia for this formula."
    de linear
    descale 1.1
    alias "Sierpinski4"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_cscale_w "CScale W" = 1.0 [-1.0, 3.0] 
    param o5_rotation_yz "Rotation YZ" = 0.0 [-180.0, 180.0] angle
    param o6_rotation_xz "Rotation XZ" = 0.0 [-180.0, 180.0] angle
    param o7_rotation_xy "Rotation XY" = 0.0 [-180.0, 180.0] angle
    param o8_rotation_xw "Rotation XW" = 0.0 [-180.0, 180.0] angle
    param o9_rotation_yw "Rotation YW" = 0.0 [-180.0, 180.0] angle
    param o10_rotation_zw "Rotation ZW" = 0.0 [-180.0, 180.0] angle
    init {
        let q5_0_00 = 1.0
        let q5_0_01 = 0.0
        let q5_0_02 = 0.0
        let q5_0_03 = 0.0
        let q5_0_10 = 0.0
        let q5_0_11 = (cos(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_12 = (-sin(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_13 = 0.0
        let q5_0_20 = 0.0
        let q5_0_21 = (sin(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_22 = (cos(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_23 = 0.0
        let q5_0_30 = 0.0
        let q5_0_31 = 0.0
        let q5_0_32 = 0.0
        let q5_0_33 = 1.0
        let q5_1_00 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_00 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_20
        let q5_1_01 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_01 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_21
        let q5_1_02 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_02 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_22
        let q5_1_03 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_03 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_23
        let q5_1_10 = q5_0_10
        let q5_1_11 = q5_0_11
        let q5_1_12 = q5_0_12
        let q5_1_13 = q5_0_13
        let q5_1_20 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_00 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_20
        let q5_1_21 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_01 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_21
        let q5_1_22 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_02 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_22
        let q5_1_23 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_03 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_23
        let q5_1_30 = q5_0_30
        let q5_1_31 = q5_0_31
        let q5_1_32 = q5_0_32
        let q5_1_33 = q5_0_33
        let q5_2_00 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_00 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_10
        let q5_2_01 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_01 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_11
        let q5_2_02 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_02 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_12
        let q5_2_03 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_03 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_13
        let q5_2_10 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_00 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_10
        let q5_2_11 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_01 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_11
        let q5_2_12 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_02 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_12
        let q5_2_13 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_03 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_13
        let q5_2_20 = q5_1_20
        let q5_2_21 = q5_1_21
        let q5_2_22 = q5_1_22
        let q5_2_23 = q5_1_23
        let q5_2_30 = q5_1_30
        let q5_2_31 = q5_1_31
        let q5_2_32 = q5_1_32
        let q5_2_33 = q5_1_33
        let q5_3_00 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_00 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_30
        let q5_3_01 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_01 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_31
        let q5_3_02 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_02 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_32
        let q5_3_03 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_03 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_33
        let q5_3_10 = q5_2_10
        let q5_3_11 = q5_2_11
        let q5_3_12 = q5_2_12
        let q5_3_13 = q5_2_13
        let q5_3_20 = q5_2_20
        let q5_3_21 = q5_2_21
        let q5_3_22 = q5_2_22
        let q5_3_23 = q5_2_23
        let q5_3_30 = (sin(o8_rotation_xw * pi / 180.0)) * q5_2_00 + (cos(o8_rotation_xw * pi / 180.0)) * q5_2_30
        let q5_3_31 = (sin(o8_rotation_xw * pi / 180.0)) * q5_2_01 + (cos(o8_rotation_xw * pi / 180.0)) * q5_2_31
        let q5_3_32 = (sin(o8_rotation_xw * pi / 180.0)) * q5_2_02 + (cos(o8_rotation_xw * pi / 180.0)) * q5_2_32
        let q5_3_33 = (sin(o8_rotation_xw * pi / 180.0)) * q5_2_03 + (cos(o8_rotation_xw * pi / 180.0)) * q5_2_33
        let q5_4_00 = q5_3_00
        let q5_4_01 = q5_3_01
        let q5_4_02 = q5_3_02
        let q5_4_03 = q5_3_03
        let q5_4_10 = (cos(o9_rotation_yw * pi / 180.0)) * q5_3_10 + (-sin(o9_rotation_yw * pi / 180.0)) * q5_3_30
        let q5_4_11 = (cos(o9_rotation_yw * pi / 180.0)) * q5_3_11 + (-sin(o9_rotation_yw * pi / 180.0)) * q5_3_31
        let q5_4_12 = (cos(o9_rotation_yw * pi / 180.0)) * q5_3_12 + (-sin(o9_rotation_yw * pi / 180.0)) * q5_3_32
        let q5_4_13 = (cos(o9_rotation_yw * pi / 180.0)) * q5_3_13 + (-sin(o9_rotation_yw * pi / 180.0)) * q5_3_33
        let q5_4_20 = q5_3_20
        let q5_4_21 = q5_3_21
        let q5_4_22 = q5_3_22
        let q5_4_23 = q5_3_23
        let q5_4_30 = (sin(o9_rotation_yw * pi / 180.0)) * q5_3_10 + (cos(o9_rotation_yw * pi / 180.0)) * q5_3_30
        let q5_4_31 = (sin(o9_rotation_yw * pi / 180.0)) * q5_3_11 + (cos(o9_rotation_yw * pi / 180.0)) * q5_3_31
        let q5_4_32 = (sin(o9_rotation_yw * pi / 180.0)) * q5_3_12 + (cos(o9_rotation_yw * pi / 180.0)) * q5_3_32
        let q5_4_33 = (sin(o9_rotation_yw * pi / 180.0)) * q5_3_13 + (cos(o9_rotation_yw * pi / 180.0)) * q5_3_33
        let q5_5_00 = q5_4_00
        let q5_5_01 = q5_4_01
        let q5_5_02 = q5_4_02
        let q5_5_03 = q5_4_03
        let q5_5_10 = q5_4_10
        let q5_5_11 = q5_4_11
        let q5_5_12 = q5_4_12
        let q5_5_13 = q5_4_13
        let q5_5_20 = (cos(o10_rotation_zw * pi / 180.0)) * q5_4_20 + (-sin(o10_rotation_zw * pi / 180.0)) * q5_4_30
        let q5_5_21 = (cos(o10_rotation_zw * pi / 180.0)) * q5_4_21 + (-sin(o10_rotation_zw * pi / 180.0)) * q5_4_31
        let q5_5_22 = (cos(o10_rotation_zw * pi / 180.0)) * q5_4_22 + (-sin(o10_rotation_zw * pi / 180.0)) * q5_4_32
        let q5_5_23 = (cos(o10_rotation_zw * pi / 180.0)) * q5_4_23 + (-sin(o10_rotation_zw * pi / 180.0)) * q5_4_33
        let q5_5_30 = (sin(o10_rotation_zw * pi / 180.0)) * q5_4_20 + (cos(o10_rotation_zw * pi / 180.0)) * q5_4_30
        let q5_5_31 = (sin(o10_rotation_zw * pi / 180.0)) * q5_4_21 + (cos(o10_rotation_zw * pi / 180.0)) * q5_4_31
        let q5_5_32 = (sin(o10_rotation_zw * pi / 180.0)) * q5_4_22 + (cos(o10_rotation_zw * pi / 180.0)) * q5_4_32
        let q5_5_33 = (sin(o10_rotation_zw * pi / 180.0)) * q5_4_23 + (cos(o10_rotation_zw * pi / 180.0)) * q5_4_33
        let k112 = single(q5_5_33)
        let k108 = single(q5_5_32)
        let k104 = single(q5_5_31)
        let k100 = single(q5_5_30)
        let k96 = single(q5_5_23)
        let k92 = single(q5_5_22)
        let k88 = single(q5_5_21)
        let k84 = single(q5_5_20)
        let k80 = single(q5_5_13)
        let k76 = single(q5_5_12)
        let k72 = single(q5_5_11)
        let k68 = single(q5_5_10)
        let k64 = single(q5_5_03)
        let k60 = single(q5_5_02)
        let k56 = single(q5_5_01)
        let k52 = single(q5_5_00)
        let k48 = o4_cscale_w
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = w
        f1 = z
        f2 = y
        f3 = x
        f3 = -f3
        fc_a = f3
        fc_b = f2
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f2
            f2 = ft
        }
        fc_a = f3
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f1
            f1 = ft
        }
        f3 = -f3
        ft = f3
        f3 = f2
        f2 = ft
        f3 = -f3
        fc_a = f3
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f1
            f1 = ft
        }
        f3 = -f3
        ft = f3
        f3 = f2
        f2 = ft
        f3 = -f3
        fc_a = f3
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f0
            f0 = ft
        }
        f3 = -f3
        ft = f3
        f3 = f2
        f2 = ft
        f3 = -f3
        fc_a = f3
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f0
            f0 = ft
        }
        f3 = -f3
        ft = f3
        f3 = f2
        f2 = ft
        ft = f3
        f3 = f1
        f1 = ft
        f3 = -f3
        fc_a = f3
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f0
            f0 = ft
        }
        f3 = -f3
        ft = f3
        f3 = f1
        f1 = ft
        f4 = f3
        f4 = f4 * k52
        f5 = f2
        f5 = f5 * k56
        f4 = f4 + f5
        f5 = f1
        f5 = f5 * k60
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k64
        f4 = f4 + f5
        x = f4
        f4 = f3
        f4 = f4 * k68
        f5 = f2
        f5 = f5 * k72
        f4 = f4 + f5
        f5 = f1
        f5 = f5 * k76
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k80
        f4 = f4 + f5
        y = f4
        f4 = f3
        f4 = f4 * k84
        f5 = f2
        f5 = f5 * k88
        f4 = f4 + f5
        f5 = f1
        f5 = f5 * k92
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k96
        f4 = f4 + f5
        z = f4
        f3 = f3 * k100
        ft = f3
        f3 = f2
        f2 = ft
        f3 = f3 * k104
        f2 = f2 + f3
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * k108
        f1 = f1 + f2
        ft = f1
        f1 = f0
        f0 = ft
        f1 = f1 * k112
        f0 = f0 + f1
        w = f0
        f0 = w
        f1 = z
        f2 = y
        f3 = x
        f4 = k16
        f5 = f4
        f5 = f5 * dr
        dr = f5
        f0 = f0 * f4
        f1 = f1 * f4
        f2 = f2 * f4
        f3 = f3 * f4
        f5 = 1.0
        f4 = f4 - f5
        f4 = -f4
        f5 = k24
        f5 = f5 * f4
        f5 = f5 + f3
        x = f5
        f5 = k32
        f5 = f5 * f4
        f5 = f5 + f2
        y = f5
        f5 = k40
        f5 = f5 * f4
        f5 = f5 + f1
        z = f5
        f5 = k48
        f5 = f5 * f4
        f5 = f5 + f0
        w = f5
    }
}

formula "Sierpinski4ex" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Sierpinski4ex. NOTES: See Sierpinski4."
    de linear
    descale 1.1
    alias "Sierpinski4ex"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_cscale_w "CScale W" = 1.0 [-1.0, 3.0] 
    param o5_rotation_yz "Rotation YZ" = 0.0 [-180.0, 180.0] angle
    param o6_rotation_xz "Rotation XZ" = 0.0 [-180.0, 180.0] angle
    param o7_rotation_xy "Rotation XY" = 0.0 [-180.0, 180.0] angle
    param o8_rotation_xw "Rotation XW" = 0.0 [-180.0, 180.0] angle
    param o9_rotation_yw "Rotation YW" = 0.0 [-180.0, 180.0] angle
    param o10_rotation_zw "Rotation ZW" = 0.0 [-180.0, 180.0] angle
    param o11_rot_x_off "Rot X-off" = 0.5 [-1.5, 2.5] 
    param o12_rot_y_off "Rot Y-off" = 0.5 [-1.5, 2.5] 
    param o13_rot_z_off "Rot Z-off" = 0.5 [-1.5, 2.5] 
    param o14_rot_w_off "Rot W-off" = 0.5 [-1.5, 2.5] 
    init {
        let q5_0_00 = 1.0
        let q5_0_01 = 0.0
        let q5_0_02 = 0.0
        let q5_0_03 = 0.0
        let q5_0_10 = 0.0
        let q5_0_11 = (cos(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_12 = (-sin(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_13 = 0.0
        let q5_0_20 = 0.0
        let q5_0_21 = (sin(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_22 = (cos(o5_rotation_yz * pi / 180.0)) * 1.0
        let q5_0_23 = 0.0
        let q5_0_30 = 0.0
        let q5_0_31 = 0.0
        let q5_0_32 = 0.0
        let q5_0_33 = 1.0
        let q5_1_00 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_00 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_20
        let q5_1_01 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_01 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_21
        let q5_1_02 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_02 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_22
        let q5_1_03 = (cos(o6_rotation_xz * pi / 180.0)) * q5_0_03 + (-sin(o6_rotation_xz * pi / 180.0)) * q5_0_23
        let q5_1_10 = q5_0_10
        let q5_1_11 = q5_0_11
        let q5_1_12 = q5_0_12
        let q5_1_13 = q5_0_13
        let q5_1_20 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_00 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_20
        let q5_1_21 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_01 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_21
        let q5_1_22 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_02 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_22
        let q5_1_23 = (sin(o6_rotation_xz * pi / 180.0)) * q5_0_03 + (cos(o6_rotation_xz * pi / 180.0)) * q5_0_23
        let q5_1_30 = q5_0_30
        let q5_1_31 = q5_0_31
        let q5_1_32 = q5_0_32
        let q5_1_33 = q5_0_33
        let q5_2_00 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_00 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_10
        let q5_2_01 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_01 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_11
        let q5_2_02 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_02 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_12
        let q5_2_03 = (cos(o7_rotation_xy * pi / 180.0)) * q5_1_03 + (-sin(o7_rotation_xy * pi / 180.0)) * q5_1_13
        let q5_2_10 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_00 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_10
        let q5_2_11 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_01 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_11
        let q5_2_12 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_02 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_12
        let q5_2_13 = (sin(o7_rotation_xy * pi / 180.0)) * q5_1_03 + (cos(o7_rotation_xy * pi / 180.0)) * q5_1_13
        let q5_2_20 = q5_1_20
        let q5_2_21 = q5_1_21
        let q5_2_22 = q5_1_22
        let q5_2_23 = q5_1_23
        let q5_2_30 = q5_1_30
        let q5_2_31 = q5_1_31
        let q5_2_32 = q5_1_32
        let q5_2_33 = q5_1_33
        let q5_3_00 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_00 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_30
        let q5_3_01 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_01 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_31
        let q5_3_02 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_02 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_32
        let q5_3_03 = (cos(o8_rotation_xw * pi / 180.0)) * q5_2_03 + (-sin(o8_rotation_xw * pi / 180.0)) * q5_2_33
        let q5_3_10 = q5_2_10
        let q5_3_11 = q5_2_11
        let q5_3_12 = q5_2_12
        let q5_3_13 = q5_2_13
        let q5_3_20 = q5_2_20
        let q5_3_21 = q5_2_21
        let q5_3_22 = q5_2_22
        let q5_3_23 = q5_2_23
