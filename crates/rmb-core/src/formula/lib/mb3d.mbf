        cy = f2
        cz = f1
        cw = f0
    }
}

formula "_vanderpol" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _vanderpol. Van der Pol modified chaotic system in 4D - variation with six parameters and strength"
    de numeric
    transform
    alias "_vanderpol"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 2.0 [-2.0, 6.0] 
    param o2_beta "Beta" = 0.6 [-1.4, 2.6] 
    param o3_gamma "Gamma" = 0.1 [-1.9, 2.1] 
    param o4_delta "Delta" = 0.4 [-1.6, 2.4] 
    param o5_phi "Phi" = 2.0 [-2.0, 6.0] 
    param o6_r1 "r1" = 1.4 [-1.4, 4.199999999999999] 
    param o7_r2 "r2" = 1.4 [-1.4, 4.199999999999999] 
    init {
        let k72 = o7_r2
        let k64 = o6_r1
        let k56 = o5_phi
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * k32
        f0 = f0 + z
        f0 = f0 * k16
        f1 = y
        f1 = f1 * k32
        f1 = f1 + dr
        f1 = f1 * k16
        f2 = y
        f2 = f2 * k40
        f3 = x
        f3 = f3 * k48
        f3 = -f3
        f2 = f2 + f3
        f3 = x
        f3 = f3 * f3
        f3 = -f3
        f3 = f3 * k64
        f3 = f3 + k56
        f3 = f3 * z
        f2 = f2 + f3
        f3 = x
        f3 = f3 * k40
        f4 = y
        f4 = f4 * k48
        f4 = -f4
        f3 = f3 + f4
        f4 = y
        f4 = f4 * f4
        f4 = -f4
        f4 = f4 * k72
        f4 = f4 + k24
        f4 = f4 * dr
        f3 = f3 + f4
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "_vanderpol2" {
    category "MB3D transforms"
