    param o1_min_r "Min R" = 0.5 [-1.5, 2.5] 
    param o2_fold "Fold" = 1.0 [-1.0, 3.0] 
    param o3_scale_vary "Scale vary" = 0.0 [-2.0, 2.0] 
    param o4_sharpness_integer_2 "Sharpness (Integer 2+)" = 6.0 [-6.0, 18.0] int
    param o5_fix_boxfold "Fix (BoxFold)" = 1.0 [-1.0, 3.0] 
