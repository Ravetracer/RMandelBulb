formula "_Abs4d" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _Abs4d. Takes the absolute values of all 4 vector components:"
    de numeric
    transform
    alias "_Abs4d"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = dr
        f1 = z
        f2 = y
        f3 = x
        f3 = abs(f3)
        x = f3
        f2 = abs(f2)
        y = f2
        f1 = abs(f1)
        z = f1
        f0 = abs(f0)
        dr = f0
    }
}

