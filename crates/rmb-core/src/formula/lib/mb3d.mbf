        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k32
        f1 = f1 + f3
        ft = f2
        f2 = f1
        f1 = ft
        f2 = abs(f2)
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f2
        f3 = f3 * 0.309016994374947
        f4 = f1
        f4 = f4 * (-0.5)
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * (-0.809016994374947)
