        f2 = cy
        f3 = cx
        f4 = f3
        f4 = f4 + f2
        f4 = f4 + f1
        f4 = abs(f4)
        f4 = f4 * k24
        f4 = f4 + f0
        cx = f4
        f4 = f1
        f4 = f4 - f3
        f4 = f4 - f2
        f4 = abs(f4)
        f4 = f4 * k24
