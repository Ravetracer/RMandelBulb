    }
}

formula "PseudoXDB" {
    category "MB3D 3D"
    description "Mandelbulb3D formula PseudoXDB. AbsZ + CosinePow2 involves in a set very similar to the one known as 'XenoDream's variation'."
    de numeric
    alias "PseudoXDB"
    param o0_z_multiplier "Z multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k16 = o0_z_multiplier
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let ft = 0.0
        f0 = y
        f0 = f0 * y
        f1 = x
        f1 = f1 * x
        f2 = f1
        f2 = f2 + f0
        f3 = z
        f3 = abs(f3)
        f4 = f3
        f4 = f4 * f4
        f4 = f4 - f2
        f4 = f4 * k16
        f4 = f4 + cz
        z = f4
        f3 = f3 + f3
        ft = f3
        f3 = f2
        f2 = ft
        f3 = sqrt(f3)
        f2 = f2 / f3
        f3 = f2
        f3 = f3 * x
        f3 = f3 * y
        f3 = f3 + f3
        f3 = f3 + cy
        y = f3
        ft = f2
        f2 = f1
        f1 = ft
        f0 = f2 - f0
        f0 = f0 * f1
        f0 = f0 + cx
        x = f0
    }
}

formula "Quad3Db" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Quad3Db. Quadratic 3D plus variations (optional), that may transform the fractal into"
    de numeric
    alias "Quad3Db"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = 2.0 [-2.0, 6.0] 
    param o3_hradius "HRadius" = 0.0 [-2.0, 2.0] 
    param o4_zradius "ZRadius" = 1.0 [-1.0, 3.0] 
    param o5_variants_0_63 "Variants (0...63)" = 40.0 [-40.0, 120.0] int
    init {
        let k52 = round(o5_variants_0_63)
        let k48 = o4_zradius
        let k40 = o3_hradius
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = k40
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = 0.0
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
            f1 = 0.0
            f2 = 0.0
            f3 = 0.0
        } else {
            if fc_a == fc_b {
                f1 = cx
                f2 = cy
                f3 = cz
            } else {
                f1 = x
                f1 = f1 * f1
                f2 = y
                f2 = f2 * f2
                f2 = -f2
                f1 = f1 + f2
                f1 = f1 * k16
                f2 = k48
                f3 = z
                f3 = f3 * f3
                f3 = f3 / f0
                f3 = -f3
                f2 = f2 + f3
                f1 = f1 * f2
                r_eax = k52
                r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
                if r_eax != 0.0 {
                    if r_eax != 1.0 {
                        if r_eax != 2.0 {
                            f1 = f1 + cx
                        } else {
                            f2 = f1
                            f2 = f2 + cx
                            f2 = abs(f2)
                            f3 = f1
                            f3 = f3 - cx
                            f3 = abs(f3)
                            ft = f3
                            f3 = f2
                            f2 = ft
                            f2 = f3 - f2
                            ft = f2
                            f2 = f1
                            f1 = ft
                            f2 = -f2
                            f1 = f1 + f2
                        }
                    } else {
                        f1 = f1 + cx
                        f1 = abs(f1)
                    }
                } else {
                    f1 = abs(f1)
                    f1 = f1 + cx
                }
                f2 = x
                f2 = f2 * y
                f2 = f2 * k24
                f3 = k48
                f4 = z
                f4 = f4 * f4
                f4 = f4 / f0
                f4 = -f4
                f3 = f3 + f4
                f2 = f2 * f3
                r_eax = k52
                r_eax = floor(r_eax / 4.0)
                r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
                if r_eax != 0.0 {
                    if r_eax != 1.0 {
                        if r_eax != 2.0 {
                            f2 = f2 + cy
                        } else {
                            f3 = f2
                            f3 = f3 + cy
                            f3 = abs(f3)
                            f4 = f2
                            f4 = f4 - cy
                            f4 = abs(f4)
                            ft = f4
                            f4 = f3
                            f3 = ft
                            f3 = f4 - f3
                            ft = f3
                            f3 = f2
                            f2 = ft
                            f3 = -f3
                            f2 = f2 + f3
                        }
                    } else {
                        f2 = f2 + cy
                        f2 = abs(f2)
                    }
                } else {
                    f2 = abs(f2)
                    f2 = f2 + cy
                }
                f3 = z
                f4 = f0
                f4 = sqrt(f4)
                f3 = f3 * f4
                f3 = f3 * k32
                r_eax = k52
                r_eax = floor(r_eax / 16.0)
                r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
                if r_eax != 0.0 {
                    if r_eax != 1.0 {
                        if r_eax != 2.0 {
                            f3 = f3 + cz
                        } else {
                            f4 = f3
                            f4 = f4 + cz
                            f4 = abs(f4)
                            f5 = f3
                            f5 = f5 - cz
                            f5 = abs(f5)
                            ft = f5
                            f5 = f4
                            f4 = ft
                            f4 = f5 - f4
                            ft = f4
                            f4 = f3
                            f3 = ft
                            f4 = -f4
                            f3 = f3 + f4
                        }
                    } else {
                        f3 = f3 + cz
                        f3 = abs(f3)
                    }
                } else {
                    f3 = abs(f3)
                    f3 = f3 + cz
                }
            }
        }
        z = f3
        y = f2
        x = f1
    }
}

formula "Quadrat3D" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Quadrat3D. Found on http://bugman123.com/Hypercomplex/index.html"
    de numeric
    alias "Quadrat3D"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = -2.0 [-6.0, 2.0] 
    param o3_hradius "HRadius" = 0.0 [-2.0, 2.0] 
    param o4_zradius "ZRadius" = 1.0 [-1.0, 3.0] 
    init {
        let k48 = o4_zradius
        let k40 = o3_hradius
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = k40
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = 0.0
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
            f1 = 0.0
            f2 = 0.0
            f3 = 0.0
        } else {
            if fc_a == fc_b {
                f1 = cx
                f2 = cy
                f3 = cz
            } else {
                f1 = x
                f1 = f1 * f1
                f2 = y
                f2 = f2 * f2
                f2 = -f2
                f1 = f1 + f2
                f1 = f1 * k16
                f2 = k48
                f3 = z
                f3 = f3 * f3
                f3 = f3 / f0
                f3 = -f3
                f2 = f2 + f3
                f1 = f1 * f2
                f1 = f1 + cx
                f2 = x
                f2 = f2 * y
                f2 = f2 * k24
                f3 = k48
                f4 = z
                f4 = f4 * f4
                f4 = f4 / f0
                f4 = -f4
                f3 = f3 + f4
                f2 = f2 * f3
                f2 = f2 + cy
                f3 = z
                f4 = f0
                f4 = sqrt(f4)
                f3 = f3 * f4
                f3 = f3 * k32
                f3 = f3 + cz
            }
        }
        z = f3
        y = f2
        x = f1
    }
}

