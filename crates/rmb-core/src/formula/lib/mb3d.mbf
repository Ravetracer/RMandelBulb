            f0 = z
            f1 = f0
            f1 = f1 * f1
            f1 = -f1
            f2 = 1.0
            f1 = f1 + f2
            f1 = sqrt(f1)
        }
        f2 = x
        f2 = f2 * k32
        f3 = y
        f3 = f3 * k40
        f2 = f2 + f3
        f3 = x
        f3 = f3 * f3
        f3 = f3 * k48
        f2 = f2 + f3
        f3 = y
        f3 = f3 * f3
        f3 = f3 * k56
        f2 = f2 + f3
        f3 = x
        f3 = f3 * y
        f3 = f3 * k64
        f2 = f2 + f3
        f3 = x
        f3 = f3 * f3
        f4 = y
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        f3 = f3 * k72
        f2 = f2 + f3
        f2 = f2 * f0
        f3 = x
        f3 = f3 * k80
        f4 = y
        f4 = f4 * k88
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f4
        f4 = f4 * k96
        f3 = f3 + f4
        f4 = y
        f4 = f4 * f4
        f4 = f4 * k104
        f3 = f3 + f4
        f4 = x
        f4 = f4 * y
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f4
        f5 = y
        f5 = f5 * f5
        f4 = f4 + f5
        f4 = sqrt(f4)
        f4 = f4 * k120
        f3 = f3 + f4
        f3 = f3 * f1
        f2 = f2 + f3
        f3 = x
        f3 = f3 * k32
        f4 = y
        f4 = f4 * k40
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f4
        f4 = f4 * k48
        f3 = f3 + f4
        f4 = y
        f4 = f4 * f4
        f4 = f4 * k56
        f3 = f3 + f4
        f4 = x
        f4 = f4 * y
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f4
        f5 = y
        f5 = f5 * f5
        f4 = f4 + f5
        f4 = sqrt(f4)
        f4 = f4 * k72
        f3 = f3 + f4
        f3 = f3 * f1
        f4 = x
        f4 = f4 * k80
        f5 = y
        f5 = f5 * k88
        f4 = f4 + f5
        f5 = x
