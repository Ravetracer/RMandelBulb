formula "_PartlyJuliaRoff" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _PartlyJuliaRoff. A pretransform to disable the julia mode outside a spheres radius."
    de numeric
    transform
    alias "_PartlyJuliaRoff"
    param o0_x_sphere "X sphere" = 0.0 [-2.0, 2.0] 
    param o1_y_sphere "Y sphere" = 0.0 [-2.0, 2.0] 
    param o2_z_sphere "Z sphere" = 0.0 [-2.0, 2.0] 
    param o3_radius_sphere "Radius sphere" = 0.0 [-2.0, 2.0] 
    init {
        let k40 = o3_radius_sphere
        let k32 = o2_z_sphere
        let k24 = o1_y_sphere
        let k16 = o0_x_sphere
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = px
        f0 = f0 - k16
        f1 = py
        f1 = f1 - k24
        f2 = pz
        f2 = f2 - k32
        f3 = f0
        f3 = f3 * f3
        f4 = f1
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        fc_a = f3
        fc_b = k40
        if fc_a <= fc_b {
            fc_a = f3
            fc_b = f2
            fc_a = f1
            fc_b = f0
        } else {
            f4 = f3
            f4 = f4 - k40
            f5 = f3
            f5 = abs(f5)
            fc_a = f5
            fc_b = 1e-10
            if fc_a > fc_b {
            } else {
                ft = f4
                f4 = f3
                f3 = ft
                f5 = 0.0
                fc_a = f5
                fc_b = f4
                f4 = 1e-10
                if fc_a <= fc_b {
                } else {
                    f4 = -f4
                }
                ft = f4
                f4 = f3
                f3 = ft
            }
            f3 = f4 / f3
            f0 = f0 * f3
            f1 = f1 * f3
            f2 = f2 * f3
            f2 = f2 + cz
            cz = f2
            f1 = f1 + cy
            cy = f1
            f0 = f0 + cx
            cx = f0
        }
    }
}

formula "_PolyFold-sym" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _PolyFold-sym. Useful to get symmetric poly and star effects. Sym because on even orders it is a continue symmetrical transform."
    de numeric
    transform
    alias "_PolyFold-sym"
    param o0_order "Order" = 4.0 [-4.0, 12.0] 
    param o1_shift_deg "Shift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_shift_x "Shift x" = 0.0 [-2.0, 2.0] 
    param o3_shift_y "Shift y" = 0.0 [-2.0, 2.0] 
    param o4_skew_deg "Skew (deg)" = 0.0 [-2.0, 2.0] 
    init {
        let k48 = o4_skew_deg
        let k40 = o3_shift_y
        let k32 = o2_shift_x
        let k24 = o1_shift_deg
        let k16 = o0_order
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let r_eax = 0.0
        let m32 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k48
        f1 = f1 + k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m32 = round(f0)
        f0 = m32
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f2 = f2 * f1
        f3 = y
        f3 = f3 * f0
        f2 = f3 - f2
        f3 = x
        f3 = f3 * f0
        f4 = y
        f4 = f4 * f1
        f3 = f3 + f4
        r_eax = m32
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax != 0.0 {
        } else {
            f3 = -f3
        }
        f3 = f3 - k40
        y = f3
        f2 = f2 - k32
        x = f2
    }
}

