        f0 = f0 + f1
        f1 = z
        f1 = f1 * k32
        f0 = f0 + f1
        f1 = dr
        f1 = f1 * k40
        f0 = f0 + f1
        f0 = f0 * k16
        f1 = k48
        f1 = f1 * z
        f1 = f1 * dr
        f2 = k24
        f2 = f2 * x
        f2 = -f2
        f1 = f1 + f2
        f2 = x
        f2 = f2 * f2
        f2 = -f2
        f2 = f2 * k80
        f2 = f2 + k24
        f2 = f2 * y
        f1 = f1 + f2
        f2 = k56
        f2 = f2 * y
        f2 = f2 * dr
        f3 = k32
        f3 = f3 * x
        f3 = -f3
        f2 = f2 + f3
        f3 = x
        f3 = f3 * f3
        f3 = -f3
        f3 = f3 * k80
        f3 = f3 + k32
        f3 = f3 * z
        f2 = f2 + f3
        f3 = k64
        f3 = f3 * z
        f3 = f3 * y
        f4 = k40
        f4 = f4 * x
        f4 = -f4
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f4
        f4 = -f4
        f4 = f4 * k80
        f4 = f4 + k40
        f4 = f4 * dr
        f3 = f3 + f4
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "amazingIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula amazingIFS. Based on Amazing Box formula (and Kali's tweaks), adapted for dIFS."
    de difs
    transform
    alias "amazingIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 5.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 5.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 5.0 [-180.0, 180.0] angle
    param o6_fold_x "Fold X" = 0.5 [-1.5, 2.5] 
    param o7_fold_y "Fold Y" = 0.5 [-1.5, 2.5] 
    param o8_fold_z "Fold Z" = 0.0 [-2.0, 2.0] 
