        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = y
        f0 = f0 + z
        f0 = -f0
        f0 = f0 * k16
        f1 = x
        f2 = y
        f2 = f2 * k24
        f1 = f1 + f2
        f1 = f1 + dr
        f1 = f1 * k16
        f2 = k32
        f3 = x
        f3 = f3 * z
        f2 = f2 + f3
        f2 = f2 * k16
        f3 = k40
        f3 = f3 * z
        f3 = -f3
        f4 = k48
        f4 = f4 * dr
        f3 = f3 + f4
        f3 = f3 * k16
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

