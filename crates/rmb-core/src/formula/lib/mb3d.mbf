                f1 = f1 * f1
                f0 = f0 + f1
                m20 = f0
                f0 = z
                f0 = f0 * f0
                f0 = f0 / m20
                f0 = -f0
                f1 = 1.0
                f0 = f0 + f1
                m28 = f0
                f0 = x
                f0 = f0 * f0
                f1 = y
                f1 = f1 * f1
                f0 = f0 - f1
                f0 = f0 * m28
                m36 = f0
                f0 = x
                f0 = f0 * y
                f0 = f0 * 2.0
                f0 = f0 * m28
                m44 = f0
                f0 = m20
                f0 = sqrt(f0)
                f0 = f0 * z
