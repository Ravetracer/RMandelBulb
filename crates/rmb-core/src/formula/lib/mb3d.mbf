    param o0_radius "Radius" = 0.1 [-1.9, 2.1] 
    param o1_sub_y "Sub Y" = 1.0 [-1.0, 3.0] 
    param o2_sub_z "Sub Z" = 1.0 [-1.0, 3.0] 
    param o3_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o4_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o5_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o6_x_add "X add" = 3.0 [-3.0, 9.0] 
    param o7_rotate_xz "Rotate XZ" = 0.0 [-180.0, 180.0] angle
    param o8_rotate_xy "Rotate XY" = 0.0 [-180.0, 180.0] angle
    param o9_apply_scale_add "apply scale+add" = 1.0 [-1.0, 3.0] int
    param o10_sphere_pos "Sphere pos" = 1.0 [-1.0, 3.0] 
    param o11_sphere_r "Sphere R" = 0.2 [-1.8, 2.2] 
    param o12_otclr_tube "OTClr Tube" = 1.0 [-1.0, 3.0] 
    param o13_otclr_sphere "OTClr Sphere" = 2.0 [-2.0, 6.0] 
    init {
        let k140 = o13_otclr_sphere
        let k132 = o12_otclr_tube
        let k124 = o11_sphere_r
        let k116 = o10_sphere_pos
        let k108 = round(o9_apply_scale_add)
        let k104 = cos(o8_rotate_xy * pi / 180.0)
        let k96 = sin(o8_rotate_xy * pi / 180.0)
        let k88 = cos(o7_rotate_xz * pi / 180.0)
        let k80 = sin(o7_rotate_xz * pi / 180.0)
        let k72 = o6_x_add
        let k64 = o5_y_add
        let k56 = o4_z_add
        let k48 = o3_scale
        let k40 = o3_scale
        let k32 = o2_sub_z
        let k24 = o1_sub_y
        let k16 = o0_radius
    }
    iter {
        let f0 = 0.0
