formula "_Fold45double" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _Fold45double. This folding is center-symmetrical, but can give unexpected results."
    de numeric
    transform
    alias "_Fold45double"
    param o0_k "k (+)" = 1.0 [-1.0, 3.0] 
    param o1_enable_pre_rotation "Enable pre-rotation" = 0.0 [-2.0, 2.0] int
    param o2_opposite_x "Opposite x" = 0.0 [-2.0, 2.0] int
    param o3_opposite_y "Opposite y" = 0.0 [-2.0, 2.0] int
    param o4_opposite_z "Opposite z" = 0.0 [-2.0, 2.0] int
    param o5_2nd_k_fix "2nd k fix" = 0.0 [-2.0, 2.0] 
    init {
        let k40 = o5_2nd_k_fix
        let k32 = round(o4_opposite_z)
        let k28 = round(o3_opposite_y)
        let k24 = round(o2_opposite_x)
        let k20 = round(o1_enable_pre_rotation)
        let k16 = o0_k
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        if k20 == 0.0 {
        } else {
            f0 = x
            if k24 != 0.0 {
            } else {
                f0 = -f0
            }
            f1 = y
            if k28 != 0.0 {
            } else {
                f1 = -f1
            }
            f0 = f0 + f1
            f1 = z
            if k32 != 0.0 {
            } else {
                f1 = -f1
            }
            f0 = f0 + f1
            f0 = f0 * 0.6666666666666666
            f1 = x
            if k24 != 0.0 {
                f1 = f1 - f0
            } else {
                f1 = f1 + f0
            }
            f1 = -f1
            x = f1
