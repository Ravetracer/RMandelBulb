formula "_BenesiSpheric" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BenesiSpheric. Warps a cube to a sphere; transform made by M.Benesi and Luca."
    de numeric
    transform
    alias "_BenesiSpheric"
    param o0_scale "Scale" = 0.81649658092773 [-1.18350341907227, 2.81649658092773] 
    init {
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        f0 = y
        f0 = f0 * f0
        m12 = f0
        f1 = z
        f1 = f1 * f1
        m20 = f1
        f0 = f0 / f1
        f1 = 1.0
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
        } else {
            f1 = 1.0
            f0 = f1 / f0
        }
        f1 = 1.0
        f0 = f0 + f1
        f0 = sqrt(f0)
        m28 = f0
        f0 = m12
        f0 = f0 + m20
        f1 = x
        f1 = f1 * f1
        f0 = f0 / f1
        f1 = 1.0
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
        } else {
            f1 = 1.0
            f0 = f1 / f0
        }
        f1 = 1.0
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 * k16
        f1 = f0
        f1 = f1 * m28
        m28 = f1
        m20 = f0
        f0 = x
        f0 = f0 * m20
        f1 = y
        f1 = f1 * m28
        f2 = z
        f2 = f2 * m28
        z = f2
        y = f1
        x = f0
    }
}

