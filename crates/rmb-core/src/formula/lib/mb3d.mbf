formula "_sphereinv" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _sphereinv. Sphere inversion in 3D with radius and center."
    de numeric
    descale 0.2
    alias "_sphereinv"
    param o0_x_center "X center" = 0.0 [-2.0, 2.0] 
    param o1_y_center "Y center" = 0.0 [-2.0, 2.0] 
    param o2_z_center "Z center" = 0.0 [-2.0, 2.0] 
    param o3_radius "Radius" = 1.0 [-1.0, 3.0] 
    param o4_rad2 "Rad2" = -1.0 [-3.0, 1.0] 
    param o5_foldmode_1_or_2 "FoldMode (1 or 2)" = 1.0 [-1.0, 3.0] int
    init {
        let k60 = round(o5_foldmode_1_or_2)
        let k56 = 1.0 / max(1.0e-40, o4_rad2)
        let k48 = o4_rad2
        let k40 = 1.0 / sel(abs(o3_radius) < 1.0e-40, sel(o3_radius < 0.0, -1.0e-40, 1.0e-40), o3_radius)
        let k32 = o2_z_center
        let k24 = o1_y_center
        let k16 = o0_x_center
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * f3
        f4 = f1
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = f3 * k40
        if k60 == 0.0 {
            fc_a = f3
            fc_b = k48
            if fc_a <= fc_b {
                if k60 == 2.0 {
                    f3 = -f3
                    f3 = f3 + k48
                    f3 = f3 + k48
                    f4 = 1.0
                    f3 = f4 / f3
                } else {
                    f3 = k56
                }
            } else {
                f4 = 1.0
                f3 = f4 / f3
            }
            f2 = f2 * f3
            f1 = f1 * f3
            f0 = f0 * f3
            f2 = f2 - k16
            x = f2
            f1 = f1 - k24
            y = f1
            f0 = f0 - k32
            z = f0
        } else {
            f4 = 1.0
            fc_a = f4
            fc_b = f3
            if fc_a <= fc_b {
            } else {
                fc_a = f3
                fc_b = k48
                if fc_a <= fc_b {
                    if k60 == 2.0 {
                        f3 = -f3
                        f3 = f3 + k48
                        f3 = f3 + k48
                        f4 = 1.0
                        f3 = f4 / f3
                    } else {
                        f3 = k56
                    }
                } else {
                    f4 = 1.0
                    f3 = f4 / f3
                }
                f2 = f2 * f3
                f1 = f1 * f3
                f0 = f0 * f3
                f2 = f2 - k16
                x = f2
                f1 = f1 - k24
                y = f1
                f0 = f0 - k32
                z = f0
            }
        }
    }
}

