    description "Mandelbulb3D formula _tocylindrical. Cylindrical coords"
    de numeric
    transform
    alias "_tocylindrical"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = y
        f2 = x
        f1 = atan2(f1, f2)
        y = f1
        x = f0
    }
}

formula "_toruspinv1" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _toruspinv1. Torus pseudo-inversion in 3D with selectable radius and center. This needs a bit of coordinate adjustment."
    de numeric
    transform
    alias "_toruspinv1"
    param o0_x_center "X center" = 0.0 [-2.0, 2.0] 
    param o1_y_center "Y center" = 0.0 [-2.0, 2.0] 
    param o2_z_center "Z center" = 0.0 [-2.0, 2.0] 
    param o3_radius "Radius" = 1.0 [-1.0, 3.0] 
    param o4_r "R" = 1.0 [-1.0, 3.0] 
    init {
        let k48 = o4_r
        let k40 = o3_radius
        let k32 = o2_z_center
        let k24 = o1_y_center
        let k16 = o0_x_center
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f2 = f2 + k16
        x = f2
        f1 = f1 + k24
        y = f1
        f0 = f0 + k32
        z = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = -f0
        f0 = f0 + k48
        f0 = f0 * f0
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = x
        f1 = abs(f1)
        f1 = f1 / f0
        f2 = k40
        f1 = f1 * f2
        f1 = f1 - k16
        x = f1
        f1 = y
        f1 = abs(f1)
        f1 = f1 / f0
        f2 = k40
        f1 = f1 * f2
        f1 = f1 - k24
        y = f1
        f1 = z
        f1 = abs(f1)
        ft = f1
        f1 = f0
        f0 = ft
        f0 = f0 * f1
        f1 = k40
        f0 = f0 / f1
        f0 = f0 - k32
        z = f0
    }
}

