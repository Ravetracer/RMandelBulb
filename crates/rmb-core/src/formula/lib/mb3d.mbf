        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f2 = w
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = f1
        f2 = f2 / f0
        f2 = -f2
        f3 = 1.0
        f2 = f2 + f3
        m12 = f2
        f0 = f0 / f1
        f0 = sqrt(f0)
        f0 = f0 + f0
        m20 = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 - f1
        f0 = f0 * m12
        f0 = f0 + cx
        f1 = x
        f1 = f1 * y
        f1 = f1 * m12
        f1 = f1 + f1
        f1 = f1 + cy
        f2 = z
        f2 = f2 * f2
        f3 = w
        f3 = f3 * f3
        f2 = f2 - f3
        f2 = f2 * m20
        f2 = f2 * k24
        f2 = f2 + cz
        f3 = z
        f3 = f3 * w
        f3 = f3 * m20
        f3 = f3 + cw
        f3 = f3 + k16
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "IQ-bulb old" {
    category "MB3D 3D"
    description "Mandelbulb3D formula IQ-bulb old. This formula is kept for compatibility. Please use IQ-bulb as it's mathematically correct."
    de numeric
    descale 1.5
    alias "IQ-bulb old"
    param o0_power "Power" = 8.0 [-8.0, 24.0] 
    param o1_z_anglepow "z-AnglePow" = 8.0 [-8.0, 24.0] 
    param o2_z_mul "z-Mul" = 1.0 [-1.0, 3.0] 
    param o3_mode "Mode" = 0.0 [-2.0, 2.0] int
    param o4_atan2mode "Atan2Mode" = 0.0 [-2.0, 2.0] int
    init {
        let k40 = round(o4_atan2mode)
        let k36 = round(o3_mode)
        let k32 = o2_z_mul
        let k24 = o1_z_anglepow
        let k16 = o0_power
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        let m68 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        m68 = f0
        f1 = k16
        ft = f1
        f1 = f0
        f0 = ft
        f1 = abs(f1)
        f0 = f0 * log(f1) * 1.4426950408889634
        f1 = 1.0
        f2 = f0
        f2 = f2 % f1
        f2 = pow(2.0, f2) - 1.0
        f1 = f1 + f2
        f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
        ft = f1
        f1 = f0
        f0 = ft
        m12 = f0
        if k36 != 0.0 {
            f0 = m68
            f1 = k24
            ft = f1
            f1 = f0
            f0 = ft
            f1 = abs(f1)
            f0 = f0 * log(f1) * 1.4426950408889634
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            m68 = f0
        } else {
            f0 = m12
            m68 = f0
        }
        f0 = x
        f0 = f0 * f0
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = x
        f1 = f1 * f1
        f2 = y
        f2 = f2 * f2
        f3 = z
        f3 = f3 * f3
        f2 = f2 + f3
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 + y
        f0 = atan2(f0, f1)
        f0 = f0 + f0
        f0 = f0 * k24
        f1 = cos(f0)
        f0 = sin(f0)
        m20 = f1
        m28 = f0
        f0 = z
        f1 = x
        f0 = atan2(f0, f1)
        if k40 != 0.0 {
        } else {
            f1 = x
            f2 = 0.0
            fc_a = f2
            fc_b = f1
            if fc_a <= fc_b {
            } else {
                f1 = z
                f2 = 0.0
                fc_a = f2
                fc_b = f1
                if fc_a <= fc_b {
                    f1 = 3.141592653589793
                    f1 = f1 * 1.0
                    f0 = f0 - f1
                } else {
                    f1 = 3.141592653589793
                    f1 = f1 * 1.0
                    f0 = f0 + f1
                }
            }
        }
        f0 = f0 * k24
        f1 = cos(f0)
        f0 = sin(f0)
        m36 = f1
        m44 = f0
        f0 = m12
        f0 = f0 * m28
        f0 = f0 * m44
        f0 = f0 + cx
        m52 = f0
        f0 = m12
        f0 = f0 * m20
        f0 = f0 + cy
        m60 = f0
        f0 = m68
        f0 = f0 * m36
        f0 = f0 * m28
        f0 = f0 * k32
        f0 = f0 + cz
        m68 = f0
        f0 = m52
        f1 = m60
        f2 = m68
        z = f2
        y = f1
        x = f0
    }
}

