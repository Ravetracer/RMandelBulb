        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * f2
        f4 = f1
        f4 = f4 * f1
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * f0
        f3 = f3 + f4
        f3 = f3 * k56
        fc_a = f3
        fc_b = k32
        if fc_a >= fc_b {
            f4 = 1.0
            fc_a = f4
            fc_b = f3
            if fc_a < fc_b {
                fc_a = f4
                fc_b = f3
                f3 = a0
            } else {
                f3 = a0 / f3
            }
        } else {
            f3 = k24
        }
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f2 = f2 + cz
        z = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cx
        x = f0
    }
}

formula "Aex-TorusPow" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Aex-TorusPow. Aexion's variation of Cosine Mandelbulb - see the thread:"
    de numeric
    alias "Aex-TorusPow"
    param o0_power "Power" = 8.0 [-8.0, 24.0] 
    param o1_donutness "Donutness" = 1.5 [-1.5, 4.5] 
    param o2_zmul "ZMul" = 1.0 [-1.0, 3.0] 
    param o3_cossubt "CosSubt" = 0.0 [-2.0, 2.0] 
    param o4_mode_0_1 "Mode 0-1" = 0.0 [-2.0, 2.0] int
    init {
        let k44 = round(o4_mode_0_1)
        let k40 = o3_cossubt
        let k32 = o2_zmul
        let k24 = o1_donutness
        let k16 = o0_power
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        f0 = y
        f1 = x
        f0 = atan2(f0, f1)
        m28 = f0
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        m12 = f1
        m20 = f0
        f0 = m28
        f1 = cos(f0)
        f0 = sin(f0)
        m28 = f1
        m36 = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = z
        f0 = atan2(f0, f1)
        f0 = f0 * k16
        f1 = cos(f0)
        f0 = sin(f0)
        f1 = f1 + k40
        if k44 == 0.0 {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        m52 = f1
        m44 = f0
        f0 = x
        f1 = m28
        f1 = f1 * k24
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * f0
        f1 = y
        f2 = m36
        f2 = f2 * k24
        f2 = -f2
        f1 = f1 + f2
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        y = f0
        f1 = k16
        f1 = f1 * 0.5
        ft = f1
        f1 = f0
        f0 = ft
        f1 = abs(f1)
        f0 = f0 * log(f1) * 1.4426950408889634
        f1 = 1.0
        f2 = f0
        f2 = f2 % f1
        f2 = pow(2.0, f2) - 1.0
        f1 = f1 + f2
        f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
        ft = f1
        f1 = f0
        f0 = ft
        x = f0
        z = f0
        f0 = f0 * m52
        f0 = f0 * m12
        f0 = f0 + cx
        f1 = z
        f1 = f1 * m52
        f1 = f1 * m20
        f1 = f1 + cy
        f2 = x
        f2 = f2 * m44
        f2 = f2 + cz
        f2 = f2 * k32
        z = f2
        y = f1
        x = f0
    }
}

