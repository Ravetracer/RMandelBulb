}

formula "Quad3Db" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Quad3Db. Quadratic 3D plus variations (optional), that may transform the fractal into"
    de numeric
    alias "Quad3Db"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = 2.0 [-2.0, 6.0] 
    param o3_hradius "HRadius" = 0.0 [-2.0, 2.0] 
    param o4_zradius "ZRadius" = 1.0 [-1.0, 3.0] 
    param o5_variants_0_63 "Variants (0...63)" = 40.0 [-40.0, 120.0] int
    init {
        let k52 = round(o5_variants_0_63)
        let k48 = o4_zradius
        let k40 = o3_hradius
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let cfl = 0.0
        let r_eax = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = k40
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = 0.0
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
            f1 = 0.0
            f2 = 0.0
            f3 = 0.0
            r_eax = sel(fc_a < fc_b, 14592.0, sel(fc_a == fc_b, 30720.0, 14336.0))
        } else {
            if fc_a == fc_b {
                f1 = cx
                f2 = cy
                f3 = cz
                r_eax = sel(fc_a < fc_b, 14592.0, sel(fc_a == fc_b, 30720.0, 14336.0))
            } else {
                f1 = x
                f1 = f1 * f1
                f2 = y
                f2 = f2 * f2
                f2 = -f2
                f1 = f1 + f2
                f1 = f1 * k16
                f2 = k48
                f3 = z
                f3 = f3 * f3
                f3 = f3 / f0
                f3 = -f3
                f2 = f2 + f3
                f1 = f1 * f2
                r_eax = k52
                r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
                if r_eax != 0.0 {
                    if r_eax != 1.0 {
                        if r_eax != 2.0 {
                            f1 = f1 + cx
                        } else {
                            f2 = f1
                            f2 = f2 + cx
                            f2 = abs(f2)
                            f3 = f1
                            f3 = f3 - cx
                            f3 = abs(f3)
                            ft = f3
                            f3 = f2
                            f2 = ft
                            f2 = f3 - f2
                            ft = f2
                            f2 = f1
                            f1 = ft
                            f2 = -f2
                            f1 = f1 + f2
                        }
                    } else {
                        f1 = f1 + cx
                        f1 = abs(f1)
                    }
                } else {
                    f1 = abs(f1)
                    f1 = f1 + cx
                }
                f2 = x
                f2 = f2 * y
                f2 = f2 * k24
                f3 = k48
                f4 = z
                f4 = f4 * f4
                f4 = f4 / f0
                f4 = -f4
                f3 = f3 + f4
                f2 = f2 * f3
                r_eax = k52
                cfl = sel(floor(r_eax / 2.0) - 2.0 * floor(r_eax / 4.0) > 0.5, 1.0, 0.0)
                r_eax = floor(r_eax / 4.0)
                r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
                if r_eax != 0.0 {
                    if r_eax != 1.0 {
                        if r_eax != 2.0 {
                            f2 = f2 + cy
                        } else {
                            f3 = f2
                            f3 = f3 + cy
                            f3 = abs(f3)
                            f4 = f2
                            f4 = f4 - cy
                            f4 = abs(f4)
                            ft = f4
                            f4 = f3
                            f3 = ft
                            f3 = f4 - f3
                            ft = f3
                            f3 = f2
                            f2 = ft
                            f3 = -f3
                            f2 = f2 + f3
                        }
                    } else {
                        f2 = f2 + cy
                        f2 = abs(f2)
                    }
                } else {
                    f2 = abs(f2)
                    f2 = f2 + cy
                }
                f3 = z
                f4 = f0
                f4 = sqrt(f4)
                f3 = f3 * f4
                f3 = f3 * k32
                r_eax = k52
                cfl = sel(floor(r_eax / 8.0) - 2.0 * floor(r_eax / 16.0) > 0.5, 1.0, 0.0)
                r_eax = floor(r_eax / 16.0)
                r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
                if r_eax != 0.0 {
                    if r_eax != 1.0 {
                        if r_eax != 2.0 {
                            f3 = f3 + cz
                        } else {
                            f4 = f3
                            f4 = f4 + cz
                            f4 = abs(f4)
                            f5 = f3
                            f5 = f5 - cz
                            f5 = abs(f5)
                            ft = f5
                            f5 = f4
                            f4 = ft
                            f4 = f5 - f4
                            ft = f4
                            f4 = f3
                            f3 = ft
                            f4 = -f4
                            f3 = f3 + f4
                        }
                    } else {
                        f3 = f3 + cz
                        f3 = abs(f3)
                    }
                } else {
                    f3 = abs(f3)
                    f3 = f3 + cz
                }
            }
        }
        z = f3
        y = f2
        x = f1
    }
}

formula "Quadrat3D" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Quadrat3D. Found on http://bugman123.com/Hypercomplex/index.html"
    de numeric
    alias "Quadrat3D"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = -2.0 [-6.0, 2.0] 
    param o3_hradius "HRadius" = 0.0 [-2.0, 2.0] 
    param o4_zradius "ZRadius" = 1.0 [-1.0, 3.0] 
    init {
        let k48 = o4_zradius
        let k40 = o3_hradius
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f2 = k40
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = 0.0
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
            f1 = 0.0
            f2 = 0.0
            f3 = 0.0
        } else {
            if fc_a == fc_b {
                f1 = cx
                f2 = cy
                f3 = cz
            } else {
                f1 = x
                f1 = f1 * f1
                f2 = y
                f2 = f2 * f2
                f2 = -f2
                f1 = f1 + f2
                f1 = f1 * k16
                f2 = k48
                f3 = z
                f3 = f3 * f3
                f3 = f3 / f0
                f3 = -f3
                f2 = f2 + f3
                f1 = f1 * f2
                f1 = f1 + cx
                f2 = x
                f2 = f2 * y
                f2 = f2 * k24
                f3 = k48
                f4 = z
                f4 = f4 * f4
                f4 = f4 / f0
                f4 = -f4
                f3 = f3 + f4
                f2 = f2 * f3
                f2 = f2 + cy
                f3 = z
                f4 = f0
                f4 = sqrt(f4)
                f3 = f3 * f4
                f3 = f3 * k32
                f3 = f3 + cz
            }
        }
        z = f3
        y = f2
        x = f1
    }
}

formula "QuadrayBrot" {
    category "MB3D 4D"
    description "Mandelbulb3D formula QuadrayBrot. This formula uses quadray numbers in 4D."
    de numeric
    alias "QuadrayBrot"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = cx
        f0 = f0 + cy
        f0 = f0 + cz
        f0 = abs(f0)
        f1 = x
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = y
        f1 = f1 * f1
        f0 = f0 - f1
        f1 = w
        f1 = f1 * z
        f1 = f1 + f1
        f0 = f0 + f1
        f1 = cx
        f1 = -f1
        f1 = f1 - cy
        f1 = f1 + cz
        f1 = abs(f1)
        f2 = y
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = x
        f2 = f2 * f2
        f1 = f1 - f2
        f2 = w
        f2 = f2 * z
        f2 = f2 + f2
        f1 = f1 + f2
        f2 = cx
        f2 = -f2
        f2 = f2 + cy
        f2 = f2 - cz
        f2 = abs(f2)
        f3 = z
        f3 = f3 * f3
        f2 = f2 + f3
        f3 = w
        f3 = f3 * f3
        f2 = f2 - f3
        f3 = x
        f3 = f3 * y
        f3 = f3 + f3
        f2 = f2 + f3
        f3 = cx
        f3 = f3 - cy
        f3 = f3 - cz
        f3 = abs(f3)
        f4 = z
        f4 = f4 * f4
        f3 = f3 - f4
        f4 = w
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = x
        f4 = f4 * y
        f4 = f4 + f4
        f3 = f3 + f4
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "QuadricsIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula QuadricsIFS. A tool for the real quadrics of revolution. They are cut with a box scissor."
    de difs
    alias "QuadricsIFS"
    param o0_cutboxsz "CutBoxSz" = 2.0 [-2.0, 6.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_thickness "Thickness" = 0.5 [-1.5, 2.5] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_zmul "zMul" = -0.7 [-2.7, 1.3] 
    param o8_hypoffset "HypOffset" = -0.2 [-2.2, 1.8] 
    param o9_half_cut "Half cut" = 0.0 [-2.0, 2.0] int
    param o10_flip_x_z "Flip X-Z" = 0.0 [-2.0, 2.0] int
    init {
        let k100 = round(o10_flip_x_z)
        let k96 = round(o9_half_cut)
        let k92 = o8_hypoffset
        let k84 = o7_zmul
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_thickness
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_cutboxsz
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m28 = x0l
        m20 = x0h
        m12 = x1l
        if k100 == 0.0 {
        } else {
            f0 = m28
            f1 = m12
            m28 = f1
            m12 = f0
        }
        f0 = m12
        f0 = f0 * f0
        f1 = m20
        f1 = f1 * f1
        f2 = m28
        f2 = f2 * f2
        f2 = f2 * k84
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = f0 - k92
        f0 = abs(f0)
        f0 = sqrt(f0)
        f0 = f0 - k72
        f1 = m28
        if k96 != 0.0 {
        } else {
            f1 = abs(f1)
            f1 = f1 - k16
        }
        f2 = m20
        f2 = abs(f2)
        f2 = f2 - k16
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        f2 = m12
        f2 = abs(f2)
        f2 = f2 - k16
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

