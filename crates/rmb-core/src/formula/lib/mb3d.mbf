formula "_HexaTransform" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _HexaTransform. Based on Aexions ideas, this performs a hexagonal transform to be used as first formula as pre-transform, and choosing 'repeat from here' on the next formula(s)."
    de numeric
    transform
    alias "_HexaTransform"
    param o0_offset "Offset" = 0.0 [-2.0, 2.0] 
    init {
        let k16 = o0_offset
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = abs(f0)
        f0 = f0 - k16
        f1 = y
        f1 = f1 * 0.8660254037844386
        f2 = x
        f2 = f2 * (-0.5)
        f1 = f1 + f2
        f1 = abs(f1)
        f1 = f1 - k16
        f2 = z
        f2 = abs(f2)
        f2 = f2 - k16
        f3 = y
        f3 = f3 * 0.8660254037844386
        f4 = x
        f4 = f4 * (-0.5)
        f3 = f4 - f3
        f3 = abs(f3)
        f3 = f3 - k16
        dr = f3
        z = f2
        y = f1
        x = f0
        f0 = cx
        f0 = abs(f0)
        f0 = f0 - k16
        f1 = cy
        f1 = f1 * 0.8660254037844386
        f2 = cx
        f2 = f2 * (-0.5)
        f1 = f1 + f2
        f1 = abs(f1)
        f1 = f1 - k16
        f2 = cz
        f2 = abs(f2)
        f2 = f2 - k16
        f3 = cy
        f3 = f3 * 0.8660254037844386
        f4 = cx
        f4 = f4 * (-0.5)
        f3 = f4 - f3
        f3 = abs(f3)
        f3 = f3 - k16
        cw = f3
        cz = f2
        cy = f1
        cx = f0
    }
}

formula "_HopSqrtX" {
    category "MB3D transforms"
