                    z = f0
                }
            } else {
                f0 = m12
                f0 = f0 / x
                m20 = f0
                f0 = m36
                f0 = f0 + m44
                f0 = f0 * m20
                f0 = f0 * 0.5
                f0 = -f0
                f0 = f0 + x
                f0 = f0 * 2.0
                f0 = f0 * k48
                f1 = m36
                f1 = f1 - m44
                f0 = f0 / f1
                x = f0
                f0 = y
                f1 = m36
                f1 = f1 - m44
                f0 = f0 / f1
                y = f0
                f0 = y
                f0 = f0 + 0.5
                f0 = round(f0)
                f0 = -f0
                f0 = f0 + 0.5
                f0 = f0 + y
                f0 = f0 * 2.0
                f0 = f0 * k48
                y = f0
                f0 = z
                f1 = m36
                f1 = f1 - m44
                f0 = f0 / f1
                z = f0
                f0 = z
                f0 = f0 + 0.5
                f0 = round(f0)
                f0 = -f0
                f0 = f0 + 0.5
                f0 = f0 + z
                f0 = f0 * 2.0
                f0 = f0 * k48
                z = f0
            }
            f0 = x
            f0 = f0 * k40
            f0 = f0 - k16
            x = f0
            f0 = y
            f0 = f0 * k40
            f0 = f0 - k24
            y = f0
            f0 = z
            f0 = f0 * k40
            f0 = f0 - k32
            z = f0
        } else {
            if lx40 == 1.0 {
                f0 = x
                f0 = f0 * k40
                f0 = f0 - k16
                x = f0
                f0 = y
                f0 = f0 * k40
                f0 = f0 - k24
                y = f0
                f0 = z
                f0 = f0 * k40
                f0 = f0 - k32
                z = f0
            } else {
