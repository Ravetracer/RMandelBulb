        f0 = f0 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "CitrusIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula CitrusIFS. Citrus surface (from MathWorld). Very similar to piriform."
    de difs
    alias "CitrusIFS"
    param o0_citrus_add "Citrus add" = 3.3 [-3.3, 9.899999999999999] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_citrus_sub "Citrus sub" = 8.0 [-8.0, 24.0] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_citrusrot_x "CitrusRot X" = 0.0 [-180.0, 180.0] angle
    param o8_citrusrot_y "CitrusRot Y" = 0.0 [-180.0, 180.0] angle
    param o9_citrusrot_z "CitrusRot Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_citrusrot_x * pi / 180.0) * cos(o8_citrusrot_y * pi / 180.0))
        let k108 = single(cos(o7_citrusrot_x * pi / 180.0) * sin(o8_citrusrot_y * pi / 180.0) * sin(o9_citrusrot_z * pi / 180.0) + sin(o7_citrusrot_x * pi / 180.0) * cos(o9_citrusrot_z * pi / 180.0))
        let k104 = single(sin(o7_citrusrot_x * pi / 180.0) * sin(o9_citrusrot_z * pi / 180.0) - cos(o7_citrusrot_x * pi / 180.0) * sin(o8_citrusrot_y * pi / 180.0) * cos(o9_citrusrot_z * pi / 180.0))
        let k100 = single(-sin(o7_citrusrot_x * pi / 180.0) * cos(o8_citrusrot_y * pi / 180.0))
        let k96 = single(cos(o7_citrusrot_x * pi / 180.0) * cos(o9_citrusrot_z * pi / 180.0) - sin(o7_citrusrot_x * pi / 180.0) * sin(o8_citrusrot_y * pi / 180.0) * sin(o9_citrusrot_z * pi / 180.0))
        let k92 = single(sin(o7_citrusrot_x * pi / 180.0) * sin(o8_citrusrot_y * pi / 180.0) * cos(o9_citrusrot_z * pi / 180.0) + cos(o7_citrusrot_x * pi / 180.0) * sin(o9_citrusrot_z * pi / 180.0))
        let k88 = single(sin(o8_citrusrot_y * pi / 180.0))
        let k84 = single(-cos(o8_citrusrot_y * pi / 180.0) * sin(o9_citrusrot_z * pi / 180.0))
        let k80 = single(cos(o8_citrusrot_y * pi / 180.0) * cos(o9_citrusrot_z * pi / 180.0))
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_citrus_sub
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_citrus_add
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m38 = 0.0
        let m46 = 0.0
        let m54 = 0.0
        let m62 = 0.0
        let m70 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m70 = x0l
        m62 = x0h
        m54 = x1l
        f0 = 0.0
        m46 = f0
        m38 = f0
        f0 = m54
        f1 = m62
        f2 = m70
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        m70 = f2
        m62 = f1
        m54 = f0
        f0 = m54
        f0 = f0 * f0
        f1 = m62
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * k72
        m46 = f0
        f0 = m70
        f0 = f0 - k16
        f1 = f0
        f1 = f1 * f1
        f0 = f0 * f1
        f0 = f0 * m70
        f0 = f0 * m70
        f0 = f0 * m70
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 + m46
            m46 = f0
        } else {
            f0 = m38 - f0
            m38 = f0
        }
        f0 = m46
        f0 = sqrt(f0)
        f0 = sqrt(f0)
        f1 = m38
        f1 = sqrt(f1)
        f1 = sqrt(f1)
        f1 = -f1
        f0 = f0 + f1
        f1 = m70
        f1 = f1 * f1
        f2 = m62
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 - k72
        f1 = f1 - k72
        f1 = f1 - k72
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f1 = m54
        f1 = abs(f1)
        f1 = f1 - k72
        f1 = f1 - k72
        f1 = f1 - k72
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "CommQuat" {
    category "MB3D 4D"
    description "Mandelbulb3D formula CommQuat. A formula from Fracmonk on fractalforums.com,"
    de numeric
    alias "CommQuat"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 1.0 [-1.0, 3.0] 
    param o2_z_mul "Z mul" = 1.0 [-1.0, 3.0] 
    param o3_w_mul "W mul" = 1.0 [-1.0, 3.0] 
    param o4_w_add "W add" = 0.0 [-2.0, 2.0] 
    init {
        let k48 = o4_w_add
        let k40 = o3_w_mul
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        f0 = w
        f1 = z
        f2 = y
        f3 = x
        f4 = f2
        f4 = f4 * f4
        f5 = f3
        f5 = f5 * f5
        f4 = f5 - f4
        f5 = f0
        f5 = f5 * f1
        f5 = f5 + f5
        f4 = f4 - f5
        f4 = f4 * k16
        f4 = f4 + cx
        x = f4
        f4 = f3
        f4 = f4 * f2
        f4 = f4 + f4
        f5 = f1
        f5 = f5 * f5
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * f5
        f4 = f4 - f5
        f4 = f4 * k24
        f4 = f4 + cy
        y = f4
        f4 = f3
        f4 = f4 * f1
        f5 = f2
        f5 = f5 * f0
        f4 = f4 - f5
        f4 = f4 + f4
        f4 = f4 * k32
        f4 = f4 + cz
        z = f4
        f0 = f0 * f3
        f1 = f1 * f2
        f0 = f0 + f1
        f0 = f0 + f0
        f0 = f0 * k40
        f0 = f0 + k48
        f0 = f0 + cw
        w = f0
    }
}

formula "CommaIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula CommaIFS. Approximate 'Yin-Yang' shape. Looked closely it is not perfect but it's nice for some decorations."
    de difs
    alias "CommaIFS"
    param o0_r1 "R1" = -1.0 [-3.0, 1.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_r2 "R2" = 0.24 [-1.76, 2.24] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_r3 "R3" = 1.5 [-1.5, 4.5] 
    param o8_r_sphere "R sphere" = 0.37 [-1.63, 2.37] 
    param o9_flip_x_z "Flip X-Z" = 0.0 [-2.0, 2.0] int
    param o10_flip_y_z "Flip Y-Z" = 0.0 [-2.0, 2.0] int
    param o11_signs "Signs" = 0.0 [-2.0, 2.0] int
    init {
        let k104 = round(o11_signs)
        let k100 = round(o10_flip_y_z)
        let k96 = round(o9_flip_x_z)
        let k92 = o8_r_sphere
        let k84 = o7_r3
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_r2
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_r1
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m60 = x0l
        m52 = x0h
        m44 = x1l
        if k96 == 0.0 {
        } else {
            f0 = m60
            f1 = m44
            m60 = f1
            m44 = f0
        }
        if k100 == 0.0 {
        } else {
            f0 = m52
            f1 = m44
            m52 = f1
            m44 = f0
        }
        r_edx = k104
        r_edx = (r_edx - 2.0 * floor(r_edx / 2.0))
        if r_edx != 0.0 {
        } else {
            f0 = m60
            f0 = -f0
            m60 = f0
        }
        r_edx = k104
        r_edx = ((floor(r_edx / 2.0) - 2.0 * floor(r_edx / 4.0)) * 2.0)
        if r_edx != 0.0 {
        } else {
            f0 = m52
            f0 = -f0
            m52 = f0
        }
        r_edx = k104
        r_edx = ((floor(r_edx / 4.0) - 2.0 * floor(r_edx / 8.0)) * 4.0)
        if r_edx != 0.0 {
        } else {
            f0 = m44
            f0 = -f0
            m44 = f0
        }
        f0 = m60
        f0 = f0 * f0
        f1 = m52
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = m52
        f2 = m60
        f1 = atan2(f1, f2)
        f1 = f1 * 0.159155
        f2 = f1
        f2 = f2 * f2
        f3 = f2
        f3 = f3 * f1
        f3 = -f3
        f2 = f2 + f3
        f1 = f1 + f2
        f2 = k16
        f1 = f1 * f2
        f1 = f1 + k72
        m36 = f1
        f0 = f0 - k84
        f0 = f0 * f0
        f1 = m44
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - m36
        f1 = m60
        f1 = f1 + k84
        f1 = f1 * f1
        f2 = m52
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = m44
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 - k92
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

