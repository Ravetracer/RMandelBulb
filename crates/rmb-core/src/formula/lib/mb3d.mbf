        let k56 = o4_y_add
        let k48 = o3_z_add
        let k32 = o2_scale
        let k24 = o2_scale
        let k16 = round(o1_polyfoldxz)
        let k12 = round(o0_polyfoldxy)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m16 = 0.0
        let m24 = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m8 = 0.0
        x0l = x
        x0h = y
        x1l = z
