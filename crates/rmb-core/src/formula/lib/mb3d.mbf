        f2 = f2 * f3
        y = f2
        x = f1
        z = f0
        f0 = 1.0
        f0 = k16 - f0
        f0 = f0 * k128
        f1 = x
        f0 = f1 - f0
        x = f0
        f0 = 1.0
        f0 = k16 - f0
        f0 = f0 * k120
        f1 = x
