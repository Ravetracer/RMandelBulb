        f0 = y
        f0 = f0 + k24
        f1 = cos(f0)
        f0 = sin(f0)
        m20 = f1
        m28 = f0
        f0 = z
        f1 = cos(f0)
        f0 = sin(f0)
        m36 = f1
        m44 = f0
        f0 = x
        f0 = f0 * m20
        f0 = f0 + k16
        m52 = f0
        f0 = x
        f0 = f0 * m28
        z = f0
        f0 = m52
        f0 = f0 * m44
        y = f0
        f0 = m52
        f0 = f0 * m36
        x = f0
    }
}

formula "_juliax2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _juliax2. Shows a double Julia set, with chosen seeds. Just *don't* turn on Julia mode, and use as a pretransform!"
    de numeric
    transform
    alias "_juliax2"
    param o0_separation "Separation" = 2.0 [-2.0, 6.0] 
    param o1_x_seed_l "X seed (L)" = 0.5 [-1.5, 2.5] 
    param o2_y_seed_l "Y seed (L)" = 0.5 [-1.5, 2.5] 
    param o3_z_seed_l "Z seed (L)" = 0.0 [-2.0, 2.0] 
    param o4_x_seed_r "X seed (R)" = -1.0 [-3.0, 1.0] 
    param o5_y_seed_r "Y seed (R)" = 0.0 [-2.0, 2.0] 
    param o6_z_seed_r "Z seed (R)" = 0.0 [-2.0, 2.0] 
    init {
        let k64 = o6_z_seed_r
        let k56 = o5_y_seed_r
        let k48 = o4_x_seed_r
        let k40 = o3_z_seed_l
        let k32 = o2_y_seed_l
        let k24 = o1_x_seed_l
        let k16 = o0_separation
    }
    iter {
        let f0 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = x
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 - k16
            x = f0
            f0 = k48
            cx = f0
            f0 = k56
            cy = f0
            f0 = k64
            cz = f0
        } else {
            f0 = f0 + k16
            x = f0
            f0 = k24
            cx = f0
            f0 = k32
            cy = f0
            f0 = k40
            cz = f0
        }
    }
}

