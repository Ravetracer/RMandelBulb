formula "_JuliaSets" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _JuliaSets. A pretransform to show juliasets from formulas."
    de numeric
    transform
    alias "_JuliaSets"
    param o0_separation "Separation" = 4.0 [-4.0, 12.0] 
    param o1_julia_factor "Julia factor" = 0.2 [-1.8, 2.2] 
    init {
        let k24 = o1_julia_factor
        let k16 = o0_separation
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        f0 = k16
        f1 = 1.0
        f1 = f1 / f0
        f2 = py
        f2 = f2 * f1
        f3 = px
        f3 = f3 * f1
        f4 = pz
        f1 = f1 * f4
        f4 = f3
        f4 = round(f4)
        f5 = f2
        f5 = round(f5)
        f6 = f1
        f6 = round(f6)
        f1 = f1 - f6
        f6 = f6 * k24
        cz = f6
        f2 = f2 - f5
        f5 = f5 * k24
        cy = f5
        f3 = f3 - f4
        f4 = f4 * k24
        cx = f4
        f3 = f3 * f0
        x = f3
        f2 = f2 * f0
        y = f2
        f0 = f0 * f1
        z = f0
    }
}

formula "_LinCombineCxyz" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _LinCombineCxyz. A general 3x3 matrix conversion for C:"
    de numeric
    transform
    alias "_LinCombineCxyz"
    param o0_cxx_mul "CXx mul" = 1.0 [-1.0, 3.0] 
    param o1_cxy_mul "CXy mul" = 0.0 [-2.0, 2.0] 
    param o2_cxz_mul "CXz mul" = 0.0 [-2.0, 2.0] 
    param o3_cyx_mul "CYx mul" = 0.0 [-2.0, 2.0] 
    param o4_cyy_mul "CYy mul" = 1.0 [-1.0, 3.0] 
    param o5_cyz_mul "CYz mul" = 0.0 [-2.0, 2.0] 
    param o6_czx_mul "CZx mul" = 0.0 [-2.0, 2.0] 
    param o7_czy_mul "CZy mul" = 0.0 [-2.0, 2.0] 
    param o8_czz_mul "CZz mul" = 1.0 [-1.0, 3.0] 
    init {
        let k80 = o8_czz_mul
        let k72 = o7_czy_mul
        let k64 = o6_czx_mul
        let k56 = o5_cyz_mul
        let k48 = o4_cyy_mul
        let k40 = o3_cyx_mul
        let k32 = o2_cxz_mul
        let k24 = o1_cxy_mul
        let k16 = o0_cxx_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let ft = 0.0
        f0 = cz
        f1 = cy
        f2 = cx
        f3 = f2
        f3 = f3 * k16
        f4 = f1
        f4 = f4 * k24
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k32
        f3 = f3 + f4
        cx = f3
        f3 = f2
        f3 = f3 * k40
        f4 = f1
        f4 = f4 * k48
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k56
        f3 = f3 + f4
        cy = f3
        f2 = f2 * k64
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * k72
        f1 = f1 + f2
        ft = f1
        f1 = f0
        f0 = ft
        f1 = f1 * k80
        f0 = f0 + f1
        cz = f0
    }
