formula "CubicQuat" {
    category "MB3D 4D"
    description "Mandelbulb3D formula CubicQuat. An attempt to replicate a formula from Gilles Nadau (2003) - from UF database"
    de numeric
    alias "CubicQuat"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 1.0 [-1.0, 3.0] 
    param o2_z_mul "Z mul" = 1.0 [-1.0, 3.0] 
    param o3_w_mul "W mul" = 1.0 [-1.0, 3.0] 
    param o4_w_add "W add" = 0.0 [-2.0, 2.0] 
    param o5_x_twist "X twist" = 0.0 [-2.0, 2.0] 
    param o6_y_twist "Y twist" = 0.0 [-2.0, 2.0] 
    init {
        let k64 = o6_y_twist
        let k56 = o5_x_twist
        let k48 = o4_w_add
        let k40 = o3_w_mul
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = y
        f0 = f0 * f0
        f0 = f0 * k24
        f1 = z
        f1 = f1 * f1
        f1 = f1 * k32
        f2 = w
        f2 = f2 * f2
        f2 = f2 * k40
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = -f0
        f1 = x
        f1 = f1 * f1
        f1 = f1 * k16
        f0 = f0 + f1
        f0 = f0 + cx
        f1 = cy
        f1 = f1 * k56
        f0 = f0 + f1
        f1 = x
        f1 = f1 * y
        f1 = f1 * k24
        f1 = f1 + f1
        f1 = f1 + cy
        f2 = cx
        f2 = f2 * k64
        f1 = f1 + f2
        f2 = x
        f2 = f2 * z
        f2 = f2 * k32
        f2 = f2 + f2
        f2 = f2 + cz
        f3 = x
        f3 = f3 * w
        f3 = f3 * k40
        f3 = f3 + f3
        f3 = f3 + k48
        f3 = f3 + cw
        w = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "DodecahedronIFS" {
    category "MB3D 3D"
