        f2 = f2 / f3
        ft = f2
        f2 = f0
        f0 = ft
        f3 = cos(f2)
        f2 = sin(f2)
        f3 = f3 + f1
        f2 = f2 / f3
        f3 = f2
        f3 = f3 * f2
        f4 = f0
        f4 = f4 * f0
        f3 = f3 + f4
        f4 = f3
        f4 = f4 + f1
        f4 = f1 / f4
        ft = f4
        f4 = f3
        f3 = ft
        f1 = f4 - f1
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f3 = k16
        f3 = f3 * k8
        f4 = rout
