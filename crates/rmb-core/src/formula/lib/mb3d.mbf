formula "_SphereFolding1" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _SphereFolding1. "
    de numeric
    transform
    alias "_SphereFolding1"
    param o0_r_fold "R fold" = 2.0 [-2.0, 6.0] 
    init {
        let k40 = -2.0 * o0_r_fold
        let k32 = -o0_r_fold
        let k24 = 2.0 * o0_r_fold
        let k16 = o0_r_fold
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = rout
        fc_a = f0
        fc_b = k16
        if fc_a < fc_b {
            fc_a = f0
            fc_b = k32
            if fc_a >= fc_b {
            } else {
                f0 = k40 - f0
                f0 = f0 / rout
                f1 = z
                f2 = y
                f3 = x
                f3 = f3 * f0
                x = f3
                f2 = f2 * f0
                y = f2
                f1 = f1 * f0
                z = f1
            }
        } else {
            f0 = k24 - f0
            f0 = f0 / rout
            f1 = z
            f2 = y
            f3 = x
            f3 = f3 * f0
            x = f3
            f2 = f2 * f0
            y = f2
            f1 = f1 * f0
            z = f1
        }
    }
}

