formula "MsltoeFoldQuat" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MsltoeFoldQuat. Very nice julias with x seeds, leave y and z at zero or it gets noisy."
    de numeric
    alias "MsltoeFoldQuat"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f0
        f3 = f3 * f0
        f4 = f1
        f4 = f4 * f1
        f5 = f2
        f5 = f5 * f2
        fc_a = f5
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f5
            f5 = f3
            f3 = ft
            ft = f5
            f5 = f2
            f2 = ft
            ft = f5
            f5 = f0
            f0 = ft
            ft = f5
            f5 = f2
            f2 = ft
        }
        fc_a = f5
        fc_b = f4
        if fc_a > fc_b {
        } else {
            ft = f5
            f5 = f4
            f4 = ft
            ft = f5
            f5 = f2
            f2 = ft
            ft = f5
            f5 = f1
            f1 = ft
            ft = f5
            f5 = f2
            f2 = ft
        }
        ft = f5
        f5 = f4
        f4 = ft
        fc_a = f5
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f5
            f5 = f3
            f3 = ft
            ft = f5
            f5 = f1
            f1 = ft
            ft = f5
            f5 = f0
            f0 = ft
            ft = f5
            f5 = f1
            f1 = ft
        }
        ft = f5
        f5 = f4
        f4 = ft
        f4 = f5 - f4
        f3 = f4 - f3
        f3 = f3 + cx
        x = f3
        f1 = f1 * f2
        f0 = f0 * f2
        f1 = f1 + f1
        f1 = f1 + cy
        y = f1
        f0 = f0 + f0
        f0 = f0 + cz
        z = f0
    }
}

formula "MsltoeSym2" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MsltoeSym2. A formula made by Msltoe at fractalforums.com, one iteration:"
    de numeric
    alias "MsltoeSym2"
    param o0_y_multiplier "Y multiplier" = 1.0 [-1.0, 3.0] 
    init {
        let k16 = o0_y_multiplier
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f1 = z
        f2 = y
        f3 = f1
        f3 = abs(f3)
        f4 = f2
        f4 = abs(f4)
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f1
        ft = f2
        f2 = f0
        f0 = ft
        if fc_a < fc_b {
        } else {
            f2 = -f2
        }
        f3 = f1
        f3 = f3 * f3
        f3 = f3 / rout
        f4 = 1.0
        f3 = f4 - f3
        f4 = f2
        f4 = f4 * f4
        f5 = f0
        f5 = f5 * f5
        f6 = f4
        f6 = f6 - f5
        f6 = f6 * f3
        f6 = f6 + cx
        x = f6
        f4 = f4 + f5
        f4 = sqrt(f4)
        f1 = f1 * f4
        f2 = f2 * f3
        f0 = f0 * f2
        f1 = f1 + f1
        z = f1
        f0 = f0 + f0
        f0 = f0 * k16
        f0 = f0 + cy
        y = f0
    }
}

formula "MsltoeSym3" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MsltoeSym3. A formula made by Msltoe at fractalforums.com, one iteration:"
    de numeric
    alias "MsltoeSym3"
    param o0_y_multiplier "Y multiplier" = 1.0 [-1.0, 3.0] 
    init {
