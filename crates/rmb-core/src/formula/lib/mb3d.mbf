formula "_setw" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _setw. Normally, w and cw are zero, so you see 4D effect indirectly."
    de numeric
    alias "_setw"
    param o0_power_mode "Power mode" = 0.0 [-2.0, 2.0] int
    param o1_power "Power" = 2.0 [-2.0, 6.0] 
    param o2_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o3_y_mul "Y mul" = 0.0 [-2.0, 2.0] 
    param o4_z_mul "Z mul" = 0.0 [-2.0, 2.0] 
    init {
        let k44 = o4_z_mul
        let k36 = o3_y_mul
        let k28 = o2_x_mul
        let k20 = o1_power
        let k12 = round(o0_power_mode)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        let m20 = 0.0
        if k12 == 0.0 {
            f0 = x
            f0 = f0 * k28
            f1 = y
            f1 = f1 * k36
            f2 = z
            f2 = f2 * k44
            f1 = f1 + f2
            f0 = f0 + f1
            f1 = k28
            f1 = f1 + k36
            f1 = f1 + k44
            f0 = f0 / f1
        } else {
            f0 = k20
            f1 = x
            f1 = abs(f1)
            f0 = f0 * log(f1) * 1.4426950408889634
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            f0 = f0 * k28
            m20 = f0
            f0 = k20
            f1 = y
            f1 = abs(f1)
            f0 = f0 * log(f1) * 1.4426950408889634
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            f0 = f0 * k36
            f0 = f0 + m20
            m20 = f0
            f0 = k20
            f1 = z
            f1 = abs(f1)
            f0 = f0 * log(f1) * 1.4426950408889634
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            f0 = f0 * k44
            f0 = f0 + m20
            f1 = k28
            f1 = f1 + k36
            f1 = f1 + k44
            f0 = f0 / f1
            f1 = k20
            f2 = 1.0
            f1 = f1 / f2
            ft = f1
            f1 = f0
            f0 = ft
            f0 = f0 * log(f1) * 1.4426950408889634
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
        }
        w = f0
        cw = f0
    }
}

formula "_skew" {
