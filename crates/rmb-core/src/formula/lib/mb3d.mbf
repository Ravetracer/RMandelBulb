    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 0.5 [-1.5, 2.5] 
    param o4_cscale_w "CScale W" = 0.5 [-1.5, 2.5] 
    param o5_rotation_yz "Rotation YZ" = 0.0 [-180.0, 180.0] angle
    param o6_rotation_xz "Rotation XZ" = 0.0 [-180.0, 180.0] angle
    param o7_rotation_xy "Rotation XY" = 0.0 [-180.0, 180.0] angle
    param o8_rotation_xw "Rotation XW" = 0.0 [-180.0, 180.0] angle
