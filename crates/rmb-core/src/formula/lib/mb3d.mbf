        let k24 = o1_y_center
        let k16 = o0_x_center
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let r_eax = 0.0
        if k88 != 1.0 {
            if k88 != 2.0 {
                if k88 != 3.0 {
