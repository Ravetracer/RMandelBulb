        let k68 = single(sin(o3_rotate_x * pi / 180.0) * sin(o5_rotate_z * pi / 180.0) - cos(o3_rotate_x * pi / 180.0) * sin(o4_rotate_y * pi / 180.0) * cos(o5_rotate_z * pi / 180.0))
        let k64 = single(-sin(o3_rotate_x * pi / 180.0) * cos(o4_rotate_y * pi / 180.0))
        let k60 = single(cos(o3_rotate_x * pi / 180.0) * cos(o5_rotate_z * pi / 180.0) - sin(o3_rotate_x * pi / 180.0) * sin(o4_rotate_y * pi / 180.0) * sin(o5_rotate_z * pi / 180.0))
        let k56 = single(sin(o3_rotate_x * pi / 180.0) * sin(o4_rotate_y * pi / 180.0) * cos(o5_rotate_z * pi / 180.0) + cos(o3_rotate_x * pi / 180.0) * sin(o5_rotate_z * pi / 180.0))
        let k52 = single(sin(o4_rotate_y * pi / 180.0))
        let k48 = single(-cos(o4_rotate_y * pi / 180.0) * sin(o5_rotate_z * pi / 180.0))
        let k44 = single(cos(o4_rotate_y * pi / 180.0) * cos(o5_rotate_z * pi / 180.0))
        let k40 = o2_fold
        let k32 = sqr(max(1.0e-40, o1_min_r))
