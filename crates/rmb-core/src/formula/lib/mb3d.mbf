formula "gyroidIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula gyroidIFS. Approximation of the gyroid minimal surface."
    de difs
    alias "gyroidIFS"
    param o0_size "Size" = 1.5 [-1.5, 4.5] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_density "Density" = 6.28 [-6.28, 18.84] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_gyrot_x "GyRot X" = 0.0 [-180.0, 180.0] angle
    param o8_gyrot_y "GyRot Y" = 0.0 [-180.0, 180.0] angle
    param o9_gyrot_z "GyRot Z" = 0.0 [-180.0, 180.0] angle
    param o10_trapcolor_density "TrapColor Density" = 1.0 [-1.0, 3.0] 
    init {
        let k120 = o10_trapcolor_density
        let k112 = single(cos(o7_gyrot_x * pi / 180.0) * cos(o8_gyrot_y * pi / 180.0))
        let k108 = single(cos(o7_gyrot_x * pi / 180.0) * sin(o8_gyrot_y * pi / 180.0) * sin(o9_gyrot_z * pi / 180.0) + sin(o7_gyrot_x * pi / 180.0) * cos(o9_gyrot_z * pi / 180.0))
        let k104 = single(sin(o7_gyrot_x * pi / 180.0) * sin(o9_gyrot_z * pi / 180.0) - cos(o7_gyrot_x * pi / 180.0) * sin(o8_gyrot_y * pi / 180.0) * cos(o9_gyrot_z * pi / 180.0))
        let k100 = single(-sin(o7_gyrot_x * pi / 180.0) * cos(o8_gyrot_y * pi / 180.0))
        let k96 = single(cos(o7_gyrot_x * pi / 180.0) * cos(o9_gyrot_z * pi / 180.0) - sin(o7_gyrot_x * pi / 180.0) * sin(o8_gyrot_y * pi / 180.0) * sin(o9_gyrot_z * pi / 180.0))
        let k92 = single(sin(o7_gyrot_x * pi / 180.0) * sin(o8_gyrot_y * pi / 180.0) * cos(o9_gyrot_z * pi / 180.0) + cos(o7_gyrot_x * pi / 180.0) * sin(o9_gyrot_z * pi / 180.0))
        let k88 = single(sin(o8_gyrot_y * pi / 180.0))
        let k84 = single(-cos(o8_gyrot_y * pi / 180.0) * sin(o9_gyrot_z * pi / 180.0))
        let k80 = single(cos(o8_gyrot_y * pi / 180.0) * cos(o9_gyrot_z * pi / 180.0))
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_density
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_size
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m16 = 0.0
        let m24 = 0.0
        let m32 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m32 = x0l
        m24 = x0h
        m16 = x1l
        f0 = m16
        f1 = m24
        f2 = m32
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        m32 = f2
        m24 = f1
        m16 = f0
        f0 = m16
        f0 = f0 * k72
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = m24
        f2 = f2 * k72
        f3 = cos(f2)
        f2 = sin(f2)
        f4 = m32
        f4 = f4 * k72
        f5 = cos(f4)
        f4 = sin(f4)
        f2 = f2 * f5
        f1 = f1 * f4
        f0 = f0 * f3
        f3 = f2
        f3 = f3 - f1
        f3 = f3 - f0
        f3 = f3 * k120
        f3 = abs(f3)
        a2 = f3
        f1 = f1 + f2
        f0 = f0 + f1
        f1 = m16
        f1 = abs(f1)
        f2 = m24
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        f2 = m32
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f1 = f2
        }
        f1 = f1 - k16
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        f0 = f0 / k72
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "heartKluchIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula heartKluchIFS. Isosurface invented and shared by Alex Kluchikov (22 Aug 2003)."
    de difs
    alias "heartKluchIFS"
    param o0_otrapoffset "OTrapOffset" = 0.0 [-2.0, 2.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_apply_scale_add "Apply scale+add" = 0.0 [-2.0, 2.0] int
    param o6_otraponits "OTrapOnIts" = 0.25 [-1.75, 2.25] 
    param o7_rotate_x "Rotate X" = 0.0 [-180.0, 180.0] angle
    param o8_rotate_y "Rotate Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotate_z "Rotate Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_rotate_x * pi / 180.0) * cos(o8_rotate_y * pi / 180.0))
        let k108 = single(cos(o7_rotate_x * pi / 180.0) * sin(o8_rotate_y * pi / 180.0) * sin(o9_rotate_z * pi / 180.0) + sin(o7_rotate_x * pi / 180.0) * cos(o9_rotate_z * pi / 180.0))
        let k104 = single(sin(o7_rotate_x * pi / 180.0) * sin(o9_rotate_z * pi / 180.0) - cos(o7_rotate_x * pi / 180.0) * sin(o8_rotate_y * pi / 180.0) * cos(o9_rotate_z * pi / 180.0))
        let k100 = single(-sin(o7_rotate_x * pi / 180.0) * cos(o8_rotate_y * pi / 180.0))
        let k96 = single(cos(o7_rotate_x * pi / 180.0) * cos(o9_rotate_z * pi / 180.0) - sin(o7_rotate_x * pi / 180.0) * sin(o8_rotate_y * pi / 180.0) * sin(o9_rotate_z * pi / 180.0))
        let k92 = single(sin(o7_rotate_x * pi / 180.0) * sin(o8_rotate_y * pi / 180.0) * cos(o9_rotate_z * pi / 180.0) + cos(o7_rotate_x * pi / 180.0) * sin(o9_rotate_z * pi / 180.0))
        let k88 = single(sin(o8_rotate_y * pi / 180.0))
        let k84 = single(-cos(o8_rotate_y * pi / 180.0) * sin(o9_rotate_z * pi / 180.0))
        let k80 = single(cos(o8_rotate_y * pi / 180.0) * cos(o9_rotate_z * pi / 180.0))
        let k76 = o6_otraponits
        let k68 = round(o5_apply_scale_add)
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_otrapoffset
    }
    iter {
