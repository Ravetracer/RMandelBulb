            f5 = f5 + f0
        }
        ft = f5
        f5 = f2
        f2 = ft
        ft = f4
        f4 = f1
        f1 = ft
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f0
        f3 = f3 * k64
        f4 = cos(f3)
        f3 = sin(f3)
        m20 = f4
        m28 = f3
        f3 = f1
        f3 = f3 * k64
        f4 = cos(f3)
        f3 = sin(f3)
        m36 = f4
        m44 = f3
        f3 = f2
        f3 = f3 * k64
        f4 = cos(f3)
        f3 = sin(f3)
        m52 = f4
        m60 = f3
        f3 = f2
        f3 = f3 * f3
        f4 = f1
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        m68 = f3
        f3 = m20
        f3 = f3 * m44
        f4 = m36
        f4 = f4 * m60
        f3 = f3 + f4
        f4 = m52
        f4 = f4 * m28
        f3 = f3 + f4
        f3 = f3 * k56
        f4 = m20
        f4 = f4 + m36
        f4 = f4 + m52
        f4 = f4 * k72
        if k84 == 1.0 {
