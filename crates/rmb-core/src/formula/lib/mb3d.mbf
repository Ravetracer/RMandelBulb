formula "_FoldingInfy" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _FoldingInfy. Continuous, seamless folding of 4D space. Boxtiling 'enhanced' version."
    de numeric
    transform
    descale 10.0
    alias "_FoldingInfy"
    param o0_x_fold "x Fold" = 5.0 [-5.0, 15.0] 
    param o1_y_fold "y Fold" = 5.0 [-5.0, 15.0] 
    param o2_z_fold "z Fold" = 5.0 [-5.0, 15.0] 
    param o3_w_fold "w Fold" = 5.0 [-5.0, 15.0] 
    init {
        let k40 = o3_w_fold
        let k32 = o2_z_fold
        let k24 = o1_y_fold
        let k16 = o0_x_fold
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = k40
        fc_a = f0
        fc_b = 0.0
        if fc_a == fc_b {
        } else {
            f0 = k40
            f0 = f0 + f0
            f0 = f0 + f0
            f1 = dr
            f2 = f1
            f2 = f2 / f0
            f2 = round(f2)
