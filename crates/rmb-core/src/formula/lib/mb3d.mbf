        f3 = f3 + f4
        f4 = f0
        f4 = f4 * f4
        f3 = f3 + f4
        fc_a = f3
        fc_b = k72
        if fc_a >= fc_b {
            f3 = 1.0
        } else {
            fc_a = f3
            fc_b = k80
            if fc_a >= fc_b {
            } else {
                f3 = k80
            }
            f4 = k72
