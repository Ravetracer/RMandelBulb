        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m66 = x0l
        m58 = x0h
        m50 = x1l
        f0 = m66
        f1 = m58
        f0 = atan2(f0, f1)
        f0 = 1.57079632675 - f0
        f0 = f0 * 0.159154943
        f0 = f0 * k80
        m18 = round(f0)
        f0 = m18
        f0 = f0 / k80
        f0 = f0 * (-6.283185307)
        f1 = cos(f0)
        f0 = sin(f0)
        m42 = f1
        m34 = f0
        f0 = m66
        f0 = f0 * m42
        f1 = m58
        f1 = f1 * m34
        f1 = -f1
        f0 = f0 + f1
        f1 = m66
        f1 = f1 * m34
        f2 = m58
        f2 = f2 * m42
        f1 = f1 + f2
        f1 = f1 * k104
        f1 = abs(f1)
        f0 = f0 + f1
        m66 = f0
        f0 = m50
        m26 = f0
        f1 = k96
        f0 = f0 + f1
        f0 = -f0
        m50 = f0
        f0 = 0.017453293
        f0 = f0 * k72
        f1 = cos(f0)
        f0 = sin(f0)
        m42 = f1
        m34 = f0
        f0 = m66
        f0 = f0 * m34
        f1 = m50
        f1 = f1 * m42
        f0 = f0 + f1
        f1 = m26
        f1 = f1 - k88
        f1 = abs(f1)
        f1 = f1 - k16
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
        f0 = i
        f0 = f0 * k112
        f0 = f0 + k120
        f1 = m18
        f1 = f1 * k128
        f0 = f0 + f1
        f0 = abs(f0)
