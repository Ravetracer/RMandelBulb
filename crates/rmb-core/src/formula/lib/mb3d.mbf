formula "LimpetIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula LimpetIFS. Limpet torus. An 'ufoid'..."
    de difs
    alias "LimpetIFS"
    param o0_r1 "R1" = 1.2 [-1.2, 3.5999999999999996] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_r2 "R2" = 1.0 [-1.0, 3.0] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_rmul "Rmul" = -1.6 [-4.800000000000001, 1.6] 
    param o8_limpetrot_x "LimpetRot X" = 0.0 [-180.0, 180.0] angle
    param o9_limpetrot_y "LimpetRot Y" = 0.0 [-180.0, 180.0] angle
    param o10_limpetrot_z "LimpetRot Z" = 0.0 [-180.0, 180.0] angle
    init {
