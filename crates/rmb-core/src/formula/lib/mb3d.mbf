        cy = f1
        cx = f0
    }
}

formula "_gnarl2D" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _gnarl2D. Gnarl deformation in 2D (from Mark Townsend) - variation with step X & Y and strength"
