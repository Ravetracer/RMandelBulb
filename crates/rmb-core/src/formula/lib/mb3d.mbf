    de numeric
    transform
    alias "_HopSqrtX"
    param o0_fixx "fixX" = 0.0 [-2.0, 2.0] 
    param o1_fixsq "fixSq" = 0.0 [-2.0, 2.0] 
    param o2_mul "Mul" = 1.0 [-1.0, 3.0] 
    param o3_div "Div" = 1.0 [-1.0, 3.0] 
    init {
