    param o0_x_above "X above" = 999.0 [-999.0, 2997.0] 
    param o1_x_below "X below" = -999.0 [-2997.0, 999.0] 
    param o2_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o3_y_above "Y above" = 999.0 [-999.0, 2997.0] 
    param o4_y_below "Y below" = -999.0 [-2997.0, 999.0] 
    param o5_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o6_z_above "Z above" = 999.0 [-999.0, 2997.0] 
    param o7_z_below "Z below" = -999.0 [-2997.0, 999.0] 
    param o8_z_add "Z add" = 0.0 [-2.0, 2.0] 
    init {
        let k80 = o8_z_add
        let k72 = o7_z_below
        let k64 = o6_z_above
        let k56 = o5_y_add
        let k48 = o4_y_below
        let k40 = o3_y_above
        let k32 = o2_x_add
        let k24 = o1_x_below
        let k16 = o0_x_above
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = px
        fc_a = f0
        fc_b = k16
        if fc_a > fc_b {
            f0 = f0 + k32
            cx = f0
        } else {
            fc_a = f0
            fc_b = k24
            if fc_a > fc_b {
            } else {
                f0 = f0 + k32
                cx = f0
            }
        }
        f1 = py
        fc_a = f1
        fc_b = k40
        if fc_a > fc_b {
            f1 = f1 + k56
            cy = f1
        } else {
            fc_a = f1
            fc_b = k48
            if fc_a > fc_b {
            } else {
                f1 = f1 + k56
                cy = f1
            }
        }
        f2 = pz
        fc_a = f2
        fc_b = k64
        if fc_a > fc_b {
            f2 = f2 + k80
            cz = f2
