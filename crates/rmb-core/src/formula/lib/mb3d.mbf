        f0 = f0 - f1
        f1 = f0
        f1 = f1 * f1
        f2 = (-0.557168173477934)
        f2 = f2 * f1
        f2 = f2 + 2.54331059122659
        f2 = f2 * f1
        f2 = f2 + (-5.16737525132345)
        f1 = f1 * f2
        f1 = f1 + 3.141592653589793
        f0 = f0 * f1
        r_eax = m28
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax == 0.0 {
        } else {
            f0 = -f0
        }
        f0 = f0 * k24
        f1 = z
        f1 = f1 * k48
        f1 = f1 * 0.3183098861837907
        m28 = round(f1)
        f2 = m28
        f1 = f1 - f2
        f2 = f1
        f2 = f2 * f2
        f3 = (-0.557168173477934)
        f3 = f3 * f2
        f3 = f3 + 2.54331059122659
        f3 = f3 * f2
        f3 = f3 + (-5.16737525132345)
        f2 = f2 * f3
        f2 = f2 + 3.141592653589793
        f1 = f1 * f2
        r_eax = m28
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax == 0.0 {
        } else {
            f1 = -f1
        }
        f1 = f1 * k32
        f0 = f0 + f1
        f0 = -f0
        f0 = f0 + x
        f0 = f0 * k16
        f1 = z
        f1 = f1 * k40
        f1 = f1 + 1.5707963267948966
        f1 = f1 * 0.3183098861837907
        m28 = round(f1)
        f2 = m28
        f1 = f1 - f2
        f2 = f1
        f2 = f2 * f2
        f3 = (-0.557168173477934)
        f3 = f3 * f2
        f3 = f3 + 2.54331059122659
        f3 = f3 * f2
        f3 = f3 + (-5.16737525132345)
        f2 = f2 * f3
        f2 = f2 + 3.141592653589793
        f1 = f1 * f2
        r_eax = m28
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax == 0.0 {
        } else {
            f1 = -f1
        }
        f1 = f1 * k24
        f2 = x
        f2 = f2 * k48
        f2 = f2 * 0.3183098861837907
        m28 = round(f2)
        f3 = m28
        f2 = f2 - f3
        f3 = f2
        f3 = f3 * f3
        f4 = (-0.557168173477934)
        f4 = f4 * f3
        f4 = f4 + 2.54331059122659
        f4 = f4 * f3
        f4 = f4 + (-5.16737525132345)
        f3 = f3 * f4
        f3 = f3 + 3.141592653589793
        f2 = f2 * f3
        r_eax = m28
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax == 0.0 {
        } else {
            f2 = -f2
        }
        f2 = f2 * k32
        f1 = f1 + f2
        f1 = -f1
        f1 = f1 + y
        f1 = f1 * k16
        f2 = x
        f2 = f2 * k40
        f2 = f2 + 1.5707963267948966
        f2 = f2 * 0.3183098861837907
        m28 = round(f2)
        f3 = m28
        f2 = f2 - f3
        f3 = f2
        f3 = f3 * f3
        f4 = (-0.557168173477934)
