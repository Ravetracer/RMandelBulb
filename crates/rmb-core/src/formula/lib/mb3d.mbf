            a1 = a1 + 1.0
            f0 = k16
            a0 = f0
        }
        f0 = a0
        f1 = 1.0
        f2 = f0
        f2 = abs(f2)
        f1 = f2 - f1
        f1 = f1 * k48
        f0 = f0 + f1
        a0 = f0
        f0 = k40
        f1 = f0
        f2 = f1
        f0 = f0 + f2
        f2 = -f2
        f3 = x
        fc_a = f3
        fc_b = f1
        if fc_a < fc_b {
            fc_a = f3
            fc_b = f2
            if fc_a >= fc_b {
            } else {
                f3 = -f3
                f3 = f3 - f0
            }
        } else {
            f3 = -f3
            f3 = f3 + f0
        }
        f4 = y
        fc_a = f4
        fc_b = f1
        if fc_a < fc_b {
            fc_a = f4
            fc_b = f2
            if fc_a >= fc_b {
            } else {
                f4 = -f4
                f4 = f4 - f0
            }
        } else {
            f4 = -f4
            f4 = f4 + f0
        }
        f5 = z
        fc_a = f5
        fc_b = f1
        if fc_a < fc_b {
            fc_a = f5
            fc_b = f2
            if fc_a >= fc_b {
            } else {
                f5 = -f5
                f5 = f5 - f0
            }
        } else {
