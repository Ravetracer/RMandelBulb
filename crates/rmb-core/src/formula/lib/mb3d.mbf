    de difs
    alias "diniIFS"
    param o0_pseudo_radius "Pseudo Radius" = 3.0 [-3.0, 9.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_max_radius "Max Radius" = 2.85 [-2.85, 8.55] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_thickness "Thickness" = 0.001 [-1.999, 2.001] 
    param o8_min_radius "Min Radius" = 0.1 [-1.9, 2.1] 
    param o9_flip_xz_yz "Flip XZ / YZ" = 0.0 [-2.0, 2.0] int
    param o10_upside_down "Upside down" = 0.0 [-2.0, 2.0] int
    param o11_spiral_tightness "Spiral tightness" = 0.2 [-1.8, 2.2] 
    init {
        let k108 = o11_spiral_tightness
        let k100 = round(o10_upside_down)
        let k96 = round(o9_flip_xz_yz)
        let k92 = o8_min_radius
        let k84 = o7_thickness
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_max_radius
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_pseudo_radius
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m22 = 0.0
        let m30 = 0.0
        let m38 = 0.0
        let m46 = 0.0
        let m54 = 0.0
        let m62 = 0.0
        let m70 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m70 = x0l
        m62 = x0h
        m54 = x1l
        f0 = 1e200
        m30 = f0
        if k96 != 1.0 {
        } else {
            f0 = m70
            f1 = m54
            m70 = f1
            m54 = f0
        }
        if k96 != (-1.0) {
        } else {
            f0 = m62
            f1 = m54
            m62 = f1
            m54 = f0
        }
        if k100 == 0.0 {
        } else {
            f0 = m54
            f0 = -f0
            m54 = f0
        }
        r_edx = 3.0
        loop {
            f0 = m62
            f0 = -f0
            m38 = f0
            f0 = m70
            f0 = -f0
            m22 = f0
            f0 = m62
            f0 = f0 - m70
            f1 = m62
            f1 = f1 + m70
            f0 = atan2(f0, f1)
            f0 = f0 * k108
            m46 = f0
            f0 = m70
            f0 = f0 * f0
            f1 = m62
            f1 = f1 * f1
            f0 = f0 + f1
            m62 = f0
            f0 = sqrt(f0)
            m70 = f0
            f0 = k16
            f0 = f0 * f0
            f0 = f0 - m62
            f1 = f0
            f1 = abs(f1)
            f0 = f0 + f1
            f0 = sqrt(f0)
            f1 = f0
            f1 = f1 + k16
            f1 = f1 / m70
            f2 = 0.6931471805599453
            ft = f2
            f2 = f1
            f1 = ft
            f1 = f1 * log(f2) * 1.4426950408889634
            f1 = f1 * k16
            ft = f1
            f1 = f0
            f0 = ft
            f1 = -f1
            f0 = f0 + f1
            f0 = f0 - m46
            f0 = f0 - m54
            f0 = abs(f0)
            f0 = f0 - k84
            f1 = m70
            f1 = f1 * 0.3
            f1 = f1 + 0.02
            f1 = abs(f1)
            f0 = f0 * f1
            f1 = m70
            f1 = f1 - k72
            fc_a = f1
            fc_b = f0
            if fc_a >= fc_b {
                f0 = f1
            }
            f1 = m70
            f1 = k92 - f1
            fc_a = f1
            fc_b = f0
            if fc_a >= fc_b {
                f0 = f1
            }
            f1 = m38
            fc_a = f1
            fc_b = f0
            if fc_a >= fc_b {
                f0 = f1
            }
            fc_a = f0
            fc_b = m30
            if fc_a >= fc_b {
            } else {
                m30 = f0
            }
            f0 = m22
            m70 = f0
            f0 = m38
            m62 = f0
            f0 = m54
            f1 = k108
            f2 = 3.141592653589793
            f1 = f1 * f2
            f0 = f0 + f1
            m54 = f0
            r_edx = r_edx - 1.0
            if r_edx > 0.0 {
                continue
            } else {
                break
            }
        }
        f0 = m30
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "discoballIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula discoballIFS. Plots a 'faceted' sphere using the powerful PolyFoldEx."
    de difs
    alias "discoballIFS"
