        f1 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k96
        f2 = f2 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f2 = f2 + f3
