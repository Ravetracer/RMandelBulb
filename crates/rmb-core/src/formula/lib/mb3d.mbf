}

formula "cylinderIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula cylinderIFS. Cylinder shape dIFS with OTrap coloring options:"
    de difs
    alias "cylinderIFS"
    param o0_radius "Radius" = 1.0 [-1.0, 3.0] 
    param o1_x_halfwidth "X halfwidth" = 1.0 [-1.0, 3.0] 
    param o2_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o3_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o4_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o5_x_add "X add" = 3.0 [-3.0, 9.0] 
    param o6_barrel "Barrel" = 0.0 [-2.0, 2.0] 
    param o7_tip "Tip" = 0.0 [-2.0, 2.0] 
    param o8_apply_scale_add "apply scale+add" = 1.0 [-1.0, 3.0] int
    param o9_otrap_option_0_3 "OTrap option (0..3)" = 0.0 [-2.0, 2.0] int
    param o10_otrap_offset "OTrap offset" = 1.0 [-1.0, 3.0] 
    param o11_otrap_scale "OTrap scale" = 1.0 [-1.0, 3.0] 
    param o12_inside_radius "Inside radius" = -1.0 [-3.0, 1.0] 
    init {
        let k112 = o12_inside_radius
        let k104 = single(o11_otrap_scale)
        let k100 = single(o10_otrap_offset)
        let k96 = round(o9_otrap_option_0_3)
        let k92 = round(o8_apply_scale_add)
        let k88 = o7_tip
        let k80 = o6_barrel
        let k72 = o5_x_add
        let k64 = o4_y_add
        let k56 = o3_z_add
        let k48 = o2_scale
        let k40 = o2_scale
        let k32 = o1_x_halfwidth
        let k16 = o0_radius
    }
    iter {
        let f0 = 0.0
        let ft = 0.0
        let r_eax = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x2l = 0.0
        let x2h = 0.0
        let x3l = 0.0
        let x3h = 0.0
        let x4l = 0.0
        let x4h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        x0l = y
        x0h = z
        x1l = x
        x1h = 0.0
        ft = x0h * k40
        x0l = x0l * k48
        x0h = ft
        x1l = x1l * k48
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k72
        if k92 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k48
            y = x0l
            z = x0h
            x = x1l
            a0 = x5l
        }
        x4l = x1l
        x4h = x1h
        ft = x0h * x0h
        x0l = x0l * x0l
        x0h = ft
        x1l = abs(x1l)
        x1h = abs(x1h)
        ft = x0l
        x2l = x0h
        x2h = ft
        x3l = x1l
        x3h = x1h
        x1l = x1l - k32
        x0l = x0l + x2l
        x3l = sel(x3l < k32, x3l, k32)
        x4l = x4l * k88
        x3l = x3l * x3l
        x0l = sqrt(x0l)
        x2l = k112
        x2h = 0.0
        x3l = x3l * k80
        x2l = x2l - x0l
        x0l = x0l - k16
        x2l = x2l - x3l
        x0l = x0l + x3l
        x2l = x2l - x4l
        x0l = x0l + x4l
        x0l = sel(x0l > x2l, x0l, x2l)
        x0l = sel(x0l > x1l, x0l, x1l)
        if k92 != 0.0 {
        } else {
            x0l = x0l / k48
        }
        r_eax = k96
        rout = x0l
        r_eax = (r_eax - 4.0 * floor(r_eax / 4.0))
        f0 = sel(r_eax == 0.0, 0.0, sel(r_eax == 1.0, x, sel(r_eax == 2.0, y, z)))
        f0 = f0 * k104
        f0 = f0 + k100
        a2 = f0
    }
}

formula "diniIFS" {
    category "MB3D dIFS"
