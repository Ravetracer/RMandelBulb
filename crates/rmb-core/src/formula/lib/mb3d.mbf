formula "_AmazingBox" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _AmazingBox. The amazing box formula without adding the C component."
    de linear
    alias "_AmazingBox"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_min_r "Min R" = 0.5 [-1.5, 2.5] 
    init {
        let k32 = sqr(max(1.0e-40, o1_min_r))
        let k24 = o0_scale / sqr(max(1.0e-40, o1_min_r))
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        f0 = 1.0
        f1 = x
        f2 = f1
        f2 = f2 - f0
        f2 = abs(f2)
        f2 = f2 + f1
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 + f0
        f2 = abs(f2)
        f1 = f2 - f1
        f2 = y
        f3 = f2
        f3 = f3 - f0
        f3 = abs(f3)
        f3 = f3 + f2
        ft = f3
        f3 = f2
        f2 = ft
        f3 = f3 + f0
        f3 = abs(f3)
        f2 = f3 - f2
        f3 = z
        f4 = f3
        f4 = f4 - f0
        f4 = abs(f4)
        f4 = f4 + f3
        ft = f4
        f4 = f3
        f3 = ft
        f4 = f4 + f0
        f4 = abs(f4)
        f3 = f4 - f3
        f4 = f3
        f4 = f4 * f3
        f5 = f2
        f5 = f5 * f2
        f4 = f4 + f5
        f5 = f1
        f5 = f5 * f1
        f4 = f4 + f5
        fc_a = f4
        fc_b = k32
        if fc_a >= fc_b {
            f5 = 1.0
            fc_a = f5
            fc_b = f4
            if fc_a < fc_b {
                fc_a = f5
                fc_b = f4
                f4 = k16
            } else {
                f4 = k16 / f4
            }
            r_eax = sel(fc_a < fc_b, 2048.0, sel(fc_a == fc_b, 10240.0, 2048.0))
        } else {
            f4 = k24
            r_eax = sel(fc_a < fc_b, 3072.0, sel(fc_a == fc_b, 11264.0, 3072.0))
        }
        f5 = dr
        f5 = f5 * f4
        dr = f5
        f1 = f1 * f4
        f2 = f2 * f4
        f3 = f3 * f4
        z = f3
        y = f2
        x = f1
    }
}

formula "_AmazingBoxSSE2" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _AmazingBoxSSE2. The amazing box formula without adding the C component."
    de linear
    alias "_AmazingBoxSSE2"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_min_r "Min R" = 0.5 [-1.5, 2.5] 
    param o2_fold "Fold" = 1.0 [-1.0, 3.0] 
    init {
        let k64 = -o2_fold
        let k56 = -o2_fold
        let k48 = o2_fold
        let k40 = o2_fold
        let k32 = sqr(max(1.0e-40, o1_min_r))
        let k24 = o0_scale / sqr(max(1.0e-40, o1_min_r))
        let k16 = o0_scale
    }
    iter {
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x2l = 0.0
        let x2h = 0.0
        let x3l = 0.0
        let x3h = 0.0
        let x4l = 0.0
        let x4h = 0.0
        let x5l = 0.0
        x2l = x
        x2h = y
        x4l = z
        x4h = 0.0
        x0l = x2l
        x0h = x2h
        ft = sel(x0h > k56, x0h, k56)
        x0l = sel(x0l > k64, x0l, k64)
        x0h = ft
        x4l = sel(x4l > k64, x4l, k64)
        ft = sel(x0h < k40, x0h, k40)
        x0l = sel(x0l < k48, x0l, k48)
        x0h = ft
        x4l = sel(x4l < k48, x4l, k48)
        ft = x0h + x0h
        x0l = x0l + x0l
        x0h = ft
        x4l = x4l + x4l
        ft = x0h - x2h
        x0l = x0l - x2l
        x0h = ft
        x4l = x4l - z
        x1l = x0l
        x1h = x0h
        x5l = x4l
        ft = x1h * x1h
        x1l = x1l * x1l
        x1h = ft
        x5l = x5l * x5l
        ft = x1l
        x2l = x1h
        x2h = ft
        x1l = x1l + x5l
        x1l = x1l + x2l
        fc_a = x1l
        fc_b = k32
        if fc_a >= fc_b {
            fc_a = x1l
            fc_b = 1.0
            x3l = k16
            x3h = 0.0
            if fc_a >= fc_b {
            } else {
                x3l = x3l / x1l
            }
        } else {
            x3l = k24
            x3h = 0.0
        }
        x4h = dr
        ft = x3l
        x3h = ft
        ft = x0h * x3h
        x0l = x0l * x3l
        x0h = ft
        ft = x4h * x3h
        x4l = x4l * x3l
        x4h = ft
        x = x0l
        y = x0h
        z = x4l
        dr = x4h
    }
}

formula "_Atan4D" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _Atan4D. *** NOTE ***"
    de numeric
    alias "_Atan4D"
    param o0_px "Px" = 0.0 [-2.0, 2.0] 
    param o1_py "Py" = 0.0 [-2.0, 2.0] 
    param o2_pz "Pz" = 0.0 [-2.0, 2.0] 
    param o3_pw "Pw" = 0.0 [-2.0, 2.0] 
    param o4_a "a" = 1.4 [-1.4, 4.199999999999999] 
    init {
        let k48 = o4_a
        let k40 = o3_pw
        let k32 = o2_pz
        let k24 = o1_py
        let k16 = o0_px
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        f0 = x
        f0 = f0 + k16
        x = f0
        f0 = y
        f0 = f0 + k24
        y = f0
        f0 = z
        f0 = f0 + k32
        z = f0
        f0 = w
        f0 = f0 + k40
        w = f0
        f0 = w
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = f0
        f2 = 1e-5
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
            f0 = x
            f1 = 1.0
            f0 = atan2(f0, f1)
            x = f0
            r_eax = sel(fc_a < fc_b, 7168.0, sel(fc_a == fc_b, 15360.0, 7168.0))
        } else {
            f1 = x
            fc_a = f1
            fc_b = 0.0
            if fc_a != fc_b {
                f1 = f0
                f1 = -f1
                f2 = 1.0
                f1 = f1 + f2
                f2 = x
                ft = f2
                f2 = f1
                f1 = ft
                f1 = atan2(f1, f2)
                f2 = f0
                f3 = 1.0
                f2 = f2 + f3
                f3 = x
                f3 = -f3
                ft = f3
                f3 = f2
                f2 = ft
                f2 = atan2(f2, f3)
                f2 = -f2
                f1 = f1 + f2
                f1 = f1 * 0.5
                f2 = f0
                f3 = 1.0
                f2 = f2 + f3
                f2 = f2 * f2
                f3 = x
                f3 = f3 * f3
                f2 = f2 + f3
                f3 = f0
                f3 = -f3
                f4 = 1.0
                f3 = f3 + f4
                f3 = f3 * f3
                f4 = x
                f4 = f4 * f4
                f3 = f3 + f4
                f2 = f2 / f3
                f3 = 0.6931471805599453
                ft = f3
                f3 = f2
                f2 = ft
                f2 = f2 * log(f3) * 1.4426950408889634
                f2 = f2 * 0.25
                f2 = f2 / f0
                f3 = f1
                f3 = f3 * k48
                x = f3
                f3 = y
                f3 = f3 * k48
                f3 = f3 * f2
                y = f3
                f3 = z
                f3 = f3 * k48
                f3 = f3 * f2
                z = f3
                f3 = w
                f3 = f3 * k48
                f3 = f3 * f2
                w = f3
                r_eax = sel(fc_a < fc_b, 4096.0, sel(fc_a == fc_b, 20480.0, 4096.0))
            } else {
                f1 = f0
                f2 = 1.0
                f2 = -f2
                f1 = f1 + f2
                f1 = abs(f1)
                f2 = 1e-5
                fc_a = f2
                fc_b = f1
                if fc_a >= fc_b {
                    f0 = x
                    f1 = 1.0
                    f0 = atan2(f0, f1)
                    x = f0
                } else {
                    f1 = f0
                    f1 = -f1
                    f2 = 1.0
                    f1 = f1 + f2
                    f2 = x
                    ft = f2
                    f2 = f1
                    f1 = ft
                    f1 = atan2(f1, f2)
                    f2 = f0
                    f3 = 1.0
                    f2 = f2 + f3
                    f3 = x
                    f3 = -f3
                    ft = f3
                    f3 = f2
                    f2 = ft
                    f2 = atan2(f2, f3)
                    f2 = -f2
                    f1 = f1 + f2
                    f1 = f1 * 0.5
                    f2 = f0
                    f3 = 1.0
                    f2 = f2 + f3
                    f2 = f2 * f2
                    f3 = x
                    f3 = f3 * f3
                    f2 = f2 + f3
                    f3 = f0
                    f3 = -f3
                    f4 = 1.0
                    f3 = f3 + f4
                    f3 = f3 * f3
                    f4 = x
                    f4 = f4 * f4
                    f3 = f3 + f4
                    f2 = f2 / f3
                    f3 = 0.6931471805599453
                    ft = f3
                    f3 = f2
                    f2 = ft
                    f2 = f2 * log(f3) * 1.4426950408889634
                    f2 = f2 * 0.25
                    f2 = f2 / f0
                    f3 = f1
                    f3 = f3 * k48
                    x = f3
                    f3 = y
                    f3 = f3 * k48
                    f3 = f3 * f2
                    y = f3
                    f3 = z
                    f3 = f3 * k48
                    f3 = f3 * f2
                    z = f3
                    f3 = w
                    f3 = f3 * k48
                    f3 = f3 * f2
                    w = f3
                }
                r_eax = sel(fc_a < fc_b, 7168.0, sel(fc_a == fc_b, 15360.0, 7168.0))
            }
        }
    }
}

formula "_BPolygonFromCircle" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BPolygonFromCircle. Circle to polygon transform centered on the x axis (transforms yz plane).  I made it for before Pine Tree Mandelbulb, after transform 1.  Use it sparingly... or a lot.  Beware of negative numbers.. mi"
    de numeric
    transform
    alias "_BPolygonFromCircle"
    param o0_sides "Sides" = 4.0 [-4.0, 12.0] 
    init {
        let k16 = o0_sides
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let m12 = 0.0
        let m20 = 0.0
        f0 = 3.1415926535898
        f0 = f0 / k16
        m12 = f0
        f0 = f0 + f0
        m20 = f0
        f0 = z
        f1 = y
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m12
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m20
                continue
            }
        }
        f0 = cos(f0)
        f1 = f0
        f1 = f1 * y
        y = f1
        f0 = f0 * z
        z = f0
    }
}

formula "_BPolygonToCircle" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BPolygonToCircle. Circle to polygon transform centered on the x axis (transforms yz plane).  I made it for before Pine Tree Mandelbulb, after transform 1.  Use it sparingly... or a lot."
    de numeric
    transform
    alias "_BPolygonToCircle"
    param o0_sides "Sides" = 4.0 [-4.0, 12.0] 
    init {
        let k16 = o0_sides
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let m12 = 0.0
        let m20 = 0.0
        f0 = 3.1415926535898
        f0 = f0 / k16
        m12 = f0
        f0 = f0 + f0
        m20 = f0
        f0 = z
        f1 = y
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m12
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m20
                continue
            }
        }
        f0 = cos(f0)
        f1 = 1.0
        f0 = f1 / f0
        f1 = f0
        f1 = f1 * y
        y = f1
        f0 = f0 * z
        z = f0
    }
}

formula "_BPolyhedronFromSphere" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BPolyhedronFromSphere. Sphere to polyhedron transform.  Does not make regular polydedra, except for the cube!  I'm probably going to make a single regular tetrahedron/sphere and a sphere/tetrahedron transform, so we can do "
    de numeric
    transform
    alias "_BPolyhedronFromSphere"
    param o0_sides "Sides" = 4.0 [-4.0, 12.0] 
    param o1_sides2 "Sides2" = 4.0 [-4.0, 12.0] 
    init {
        let k24 = o1_sides2
        let k16 = o0_sides
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = 3.1415926535898
        f0 = f0 / k16
        m12 = f0
        f0 = f0 + f0
        m20 = f0
        f0 = 3.1415926535898
        f0 = f0 / k24
        m28 = f0
        f0 = f0 + f0
        m36 = f0
        f0 = z
        f1 = y
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m12
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m20
                continue
            }
        }
        f0 = cos(f0)
        m20 = f0
        f0 = f0 * y
        m12 = f0
        f0 = f0 * f0
        f1 = m20
        f1 = f1 * z
        m20 = f1
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = x
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m28
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m36
                continue
            }
        }
        f0 = cos(f0)
        f1 = f0
        f2 = f1
        f2 = f2 * m12
        y = f2
        f1 = f1 * m20
        z = f1
        f0 = f0 * x
        x = f0
    }
}

formula "_BPolyhedronToSphere" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BPolyhedronToSphere. Polyhedron to sphere transform. You can make a cube into a sphere, and then make other things out of it.  It doesn't do regular polygons, except the cube, because, well.. it is the inverse function of"
    de numeric
    transform
    alias "_BPolyhedronToSphere"
    param o0_sides "Sides" = 4.0 [-4.0, 12.0] 
    param o1_sides2 "Sides2" = 4.0 [-4.0, 12.0] 
    init {
        let k24 = o1_sides2
        let k16 = o0_sides
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = 3.1415926535898
        f0 = f0 / k16
        m12 = f0
        f0 = f0 + f0
        m20 = f0
        f0 = 3.1415926535898
        f0 = f0 / k24
        m28 = f0
        f0 = f0 + f0
        m36 = f0
        f0 = z
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = x
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m28
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m36
                continue
            }
        }
        f0 = cos(f0)
        f1 = 1.0
        f0 = f1 / f0
        f1 = f0
        f2 = f1
        f2 = f2 * x
        x = f2
        f1 = f1 * y
        m28 = f1
        f0 = f0 * z
        m36 = f0
        f1 = m28
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m12
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m20
                continue
            }
        }
        f0 = cos(f0)
        f1 = 1.0
        f0 = f1 / f0
        f1 = f0
        f1 = f1 * m28
        y = f1
        f0 = f0 * m36
        z = f0
    }
}

formula "_BRotateFromMag" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BRotateFromMag. Rotates from the magnitude axis (-1,-1,-1) --> (1,1,1) to the x-axis (-1,0,0) --> (1,0,0)"
    de numeric
    transform
    alias "_BRotateFromMag"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        f0 = x
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = y
        f0 = f0 * 0.7071067811865475
        m20 = f0
        f0 = m12
        f1 = m20
        f0 = f0 + f1
        m28 = f0
        f0 = m20
        f0 = f0 - m12
        y = f0
        f0 = m28
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f0 = f0 + f1
        x = f0
        f0 = z
        f0 = f0 * 0.816496580927726
        f1 = m28
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f0 = f0 + f1
        z = f0
    }
}

formula "_BRotateToMag" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BRotateToMag. This rotates the whole coordinate system so that the x-axis (-1,0,0) --> (1,0,0) lies on the mag axis (-1,-1,-1) --> (1,1,1)."
    de numeric
    transform
    alias "_BRotateToMag"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let m12 = 0.0
        f0 = x
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = y
        f0 = f0 * 0.7071067811865475
        y = f0
        f0 = x
        f0 = f0 * 0.5773502691896258
        f1 = z
        f1 = f1 * 0.816496580927726
        f0 = f0 + f1
        z = f0
        f0 = m12
        f0 = f0 - y
        x = f0
        f0 = m12
        f0 = f0 + y
        y = f0
    }
}

formula "_BSkewXmaxV1" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BSkewXmaxV1. Alters the x variable- which the T1 Pine Tree Mandelbulb revolves around.  Altering the one variable, rotating around the x axis, doing things to only the x variable... it works well with that particu"
    de numeric
    transform
    alias "_BSkewXmaxV1"
    param o0_xmin "xMin" = 0.707 [-1.2930000000000001, 2.707] 
    param o1_xscale "xScale" = 0.0 [-2.0, 2.0] 
    param o2_xmax "xMax" = 1.414 [-1.414, 4.242] 
    param o3_yzmin "yzMin" = 0.5 [-1.5, 2.5] 
    param o4_yzscale "yzScale" = 0.0 [-2.0, 2.0] 
    param o5_yzmax "yzMax" = 1.0 [-1.0, 3.0] 
    param o6_xpixelmin "xPixelMin" = 0.707 [-1.2930000000000001, 2.707] 
    param o7_xpixelscale "xPixelScale" = 0.0 [-2.0, 2.0] 
    param o8_xpixelmax "xPixelMax" = 1.414 [-1.414, 4.242] 
    init {
        let k72 = o7_xpixelscale
        let k64 = o6_xpixelmin
        let k48 = o4_yzscale
        let k32 = o2_xmax
        let k24 = o1_xscale
        let k16 = o0_xmin
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let m12 = 0.0
        let m20 = 0.0
        f0 = x
        f0 = abs(f0)
        f0 = f0 - k16
        f1 = x
        f1 = abs(f1)
        f1 = -f1
        f1 = f1 + k32
        f0 = f0 * f1
        f0 = f0 * k24
        m12 = f0
        f0 = cx
        f0 = abs(f0)
        f1 = cx
        f1 = abs(f1)
        f1 = f1 + k64
        f0 = f0 * f1
        f0 = f0 * k72
        m20 = f0
        f0 = y
        f0 = f0 * f0
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 * k48
        f0 = f0 + m12
        f0 = f0 + m20
        f0 = -f0
        f0 = f0 + x
        x = f0
    }
}

formula "_BStellahedron_F_Sphere" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BStellahedron_F_Sphere. Sphere to polyhedron with Stellation angles transform.  Does not make regular polydedra, except for the cube!  If you're mixing it with a Menger, remember to put the polyhedra to sphere (polyhedra wit"
    de numeric
    transform
    alias "_BStellahedron_F_Sphere"
    param o0_sides "Sides" = 4.0 [-4.0, 12.0] 
    param o1_sides2 "Sides2" = 4.0 [-4.0, 12.0] 
    param o2_stellangle "StellAngle" = 0.0 [-2.0, 2.0] 
    param o3_stellangle2 "StellAngle2" = 0.0 [-2.0, 2.0] 
    init {
        let k40 = o3_stellangle2
        let k32 = o2_stellangle
        let k24 = o1_sides2
        let k16 = o0_sides
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        f0 = 3.1415926535898
        f0 = f0 / k16
        m12 = f0
        f0 = f0 + f0
        m20 = f0
        f0 = m12
        f0 = f0 * 0.5
        f1 = f0
        f1 = f1 - k32
        f1 = cos(f1)
        m44 = f1
        f0 = cos(f0)
        f0 = f0 / m44
        m44 = f0
        f0 = 3.1415926535898
        f0 = f0 / k24
        m28 = f0
        f0 = f0 + f0
        m36 = f0
        f0 = m28
        f0 = f0 * 0.5
        f1 = f0
        f1 = f1 - k40
        f1 = cos(f1)
        m52 = f1
        f0 = cos(f0)
        f0 = f0 / m52
        m52 = f0
        f0 = z
        f1 = y
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m12
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m20
                continue
            }
        }
        f0 = abs(f0)
        f0 = f0 - k32
        f0 = cos(f0)
        f0 = f0 * m44
        m20 = f0
        f0 = f0 * y
        m12 = f0
        f0 = f0 * f0
        f1 = m20
        f1 = f1 * z
        m20 = f1
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = x
        f0 = atan2(f0, f1)
        f0 = abs(f0)
        loop {
            fc_a = f0
            fc_b = m28
            if fc_a <= fc_b {
                break
            } else {
                f0 = f0 - m36
                continue
            }
        }
        f0 = abs(f0)
        f0 = f0 - k40
        f0 = cos(f0)
        f0 = f0 * m52
        f1 = f0
        f2 = f1
        f2 = f2 * m12
        y = f2
        f1 = f1 * m20
        z = f1
        f0 = f0 * x
        x = f0
    }
}

formula "_BT1_4D_Transform1" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _BT1_4D_Transform1. Description:  This isn't very different from the 3d version of Transform 1.  The 3d version is better because it is faster.. although in the future, higher dimensional versions might become more inter"
    de numeric
    transform
    alias "_BT1_4D_Transform1"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_xoff "xOff" = 2.0 [-2.0, 6.0] 
    init {
        let k24 = o1_xoff
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        f0 = x
        f0 = f0 * 0.5
        f1 = dr
        f1 = f1 * 0.8660254037844387
        f0 = f0 + f1
        f0 = abs(f0)
        m28 = f0
        f0 = x
        f0 = f0 * 0.8660254037844387
        f1 = dr
        f1 = f1 * 0.5
        f1 = -f1
        f0 = f0 + f1
        m20 = f0
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = m20
        f0 = f0 * 0.5773502691896258
        f1 = z
        f1 = f1 * 0.816496580927726
        f0 = f0 + f1
        f0 = abs(f0)
        f1 = m12
        f2 = y
        f2 = f2 * 0.7071067811865475
        f2 = -f2
        f1 = f1 + f2
        f1 = abs(f1)
        f2 = m12
        f3 = y
        f3 = f3 * 0.7071067811865475
        f2 = f2 + f3
        f2 = abs(f2)
        y = f2
        x = f1
        z = f0
        f0 = x
        f0 = f0 + y
        f0 = f0 * 0.7071067811865475
        m12 = f0
        f0 = x
        f0 = -f0
        f0 = f0 + y
        f0 = f0 * 0.7071067811865475
        y = f0
        f0 = m12
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f0 = f0 + f1
        m20 = f0
        f1 = m12
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f2 = z
        f2 = f2 * 0.816496580927726
        f1 = f1 + f2
        z = f1
        f0 = f0 * 0.5
        f0 = -f0
        f1 = m28
        f1 = f1 * 0.8660254037844387
        f0 = f0 + f1
        dr = f0
        f0 = m20
        f0 = f0 * 0.8660254037844387
        f1 = m28
        f1 = f1 * 0.5
        f0 = f0 + f1
        f0 = f0 * k16
        f0 = f0 - k24
        x = f0
        f0 = y
        f0 = f0 * k16
        y = f0
        f0 = z
        f0 = f0 * k16
        z = f0
    }
}

