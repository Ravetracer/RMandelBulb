        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = y
        f2 = f2 * f1
        f3 = x
        f3 = f3 * f0
