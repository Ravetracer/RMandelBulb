        f2 = f1
        f1 = ft
        f2 = f2 + k48
        ft = f2
        f2 = f0
        f0 = ft
        f2 = f2 + k64
        ft = f2
        f2 = f0
        f0 = ft
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f2
