    }
}

formula "_Folding2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _Folding2. Fold with z' = z+abs(z-2*fold)-abs(z-fold)-fold"
    de numeric
    transform
    alias "_Folding2"
    param o0_r_fold "R fold" = 2.0 [-2.0, 6.0] 
    init {
        let k24 = 2.0 * o0_r_fold
