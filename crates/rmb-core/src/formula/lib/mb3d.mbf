        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k16
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k20
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
