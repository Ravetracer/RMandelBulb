formula "columnsIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula columnsIFS. Plots a rectangular arrangement of vertical cylinders, useful to create quickly temples or something."
    de difs
    alias "columnsIFS"
    param o0_colr_style "ColR + Style" = 0.1 [-1.9, 2.1] 
    param o1_coldist "ColDist" = 0.25 [-1.75, 2.25] 
    param o2_height "Height" = 1.0 [-1.0, 3.0] 
    param o3_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o4_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o5_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o6_x_add "X add" = 2.0 [-2.0, 6.0] 
    param o7_barrel_or_x2 "Barrel or x2" = 0.0 [-2.0, 2.0] 
    param o8_iterations_max_1000 "#Iterations (max 1000)" = 6.0 [-6.0, 18.0] int
    param o9_asymmetry "Asymmetry" = 1.0 [-1.0, 3.0] 
    param o10_delta_1 "Delta 1" = 3.0 [-3.0, 9.0] 
    param o11_delta_2 "Delta 2" = 0.0 [-2.0, 2.0] 
    param o12_apply_scale_add "apply scale+add" = 1.0 [-1.0, 3.0] int
    init {
        let k112 = round(o12_apply_scale_add)
        let k108 = o11_delta_2
        let k100 = o10_delta_1
        let k92 = o9_asymmetry
        let k84 = round(o8_iterations_max_1000)
        let k80 = o7_barrel_or_x2
        let k72 = o6_x_add
        let k64 = o5_y_add
        let k56 = o4_z_add
        let k48 = o3_scale
        let k40 = o3_scale
        let k32 = o2_height
        let k24 = o1_coldist
        let k16 = o0_colr_style
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m32 = 0.0
        let m40 = 0.0
        let m48 = 0.0
        let sv1 = 0.0
        let sv2 = 0.0
        let sv3 = 0.0
        x0l = y
        x0h = z
        x1l = x
        x1h = 0.0
        ft = x0h * k40
        x0l = x0l * k48
        x0h = ft
        x1l = x1l * k48
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k72
        if k112 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k48
            y = x0l
            z = x0h
            x = x1l
            a0 = x5l
        }
        m48 = x0l
        m40 = x0h
        m32 = x1l
        f0 = m48
        f0 = abs(f0)
        f1 = m32
        f1 = abs(f1)
        f2 = f1
        f2 = f2 + f0
        f3 = f1
        f3 = f3 - f0
        f3 = f3 - k92
        m48 = f3
        f2 = f2 - k100
        m32 = f2
        f0 = m48
        f0 = abs(f0)
        f0 = -f0
        f1 = m32
        f2 = f1
        f2 = f0 - f2
        f3 = f1
        f3 = f3 + f0
        f3 = -f3
        f3 = f3 - k108
        f3 = f3 * 0.5
        m48 = f3
        f2 = f2 - k108
        f2 = f2 * 0.5
        m32 = f2
        f0 = k24
        f1 = m48
        fc_a = f1
        fc_b = 0.0
        if fc_a < fc_b {
            r_eax = sel(fc_a < fc_b, 6144.0, sel(fc_a == fc_b, 14336.0, 6144.0))
            r_edx = 0.0
        } else {
            r_edx = k84
            r_edx = r_edx - 1.0
            if r_edx <= 0.0 {
                r_eax = sel(fc_a < fc_b, 6144.0, sel(fc_a == fc_b, 14336.0, 6144.0))
            } else {
                if r_edx > 999.0 {
                    r_eax = sel(fc_a < fc_b, 6144.0, sel(fc_a == fc_b, 14336.0, 6144.0))
                } else {
                    loop {
                        f1 = f0 - f1
                        f1 = abs(f1)
                        f1 = f0 - f1
                        f1 = abs(f1)
                        r_edx = r_edx - 1.0
                        if r_edx > 0.0 {
