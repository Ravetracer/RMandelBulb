        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f1 = x
        f2 = cx
        f2 = f2 * k16
        f1 = f1 + f2
        f1 = abs(f1)
        f2 = cx
        f2 = f2 * k16
        f2 = -f2
        f1 = f1 + f2
        ft = f1
        f1 = f0
        f0 = ft
        f1 = f1 * k24
        f0 = f0 + f1
        x = f0
        f0 = k32
        f1 = 0.0
        fc_a = f1
        fc_b = f0
        if fc_a == fc_b {
        } else {
            f0 = z
            f1 = cz
            f1 = f1 * k32
            f0 = f0 + f1
            f0 = abs(f0)
            f1 = cz
            f1 = f1 * k40
            f1 = -f1
            f0 = f0 + f1
            z = f0
        }
    }
}

