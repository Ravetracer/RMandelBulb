    de numeric
    alias "RuckerBrot1"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = -2.0 [-6.0, 2.0] 
    param o3_cz_mul "Cz mul" = -1.0 [-3.0, 1.0] 
    init {
        let k40 = o3_cz_mul
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
