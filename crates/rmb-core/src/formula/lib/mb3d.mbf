            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m28 = x0l
        m20 = x0h
        m12 = x1l
        f0 = m28
        f0 = f0 * f0
        m28 = f0
        f0 = m20
        f0 = f0 * f0
        m20 = f0
        f0 = m12
        f0 = f0 * f0
        m12 = f0
        f0 = m28
        f0 = f0 + m20
        f0 = f0 - k16
        f0 = f0 * f0
        f1 = m12
        f1 = f1 - k72
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = m28
