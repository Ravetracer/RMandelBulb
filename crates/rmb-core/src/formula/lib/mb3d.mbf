formula "YinYangIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula YinYangIFS. The symbol of Tao, made with toruses and spheres. Added too rotations."
    de difs
    alias "YinYangIFS"
    param o0_radius_1 "Radius 1" = 0.5 [-1.5, 2.5] 
    param o1_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_radius_2 "Radius 2" = 0.1 [-1.9, 2.1] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_radius_spheres "Radius Spheres" = 0.2 [-1.8, 2.2] 
    param o8_yinyangrot_x "YinYangRot X" = 0.0 [-180.0, 180.0] angle
    param o9_yinyangrot_y "YinYangRot Y" = 0.0 [-180.0, 180.0] angle
    param o10_yinyangrot_z "YinYangRot Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k120 = single(cos(o8_yinyangrot_x * pi / 180.0) * cos(o9_yinyangrot_y * pi / 180.0))
        let k116 = single(cos(o8_yinyangrot_x * pi / 180.0) * sin(o9_yinyangrot_y * pi / 180.0) * sin(o10_yinyangrot_z * pi / 180.0) + sin(o8_yinyangrot_x * pi / 180.0) * cos(o10_yinyangrot_z * pi / 180.0))
        let k112 = single(sin(o8_yinyangrot_x * pi / 180.0) * sin(o10_yinyangrot_z * pi / 180.0) - cos(o8_yinyangrot_x * pi / 180.0) * sin(o9_yinyangrot_y * pi / 180.0) * cos(o10_yinyangrot_z * pi / 180.0))
        let k108 = single(-sin(o8_yinyangrot_x * pi / 180.0) * cos(o9_yinyangrot_y * pi / 180.0))
        let k104 = single(cos(o8_yinyangrot_x * pi / 180.0) * cos(o10_yinyangrot_z * pi / 180.0) - sin(o8_yinyangrot_x * pi / 180.0) * sin(o9_yinyangrot_y * pi / 180.0) * sin(o10_yinyangrot_z * pi / 180.0))
        let k100 = single(sin(o8_yinyangrot_x * pi / 180.0) * sin(o9_yinyangrot_y * pi / 180.0) * cos(o10_yinyangrot_z * pi / 180.0) + cos(o8_yinyangrot_x * pi / 180.0) * sin(o10_yinyangrot_z * pi / 180.0))
        let k96 = single(sin(o9_yinyangrot_y * pi / 180.0))
        let k92 = single(-cos(o9_yinyangrot_y * pi / 180.0) * sin(o10_yinyangrot_z * pi / 180.0))
        let k88 = single(cos(o9_yinyangrot_y * pi / 180.0) * cos(o10_yinyangrot_z * pi / 180.0))
        let k84 = o7_radius_spheres
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_radius_2
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_radius_1
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m34 = 0.0
        let m42 = 0.0
        let m50 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m50 = x0l
        m42 = x0h
        m34 = x1l
        f0 = m34
        f1 = m42
        f2 = m50
        f3 = f2
        f3 = f3 * k112
        f4 = f1
        f4 = f4 * k116
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k120
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k88
        f5 = f1
        f5 = f5 * k92
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k96
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k100
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k104
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k108
        f1 = f1 + f3
        m50 = f2
        m42 = f1
        m34 = f0
        f0 = m50
        f0 = f0 * f0
        f1 = m42
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k16
        f0 = f0 - k16
        f0 = f0 * f0
        f1 = m34
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k72
        f1 = m50
        f1 = abs(f1)
        f2 = k16
        f2 = f2 * (-1.0)
        f1 = f1 + f2
        f1 = f1 * f1
        f2 = m42
        f2 = f2 * f2
        f1 = f1 + f2
        f2 = m34
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 - k84
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            f0 = f1
        }
        f1 = m50
        f2 = m42
        fc_a = f2
        fc_b = 0.0
        if fc_a >= fc_b {
            f3 = k16
            f3 = -f3
            r_edx = (-1.0)
        } else {
            f3 = k16
            r_edx = 1.0
        }
        f2 = f3
        f1 = f1 + f2
        m50 = f1
        f1 = m50
        f1 = f1 * f1
        f2 = m42
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 - k16
        f1 = f1 * f1
        f2 = m34
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f1 = f1 - k72
        fc_a = f1
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            f0 = f1
        }
        if k76 != 0.0 {
        } else {
            f0 = f0 / k32
        }
        rout = f0
    }
}

formula "_Abs4d" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _Abs4d. Takes the absolute values of all 4 vector components:"
    de numeric
    transform
    alias "_Abs4d"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = dr
        f1 = z
        f2 = y
        f3 = x
        f3 = abs(f3)
        x = f3
        f2 = abs(f2)
        y = f2
        f1 = abs(f1)
        z = f1
        f0 = abs(f0)
        dr = f0
    }
}

formula "_AbsX" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _AbsX. Absolute value for x (with fixing constant) - Can work as a 'mirror' or... ?!"
    de numeric
    transform
    alias "_AbsX"
    param o0_fixx "fixX" = 0.0 [-2.0, 2.0] 
    init {
        let k16 = o0_fixx
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        f0 = x
        f1 = k16
        f0 = f0 + f1
        f0 = abs(f0)
        f1 = k16
        f1 = -f1
        f0 = f0 + f1
        x = f0
    }
}

