        let k72 = o7_maxradius
        let k64 = o6_z_inv
        let k56 = o5_y_inv
        let k48 = o4_x_inv
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
