        f0 = ft
        f1 = f1 * f2
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * x
        ft = f2
        f2 = f0
        f0 = ft
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 * x
        f1 = f1 * f2
        y = f1
        x = f0
    }
}

formula "_invtorical" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _invtorical. Reversed torical (generalized) coords."
    de numeric
    transform
    alias "_invtorical"
    param o0_r "R" = 2.0 [-2.0, 6.0] 
    init {
        let k16 = o0_r
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = x
        f0 = -f0
        f0 = f0 + k16
        f0 = abs(f0)
        f1 = y
        f1 = cos(f1)
        f1 = abs(f1)
        f0 = f0 * f1
        x = f0
        f1 = y
        f1 = tan(f1)
        f2 = 1.0
        f1 = f1 * f2
        f0 = f0 * f1
        y = f0
    }
}

formula "_invtorical2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _invtorical2. Inverse torical (generalized) coords."
    de numeric
    transform
    alias "_invtorical2"
    param o0_r "R" = 2.0 [-2.0, 6.0] 
    param o1_gamma "Gamma" = 0.0 [-2.0, 2.0] 
    init {
        let k24 = o1_gamma
        let k16 = o0_r
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        f0 = y
        f0 = f0 + k24
        f1 = cos(f0)
        f0 = sin(f0)
        m20 = f1
        m28 = f0
        f0 = z
        f1 = cos(f0)
        f0 = sin(f0)
        m36 = f1
        m44 = f0
        f0 = x
        f0 = f0 * m20
        f0 = f0 + k16
        m52 = f0
        f0 = x
        f0 = f0 * m28
        z = f0
        f0 = m52
        f0 = f0 * m44
        y = f0
        f0 = m52
        f0 = f0 * m36
        x = f0
    }
}

formula "_juliax2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _juliax2. Shows a double Julia set, with chosen seeds. Just *don't* turn on Julia mode, and use as a pretransform!"
    de numeric
    transform
    alias "_juliax2"
    param o0_separation "Separation" = 2.0 [-2.0, 6.0] 
    param o1_x_seed_l "X seed (L)" = 0.5 [-1.5, 2.5] 
    param o2_y_seed_l "Y seed (L)" = 0.5 [-1.5, 2.5] 
    param o3_z_seed_l "Z seed (L)" = 0.0 [-2.0, 2.0] 
    param o4_x_seed_r "X seed (R)" = -1.0 [-3.0, 1.0] 
    param o5_y_seed_r "Y seed (R)" = 0.0 [-2.0, 2.0] 
    param o6_z_seed_r "Z seed (R)" = 0.0 [-2.0, 2.0] 
    init {
        let k64 = o6_z_seed_r
        let k56 = o5_y_seed_r
        let k48 = o4_x_seed_r
        let k40 = o3_z_seed_l
        let k32 = o2_y_seed_l
        let k24 = o1_x_seed_l
        let k16 = o0_separation
    }
    iter {
        let f0 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        f0 = x
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 - k16
            x = f0
            f0 = k48
            cx = f0
            f0 = k56
            cy = f0
            f0 = k64
            cz = f0
        } else {
            f0 = f0 + k16
            x = f0
            f0 = k24
            cx = f0
            f0 = k32
            cy = f0
            f0 = k40
            cz = f0
        }
    }
}

formula "_julibrot" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _julibrot. This PRE-transform is a standard Juli-brot mode in 4D"
    de numeric
    alias "_julibrot"
    param o0_x1_seed "x1 seed" = -0.844 [-2.844, 1.1560000000000001] 
    param o1_y1_seed "y1 seed" = 0.206 [-1.794, 2.206] 
    param o2_x2_seed "x2 seed" = 0.363 [-1.637, 2.363] 
    param o3_y2_seed "y2 seed" = -0.106 [-2.106, 1.894] 
    init {
        let k40 = o3_y2_seed
        let k32 = o2_x2_seed
        let k24 = o1_y1_seed
        let k16 = o0_x1_seed
    }
    iter {
        let f0 = 0.0
        f0 = k16
        z = f0
        f0 = k24
        w = f0
        f0 = k32
        cx = f0
        f0 = k40
        cy = f0
    }
}

formula "_kamtor" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _kamtor. KAM torus system customizable 'dynamic' variation in 3D - variation with 12 parameters + 2"
    de numeric
    transform
    alias "_kamtor"
    param o0_soft1 "Soft1" = 1.05 [-1.05, 3.1500000000000004] 
    param o1_soft2 "Soft2" = -0.05 [-2.05, 1.95] 
