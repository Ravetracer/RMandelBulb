        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k24
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k36
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k16
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k40
        f1 = f1 + f3
        f2 = f2 - k60
        x = f2
        f1 = f1 - k68
        y = f1
        f0 = f0 - k76
        z = f0
    }
}

formula "_updateC_4d" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _updateC_4d. Moves x, y, z, w values to Cx, Cy, Cz, Cw."
    de numeric
    transform
    alias "_updateC_4d"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = dr
        f1 = z
        f2 = y
        f3 = x
        cx = f3
        cy = f2
        cz = f1
        cw = f0
    }
}

formula "_vanderpol" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _vanderpol. Van der Pol modified chaotic system in 4D - variation with six parameters and strength"
    de numeric
    transform
    alias "_vanderpol"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 2.0 [-2.0, 6.0] 
    param o2_beta "Beta" = 0.6 [-1.4, 2.6] 
    param o3_gamma "Gamma" = 0.1 [-1.9, 2.1] 
    param o4_delta "Delta" = 0.4 [-1.6, 2.4] 
    param o5_phi "Phi" = 2.0 [-2.0, 6.0] 
    param o6_r1 "r1" = 1.4 [-1.4, 4.199999999999999] 
    param o7_r2 "r2" = 1.4 [-1.4, 4.199999999999999] 
    init {
        let k72 = o7_r2
        let k64 = o6_r1
        let k56 = o5_phi
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * k32
        f0 = f0 + z
        f0 = f0 * k16
        f1 = y
        f1 = f1 * k32
        f1 = f1 + dr
        f1 = f1 * k16
        f2 = y
        f2 = f2 * k40
        f3 = x
        f3 = f3 * k48
        f3 = -f3
        f2 = f2 + f3
        f3 = x
        f3 = f3 * f3
        f3 = -f3
        f3 = f3 * k64
        f3 = f3 + k56
        f3 = f3 * z
        f2 = f2 + f3
        f3 = x
        f3 = f3 * k40
        f4 = y
        f4 = f4 * k48
        f4 = -f4
        f3 = f3 + f4
        f4 = y
        f4 = f4 * f4
        f4 = -f4
        f4 = f4 * k72
        f4 = f4 + k24
        f4 = f4 * dr
        f3 = f3 + f4
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "_vanderpol2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _vanderpol2. Van der Pol modified chaotic system in 4D - variation with seven parameters and strength"
    de numeric
    transform
    alias "_vanderpol2"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 0.7 [-1.3, 2.7] 
    param o2_beta "Beta" = 0.7 [-1.3, 2.7] 
    param o3_gamma "Gamma" = 0.7 [-1.3, 2.7] 
    param o4_delta "Delta" = 0.2 [-1.8, 2.2] 
    param o5_epsilon "Epsilon" = 0.2 [-1.8, 2.2] 
    param o6_phi "Phi" = 0.2 [-1.8, 2.2] 
    param o7_rho "Rho" = 0.8 [-1.2, 2.8] 
    param o8_r "r" = 1.4 [-1.4, 4.199999999999999] 
    init {
        let k80 = o8_r
        let k72 = o7_rho
        let k64 = o6_phi
        let k56 = o5_epsilon
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * k72
        f1 = y
        f1 = f1 * k24
        f0 = f0 + f1
        f1 = z
        f1 = f1 * k32
        f0 = f0 + f1
        f1 = dr
        f1 = f1 * k40
        f0 = f0 + f1
        f0 = f0 * k16
        f1 = k48
        f1 = f1 * z
        f1 = f1 * dr
        f2 = k24
        f2 = f2 * x
        f2 = -f2
        f1 = f1 + f2
        f2 = x
        f2 = f2 * f2
        f2 = -f2
        f2 = f2 * k80
        f2 = f2 + k24
        f2 = f2 * y
        f1 = f1 + f2
        f2 = k56
        f2 = f2 * y
        f2 = f2 * dr
        f3 = k32
        f3 = f3 * x
        f3 = -f3
        f2 = f2 + f3
        f3 = x
        f3 = f3 * f3
        f3 = -f3
        f3 = f3 * k80
        f3 = f3 + k32
        f3 = f3 * z
        f2 = f2 + f3
        f3 = k64
        f3 = f3 * z
        f3 = f3 * y
        f4 = k40
        f4 = f4 * x
        f4 = -f4
        f3 = f3 + f4
        f4 = x
        f4 = f4 * f4
        f4 = -f4
        f4 = f4 * k80
        f4 = f4 + k40
        f4 = f4 * dr
        f3 = f3 + f4
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

formula "genIFS" {
    category "MB3D 3D"
    description "Mandelbulb3D formula genIFS. A more general IFS based on an idea from Kali at fractalforums."
    de linear
    descale 0.5
    alias "genIFS"
    param o0_scale "Scale" = -1.6 [-4.800000000000001, 1.6] 
    param o1_abs_x "Abs X" = 1.0 [-1.0, 3.0] int
    param o2_abs_y "Abs Y" = 1.0 [-1.0, 3.0] int
    param o3_abs_z "Abs Z" = 0.0 [-2.0, 2.0] int
    param o4_offset_x "Offset X" = -1.0 [-3.0, 1.0] 
    param o5_offset_y "Offset Y" = -1.0 [-3.0, 1.0] 
    param o6_offset_z "Offset Z" = 0.0 [-2.0, 2.0] 
    param o7_rotation_x "Rotation X" = 30.0 [-180.0, 180.0] angle
    param o8_rotation_y "Rotation Y" = 30.0 [-180.0, 180.0] angle
    param o9_rotation_z "Rotation Z" = 30.0 [-180.0, 180.0] angle
    init {
        let k76 = single(cos(o7_rotation_x * pi / 180.0) * cos(o8_rotation_y * pi / 180.0))
        let k72 = single(cos(o7_rotation_x * pi / 180.0) * sin(o8_rotation_y * pi / 180.0) * sin(o9_rotation_z * pi / 180.0) + sin(o7_rotation_x * pi / 180.0) * cos(o9_rotation_z * pi / 180.0))
        let k68 = single(sin(o7_rotation_x * pi / 180.0) * sin(o9_rotation_z * pi / 180.0) - cos(o7_rotation_x * pi / 180.0) * sin(o8_rotation_y * pi / 180.0) * cos(o9_rotation_z * pi / 180.0))
        let k64 = single(-sin(o7_rotation_x * pi / 180.0) * cos(o8_rotation_y * pi / 180.0))
        let k60 = single(cos(o7_rotation_x * pi / 180.0) * cos(o9_rotation_z * pi / 180.0) - sin(o7_rotation_x * pi / 180.0) * sin(o8_rotation_y * pi / 180.0) * sin(o9_rotation_z * pi / 180.0))
        let k56 = single(sin(o7_rotation_x * pi / 180.0) * sin(o8_rotation_y * pi / 180.0) * cos(o9_rotation_z * pi / 180.0) + cos(o7_rotation_x * pi / 180.0) * sin(o9_rotation_z * pi / 180.0))
        let k52 = single(sin(o8_rotation_y * pi / 180.0))
        let k48 = single(-cos(o8_rotation_y * pi / 180.0) * sin(o9_rotation_z * pi / 180.0))
        let k44 = single(cos(o8_rotation_y * pi / 180.0) * cos(o9_rotation_z * pi / 180.0))
        let k40 = single(o6_offset_z)
        let k36 = single(o5_offset_y)
        let k32 = single(o4_offset_x)
        let k28 = round(o3_abs_z)
        let k24 = round(o2_abs_y)
        let k20 = round(o1_abs_x)
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        f0 = z
        if k28 == 0.0 {
        } else {
            f0 = abs(f0)
        }
        f0 = f0 + k40
        f1 = y
        if k24 == 0.0 {
        } else {
            f1 = abs(f1)
        }
        f1 = f1 + k36
        f2 = x
        if k20 == 0.0 {
        } else {
            f2 = abs(f2)
        }
        f2 = f2 + k32
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        f3 = k16
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f3 = f3 * dr
        dr = f3
        f2 = f2 + cx
        x = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cz
        z = f0
    }
}

formula "koch_cube" {
    category "MB3D 3D"
    description "Mandelbulb3D formula koch_cube. Cubic Koch fractal. Inspired from a Wikipedia image ( http://en.wikipedia.org/wiki/File:Quadratic_Koch_3D_(type1_stage2).png )"
    de linear
    alias "koch_cube"
    param o0_post_scale "Post-scale" = 1.0 [-1.0, 3.0] 
    param o1_xy_stretch "XY Stretch" = 1.0 [-1.0, 3.0] 
    param o2_z_fold "Z Fold" = 1.0 [-1.0, 3.0] 
    param o3_x_add "X Add" = 0.0 [-2.0, 2.0] 
    param o4_y_add "Y Add" = 0.0 [-2.0, 2.0] 
    param o5_z_add "Z Add" = 0.0 [-2.0, 2.0] 
    param o6_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o7_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o8_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k92 = single(cos(o6_rotation_x * pi / 180.0) * cos(o7_rotation_y * pi / 180.0))
        let k88 = single(cos(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * sin(o8_rotation_z * pi / 180.0) + sin(o6_rotation_x * pi / 180.0) * cos(o8_rotation_z * pi / 180.0))
        let k84 = single(sin(o6_rotation_x * pi / 180.0) * sin(o8_rotation_z * pi / 180.0) - cos(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * cos(o8_rotation_z * pi / 180.0))
        let k80 = single(-sin(o6_rotation_x * pi / 180.0) * cos(o7_rotation_y * pi / 180.0))
        let k76 = single(cos(o6_rotation_x * pi / 180.0) * cos(o8_rotation_z * pi / 180.0) - sin(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * sin(o8_rotation_z * pi / 180.0))
        let k72 = single(sin(o6_rotation_x * pi / 180.0) * sin(o7_rotation_y * pi / 180.0) * cos(o8_rotation_z * pi / 180.0) + cos(o6_rotation_x * pi / 180.0) * sin(o8_rotation_z * pi / 180.0))
        let k68 = single(sin(o7_rotation_y * pi / 180.0))
        let k64 = single(-cos(o7_rotation_y * pi / 180.0) * sin(o8_rotation_z * pi / 180.0))
        let k60 = single(cos(o7_rotation_y * pi / 180.0) * cos(o8_rotation_z * pi / 180.0))
        let k56 = o5_z_add
        let k48 = o4_y_add
        let k40 = o3_x_add
        let k32 = o2_z_fold
        let k24 = o1_xy_stretch
        let k16 = o0_post_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = x
        f0 = abs(f0)
        f0 = f0 * 3.0
        x = f0
        f0 = y
        f0 = abs(f0)
        f0 = f0 * 3.0
        y = f0
        f0 = z
        f0 = abs(f0)
        f0 = f0 * 3.0
        z = f0
        f0 = dr
        f0 = f0 * 3.0
        f0 = f0 / k24
        f0 = f0 * k16
        dr = f0
        f0 = x
        f1 = y
        fc_a = f1
        fc_b = f0
        if fc_a <= fc_b {
        } else {
            f0 = x
            f1 = y
            x = f1
            y = f0
        }
        f0 = x
        f1 = z
        fc_a = f1
        fc_b = f0
        if fc_a <= fc_b {
        } else {
            f0 = x
            f1 = z
            x = f1
            z = f0
        }
        f0 = z
        f1 = y
        fc_a = f1
        fc_b = f0
        if fc_a > fc_b {
        } else {
            f0 = z
            f1 = y
            z = f1
            y = f0
        }
        f0 = z
        f0 = f0 + k56
        f1 = y
        f1 = f1 + k48
        f2 = x
        f2 = f2 + k40
        f3 = f2
        f3 = f3 * k84
        f4 = f1
        f4 = f4 * k88
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k92
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k60
        f5 = f1
        f5 = f5 * k64
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k68
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k72
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k76
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k80
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        f0 = k32
        f0 = f0 - z
        f0 = abs(f0)
        f0 = -f0
        f0 = f0 + k32
        z = f0
        f0 = 3.0
        f1 = f0
        f2 = k24
        f1 = f1 + f2
        m28 = f1
        f1 = k24
        f0 = f0 - f1
        m36 = f0
        f0 = x
        f0 = f0 - m36
        m12 = f0
        f0 = x
        f0 = f0 - m28
        m20 = f0
        f0 = m12
        f1 = y
        fc_a = f1
        fc_b = f0
        if fc_a <= fc_b {
            f0 = m20
            f1 = y
            fc_a = f1
            fc_b = f0
            if fc_a > fc_b {
                f0 = y
                f1 = m20
                y = f1
                x = f0
            } else {
                f0 = m20
                x = f0
            }
        } else {
            f0 = m12
            x = f0
            f0 = y
            f0 = f0 - m36
            y = f0
        }
        f0 = x
        f0 = f0 * k16
        f0 = f0 / k24
        x = f0
        f0 = y
        f0 = f0 * k16
        f0 = f0 / k24
        y = f0
        f0 = z
        f0 = f0 * k16
        z = f0
    }
}

formula "koch_oct" {
    category "MB3D 3D"
    description "Mandelbulb3D formula koch_oct. Modified from OctahedronIFS."
    de linear
    alias "koch_oct"
    param o0_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o1_cscale_x "CScale X" = 0.0 [-2.0, 2.0] 
    param o2_cscale_y "CScale Y" = 0.0 [-2.0, 2.0] 
    param o3_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o4_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    param o7_rotation2_x "Rotation2 X" = 0.0 [-180.0, 180.0] angle
    param o8_rotation2_y "Rotation2 Y" = 0.0 [-180.0, 180.0] angle
    param o9_rotation2_z "Rotation2 Z" = 0.0 [-180.0, 180.0] angle
    param o10_fold "Fold" = 0.5 [-1.5, 2.5] 
    init {
        let k120 = o10_fold
        let k112 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k108 = single(cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) + sin(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k104 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0) - cos(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k100 = single(-sin(o7_rotation2_x * pi / 180.0) * cos(o8_rotation2_y * pi / 180.0))
        let k96 = single(cos(o7_rotation2_x * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) - sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k92 = single(sin(o7_rotation2_x * pi / 180.0) * sin(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0) + cos(o7_rotation2_x * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k88 = single(sin(o8_rotation2_y * pi / 180.0))
        let k84 = single(-cos(o8_rotation2_y * pi / 180.0) * sin(o9_rotation2_z * pi / 180.0))
        let k80 = single(cos(o8_rotation2_y * pi / 180.0) * cos(o9_rotation2_z * pi / 180.0))
        let k76 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k72 = single(cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) + sin(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k68 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0) - cos(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation1_x * pi / 180.0) * cos(o5_rotation1_y * pi / 180.0))
        let k60 = single(cos(o4_rotation1_x * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) - sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k56 = single(sin(o4_rotation1_x * pi / 180.0) * sin(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0) + cos(o4_rotation1_x * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k52 = single(sin(o5_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation1_y * pi / 180.0) * sin(o6_rotation1_z * pi / 180.0))
        let k44 = single(cos(o5_rotation1_y * pi / 180.0) * cos(o6_rotation1_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = abs(f0)
        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        f3 = f2
        f3 = f3 * k68
        f4 = f1
        f4 = f4 * k72
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k76
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k44
        f5 = f1
        f5 = f5 * k48
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k52
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k56
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k60
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k64
        f1 = f1 + f3
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f1
        f3 = f3 * k104
        f4 = f2
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f1
        f4 = f4 * k80
        f5 = f2
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k96
        f2 = f2 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f2 = f2 + f3
        f3 = k16
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        ft = f3
        f3 = f2
        f2 = ft
        f4 = k120
        f4 = f4 + f3
        f4 = abs(f4)
        f5 = k120
        f5 = f5 - f3
        f5 = abs(f5)
        f5 = -f5
        f4 = f4 + f5
        f3 = f4 - f3
        ft = f3
        f3 = f2
        f2 = ft
        f4 = 1.0
        f3 = f3 - f4
        f4 = f3
        f5 = f4
        f5 = f5 * k32
        f1 = f1 - f5
        f4 = f4 * k24
        f2 = f2 - f4
        f3 = f3 * k40
        f0 = f0 - f3
        x = f2
        y = f1
        z = f0
    }
}

formula "koch_surf" {
    category "MB3D 3D"
    description "Mandelbulb3D formula koch_surf. From a Knighty's script, modified a bit;"
    de linear
    alias "koch_surf"
    param o0_pforder "PFOrder" = 4.0 [-4.0, 12.0] 
    param o1_pfshift_deg "PFShift (deg)" = 0.0 [-2.0, 2.0] 
    param o2_pfshift_x "PFShift x" = 0.0 [-2.0, 2.0] 
    param o3_pfshift_y "PFShift y" = 0.0 [-2.0, 2.0] 
    param o4_yoff1 "YOff1" = 0.3333333333 [-1.6666666667, 2.3333333333] 
    param o5_yoff2 "YOff2" = 0.3333333333 [-1.6666666667, 2.3333333333] 
    param o6_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o7_cscale_z "CScale Z" = 1.0 [-1.0, 3.0] 
    param o8_cscale_y "CScale Y" = 0.0 [-2.0, 2.0] 
    param o9_cscale_x "CScale X" = 0.3333333333 [-1.6666666667, 2.3333333333] 
    param o10_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o11_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o12_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o13_variation "Variation" = 0.0 [-2.0, 2.0] int
    init {
        let k128 = round(o13_variation)
        let k124 = single(cos(o10_rotation_x * pi / 180.0) * cos(o11_rotation_y * pi / 180.0))
        let k120 = single(cos(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * sin(o12_rotation_z * pi / 180.0) + sin(o10_rotation_x * pi / 180.0) * cos(o12_rotation_z * pi / 180.0))
        let k116 = single(sin(o10_rotation_x * pi / 180.0) * sin(o12_rotation_z * pi / 180.0) - cos(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * cos(o12_rotation_z * pi / 180.0))
        let k112 = single(-sin(o10_rotation_x * pi / 180.0) * cos(o11_rotation_y * pi / 180.0))
        let k108 = single(cos(o10_rotation_x * pi / 180.0) * cos(o12_rotation_z * pi / 180.0) - sin(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * sin(o12_rotation_z * pi / 180.0))
        let k104 = single(sin(o10_rotation_x * pi / 180.0) * sin(o11_rotation_y * pi / 180.0) * cos(o12_rotation_z * pi / 180.0) + cos(o10_rotation_x * pi / 180.0) * sin(o12_rotation_z * pi / 180.0))
        let k100 = single(sin(o11_rotation_y * pi / 180.0))
        let k96 = single(-cos(o11_rotation_y * pi / 180.0) * sin(o12_rotation_z * pi / 180.0))
        let k92 = single(cos(o11_rotation_y * pi / 180.0) * cos(o12_rotation_z * pi / 180.0))
        let k88 = o9_cscale_x
        let k80 = o8_cscale_y
        let k72 = o7_cscale_z
        let k64 = o6_scale
        let k56 = o5_yoff2
        let k48 = o4_yoff1
        let k40 = o3_pfshift_y
        let k32 = o2_pfshift_x
        let k24 = o1_pfshift_deg
        let k16 = o0_pforder
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_eax = 0.0
        let m12 = 0.0
        f0 = y
        f0 = f0 + k40
        y = f0
        f1 = x
        f1 = f1 + k32
        x = f1
        f0 = atan2(f0, f1)
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f0 = f0 / 6.283185307
        f0 = f0 * k16
        m12 = round(f0)
        f0 = m12
        f0 = -f0
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = k24
        f1 = f1 * 0.017453293
        f0 = f0 + f1
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = x
        f2 = f2 * f1
        f3 = y
        f3 = f3 * f0
        f2 = f3 - f2
        f3 = x
        f3 = f3 * f0
        f4 = y
        f4 = f4 * f1
        f3 = f3 + f4
        r_eax = k128
        r_eax = ((floor(r_eax / 2.0) - 2.0 * floor(r_eax / 4.0)) * 2.0)
        if r_eax == 0.0 {
            r_eax = m12
            r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
            if r_eax != 0.0 {
            } else {
                f3 = -f3
            }
        } else {
            f3 = abs(f3)
        }
        f3 = f3 - k40
        f3 = f3 - k48
        f3 = abs(f3)
        f3 = -f3
        f3 = f3 + k48
        y = f3
        f2 = f2 - k32
        f3 = z
        f4 = k56
        f2 = f2 + f4
        fc_a = f3
        fc_b = f2
        if fc_a < fc_b {
        } else {
            ft = f3
            f3 = f2
            f2 = ft
        }
        f4 = k56
        f2 = f2 - f4
        r_eax = k128
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax == 0.0 {
            f2 = f2 - f4
            fc_a = f3
            fc_b = f2
            if fc_a < fc_b {
            } else {
                ft = f3
                f3 = f2
                f2 = ft
            }
            f4 = k56
            f2 = f2 + f4
        } else {
            f2 = f2 + f4
            fc_a = f3
            fc_b = f2
            if fc_a < fc_b {
            } else {
                ft = f3
                f3 = f2
                f2 = ft
            }
            f4 = k56
            f2 = f2 - f4
        }
        z = f3
        x = f2
        f0 = z
        f0 = f0 + k72
        f1 = y
        f1 = f1 + k80
        f2 = x
        f2 = f2 + k88
        f3 = f2
        f3 = f3 * k116
        f4 = f1
        f4 = f4 * k120
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k124
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k92
        f5 = f1
        f5 = f5 * k96
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k100
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k104
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k108
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k112
        f1 = f1 + f3
        f3 = k64
        f4 = dr
        f4 = f4 * f3
        dr = f4
        f0 = f0 * f3
        f1 = f1 * f3
        f2 = f2 * f3
        f2 = f2 - k88
        x = f2
        f1 = f1 - k80
        y = f1
        f0 = f0 - k72
        z = f0
    }
}

