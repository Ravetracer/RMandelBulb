        let fc_b = 0.0
        f0 = k16
        f1 = x
        f1 = f1 * k24
        f1 = f0 - f1
        f2 = y
        f2 = f2 * k24
        f2 = f0 - f2
        f3 = z
        f3 = f3 * k24
        f3 = f0 - f3
        fc_a = f3
        fc_b = f2
        if fc_a > fc_b {
        } else {
            f2 = f3
        }
        fc_a = f2
        fc_b = f1
        if fc_a > fc_b {
        } else {
            f1 = f2
        }
        f0 = f1
        f1 = f0
        f1 = abs(f1)
        f0 = f0 + f1
        f1 = x
        f1 = f1 - f0
        f2 = y
        f2 = f2 - f0
        f3 = z
        f3 = f3 - f0
        z = f3
        y = f2
        x = f1
    }
}

