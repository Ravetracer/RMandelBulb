formula "_Log4D" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _Log4D. Computes log(Q), following Hamiltonian theory, exact for all Q but truncated for (Re(Q)>0 & Re(Q)<1e-200)."
    de numeric
    alias "_Log4D"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = w
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = f0
        fc_a = f1
        fc_b = 0.0
        if fc_a == fc_b {
            f0 = x
            f1 = 1e-200
            fc_a = f1
            fc_b = f0
            if fc_a > fc_b {
                f0 = 460.0
                x = f0
            } else {
                f0 = x
                f1 = 0.6931471805599453
                ft = f1
                f1 = f0
                f0 = ft
                f0 = f0 * log(f1) * 1.4426950408889634
                x = f0
            }
        } else {
            f1 = f0
            f2 = x
            f1 = atan2(f1, f2)
            f2 = f0
            f1 = f1 / f2
            f2 = x
            f2 = f2 * f2
            f3 = f0
            f3 = f3 * f3
            f2 = f2 + f3
            f3 = f2
            f4 = 1e-200
            fc_a = f4
            fc_b = f3
            if fc_a > fc_b {
                f3 = 460.0
            } else {
                f3 = f2
                f4 = 0.6931471805599453
                ft = f4
                f4 = f3
                f3 = ft
                f3 = f3 * log(f4) * 1.4426950408889634
                f3 = f3 * 0.5
            }
            x = f3
            f3 = y
            f3 = f3 * f1
            y = f3
            f3 = z
            f3 = f3 * f1
            z = f3
            f3 = w
            f3 = f3 * f1
            w = f3
        }
    }
}

formula "_LogX" {
    category "MB3D transforms"
