        f1 = f1 + f2
        f2 = m12
        f2 = f2 + m20
        f2 = f2 - k16
        f2 = f2 * f2
        f3 = m28
        f3 = f3 - k72
        f3 = f3 * f3
        f2 = f2 + f3
        f1 = f1 * f2
