        let q5_5_21 = (cos(o10_rotation_zw * pi / 180.0)) * q5_4_21 + (-sin(o10_rotation_zw * pi / 180.0)) * q5_4_31
        let q5_5_22 = (cos(o10_rotation_zw * pi / 180.0)) * q5_4_22 + (-sin(o10_rotation_zw * pi / 180.0)) * q5_4_32
