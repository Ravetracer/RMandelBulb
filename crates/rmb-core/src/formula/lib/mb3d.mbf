formula "MengerIFS" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MengerIFS. A 3d menger version that hormonizes more in hybrids then 'menger3'."
    de linear
    alias "MengerIFS"
    param o0_scale "Scale" = 3.0 [-3.0, 9.0] 
    param o1_cscale_x "CScale X" = 1.0 [-1.0, 3.0] 
    param o2_cscale_y "CScale Y" = 1.0 [-1.0, 3.0] 
    param o3_cscale_z "CScale Z" = 0.5 [-1.5, 2.5] 
    param o4_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o6_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k76 = single(cos(o4_rotation_x * pi / 180.0) * cos(o5_rotation_y * pi / 180.0))
        let k72 = single(cos(o4_rotation_x * pi / 180.0) * sin(o5_rotation_y * pi / 180.0) * sin(o6_rotation_z * pi / 180.0) + sin(o4_rotation_x * pi / 180.0) * cos(o6_rotation_z * pi / 180.0))
        let k68 = single(sin(o4_rotation_x * pi / 180.0) * sin(o6_rotation_z * pi / 180.0) - cos(o4_rotation_x * pi / 180.0) * sin(o5_rotation_y * pi / 180.0) * cos(o6_rotation_z * pi / 180.0))
        let k64 = single(-sin(o4_rotation_x * pi / 180.0) * cos(o5_rotation_y * pi / 180.0))
        let k60 = single(cos(o4_rotation_x * pi / 180.0) * cos(o6_rotation_z * pi / 180.0) - sin(o4_rotation_x * pi / 180.0) * sin(o5_rotation_y * pi / 180.0) * sin(o6_rotation_z * pi / 180.0))
        let k56 = single(sin(o4_rotation_x * pi / 180.0) * sin(o5_rotation_y * pi / 180.0) * cos(o6_rotation_z * pi / 180.0) + cos(o4_rotation_x * pi / 180.0) * sin(o6_rotation_z * pi / 180.0))
        let k52 = single(sin(o5_rotation_y * pi / 180.0))
        let k48 = single(-cos(o5_rotation_y * pi / 180.0) * sin(o6_rotation_z * pi / 180.0))
        let k44 = single(cos(o5_rotation_y * pi / 180.0) * cos(o6_rotation_z * pi / 180.0))
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = abs(f0)
        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        fc_a = f2
        fc_b = f1
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f3 = f1
        f3 = f3 * k68
