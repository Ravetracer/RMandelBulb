    param o0_strength "Strength" = 1.03 [-1.03, 3.09] 
    param o1_x_step "X step" = 0.1 [-1.9, 2.1] 
    param o2_y_step "Y step" = 0.1 [-1.9, 2.1] 
    param o3_alpha "Alpha" = 3.0 [-3.0, 9.0] 
    param o4_beta "Beta" = 2.0 [-2.0, 6.0] 
    init {
        let k48 = o4_beta
        let k40 = o3_alpha
        let k32 = o2_y_step
        let k24 = o1_x_step
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = y
        f1 = k48
        f0 = f0 * f1
        f0 = sin(f0)
        f1 = y
        f0 = f0 + f1
        f1 = k40
        f0 = f0 * f1
        f0 = sin(f0)
        f1 = y
        f0 = f0 + f1
        f0 = sin(f0)
        f1 = k24
        f0 = f0 * f1
        f0 = -f0
        f1 = x
        f0 = f0 + f1
        f1 = k16
        f0 = f0 * f1
        f1 = x
        f2 = k48
        f1 = f1 * f2
        f1 = sin(f1)
        f2 = x
        f1 = f1 + f2
        f2 = k40
        f1 = f1 * f2
        f1 = sin(f1)
        f2 = x
        f1 = f1 + f2
        f1 = sin(f1)
        f2 = k32
        f1 = f1 * f2
        f1 = -f1
        f2 = y
        f1 = f1 + f2
        f2 = k16
        f1 = f1 * f2
        y = f1
        x = f0
    }
}

