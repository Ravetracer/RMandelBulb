    param o0_x_center "X center" = 0.0 [-2.0, 2.0] 
    param o1_y_center "Y center" = 0.0 [-2.0, 2.0] 
    param o2_z_center "Z center" = 0.0 [-2.0, 2.0] 
    param o3_radius "Radius" = 1.0 [-1.0, 3.0] 
    init {
        let k40 = o3_radius
        let k32 = o2_z_center
        let k24 = o1_y_center
        let k16 = o0_x_center
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f2 = f2 + k16
        x = f2
        f1 = f1 + k24
        y = f1
        f0 = f0 + k32
        z = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = x
        f1 = f1 / f0
        f2 = k40
