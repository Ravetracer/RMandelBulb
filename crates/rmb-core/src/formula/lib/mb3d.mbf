formula "hextgridIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula hextgridIFS. Beautiful iso-surface made of a hexagonal grid of tubes."
    de difs
    alias "hextgridIFS"
    param o0_radiusmod "RadiusMod" = 1.0 [-1.0, 3.0] 
    param o1_scale "Scale" = 2.0 [-2.0, 6.0] 
    param o2_z_add "Z add" = 0.0 [-2.0, 2.0] 
    param o3_y_add "Y add" = 0.0 [-2.0, 2.0] 
    param o4_x_add "X add" = 0.0 [-2.0, 2.0] 
    param o5_grid_styling "Grid styling" = 0.12 [-1.88, 2.12] 
    param o6_apply_scale_add "Apply scale+add" = 1.0 [-1.0, 3.0] int
    param o7_planerot_x "PlaneRot X" = 0.0 [-180.0, 180.0] angle
    param o8_planerot_y "PlaneRot Y" = 0.0 [-180.0, 180.0] angle
    param o9_planerot_z "PlaneRot Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k112 = single(cos(o7_planerot_x * pi / 180.0) * cos(o8_planerot_y * pi / 180.0))
        let k108 = single(cos(o7_planerot_x * pi / 180.0) * sin(o8_planerot_y * pi / 180.0) * sin(o9_planerot_z * pi / 180.0) + sin(o7_planerot_x * pi / 180.0) * cos(o9_planerot_z * pi / 180.0))
        let k104 = single(sin(o7_planerot_x * pi / 180.0) * sin(o9_planerot_z * pi / 180.0) - cos(o7_planerot_x * pi / 180.0) * sin(o8_planerot_y * pi / 180.0) * cos(o9_planerot_z * pi / 180.0))
        let k100 = single(-sin(o7_planerot_x * pi / 180.0) * cos(o8_planerot_y * pi / 180.0))
        let k96 = single(cos(o7_planerot_x * pi / 180.0) * cos(o9_planerot_z * pi / 180.0) - sin(o7_planerot_x * pi / 180.0) * sin(o8_planerot_y * pi / 180.0) * sin(o9_planerot_z * pi / 180.0))
        let k92 = single(sin(o7_planerot_x * pi / 180.0) * sin(o8_planerot_y * pi / 180.0) * cos(o9_planerot_z * pi / 180.0) + cos(o7_planerot_x * pi / 180.0) * sin(o9_planerot_z * pi / 180.0))
        let k88 = single(sin(o8_planerot_y * pi / 180.0))
        let k84 = single(-cos(o8_planerot_y * pi / 180.0) * sin(o9_planerot_z * pi / 180.0))
        let k80 = single(cos(o8_planerot_y * pi / 180.0) * cos(o9_planerot_z * pi / 180.0))
        let k76 = round(o6_apply_scale_add)
        let k72 = o5_grid_styling
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_radiusmod
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m38 = 0.0
        let m46 = 0.0
        let m54 = 0.0
        let m62 = 0.0
        let m70 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 == 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
