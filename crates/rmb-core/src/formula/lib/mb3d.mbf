    param o8_minradius "MinRadius" = 0.048 [-1.952, 2.048] 
    param o9_centradmul "CentRadMul" = 0.9 [-1.1, 2.9] 
    param o10_fold_again "Fold again" = 1.0 [-1.0, 3.0] int
    init {
        let k92 = round(o10_fold_again)
        let k88 = o9_centradmul
        let k80 = o8_minradius
        let k72 = o7_maxradius
        let k64 = o6_z_inv
        let k56 = o5_y_inv
        let k48 = o4_x_inv
        let k40 = o3_cscale_z
        let k32 = o2_cscale_y
        let k24 = o1_cscale_x
        let k16 = o0_scale
