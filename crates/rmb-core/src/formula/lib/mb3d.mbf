formula "MsltoeSym4" {
    category "MB3D 3D"
    description "Mandelbulb3D formula MsltoeSym4. A formula made by Msltoe at fractalforums.com, one iteration:"
    de numeric
    alias "MsltoeSym4"
    param o0_xz_sym_mul "XZ sym-mul" = 1.0 [-1.0, 3.0] 
    param o1_xy_sym_mul "XY sym-mul" = 1.0 [-1.0, 3.0] 
    param o2_yz_sym_mul "YZ sym-mul" = 1.0 [-1.0, 3.0] 
    init {
        let k20 = single(o2_yz_sym_mul)
        let k16 = single(o1_xy_sym_mul)
        let k12 = single(o0_xz_sym_mul)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f1 = z
        f2 = f1
        f2 = abs(f2)
        f2 = f2 * k12
        f3 = f0
        f3 = abs(f3)
        fc_a = f3
        fc_b = f2
        if fc_a > fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        f2 = y
        f3 = f2
        f3 = abs(f3)
        f3 = f3 * k16
        f4 = f0
        f4 = abs(f4)
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f3 = f1
        f3 = abs(f3)
        f3 = f3 * k20
        f4 = f1
        f4 = abs(f4)
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        f3 = f1
        f3 = f3 * f0
        fc_a = f3
        fc_b = 0.0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
        }
        f3 = f2
        f3 = f3 * f0
        fc_a = f3
        fc_b = 0.0
        if fc_a < fc_b {
        } else {
            f2 = -f2
        }
        f3 = f0
        f3 = f3 * f3
        f4 = f2
        f4 = f4 * f4
        f3 = f3 - f4
        f4 = f1
        f4 = f4 * f4
        f3 = f3 - f4
        f3 = f3 + cx
        x = f3
        f2 = f2 * f0
        f2 = f2 + f2
        f2 = f2 + cy
        y = f2
        f0 = f0 * f1
        f0 = f0 + f0
        f0 = f0 + cz
        z = f0
    }
}

formula "NewFoldCutIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula NewFoldCutIFS. Loosely inspired by a Knighty script, and by a sculpture"
    de difs
    alias "NewFoldCutIFS"
    param o0_iterscale "IterScale" = -1.23 [-3.69, 1.23] 
    param o1_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o2_prezoff "preZoff" = 0.0 [-2.0, 2.0] 
    param o3_preyoff "preYoff" = 0.0 [-2.0, 2.0] 
    param o4_prexoff "preXoff" = 0.0 [-2.0, 2.0] 
    param o5_xy_final_angle "XY final angle" = 90.0 [-180.0, 180.0] angle
    param o6_applysc_no_restore "Applysc/No restore" = -1.0 [-3.0, 1.0] int
    param o7_xoff "XOff" = 0.0 [-2.0, 2.0] 
    param o8_yoff "YOff" = 0.67 [-1.33, 2.67] 
    param o9_zoff "ZOff" = 0.67 [-1.33, 2.67] 
    param o10_maxiter_32 "MaxIter (<32)" = 8.0 [-8.0, 24.0] int
    param o11_rotation_x "Rotation X" = 6.0 [-180.0, 180.0] angle
    param o12_rotation_y "Rotation Y" = 6.0 [-180.0, 180.0] angle
    param o13_rotation_z "Rotation Z" = 6.0 [-180.0, 180.0] angle
    init {
        let k140 = single(cos(o11_rotation_x * pi / 180.0) * cos(o12_rotation_y * pi / 180.0))
        let k136 = single(cos(o11_rotation_x * pi / 180.0) * sin(o12_rotation_y * pi / 180.0) * sin(o13_rotation_z * pi / 180.0) + sin(o11_rotation_x * pi / 180.0) * cos(o13_rotation_z * pi / 180.0))
        let k132 = single(sin(o11_rotation_x * pi / 180.0) * sin(o13_rotation_z * pi / 180.0) - cos(o11_rotation_x * pi / 180.0) * sin(o12_rotation_y * pi / 180.0) * cos(o13_rotation_z * pi / 180.0))
        let k128 = single(-sin(o11_rotation_x * pi / 180.0) * cos(o12_rotation_y * pi / 180.0))
        let k124 = single(cos(o11_rotation_x * pi / 180.0) * cos(o13_rotation_z * pi / 180.0) - sin(o11_rotation_x * pi / 180.0) * sin(o12_rotation_y * pi / 180.0) * sin(o13_rotation_z * pi / 180.0))
        let k120 = single(sin(o11_rotation_x * pi / 180.0) * sin(o12_rotation_y * pi / 180.0) * cos(o13_rotation_z * pi / 180.0) + cos(o11_rotation_x * pi / 180.0) * sin(o13_rotation_z * pi / 180.0))
        let k116 = single(sin(o12_rotation_y * pi / 180.0))
        let k112 = single(-cos(o12_rotation_y * pi / 180.0) * sin(o13_rotation_z * pi / 180.0))
        let k108 = single(cos(o12_rotation_y * pi / 180.0) * cos(o13_rotation_z * pi / 180.0))
        let k104 = round(o10_maxiter_32)
        let k100 = o9_zoff
        let k92 = o8_yoff
        let k84 = o7_xoff
        let k76 = round(o6_applysc_no_restore)
        let k72 = single(cos(o5_xy_final_angle * pi / 180.0))
        let k68 = single(sin(o5_xy_final_angle * pi / 180.0))
        let k64 = o4_prexoff
        let k56 = o3_preyoff
        let k48 = o2_prezoff
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_iterscale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let r_edx = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
        let x1h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let m26 = 0.0
        let m42 = 0.0
        let m50 = 0.0
        let m58 = 0.0
        let m66 = 0.0
        let m74 = 0.0
        let m82 = 0.0
        let m90 = 0.0
        x0l = x
        x0h = y
        x1l = z
        x1h = 0.0
        ft = x0h * k24
        x0l = x0l * k32
        x0h = ft
        x1l = x1l * k32
        m90 = x0l
        m82 = x0h
        m74 = x1l
        ft = x0h + k56
        x0l = x0l + k64
        x0h = ft
        x1l = x1l + k48
        if k76 < 0.0 {
        } else {
            x5l = a0
            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        f0 = 1.0
        m26 = f0
        f0 = 2000.0
        rout = f0
        r_edx = k104
        r_edx = (r_edx - 32.0 * floor(r_edx / 32.0))
        if r_edx != 0.0 {
        } else {
            r_edx = 1.0
        }
        loop {
            f0 = m74
            f1 = m82
            f2 = m90
            f3 = f2
            f3 = f3 * k132
            f4 = f1
            f4 = f4 * k136
            f3 = f3 + f4
            f4 = f0
            f4 = f4 * k140
            f3 = f3 + f4
            f4 = f2
            f4 = f4 * k108
            f5 = f1
            f5 = f5 * k112
            f4 = f4 + f5
            f5 = f0
            f5 = f5 * k116
            f4 = f4 + f5
            ft = f4
            f4 = f2
            f2 = ft
            f4 = f4 * k120
            ft = f4
            f4 = f1
            f1 = ft
            f4 = f4 * k124
            f1 = f1 + f4
            ft = f3
            f3 = f0
            f0 = ft
            f3 = f3 * k128
            f1 = f1 + f3
            f2 = f2 * k16
            m66 = f2
            f2 = abs(f2)
            m42 = f2
            f2 = f2 - k64
            m90 = f2
            f1 = f1 * k16
            m58 = f1
            f1 = abs(f1)
            f2 = f1
            f3 = m42
            fc_a = f3
            fc_b = f2
            if fc_a <= fc_b {
            } else {
                f2 = f3
            }
            m42 = f2
            f1 = f1 - k56
            m82 = f1
            f0 = f0 * k16
            m50 = f0
            f0 = abs(f0)
            f1 = f0
            f2 = m42
            fc_a = f2
            fc_b = f1
            if fc_a <= fc_b {
            } else {
                f1 = f2
            }
            m42 = f1
            f0 = f0 - k48
            m74 = f0
            f0 = m74
            f1 = m82
            f2 = m90
            fc_a = f2
            fc_b = f1
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f1
                f1 = ft
            }
            fc_a = f2
            fc_b = f0
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            ft = f2
            f2 = f1
            f1 = ft
            fc_a = f2
            fc_b = f0
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            f2 = f2 - k92
            m82 = f2
            f1 = f1 - k84
            m90 = f1
            f0 = f0 - k100
            m74 = f0
            f0 = m74
            f1 = m82
            f2 = m90
            fc_a = f2
            fc_b = f1
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f1
                f1 = ft
            }
            fc_a = f2
            fc_b = f0
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            ft = f2
            f2 = f1
            f1 = ft
            fc_a = f2
            fc_b = f0
            if fc_a > fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            m82 = f2
            m90 = f1
            m74 = f0
            f0 = m26
            f0 = f0 * k16
            f0 = abs(f0)
            f1 = f0
            m26 = f1
            f1 = 1.0
            f1 = m42 - f1
            f2 = m90
            f2 = f2 * k72
            f3 = m82
            f3 = f3 * k68
            f2 = f2 + f3
            f3 = k16
            f4 = 0.0
            fc_a = f4
            fc_b = f3
            if fc_a <= fc_b {
            } else {
                f2 = -f2
            }
            fc_a = f2
