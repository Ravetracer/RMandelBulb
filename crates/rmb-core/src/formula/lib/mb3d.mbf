formula "_DonutTransform" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _DonutTransform. Based on Aexions ideas, this performs a toroidal transform to be used as first formula as pre-transform, and choosing 'repeat from here' on the next formula(s)."
    de numeric
    transform
    alias "_DonutTransform"
    param o0_offset "Offset" = 4.0 [-4.0, 12.0] 
    param o1_roffset "ROffset" = 0.5 [-1.5, 2.5] 
    param o2_order "Order" = 5.0 [-5.0, 15.0] 
    init {
        let k32 = o2_order
        let k24 = o1_roffset
        let k16 = o0_offset
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        f0 = x
        f1 = y
        f0 = atan2(f0, f1)
        f0 = f0 * k32
        m20 = f0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        m28 = f0
        f0 = f0 - k16
        m36 = f0
        f0 = m20
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = m28
        f0 = f0 * f2
        f1 = f1 * f2
        f2 = k24
        f0 = f0 - f2
        f1 = f1 - f2
        y = f1
        x = f0
        f0 = z
        f0 = f0 * f0
        f0 = f0 - k24
        f1 = m36
        f1 = f1 * f1
        f0 = f0 + f1
        dr = f0
        f0 = z
        f0 = f0 - k24
        z = f0
        f0 = cx
        f1 = cy
        f0 = atan2(f0, f1)
        f0 = f0 * k32
        m20 = f0
        f0 = cx
        f0 = f0 * f0
        f1 = cy
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        m28 = f0
        f0 = f0 - k16
        m36 = f0
        f0 = m20
        f1 = cos(f0)
        f0 = sin(f0)
        f2 = m28
        f0 = f0 * f2
        f1 = f1 * f2
        f2 = k24
        f0 = f0 - f2
        f1 = f1 - f2
        cy = f1
        cx = f0
        f0 = cz
        f0 = f0 * f0
        f0 = f0 - k24
        f1 = m36
        f1 = f1 * f1
        f0 = f0 + f1
        cw = f0
        f0 = cz
        f0 = f0 - k24
        cz = f0
    }
}

formula "_Exp4D" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _Exp4D. Computes exp(Q), following Hamiltonian theory, exact for all Q except for (Re(Q)>0 & Re(Q)<1e-200)."
    de numeric
    alias "_Exp4D"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = w
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = f0
        f2 = cos(f1)
        f1 = sin(f1)
        f3 = x
        f4 = 1.4426950408889634
        f3 = f3 * f4
        f4 = 1.0
        f5 = f3
        f5 = f5 % f4
        f5 = pow(2.0, f5) - 1.0
        f4 = f4 + f5
        f4 = f4 * pow(2.0, sel(f3 < 0.0, -floor(-f3), floor(f3)))
        ft = f4
        f4 = f3
        f3 = ft
        f4 = f3
        f4 = f4 * f2
        x = f4
        f3 = f3 * f1
        f4 = f0
        f5 = 1e-200
        fc_a = f5
        fc_b = f4
        if fc_a > fc_b {
        } else {
            f3 = f3 / f0
        }
        f4 = y
        f4 = f4 * f3
        y = f4
        f4 = z
        f4 = f4 * f3
        z = f4
        f4 = w
        f4 = f4 * f3
        w = f4
    }
}

