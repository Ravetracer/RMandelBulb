formula "Amazing Surf" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Amazing Surf. Formula proposed by Kali by a private message. I added some features btw"
    de linear
    alias "Amazing Surf"
    param o0_scale "Scale" = 1.5 [-1.5, 4.5] 
    param o1_min_r "Min R" = 0.5 [-1.5, 2.5] 
    param o2_fold "Fold" = 1.0 [-1.0, 3.0] 
    param o3_rotation1_x "Rotation1 X" = 5.0 [-180.0, 180.0] angle
    param o4_rotation1_y "Rotation1 Y" = 5.0 [-180.0, 180.0] angle
    param o5_rotation1_z "Rotation1 Z" = 5.0 [-180.0, 180.0] angle
    param o6_scale_vary "Scale vary" = 0.0 [-2.0, 2.0] 
    param o7_sphere_or_cylinder "Sphere or Cylinder" = 1.0 [-1.0, 3.0] int
    init {
        let k88 = round(o7_sphere_or_cylinder)
        let k84 = o6_scale_vary
        let k76 = single(cos(o3_rotation1_x * pi / 180.0) * cos(o4_rotation1_y * pi / 180.0))
        let k72 = single(cos(o3_rotation1_x * pi / 180.0) * sin(o4_rotation1_y * pi / 180.0) * sin(o5_rotation1_z * pi / 180.0) + sin(o3_rotation1_x * pi / 180.0) * cos(o5_rotation1_z * pi / 180.0))
        let k68 = single(sin(o3_rotation1_x * pi / 180.0) * sin(o5_rotation1_z * pi / 180.0) - cos(o3_rotation1_x * pi / 180.0) * sin(o4_rotation1_y * pi / 180.0) * cos(o5_rotation1_z * pi / 180.0))
        let k64 = single(-sin(o3_rotation1_x * pi / 180.0) * cos(o4_rotation1_y * pi / 180.0))
        let k60 = single(cos(o3_rotation1_x * pi / 180.0) * cos(o5_rotation1_z * pi / 180.0) - sin(o3_rotation1_x * pi / 180.0) * sin(o4_rotation1_y * pi / 180.0) * sin(o5_rotation1_z * pi / 180.0))
        let k56 = single(sin(o3_rotation1_x * pi / 180.0) * sin(o4_rotation1_y * pi / 180.0) * cos(o5_rotation1_z * pi / 180.0) + cos(o3_rotation1_x * pi / 180.0) * sin(o5_rotation1_z * pi / 180.0))
        let k52 = single(sin(o4_rotation1_y * pi / 180.0))
        let k48 = single(-cos(o4_rotation1_y * pi / 180.0) * sin(o5_rotation1_z * pi / 180.0))
        let k44 = single(cos(o4_rotation1_y * pi / 180.0) * cos(o5_rotation1_z * pi / 180.0))
        let k40 = o2_fold
        let k32 = sqr(max(1.0e-40, o1_min_r))
        let k24 = o0_scale / sqr(max(1.0e-40, o1_min_r))
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        if a1 > 0.0 {
        } else {
            a1 = a1 + 1.0
            f0 = k16
            a0 = f0
        }
        f0 = a0
        f1 = 1.0
        f2 = f0
        f2 = abs(f2)
        f1 = f2 - f1
        f1 = f1 * k84
        f0 = f0 + f1
        a0 = f0
        f0 = k40
        f1 = x
        f2 = f1
        f2 = f2 - f0
        f2 = abs(f2)
        f2 = f2 + f1
        ft = f2
        f2 = f1
        f1 = ft
        f2 = f2 + f0
        f2 = abs(f2)
        f1 = f2 - f1
        f2 = y
        f3 = f2
        f3 = f3 - f0
        f3 = abs(f3)
        f3 = f3 + f2
        ft = f3
        f3 = f2
        f2 = ft
        f3 = f3 + f0
        f3 = abs(f3)
        f2 = f3 - f2
        y = f2
        f2 = f2 * f2
        ft = f2
        f2 = f1
        f1 = ft
        x = f2
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f1
        if k88 != 0.0 {
        } else {
            f1 = z
            f1 = f1 * f1
            f0 = f0 + f1
        }
        fc_a = f0
        fc_b = k32
        if fc_a >= fc_b {
            f1 = 1.0
            fc_a = f1
            fc_b = f0
            if fc_a < fc_b {
                fc_a = f1
                fc_b = f0
                f0 = a0
            } else {
                f0 = a0 / f0
            }
        } else {
            f0 = k24
        }
        f1 = dr
        f1 = f1 * f0
        dr = f1
        f1 = z
        f1 = f1 * f0
        f1 = f1 + cz
        f2 = y
        f2 = f2 * f0
        f2 = f2 + cy
        f3 = x
        f3 = f3 * f0
        f3 = f3 + cx
        f4 = f3
        f4 = f4 * k68
        f5 = f2
        f5 = f5 * k72
        f4 = f4 + f5
        f5 = f1
        f5 = f5 * k76
        f4 = f4 + f5
        f5 = f3
        f5 = f5 * k44
        f6 = f2
        f6 = f6 * k48
        f5 = f5 + f6
        f6 = f1
        f6 = f6 * k52
        f5 = f5 + f6
        ft = f5
        f5 = f3
        f3 = ft
        f5 = f5 * k56
        ft = f5
        f5 = f2
        f2 = ft
        f5 = f5 * k60
        f2 = f2 + f5
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k64
        f2 = f2 + f4
        x = f3
        y = f2
        z = f1
    }
}

formula "AmazingBox2" {
    category "MB3D 3D"
