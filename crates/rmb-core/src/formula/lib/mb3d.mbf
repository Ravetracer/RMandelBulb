formula "Makin3D-3-4" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Makin3D-3-4. From WIP3D5 in MMFwip3D.ufm, by David Makin, uploaded at FractalForums."
    de numeric
    alias "Makin3D-3-4"
    param o0_fuzzy_y "Fuzzy-Y" = 0.0 [-2.0, 2.0] int
    param o1_fuzzy_z "Fuzzy-Z" = 0.0 [-2.0, 2.0] int
    param o2_limiter "Limiter" = 0.01 [-1.99, 2.01] 
    init {
        let k24 = o2_limiter
        let k16 = round(o1_fuzzy_z)
        let k12 = round(o0_fuzzy_y)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
