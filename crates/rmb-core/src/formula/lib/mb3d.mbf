            m8 = x1l
            f0 = k92
            f0 = f0 * m8
            f1 = cos(f0)
            f0 = sin(f0)
            f2 = m16
            f3 = m24
            f4 = f0
            f4 = f4 * f3
            f5 = f2
            f5 = f5 * f1
            f4 = f4 + f5
            m24 = f4
            f1 = f1 * f3
            f0 = f0 * f2
            f0 = f1 - f0
            m16 = f0
            x0l = m24
            x0h = m16
        }
        x3l = x1l
        x0l = abs(x0l)
        x0h = abs(x0h)
        x1l = abs(x1l)
        x1h = abs(x1h)
        x3l = x3l * k88
        ft = x0h - k24
        x0l = x0l - k32
        x0h = ft
        x1l = x1l - k16
        x0l = x0l - x3l
