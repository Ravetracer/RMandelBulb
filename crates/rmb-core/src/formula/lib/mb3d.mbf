formula "JCube3" {
    category "MB3D 3D"
    description "Mandelbulb3D formula JCube3. A brute-force IFS formula, that tries to replicate the 'Jerusalem Cube' fractal."
    de linear
    alias "JCube3"
    param o0_alpha "Alpha" = 0.41421356 [-1.5857864400000001, 2.41421356] 
    param o1_cx1 "Cx1" = 0.0 [-2.0, 2.0] 
    param o2_cy1 "Cy1" = 1.0 [-1.0, 3.0] 
    param o3_cz1 "Cz1" = 1.0 [-1.0, 3.0] 
    param o4_cx2 "Cx2" = 1.0 [-1.0, 3.0] 
    param o5_cy2 "Cy2" = 1.0 [-1.0, 3.0] 
    param o6_cz2 "Cz2" = 1.0 [-1.0, 3.0] 
    param o7_gscale_test "GScale (test)" = 3.0 [-3.0, 9.0] 
    init {
        let k80 = o7_gscale_test
        let k72 = o6_cz2
        let k64 = o5_cy2
        let k56 = o4_cx2
        let k48 = o3_cz1
        let k40 = o2_cy1
        let k32 = o1_cx1
        let k24 = 1.0 / max(1.0e-40, o0_alpha)
        let k16 = o0_alpha
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let m68 = 0.0
        let m76 = 0.0
        let m84 = 0.0
        let m92 = 0.0
        fc_a = z
        fc_b = 0.0
        z = abs(z)
        fc_a = y
        fc_b = 0.0
        y = abs(y)
        fc_a = x
        fc_b = 0.0
        x = abs(x)
        f0 = k80
        f1 = 1.0
        f1 = f0 - f1
        ft = f1
        f1 = f0
        f0 = ft
        f1 = -f1
        m68 = f1
        f0 = f0 + k16
        m92 = f0
        f0 = f0 * k24
        m84 = f0
        f1 = 1.0
        f0 = f1 / f0
        m76 = f0
        f0 = f0 * m68
        f1 = 1.0
        f0 = f0 + f1
        m68 = f0
        f0 = z
        f1 = y
        f2 = x
        fc_a = f2
        fc_b = f1
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        f3 = f2
        f4 = m76
        fc_a = f4
        fc_b = f3
        if fc_a < fc_b {
            f3 = k56
            f2 = f2 - f3
            f3 = k64
            f1 = f1 - f3
            f3 = k72
            f0 = f0 - f3
            f3 = m92
            f0 = f0 * f3
            f1 = f1 * f3
            f2 = f2 * f3
            f4 = dr
            f3 = f3 * f4
            dr = f3
            f3 = k56
            f2 = f2 + f3
            f3 = k64
            f1 = f1 + f3
            f3 = k72
            f0 = f0 + f3
        } else {
            f3 = f2
            f3 = f3 + m68
            f4 = f1
            fc_a = f4
            fc_b = f3
            if fc_a < fc_b {
                f3 = k56
                f2 = f2 - f3
                f3 = k64
                f1 = f1 - f3
                f3 = k72
                f0 = f0 - f3
                f3 = m92
                f0 = f0 * f3
                f1 = f1 * f3
                f2 = f2 * f3
                f4 = dr
                f3 = f3 * f4
                dr = f3
                f3 = k56
                f2 = f2 + f3
                f3 = k64
                f1 = f1 + f3
                f3 = k72
                f0 = f0 + f3
            } else {
                f3 = k32
                f2 = f2 - f3
                f3 = k40
                f1 = f1 - f3
                f3 = k48
                f0 = f0 - f3
                f3 = m84
                f0 = f0 * f3
                f1 = f1 * f3
                f2 = f2 * f3
                f4 = dr
                f3 = f3 * f4
                dr = f3
                f3 = k32
                f2 = f2 + f3
                f3 = k40
                f1 = f1 + f3
                f3 = k48
                f0 = f0 + f3
            }
        }
        x = f2
        y = f1
        z = f0
    }
}

formula "KaliDucks" {
    category "MB3D 3D"
    description "Mandelbulb3D formula KaliDucks. A formula suggested by Kali at fractalforums.com."
    de numeric
    descale 0.5
    alias "KaliDucks"
    param o0_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o1_min_r "Min R" = 0.5 [-1.5, 2.5] 
    init {
        let k24 = o1_min_r
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f0 = abs(f0)
        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        f3 = rout
        f4 = k24
        fc_a = f4
        fc_b = f3
        if fc_a > fc_b {
            f4 = f4 * f4
            f5 = 1.0
            f4 = f5 / f4
            ft = f4
            f4 = f3
            f3 = ft
        } else {
            f3 = k16 / f3
        }
        f1 = f1 * f3
        f0 = f0 * f3
        f2 = f2 * f3
        f2 = f2 + cx
        x = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cz
        z = f0
    }
}

formula "KaliLinCombSSE2sm" {
    category "MB3D 3D"
    description "Mandelbulb3D formula KaliLinCombSSE2sm. "
    de numeric
    alias "KaliLinCombSSE2sm"
    param o0_integer_power_2_9 "Integer power 2..9" = 2.0 [-2.0, 6.0] int
    init {
        let k12 = round(o0_integer_power_2_9)
        let k8 = 0.5
    }
    iter {
        let ft = 0.0
        let r_ebx = 0.0
        let r_edi = 0.0
        let x0l = 0.0
        let x0h = 0.0
        let x1l = 0.0
