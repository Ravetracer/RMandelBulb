formula "_coordvspow" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _coordvspow. With this tool you can create a custom linear combination of transformations."
    de numeric
    alias "_coordvspow"
    param o0_power "Power %" = 100.0 [-100.0, 300.0] int
    param o1_float_pow "Float pow" = 1.0 [-1.0, 3.0] 
    param o2_cylindric "Cylindric %" = 0.0 [-2.0, 2.0] int
    param o3_spheric "Spheric %" = 0.0 [-2.0, 2.0] int
    param o4_i_cylindric "I.Cylindric %" = 0.0 [-2.0, 2.0] int
    param o5_i_spheric "I.Spheric %" = 0.0 [-2.0, 2.0] int
    param o6_exp3d "Exp3D %" = 0.0 [-2.0, 2.0] int
    init {
        let k40 = round(o6_exp3d)
        let k36 = round(o5_i_spheric)
        let k32 = round(o4_i_cylindric)
        let k28 = round(o3_spheric)
        let k24 = round(o2_cylindric)
        let k20 = o1_float_pow
        let k12 = round(o0_power)
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m52 = 0.0
        let m60 = 0.0
        let m68 = 0.0
        let m76 = 0.0
        if k12 != 0.0 {
            f0 = k20
            f1 = 1.0
            fc_a = f1
            fc_b = f0
            if fc_a == fc_b {
                f0 = x
                f0 = f0 * k12
                f0 = f0 * 0.01
                m12 = f0
                f0 = y
                f0 = f0 * k12
                f0 = f0 * 0.01
                m20 = f0
                f0 = z
                f0 = f0 * k12
                f0 = f0 * 0.01
                m28 = f0
            } else {
                f0 = k20
                f1 = 0.0
                fc_a = f1
                fc_b = f0
                if fc_a == fc_b {
                    f0 = x
                    f0 = f0 * k12
                    f0 = f0 * 0.01
                    m12 = f0
                    f0 = y
                    f0 = f0 * k12
                    f0 = f0 * 0.01
                    m20 = f0
                    f0 = z
                    f0 = f0 * k12
                    f0 = f0 * 0.01
                    m28 = f0
                } else {
                    f0 = x
                    f0 = f0 * f0
                    f1 = y
                    f1 = f1 * f1
                    f2 = z
                    f2 = f2 * f2
                    f1 = f1 + f2
                    f0 = f0 + f1
                    f0 = sqrt(f0)
                    m36 = f0
                    f1 = k20
                    ft = f1
                    f1 = f0
                    f0 = ft
                    f1 = abs(f1)
                    f0 = f0 * log(f1) * 1.4426950408889634
                    f1 = 1.0
                    f2 = f0
                    f2 = f2 % f1
                    f2 = pow(2.0, f2) - 1.0
                    f1 = f1 + f2
                    f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
                    ft = f1
                    f1 = f0
                    f0 = ft
                    m44 = f0
                    f0 = y
                    f1 = x
                    f0 = atan2(f0, f1)
                    f0 = f0 * k20
                    f1 = z
                    f1 = f1 / m36
                    f2 = f1
                    f2 = f2 * f2
                    f2 = -f2
                    f3 = 1.0
                    f2 = f2 + f3
                    f2 = sqrt(f2)
                    f3 = 1.0
                    f2 = f2 + f3
                    ft = f2
                    f2 = f1
                    f1 = ft
                    f1 = atan2(f1, f2)
                    f1 = f1 + f1
                    f1 = f1 * k20
                    f2 = cos(f1)
                    f1 = sin(f1)
                    m76 = f2
                    m68 = f1
                    f1 = cos(f0)
                    f0 = sin(f0)
                    m60 = f1
                    m52 = f0
                    f0 = m44
                    f0 = f0 * m60
                    f0 = f0 * m76
                    f0 = f0 * k12
                    f0 = f0 * 0.01
                    m12 = f0
                    f0 = m44
                    f0 = f0 * m52
                    f0 = f0 * m76
                    f0 = f0 * k12
                    f0 = f0 * 0.01
                    m20 = f0
                    f0 = m44
                    f0 = f0 * m68
                    f0 = f0 * k12
                    f0 = f0 * 0.01
                    m28 = f0
                }
            }
        } else {
            f0 = 0.0
            m12 = f0
            m20 = f0
            m28 = f0
        }
        if k24 == 0.0 {
        } else {
            f0 = x
            f0 = f0 * f0
            f1 = y
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f1 = y
            f2 = x
            f1 = atan2(f1, f2)
            f1 = f1 * k24
            f1 = f1 * 0.01
            f1 = f1 + m20
            m20 = f1
            f0 = f0 * k24
            f0 = f0 * 0.01
            f0 = f0 + m12
            m12 = f0
        }
        if k28 == 0.0 {
        } else {
            f0 = x
            f0 = f0 * f0
            f1 = y
            f1 = f1 * f1
            f0 = f0 + f1
            f1 = z
            f1 = f1 * f1
            f1 = f1 + f0
            f1 = sqrt(f1)
            ft = f1
            f1 = f0
            f0 = ft
            f1 = sqrt(f1)
            f2 = z
            f1 = atan2(f1, f2)
            f2 = y
            f3 = x
            f2 = atan2(f2, f3)
            f2 = f2 * k28
            f2 = f2 * 0.01
            f2 = f2 + m28
            m28 = f2
            f1 = f1 * k28
            f1 = f1 * 0.01
            f1 = f1 + m20
            m20 = f1
            f0 = f0 * k28
            f0 = f0 * 0.01
            f0 = f0 + m12
            m12 = f0
        }
        if k32 == 0.0 {
        } else {
            f0 = x
            f1 = y
            f1 = cos(f1)
            f0 = f0 * f1
            f1 = x
            f2 = y
            f2 = sin(f2)
            f1 = f1 * f2
            f1 = f1 * k32
            f1 = f1 * 0.01
            f1 = f1 + m20
            m20 = f1
            f0 = f0 * k32
            f0 = f0 * 0.01
            f0 = f0 + m12
            m12 = f0
        }
        if k36 == 0.0 {
        } else {
            f0 = y
            f1 = cos(f0)
            f0 = sin(f0)
            f2 = z
            f3 = cos(f2)
            f2 = sin(f2)
            ft = f3
            f3 = f1
            f1 = ft
            f3 = f3 * x
            f3 = f3 * k36
            f3 = f3 * 0.01
            f3 = f3 + m28
            m28 = f3
            ft = f2
            f2 = f0
            f0 = ft
            f1 = f1 * f2
            ft = f2
            f2 = f1
            f1 = ft
            f2 = f2 * x
            ft = f2
            f2 = f0
            f0 = ft
            ft = f2
            f2 = f1
            f1 = ft
            f2 = f2 * x
            f1 = f1 * f2
            f1 = f1 * k36
            f1 = f1 * 0.01
            f1 = f1 + m20
            m20 = f1
            f0 = f0 * k36
            f0 = f0 * 0.01
            f0 = f0 + m12
            m12 = f0
        }
        if k40 == 0.0 {
        } else {
            f0 = x
            f0 = f0 * f0
            f1 = y
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f1 = z
            f0 = f1 / f0
            m36 = f0
            f0 = f0 * y
            f0 = -f0
            f0 = f0 + x
            f1 = 1.4426950408889634
            f0 = f0 * f1
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            f0 = f0 * 0.5
            m44 = f0
            f0 = m36
            f0 = f0 * x
            f0 = f0 + y
            f1 = cos(f0)
            f0 = sin(f0)
            m60 = f1
            m52 = f0
            f0 = m36
            f0 = f0 * x
            f0 = f0 - y
            f1 = cos(f0)
            f0 = sin(f0)
            m76 = f1
            m68 = f0
            f0 = m36
            f0 = f0 * y
            f0 = f0 + f0
            f1 = 1.4426950408889634
            f0 = f0 * f1
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            m36 = f0
            f0 = m36
            f0 = f0 * m76
            f0 = f0 + m60
            f0 = f0 * m44
            f0 = f0 * k40
            f0 = f0 * 0.01
            f0 = f0 + m12
            m12 = f0
            f0 = m36
            f0 = f0 * m68
            f0 = -f0
            f0 = f0 + m52
            f0 = f0 * m44
            f0 = f0 * k40
            f0 = f0 * 0.01
            f0 = f0 + m20
            m20 = f0
            f0 = x
            f0 = f0 * f0
            f1 = y
            f1 = f1 * f1
            f0 = f0 + f1
            f0 = sqrt(f0)
            f1 = 1.4426950408889634
            f0 = f0 * f1
            f1 = 1.0
            f2 = f0
            f2 = f2 % f1
            f2 = pow(2.0, f2) - 1.0
            f1 = f1 + f2
            f1 = f1 * pow(2.0, sel(f0 < 0.0, -floor(-f0), floor(f0)))
            ft = f1
            f1 = f0
            f0 = ft
            f1 = z
            f1 = sin(f1)
            f0 = f0 * f1
            f0 = f0 * k40
            f0 = f0 * 0.01
            f0 = f0 + m28
            m28 = f0
        }
        f0 = m28
        z = f0
        f0 = m20
        y = f0
        f0 = m12
        x = f0
    }
}

formula "_cosmartin" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _cosmartin. CosMartin deformation in 4D - variation with four parameters and strength"
    de numeric
    transform
    alias "_cosmartin"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 0.5 [-1.5, 2.5] 
    param o2_beta "Beta" = 0.75 [-1.25, 2.75] 
    param o3_gamma "Gamma" = 1.0 [-1.0, 3.0] 
    param o4_delta "Delta" = 1.0 [-1.0, 3.0] 
    init {
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        f0 = y
        f1 = x
        f1 = f1 * k32
        f1 = cos(f1)
        f1 = -f1
        f1 = f1 * k24
        f0 = f0 + f1
        f0 = f0 * k16
        f1 = k40
        f1 = f1 - x
        f1 = f1 * k16
        y = f1
        x = f0
        f0 = dr
        f1 = z
        f1 = f1 * k32
        f1 = cos(f1)
        f1 = -f1
        f1 = f1 * k24
        f0 = f0 + f1
        f0 = f0 * k16
        f1 = k48
        f1 = f1 - z
        f1 = f1 * k16
        dr = f1
        z = f0
    }
}

formula "_cylripple" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _cylripple. You are warned; this transform may slow down and/or cause de trouble."
    de numeric
    descale 0.1
    alias "_cylripple"
    param o0_reference_rotation_x "Reference rotation X" = 0.0 [-180.0, 180.0] angle
    param o1_reference_rotation_y "Reference rotation Y" = 0.0 [-180.0, 180.0] angle
    param o2_reference_rotation_z "Reference rotation Z" = 0.0 [-180.0, 180.0] angle
    param o3_longitudinal_freq "Longitudinal (freq.)" = 6.0 [-6.0, 18.0] 
    param o4_longitudinal_ampl "Longitudinal (ampl.)" = 0.05 [-1.95, 2.05] 
    param o5_trasverse_freq "Trasverse (freq.)" = 12.0 [-12.0, 36.0] 
    param o6_trasverse_ampl "Trasverse (ampl.)" = 0.05 [-1.95, 2.05] 
    param o7_byc_l "ByC (L)" = 0.0 [-2.0, 2.0] int
    param o8_byc_t "ByC (T)" = 0.0 [-2.0, 2.0] int
    init {
        let k84 = round(o8_byc_t)
        let k80 = round(o7_byc_l)
        let k76 = o6_trasverse_ampl
        let k68 = o5_trasverse_freq
        let k60 = o4_longitudinal_ampl
        let k52 = o3_longitudinal_freq
        let k44 = single(cos(o0_reference_rotation_x * pi / 180.0) * cos(o1_reference_rotation_y * pi / 180.0))
        let k40 = single(cos(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0) + sin(o0_reference_rotation_x * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0))
        let k36 = single(sin(o0_reference_rotation_x * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0) - cos(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0))
        let k32 = single(-sin(o0_reference_rotation_x * pi / 180.0) * cos(o1_reference_rotation_y * pi / 180.0))
        let k28 = single(cos(o0_reference_rotation_x * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0) - sin(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0))
        let k24 = single(sin(o0_reference_rotation_x * pi / 180.0) * sin(o1_reference_rotation_y * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0) + cos(o0_reference_rotation_x * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0))
        let k20 = single(sin(o1_reference_rotation_y * pi / 180.0))
        let k16 = single(-cos(o1_reference_rotation_y * pi / 180.0) * sin(o2_reference_rotation_z * pi / 180.0))
        let k12 = single(cos(o1_reference_rotation_y * pi / 180.0) * cos(o2_reference_rotation_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let ft = 0.0
        let m12 = 0.0
        let m20 = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k36
        f4 = f1
        f4 = f4 * k40
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k16
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k20
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k32
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
        if k80 != 1.0 {
            f0 = cx
            f0 = f0 * f0
            f1 = cy
        } else {
            f0 = x
            f0 = f0 * f0
            f1 = y
        }
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        m12 = f0
        f0 = f0 * k52
        f0 = sin(f0)
        f0 = f0 * k60
        if k84 != 1.0 {
            f1 = cy
            f2 = cx
        } else {
            f1 = y
            f2 = x
        }
        f1 = atan2(f1, f2)
        m20 = f1
        f1 = f1 * k68
        f1 = sin(f1)
        f1 = f1 * k76
        f2 = 1.0
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = f0 * m12
        x = f0
        f0 = m20
        y = f0
        f0 = x
        f1 = y
        f1 = cos(f1)
        f0 = f0 * f1
        f1 = x
        f2 = y
        f2 = sin(f2)
        f1 = f1 * f2
        y = f1
        x = f0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k20
        f4 = f1
        f4 = f4 * k32
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k24
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k36
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k16
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k40
        f1 = f1 + f3
        x = f2
        y = f1
        z = f0
    }
}

formula "_dynamic" {
