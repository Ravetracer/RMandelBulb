formula "Fuzzy" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Fuzzy. "
    de numeric
    alias "Fuzzy"
    param o0_power "Power" = 8.0 [-8.0, 24.0] 
    param o1_y_multiplier "Y multiplier" = -1.0 [-3.0, 1.0] 
    init {
        let k24 = o1_y_multiplier
        let k16 = o0_power
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
