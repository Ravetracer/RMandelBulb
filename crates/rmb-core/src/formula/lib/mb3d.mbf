        f5 = f5 * k64
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k72
        f4 = f4 + f5
        f4 = f4 + k48
        f5 = f1
        f5 = f5 - f4
        f5 = abs(f5)
