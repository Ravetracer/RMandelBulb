        let q0_0_31 = 0.0
        let q0_0_32 = 0.0
        let q0_0_33 = 1.0
        let q0_1_00 = (cos(o1_rotation_xz * pi / 180.0)) * q0_0_00 + (-sin(o1_rotation_xz * pi / 180.0)) * q0_0_20
        let q0_1_01 = (cos(o1_rotation_xz * pi / 180.0)) * q0_0_01 + (-sin(o1_rotation_xz * pi / 180.0)) * q0_0_21
        let q0_1_02 = (cos(o1_rotation_xz * pi / 180.0)) * q0_0_02 + (-sin(o1_rotation_xz * pi / 180.0)) * q0_0_22
        let q0_1_03 = (cos(o1_rotation_xz * pi / 180.0)) * q0_0_03 + (-sin(o1_rotation_xz * pi / 180.0)) * q0_0_23
        let q0_1_10 = q0_0_10
        let q0_1_11 = q0_0_11
