    param o4_rotate_y "Rotate Y" = 0.0 [-180.0, 180.0] angle
    param o5_rotate_z "Rotate Z" = 0.0 [-180.0, 180.0] angle
    param o6_inv_xc "Inv xC" = 0.0 [-2.0, 2.0] 
    param o7_inv_yc "Inv yC" = 0.0 [-2.0, 2.0] 
    param o8_inv_zc "Inv zC" = 0.0 [-2.0, 2.0] 
