        f0 = y
        f0 = f0 * 0.7071067811865475
        y = f0
        f0 = x
        f0 = f0 * 0.5773502691896258
        f1 = z
        f1 = f1 * 0.816496580927726
        f0 = f0 + f1
        f1 = m12
        f1 = f1 - y
        f2 = m12
        f2 = f2 + y
        f2 = f2 * f2
        m20 = f2
        f1 = f1 * f1
        m12 = f1
        f0 = f0 * f0
        z = f0
        f0 = m20
        f0 = f0 + z
        f0 = sqrt(f0)
        f0 = f0 - k24
        f0 = abs(f0)
        f0 = f0 * k16
        f0 = f0 * 0.7071067811865475
        x = f0
        f0 = m12
        f0 = f0 + z
        f0 = sqrt(f0)
        f0 = f0 - k24
        f0 = abs(f0)
        f0 = f0 * k16
        f0 = f0 * 0.7071067811865475
        y = f0
        f0 = m12
        f0 = f0 + m20
        f0 = sqrt(f0)
        f0 = f0 - k24
        f0 = abs(f0)
        f0 = f0 * k16
        z = f0
        f0 = y
        f0 = f0 + x
        f1 = y
        f1 = f1 - x
        y = f1
        m12 = f0
        f0 = m12
        f0 = f0 * 0.816496580927726
        f1 = z
        f1 = f1 * 0.5773502691896258
        f0 = f0 + f1
        f1 = m12
        f1 = f1 * 0.5773502691896258
        f1 = -f1
        f2 = z
        f2 = f2 * 0.816496580927726
        f1 = f1 + f2
