        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = z
        f0 = f0 - k24
        f1 = x
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = f0 * y
        f1 = x
        f1 = f1 * k40
        f0 = f0 + f1
        f0 = f0 * k16
        f1 = z
        f1 = f1 * k32
        f1 = f1 + k24
        f2 = x
        f2 = f2 * f2
        f2 = -f2
