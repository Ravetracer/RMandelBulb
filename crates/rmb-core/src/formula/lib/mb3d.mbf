        z = f0
        f0 = y
        f1 = k24
        f0 = f0 * f1
        y = f0
        f0 = x
        f1 = k16
        f0 = f0 * f1
        x = f0
    }
}

formula "_Sin4Dplus" {
    category "MB3D 4D"
    description "Mandelbulb3D formula _Sin4Dplus. Computes sin(Q+P) * a, following Hamiltonian (non commutative) theory."
    de numeric
    alias "_Sin4Dplus"
    param o0_px "Px" = 0.0 [-2.0, 2.0] 
    param o1_py "Py" = 0.0 [-2.0, 2.0] 
    param o2_pz "Pz" = 0.0 [-2.0, 2.0] 
    param o3_pw "Pw" = 0.0 [-2.0, 2.0] 
    param o4_a "a" = 1.5 [-1.5, 4.5] 
    init {
        let k48 = o4_a
        let k40 = o3_pw
        let k32 = o2_pz
        let k24 = o1_py
        let k16 = o0_px
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let f7 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f0 = f0 + k16
        x = f0
        f0 = y
        f0 = f0 + k24
        y = f0
        f0 = z
        f0 = f0 + k32
        z = f0
        f0 = w
        f0 = f0 + k40
        w = f0
        f0 = w
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f1 = f0
        f2 = 1e-5
        fc_a = f2
        fc_b = f1
        f1 = x
        f2 = cos(f1)
        f1 = sin(f1)
        f3 = f0
        f4 = 1.4426950408889634
        f3 = f3 * f4
        f4 = 1.0
        f5 = f3
        f5 = f5 % f4
        f5 = pow(2.0, f5) - 1.0
        f4 = f4 + f5
        f4 = f4 * pow(2.0, sel(f3 < 0.0, -floor(-f3), floor(f3)))
        ft = f4
        f4 = f3
        f3 = ft
        f4 = f3
        f5 = 1.0
        f6 = f4
        f5 = f5 / f6
        f5 = -f5
        f4 = f4 + f5
        f4 = f4 * 0.5
        f5 = f3
        f6 = 1.0
        f7 = f5
        f6 = f6 / f7
        f5 = f5 + f6
        f5 = f5 * 0.5
        f3 = f5
        f5 = f1
        f5 = f5 * f3
        x = f5
        f5 = f2
        f5 = f5 * f4
        f5 = f5 / f0
        f4 = f5
        f3 = f4
        f2 = f3
        f1 = f2
        f0 = f1
        f1 = y
        f1 = f1 * f0
        y = f1
        f1 = z
        f1 = f1 * f0
        z = f1
        f1 = w
        f1 = f1 * f0
        w = f1
        f0 = x
        f0 = f0 * k48
        x = f0
        f0 = y
        f0 = f0 * k48
        y = f0
        f0 = z
        f0 = f0 * k48
        z = f0
        f0 = w
        f0 = f0 * k48
        w = f0
    }
}

formula "_SinY" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _SinY. New added parameters:"
    de numeric
    transform
    alias "_SinY"
    param o0_index "Index" = 1.0 [-1.0, 3.0] int
    param o1_offset_1 "Offset 1" = 0.0 [-2.0, 2.0] 
    param o2_scale_1 "Scale 1" = 1.0 [-1.0, 3.0] 
    param o3_scale_2 "Scale 2" = 1.0 [-1.0, 3.0] 
    param o4_offset_2 "Offset 2" = 0.0 [-2.0, 2.0] 
    init {
        let k28 = single(o4_offset_2)
        let k24 = single(o3_scale_2)
        let k20 = single(o2_scale_1)
        let k16 = single(o1_offset_1)
        let k12 = round(o0_index)
    }
    iter {
        let f0 = 0.0
        let r_esi = 0.0
        let tw0 = 0.0
        r_esi = k12
        r_esi = (r_esi - 4.0 * floor(r_esi / 4.0))
        f0 = sel(r_esi == 0.0, x, sel(r_esi == 1.0, y, sel(r_esi == 2.0, z, dr)))
        f0 = f0 - k16
        f0 = f0 * k20
        f0 = sin(f0)
        f0 = f0 * k24
        f0 = f0 + k28
        tw0 = f0
        if r_esi == 0.0 {
            x = tw0
        } else {
            if r_esi == 1.0 {
                y = tw0
            } else {
                if r_esi == 2.0 {
                    z = tw0
                } else {
                    if r_esi == 3.0 {
                        dr = tw0
                    }
                }
            }
        }
    }
}

formula "_SinePow2" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _SinePow2. Does the transformation like the sine power 2 bulb, but without adding C."
    de numeric
    alias "_SinePow2"
    param o0_y_multiplier "Y multiplier" = 1.0 [-1.0, 3.0] 
    param o1_z_multiplier "Z multiplier" = -1.0 [-3.0, 1.0] 
    init {
        let k24 = o1_z_multiplier
        let k16 = o0_y_multiplier
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f1
        f3 = f3 * f1
        f4 = f2
        f4 = f4 * f2
        f5 = f4
        f5 = f5 + f3
        f6 = f5
        f6 = sqrt(f6)
        f6 = f6 * k24
        f6 = f6 * f0
        f6 = f6 + f6
        z = f6
        f6 = f0
        f0 = f0 * f6
        f6 = f5
        f0 = f6 - f0
        f0 = f0 / f5
        f3 = f4 - f3
        f3 = f3 * f0
        x = f3
        f1 = f1 * f2
        f0 = f0 * f1
        f0 = f0 + f0
        f0 = f0 * k16
        y = f0
    }
}

formula "_SinhX" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _SinhX. Hyp.Sine for x + some bells & whistles"
    de numeric
    transform
    alias "_SinhX"
    param o0_fixx "fixX" = 0.0 [-2.0, 2.0] 
    param o1_fixlg "fixLg" = 0.0 [-2.0, 2.0] 
    param o2_mul "Mul" = -2.0 [-6.0, 2.0] 
    param o3_base "Base" = 0.367879441 [-1.632120559, 2.367879441] 
    init {
        let k40 = o3_base
        let k32 = o2_mul
        let k24 = o1_fixlg
        let k16 = o0_fixx
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let ft = 0.0
        let sv1 = 0.0
        f0 = x
        f1 = k32
        f0 = f0 * f1
        f1 = k16
        f0 = f0 + f1
        x = f0
        sv1 = x
        f0 = abs(f0)
        f1 = k24
        f1 = abs(f1)
        f0 = f0 + f1
        f1 = k40
        ft = f1
        f1 = f0
        f0 = ft
        f0 = f0 * log(f1) * 1.4426950408889634
        x = f0
        x = sel(sv1 < 0.0, -x, x)
    }
}

