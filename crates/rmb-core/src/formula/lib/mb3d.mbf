            x5h = 0.0
            x5l = x5l * k32
            x = x0l
            y = x0h
            z = x1l
            a0 = x5l
        }
        m40 = x0l
        m32 = x0h
        m24 = x1l
        f0 = m40
        f1 = m32
        f0 = atan2(f0, f1)
        f0 = 1.57079632675 - f0
        f0 = f0 * 0.159154943
        f0 = f0 * k12
        f0 = round(f0)
        f0 = f0 / k12
        f0 = f0 * 6.283185307
        f1 = cos(f0)
        f0 = sin(f0)
        m8 = f1
        m16 = f0
        f0 = m40
        f0 = f0 * m16
        f1 = m32
        f1 = f1 * m8
        f1 = -f1
        f0 = f0 + f1
        f1 = m40
        f1 = f1 * m8
        f2 = m32
        f2 = f2 * m16
        f1 = f1 + f2
        m40 = f1
        m32 = f0
        f0 = m40
        f1 = m24
        f0 = atan2(f0, f1)
        f0 = 1.57079632675 - f0
        f0 = f0 * 0.159154943
        f0 = f0 * k16
        f0 = round(f0)
        f0 = f0 / k16
        f0 = f0 * 6.283185307
        f1 = cos(f0)
        f0 = sin(f0)
        m8 = f1
        m16 = f0
        f0 = m40
        f0 = f0 * m8
        f1 = m24
        f1 = f1 * m16
        f0 = f0 + f1
        f0 = f0 - k76
        f0 = abs(f0)
