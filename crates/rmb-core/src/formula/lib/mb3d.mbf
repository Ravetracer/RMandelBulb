formula "_tospherical" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _tospherical. Spherical coords. Fast conversion without parameters."
    de numeric
    transform
    alias "_tospherical"
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let ft = 0.0
        f0 = x
        f0 = f0 * x
        f1 = y
        f1 = f1 * y
        f0 = f0 + f1
        f1 = z
        f1 = f1 * z
        f1 = f1 + f0
        f1 = sqrt(f1)
        ft = f1
        f1 = f0
        f0 = ft
        f1 = sqrt(f1)
        f2 = z
        f1 = atan2(f1, f2)
        f2 = y
        f3 = x
        f2 = atan2(f2, f3)
        z = f2
        y = f1
        x = f0
    }
}

formula "_totorical" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _totorical. Torical (generalized) coords."
    de numeric
    transform
    alias "_totorical"
    param o0_r "R" = 2.0 [-2.0, 6.0] 
    init {
        let k16 = o0_r
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = -f0
        f0 = f0 + k16
        f1 = y
        f2 = x
        f1 = atan2(f1, f2)
        y = f1
        x = f0
    }
}

formula "_totorical2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _totorical2. Torical (generalized) coords."
    de numeric
    transform
    alias "_totorical2"
    param o0_r "R" = 2.0 [-2.0, 6.0] 
    param o1_gamma "Gamma" = 0.0 [-2.0, 2.0] 
    init {
        let k24 = o1_gamma
        let k16 = o0_r
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f0 = f0 + f1
        f0 = sqrt(f0)
        f0 = f0 - k16
        f1 = f0
        f1 = f1 * f1
        f2 = z
        f2 = f2 * f2
        f1 = f1 + f2
        f1 = sqrt(f1)
        f2 = f0
        f3 = z
        f2 = atan2(f2, f3)
        f2 = f2 - k24
        f2 = f2 - 1.5707963267948966
        f3 = y
        f4 = x
        f3 = atan2(f3, f4)
        z = f3
        y = f2
        x = f1
    }
}

formula "_updateC" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _updateC. Moves x, y, z values to Cx, Cy, Cz or linear-combines C and xyz values, like this"
    de numeric
    transform
    alias "_updateC"
    param o0_xyz_mul "xyz mul" = 1.0 [-1.0, 3.0] 
    param o1_c_xyz_mul "C-xyz mul" = 0.0 [-2.0, 2.0] 
    init {
        let k24 = o1_c_xyz_mul
        let k16 = o0_xyz_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        f0 = x
        f0 = f0 * k16
        f1 = cx
        f1 = f1 * k24
        f0 = f0 + f1
        cx = f0
        f0 = y
        f0 = f0 * k16
        f1 = cy
        f1 = f1 * k24
        f0 = f0 + f1
        cy = f0
        f0 = z
        f0 = f0 * k16
        f1 = cz
        f1 = f1 * k24
        f0 = f0 + f1
        cz = f0
    }
}

formula "_updateC2" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _updateC2. Mixes conditionally x,y,z and C in a strange way;"
    de numeric
    transform
    alias "_updateC2"
    param o0_rotate_x "Rotate X" = 0.0 [-180.0, 180.0] angle
    param o1_rotate_y "Rotate Y" = 0.0 [-180.0, 180.0] angle
    param o2_rotate_z "Rotate Z" = 0.0 [-180.0, 180.0] angle
    param o3_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o4_addx "AddX" = 0.0 [-2.0, 2.0] 
    param o5_addy "AddY" = 0.0 [-2.0, 2.0] 
    param o6_addz "AddZ" = 0.0 [-2.0, 2.0] 
    init {
        let k76 = o6_addz
        let k68 = o5_addy
        let k60 = o4_addx
        let k52 = o3_scale
        let k44 = single(cos(o0_rotate_x * pi / 180.0) * cos(o1_rotate_y * pi / 180.0))
        let k40 = single(cos(o0_rotate_x * pi / 180.0) * sin(o1_rotate_y * pi / 180.0) * sin(o2_rotate_z * pi / 180.0) + sin(o0_rotate_x * pi / 180.0) * cos(o2_rotate_z * pi / 180.0))
        let k36 = single(sin(o0_rotate_x * pi / 180.0) * sin(o2_rotate_z * pi / 180.0) - cos(o0_rotate_x * pi / 180.0) * sin(o1_rotate_y * pi / 180.0) * cos(o2_rotate_z * pi / 180.0))
        let k32 = single(-sin(o0_rotate_x * pi / 180.0) * cos(o1_rotate_y * pi / 180.0))
        let k28 = single(cos(o0_rotate_x * pi / 180.0) * cos(o2_rotate_z * pi / 180.0) - sin(o0_rotate_x * pi / 180.0) * sin(o1_rotate_y * pi / 180.0) * sin(o2_rotate_z * pi / 180.0))
        let k24 = single(sin(o0_rotate_x * pi / 180.0) * sin(o1_rotate_y * pi / 180.0) * cos(o2_rotate_z * pi / 180.0) + cos(o0_rotate_x * pi / 180.0) * sin(o2_rotate_z * pi / 180.0))
        let k20 = single(sin(o1_rotate_y * pi / 180.0))
        let k16 = single(-cos(o1_rotate_y * pi / 180.0) * sin(o2_rotate_z * pi / 180.0))
        let k12 = single(cos(o1_rotate_y * pi / 180.0) * cos(o2_rotate_z * pi / 180.0))
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k36
        f4 = f1
        f4 = f4 * k40
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k16
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k20
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k24
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k32
        f1 = f1 + f3
        f2 = f2 * k52
        f2 = f2 + k60
        x = f2
        f1 = f1 * k52
        f1 = f1 + k68
        y = f1
        f0 = f0 * k52
        f0 = f0 + k76
        z = f0
        f0 = dr
        f0 = f0 * k52
        dr = f0
        f0 = x
        f1 = cx
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        cx = f1
        x = f0
        f0 = y
        f1 = cy
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        cy = f1
        y = f0
        f0 = z
        f1 = cz
        fc_a = f1
        fc_b = f0
        if fc_a < fc_b {
        } else {
            ft = f1
            f1 = f0
            f0 = ft
        }
        cz = f1
        z = f0
        f0 = z
        f1 = y
        f2 = x
        f3 = f2
        f3 = f3 * k20
        f4 = f1
        f4 = f4 * k32
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k44
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k12
        f5 = f1
        f5 = f5 * k24
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k36
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k16
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k28
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k40
        f1 = f1 + f3
        f2 = f2 - k60
        x = f2
        f1 = f1 - k68
        y = f1
        f0 = f0 - k76
        z = f0
    }
}

formula "_updateC_4d" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _updateC_4d. Moves x, y, z, w values to Cx, Cy, Cz, Cw."
