formula "BristorBrot" {
    category "MB3D 3D"
    description "Mandelbulb3D formula BristorBrot. An easy 3D formula from Doug Bristor. Found on http://bugman123.com/Hypercomplex/index.html"
    de numeric
    alias "BristorBrot"
    param o0_x_mul "X mul" = 2.0 [-2.0, 6.0] 
    param o1_y_mul "Y mul" = 1.0 [-1.0, 3.0] 
    param o2_z_mul "Z mul" = -1.0 [-3.0, 1.0] 
    init {
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        f0 = x
        f0 = f0 * f0
        f1 = y
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f1 = z
        f1 = f1 * f1
        f1 = -f1
        f0 = f0 + f1
        f0 = f0 + cx
        f1 = x
        f1 = f1 * k16
        f2 = z
        f2 = f2 * k32
        f1 = f1 + f2
        f1 = f1 * y
        f1 = f1 + cy
        f2 = x
        f2 = f2 * k16
        f3 = y
        f3 = f3 * k24
        f2 = f2 + f3
        f2 = f2 * z
        f2 = f2 + cz
        z = f2
        y = f1
        x = f0
    }
}

