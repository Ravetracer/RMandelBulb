        r_eax = m48
        r_eax = (r_eax - 2.0 * floor(r_eax / 2.0))
        if r_eax != 0.0 {
        } else {
            f2 = -f2
        }
        f3 = y
        f3 = f3 * f3
        f4 = x
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = sqrt(f3)
        f3 = f3 / k16
        f3 = f3 * 6.283185307
        f3 = f3 - k40
        y = f3
        f2 = f2 - k32
        x = f2
    }
}

formula "_planeFold" {
