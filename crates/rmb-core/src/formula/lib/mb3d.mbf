formula "PolyFoldIFS" {
    category "MB3D dIFS"
    description "Mandelbulb3D formula PolyFoldIFS. Poly fold is a discontinue function. It reflects objects belonging to a quadrant to all other quadrants."
    de difs
    transform
    alias "PolyFoldIFS"
    param o0_add_x "Add X" = 0.0 [-2.0, 2.0] 
    param o1_add_y "Add Y" = 0.0 [-2.0, 2.0] 
    param o2_add_z "Add Z" = 0.0 [-2.0, 2.0] 
    param o3_rotation_x "Rotation X" = 0.0 [-180.0, 180.0] angle
    param o4_rotation_y "Rotation Y" = 0.0 [-180.0, 180.0] angle
    param o5_rotation_z "Rotation Z" = 0.0 [-180.0, 180.0] angle
    param o6_polyfold_order "PolyFold Order" = 5.0 [-5.0, 15.0] int
    param o7_atan2_fixer "Atan2 fixer" = 3.141592653589793 [-3.141592653589793, 9.42477796076938] 
    init {
        let k80 = o7_atan2_fixer
        let k72 = round(o6_polyfold_order)
        let k68 = single(cos(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k64 = single(cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) + sin(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k60 = single(sin(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0) - cos(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k56 = single(-sin(o3_rotation_x * pi / 180.0) * cos(o4_rotation_y * pi / 180.0))
        let k52 = single(cos(o3_rotation_x * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) - sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k48 = single(sin(o3_rotation_x * pi / 180.0) * sin(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0) + cos(o3_rotation_x * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k44 = single(sin(o4_rotation_y * pi / 180.0))
        let k40 = single(-cos(o4_rotation_y * pi / 180.0) * sin(o5_rotation_z * pi / 180.0))
        let k36 = single(cos(o4_rotation_y * pi / 180.0) * cos(o5_rotation_z * pi / 180.0))
        let k32 = o2_add_z
        let k24 = o1_add_y
        let k16 = o0_add_x
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
        let f6 = 0.0
        let ft = 0.0
        f0 = z
        f0 = f0 + k32
        f1 = y
        f1 = f1 + k24
        f2 = x
        f2 = f2 + k16
        f3 = f2
        f3 = f3 * k60
        f4 = f1
        f4 = f4 * k64
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k68
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k36
        f5 = f1
        f5 = f5 * k40
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k44
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k48
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k52
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k56
        f1 = f1 + f3
        f3 = f1
        f4 = f2
        f3 = atan2(f3, f4)
        f3 = k80 - f3
        f3 = f3 * 0.159154943
        f3 = f3 * k72
        f3 = round(f3)
        f3 = f3 / k72
        f3 = f3 * 6.283185307
        f4 = cos(f3)
        f3 = sin(f3)
        f5 = f1
        f5 = f5 * f4
        f6 = f2
        f6 = f6 * f3
        f5 = f5 + f6
        y = f5
        f5 = f2
        f5 = f5 * f4
        f6 = f1
        f6 = f6 * f3
        f5 = f5 - f6
        x = f5
        z = f0
    }
}

