            f2 = f1
            f1 = ft
        }
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
            ft = f2
            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        fc_a = f2
        fc_b = f0
        if fc_a >= fc_b {
        } else {
