formula "_e_3Dtess" {
    category "MB3D 3D"
    description "Mandelbulb3D formula _e_3Dtess. This is a fractal non-linear tessellation in 3D (Escher's cubic tessellation)."
    de numeric
    alias "_e_3Dtess"
    param o0_x_shift "x Shift" = 0.0 [-2.0, 2.0] 
    param o1_y_shift "y Shift" = 0.0 [-2.0, 2.0] 
    param o2_z_shift "z Shift" = 0.0 [-2.0, 2.0] 
    param o3_outer_scale "Outer scale" = 2.0 [-2.0, 6.0] 
    param o4_inner_scale "Inner scale" = 1.0 [-1.0, 3.0] 
    param o5_overall_scale "Overall scale" = 1.0 [-1.0, 3.0] 
    param o6_axiom "Axiom" = 0.0 [-2.0, 2.0] int
    param o7_maxdepth "MAXDEPTH" = 5.0 [-5.0, 15.0] int
    init {
        let k64 = round(o7_maxdepth)
        let k60 = round(o6_axiom)
        let k56 = o5_overall_scale
        let k48 = o4_inner_scale
        let k40 = o3_outer_scale
        let k32 = o2_z_shift
        let k24 = o1_y_shift
        let k16 = o0_x_shift
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let r_eax = 0.0
        let lx40 = 0.0
        let m12 = 0.0
        let m20 = 0.0
        let m24 = 0.0
        let m28 = 0.0
        let m36 = 0.0
        let m44 = 0.0
        let m48 = 0.0
        f0 = x
        f0 = f0 * k56
        f0 = f0 + k16
        x = f0
        f0 = y
        f0 = f0 * k56
        f0 = f0 + k24
        y = f0
        f0 = z
        f0 = f0 * k56
        f0 = f0 + k32
        z = f0
        if k60 != 1.0 {
            if k60 != 2.0 {
                if k60 != 3.0 {
                    f0 = 1.0
                    m44 = f0
                } else {
                    f0 = 0.125
                    m44 = f0
                }
            } else {
                f0 = 0.25
                m44 = f0
            }
        } else {
            f0 = 0.5
            m44 = f0
        }
        f0 = 0.0
        m28 = round(f0)
        f0 = m44
        f1 = 1.0
        f0 = f0 + f1
        f0 = f0 * m44
        m36 = f0
        f0 = 0.0
        m48 = round(f0)
        loop {
            m48 = m48 + 1.0
            f0 = x
            f0 = abs(f0)
            m12 = f0
            f0 = 0.0
            m24 = round(f0)
            f0 = y
            f0 = abs(f0)
            f1 = m12
            fc_a = f1
            fc_b = f0
            if fc_a > fc_b {
            } else {
                f0 = y
                f0 = abs(f0)
                m12 = f0
                f0 = 1.0
                m24 = round(f0)
            }
            f0 = z
            f0 = abs(f0)
            f1 = m12
            fc_a = f1
            fc_b = f0
            if fc_a > fc_b {
            } else {
                f0 = z
                f0 = abs(f0)
                m12 = f0
                f0 = 2.0
                m24 = round(f0)
            }
            f0 = m12
            f1 = m36
            fc_a = f1
            fc_b = f0
            if fc_a <= fc_b {
                f0 = m44
                f1 = m36
                m44 = f1
                f1 = m36
                f0 = f1 - f0
                f0 = f0 * 0.5
                f0 = f0 + m36
                m36 = f0
                if m28 != 0.0 {
                    if fc_a <= fc_b {
                        continue
                    } else {
                        lx40 = 2.0
                        break
                    }
                } else {
                    r_eax = k64
                    if r_eax <= m48 {
                        lx40 = 1.0
                        break
                    } else {
                        f0 = m36
                        f0 = f0 - m44
                        f1 = 1e-15
                        fc_a = f1
                        fc_b = f0
                        if fc_a <= fc_b {
                            continue
                        } else {
                            lx40 = 2.0
                            break
                        }
                    }
                }
            } else {
                f0 = m12
                f1 = m44
                fc_a = f1
                fc_b = f0
                if fc_a > fc_b {
                    f0 = m44
                    f1 = m36
                    m44 = f1
                    f1 = m36
                    f0 = f1 - f0
                    f0 = f0 * 0.5
                    f0 = f0 + m36
                    m36 = f0
                    if m28 != 0.0 {
                        if fc_a <= fc_b {
                            continue
                        } else {
                            lx40 = 2.0
                            break
                        }
                    } else {
                        r_eax = k64
                        if r_eax <= m48 {
                            lx40 = 1.0
                            break
                        } else {
                            f0 = m36
                            f0 = f0 - m44
                            f1 = 1e-15
                            fc_a = f1
                            fc_b = f0
                            if fc_a <= fc_b {
                                continue
                            } else {
                                lx40 = 2.0
                                break
                            }
                        }
                    }
                } else {
                    lx40 = 0.0
                    break
                }
            }
        }
        if lx40 == 0.0 {
            f0 = 1.0
            m28 = round(f0)
            if m24 != 0.0 {
                if m24 != 1.0 {
                    f0 = m12
                    f0 = f0 / z
                    m20 = f0
                    f0 = m36
                    f0 = f0 + m44
                    f0 = f0 * m20
                    f0 = f0 * 0.5
                    f0 = -f0
                    f0 = f0 + z
                    f0 = f0 * 2.0
                    f0 = f0 * k48
                    f1 = m36
                    f1 = f1 - m44
                    f0 = f0 / f1
                    z = f0
                    f0 = y
                    f1 = m36
                    f1 = f1 - m44
                    f0 = f0 / f1
                    y = f0
                    f0 = y
                    f0 = f0 + 0.5
                    f0 = round(f0)
                    f0 = -f0
                    f0 = f0 + 0.5
                    f0 = f0 + y
                    f0 = f0 * 2.0
                    f0 = f0 * k48
                    y = f0
                    f0 = x
                    f1 = m36
                    f1 = f1 - m44
                    f0 = f0 / f1
                    x = f0
                    f0 = x
                    f0 = f0 + 0.5
                    f0 = round(f0)
                    f0 = -f0
                    f0 = f0 + 0.5
                    f0 = f0 + x
                    f0 = f0 * 2.0
                    f0 = f0 * k48
                    x = f0
                } else {
                    f0 = m12
                    f0 = f0 / y
                    m20 = f0
                    f0 = m36
                    f0 = f0 + m44
                    f0 = f0 * m20
                    f0 = f0 * 0.5
                    f0 = -f0
                    f0 = f0 + y
                    f0 = f0 * 2.0
                    f0 = f0 * k48
                    f1 = m36
                    f1 = f1 - m44
                    f0 = f0 / f1
                    y = f0
                    f0 = x
                    f1 = m36
                    f1 = f1 - m44
                    f0 = f0 / f1
                    x = f0
                    f0 = x
                    f0 = f0 + 0.5
                    f0 = round(f0)
                    f0 = -f0
                    f0 = f0 + 0.5
                    f0 = f0 + x
                    f0 = f0 * 2.0
                    f0 = f0 * k48
                    x = f0
                    f0 = z
