    de numeric
    transform
    alias "_PartlyJuliaR"
    param o0_x_center "X Center" = 0.0 [-2.0, 2.0] 
    param o1_y_center "Y Center" = 0.5 [-1.5, 2.5] 
    param o2_z_center "Z Center" = 0.0 [-2.0, 2.0] 
    param o3_r_max "R Max" = 1.0 [-1.0, 3.0] 
    param o4_speed_max_1 "Speed (max 1)" = 0.5 [-1.5, 2.5] 
    param o5_x_seed "X Seed" = 0.0 [-2.0, 2.0] 
    param o6_y_seed "Y Seed" = 0.0 [-2.0, 2.0] 
    param o7_z_seed "Z Seed" = 0.0 [-2.0, 2.0] 
    param o8_inside_mode "Inside mode" = 0.0 [-2.0, 2.0] int
    param o9_recenter "Recenter" = 0.0 [-2.0, 2.0] 
    param o10_shape "Shape" = 0.0 [-2.0, 2.0] int
    init {
        let k88 = round(o10_shape)
        let k84 = o9_recenter
        let k76 = round(o8_inside_mode)
        let k72 = o7_z_seed
        let k64 = o6_y_seed
        let k56 = o5_x_seed
        let k48 = o4_speed_max_1
        let k40 = o3_r_max
