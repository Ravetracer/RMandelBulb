        let x4h = 0.0
        let x5l = 0.0
        let x5h = 0.0
        let x6l = 0.0
        let x6h = 0.0
        r_edi = k12
        if a1 != 0.0 {
            x6l = a2
            x6h = a3
            x5l = a5
            x5h = a7
        } else {
            a1 = a1 + 1.0
            x6l = x
            x6h = y
            x5l = z
            x4l = 0.0
            x4h = 0.0
            ft = x5l
            x5h = ft
            a2 = x6l
            a3 = x6h
            a5 = x5l
            a7 = x5h
            z = x4l
        }
        x1l = x6l
        x1h = x6h
        x0l = x5l
        x0h = x5h
        x2l = x1l
        x2h = x1h
        ft = x1h * x0h
        x1l = x1l * x0l
        x1h = ft
        ft = x0h * x0h
        x0l = x0l * x0l
        x0h = ft
        ft = x2h * x2h
        x2l = x2l * x2l
        x2h = ft
        ft = x1h + x1h
        x1l = x1l + x1l
        x1h = ft
        ft = x0h - x2h
        x0l = x0l - x2l
        x0h = ft
        r_ebx = r_edi
        r_edi = floor(r_edi / 2.0)
        if r_edi != 3.0 {
        } else {
            x2l = x0l
            x2h = x0h
            x3l = x1l
            x3h = x1h
            ft = x2h * x6h
            x2l = x2l * x6l
            x2h = ft
            ft = x1h * x5h
            x1l = x1l * x5l
            x1h = ft
            ft = x0h * x5h
            x0l = x0l * x5l
            x0h = ft
            ft = x3h * x6h
            x3l = x3l * x6l
            x3h = ft
            ft = x1h + x2h
            x1l = x1l + x2l
            x1h = ft
            ft = x0h - x3h
            x0l = x0l - x3l
            x0h = ft
        }
        r_edi = r_edi - 2.0
        if r_edi < 0.0 {
        } else {
            x2l = x1l
            x2h = x1h
            ft = x1h * x0h
            x1l = x1l * x0l
            x1h = ft
            ft = x0h * x0h
            x0l = x0l * x0l
            x0h = ft
            ft = x2h * x2h
            x2l = x2l * x2l
            x2h = ft
            ft = x1h + x1h
            x1l = x1l + x1l
            x1h = ft
            ft = x0h - x2h
            x0l = x0l - x2l
            x0h = ft
        }
        r_edi = r_edi - 2.0
        if r_edi < 0.0 {
        } else {
            x2l = x1l
            x2h = x1h
            ft = x1h * x0h
            x1l = x1l * x0l
            x1h = ft
            ft = x0h * x0h
            x0l = x0l * x0l
            x0h = ft
            ft = x2h * x2h
            x2l = x2l * x2l
            x2h = ft
            ft = x1h + x1h
            x1l = x1l + x1l
            x1h = ft
            ft = x0h - x2h
            x0l = x0l - x2l
            x0h = ft
        }
        r_ebx = floor(r_ebx / 2.0)
        if r_ebx >= 0.0 {
        } else {
            x2l = x0l
            x2h = x0h
            x3l = x1l
            x3h = x1h
            ft = x2h * x6h
            x2l = x2l * x6l
            x2h = ft
            ft = x1h * x5h
            x1l = x1l * x5l
            x1h = ft
            ft = x0h * x5h
            x0l = x0l * x5l
            x0h = ft
            ft = x3h * x6h
            x3l = x3l * x6l
            x3h = ft
            ft = x1h + x2h
            x1l = x1l + x2l
            x1h = ft
            ft = x0h - x3h
            x0l = x0l - x3l
            x0h = ft
        }
        x2l = cz
        x3l = cx
        x3h = cy
        ft = x2l
        x2h = ft
        ft = x1h + x3h
        x1l = x1l + x3l
        x1h = ft
        ft = x0h + x2h
        x0l = x0l + x2l
        x0h = ft
        a2 = x1l
        a3 = x1h
        a5 = x0l
        a7 = x0h
        ft = x0l
        x2l = x0h
        x2h = ft
        ft = x1l
        x3l = x1h
        x3h = ft
        x2l = x2l + x0l
        x3l = x3l + x1l
        ft = x0h * x0h
        x0l = x0l * x0l
        x0h = ft
        ft = x1h * x1h
        x1l = x1l * x1l
        x1h = ft
        ft = x3l
        x2h = ft
        ft = x0h + x1h
        x0l = x0l + x1l
        x0h = ft
        x5l = x2l
        x5h = x2h
        ft = x0l
        x4l = x0h
        x4h = ft
        ft = x5h * x5h
        x5l = x5l * x5l
        x5h = ft
        x0l = x0l + x4l
        ft = x5l
        x3l = x5h
        x3h = ft
        x0l = x0l * k8
        x3l = x3l + x5l
        x3l = x3l + 0.0
        x0l = x0l / x3l
        x0l = sqrt(x0l)
        ft = x0l
        x0h = ft
        ft = x2h * x0h
        x2l = x2l * x0l
        x2h = ft
        x = x2l
        y = x2h
    }
}

formula "Kalisets1" {
    category "MB3D 3D"
    description "Mandelbulb3D formula Kalisets1. A formula suggested by Kali at fractalforums.com, added Scale and Fix parameters."
    de numeric
    alias "Kalisets1"
    param o0_scale "Scale" = 1.0 [-1.0, 3.0] 
    param o1_fix "Fix" = 1e-60 [-2.0, 2.0] 
    init {
        let k24 = o1_fix
        let k16 = o0_scale
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = z
        f0 = abs(f0)
        f1 = y
        f1 = abs(f1)
        f2 = x
        f2 = abs(f2)
        f3 = f2
        f3 = f3 * f3
        f4 = f1
        f4 = f4 * f4
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * f4
        f3 = f3 + f4
        f3 = f3 + k24
        f3 = k16 / f3
        f1 = f1 * f3
        f0 = f0 * f3
        f2 = f2 * f3
        f2 = f2 + cx
        x = f2
        f1 = f1 + cy
        y = f1
        f0 = f0 + cz
        z = f0
    }
}

