                                                                            fc_a = f2
                                                                            fc_b = f1
                                                                            if fc_a <= fc_b {
                                                                            } else {
                                                                                f1 = f2
                                                                            }
                                                                            ft = f1
                                                                            f1 = f0
                                                                            f0 = ft
                                                                            r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
                                                                        }
                                                                    } else {
                                                                        f0 = cx
                                                                        f1 = cz
                                                                        f1 = abs(f1)
                                                                        f2 = cy
                                                                        f2 = abs(f2)
                                                                        fc_a = f2
                                                                        fc_b = f1
                                                                        if fc_a <= fc_b {
                                                                        } else {
                                                                            f1 = f2
                                                                        }
                                                                        ft = f1
                                                                        f1 = f0
                                                                        f0 = ft
                                                                        r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
                                                                    }
                                                                } else {
                                                                    f0 = cz
                                                                    f1 = cx
                                                                    f1 = abs(f1)
                                                                    f2 = cy
                                                                    f2 = abs(f2)
                                                                    fc_a = f2
                                                                    fc_b = f1
                                                                    if fc_a <= fc_b {
                                                                    } else {
                                                                        f1 = f2
                                                                    }
                                                                    r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
                                                                }
                                                            } else {
                                                                f0 = cy
                                                                f1 = cz
                                                                f1 = abs(f1)
                                                                f2 = cx
                                                                f2 = abs(f2)
                                                                fc_a = f2
                                                                fc_b = f1
                                                                if fc_a <= fc_b {
                                                                } else {
                                                                    f1 = f2
                                                                }
                                                                r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
                                                            }
                                                        } else {
                                                            f0 = cx
                                                            f1 = cz
                                                            f1 = abs(f1)
                                                            f2 = cy
                                                            f2 = abs(f2)
                                                            fc_a = f2
                                                            fc_b = f1
                                                            if fc_a <= fc_b {
                                                            } else {
                                                                f1 = f2
                                                            }
                                                            r_eax = sel(fc_a < fc_b, 256.0, sel(fc_a == fc_b, 16384.0, 0.0))
                                                        }
                                                    } else {
                                                        f0 = cz
                                                        f1 = cy
                                                        f1 = f1 * f1
                                                        f2 = cx
                                                        f2 = f2 * f2
                                                        f1 = f1 + f2
                                                        f1 = sqrt(f1)
                                                        ft = f1
                                                        f1 = f0
                                                        f0 = ft
                                                        r_eax = 0.0
                                                    }
                                                } else {
                                                    f0 = cy
                                                    f1 = cx
                                                    f1 = f1 * f1
                                                    f2 = cz
                                                    f2 = f2 * f2
                                                    f1 = f1 + f2
                                                    f1 = sqrt(f1)
                                                    ft = f1
                                                    f1 = f0
                                                    f0 = ft
                                                    r_eax = 0.0
                                                }
                                            } else {
                                                f0 = cx
                                                f1 = cy
                                                f1 = f1 * f1
                                                f2 = cz
                                                f2 = f2 * f2
                                                f1 = f1 + f2
                                                f1 = sqrt(f1)
                                                ft = f1
                                                f1 = f0
                                                f0 = ft
                                                r_eax = 0.0
                                            }
                                        } else {
                                            f0 = cz
                                            f1 = cx
                                            f1 = f1 * f1
                                            f2 = cy
                                            f2 = f2 * f2
                                            f1 = f1 + f2
                                            f1 = sqrt(f1)
                                            r_eax = 0.0
                                        }
                                    } else {
                                        f0 = cy
                                        f1 = cx
                                        f1 = f1 * f1
                                        f2 = cz
                                        f2 = f2 * f2
                                        f1 = f1 + f2
                                        f1 = sqrt(f1)
                                        r_eax = 0.0
                                    }
                                } else {
                                    f0 = cx
                                    f1 = cy
                                    f1 = f1 * f1
                                    f2 = cz
                                    f2 = f2 * f2
                                    f1 = f1 + f2
                                    f1 = sqrt(f1)
                                    r_eax = 0.0
                                }
                            } else {
                                f0 = cz
                                f1 = cy
                                r_eax = 0.0
                            }
                        } else {
                            f0 = cz
                            f1 = cx
                            r_eax = 0.0
                        }
                    } else {
                        f0 = cy
                        f1 = cz
                        r_eax = 0.0
                    }
                } else {
                    f0 = cy
                    f1 = cx
                    r_eax = 0.0
                }
            } else {
                f0 = cx
                f1 = cz
                r_eax = 0.0
            }
        } else {
            f0 = cx
            f1 = cy
            r_eax = 0.0
        }
        f0 = atan2(f0, f1)
        f0 = f0 * k60
        f1 = cos(f0)
        f0 = sin(f0)
        m68 = f1
        m60 = f0
        f0 = cx
        f0 = f0 * f0
        f1 = cy
        f1 = f1 * f1
        f2 = cz
        f2 = f2 * f2
        f1 = f1 + f2
        f0 = f0 + f1
        f0 = sqrt(f0)
        m36 = f0
        if k72 != 0.0 {
            if k72 != 1.0 {
                f0 = m52
                f0 = f0 * m68
                f0 = f0 * m36
                cx = f0
                f0 = m44
                f0 = f0 * m36
                cy = f0
                f0 = m52
                f0 = f0 * m60
                f0 = f0 * m36
                cz = f0
            } else {
                f0 = m52
                f0 = f0 * m60
                f0 = f0 * m36
                cx = f0
                f0 = m44
                f0 = f0 * m60
                f0 = f0 * m36
                cy = f0
                f0 = m68
                f0 = f0 * m36
                cz = f0
            }
        } else {
            f0 = m52
            f0 = f0 * m68
            f0 = f0 * m36
            cx = f0
            f0 = m44
            f0 = f0 * m68
            f0 = f0 * m36
            cy = f0
            f0 = m60
            f0 = f0 * m36
            cz = f0
        }
        f0 = k80
        f1 = 1.0
        f1 = f1 - f0
        f2 = m12
        f2 = f2 * f1
        f3 = cx
        f3 = f3 * f0
        f2 = f2 + f3
        cx = f2
        f2 = m20
        f2 = f2 * f1
        f3 = cy
        f3 = f3 * f0
        f2 = f2 + f3
        cy = f2
        f2 = m28
        f2 = f2 * f1
        f3 = cz
        f3 = f3 * f0
        f2 = f2 + f3
        cz = f2
        f0 = k88
        f1 = 1.0
        f1 = f1 - f0
        ft = f1
        f1 = f0
        f0 = ft
        f2 = x
        f2 = f2 * f1
        f3 = cx
        f3 = f3 * f0
        f2 = f2 + f3
        cx = f2
        f2 = y
        f2 = f2 * f1
        f3 = cy
        f3 = f3 * f0
        f2 = f2 + f3
        cy = f2
        f2 = z
        f2 = f2 * f1
        f3 = cz
        f3 = f3 * f0
        f2 = f2 + f3
        cz = f2
    }
}

formula "_HexaTransform" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _HexaTransform. Based on Aexions ideas, this performs a hexagonal transform to be used as first formula as pre-transform, and choosing 'repeat from here' on the next formula(s)."
    de numeric
    transform
    alias "_HexaTransform"
    param o0_offset "Offset" = 0.0 [-2.0, 2.0] 
    init {
        let k16 = o0_offset
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = x
        f0 = abs(f0)
        f0 = f0 - k16
        f1 = y
        f1 = f1 * 0.8660254037844386
        f2 = x
        f2 = f2 * (-0.5)
        f1 = f1 + f2
        f1 = abs(f1)
        f1 = f1 - k16
        f2 = z
        f2 = abs(f2)
        f2 = f2 - k16
        f3 = y
        f3 = f3 * 0.8660254037844386
        f4 = x
        f4 = f4 * (-0.5)
        f3 = f4 - f3
        f3 = abs(f3)
        f3 = f3 - k16
        dr = f3
        z = f2
        y = f1
        x = f0
        f0 = cx
        f0 = abs(f0)
        f0 = f0 - k16
        f1 = cy
        f1 = f1 * 0.8660254037844386
        f2 = cx
        f2 = f2 * (-0.5)
        f1 = f1 + f2
        f1 = abs(f1)
        f1 = f1 - k16
        f2 = cz
        f2 = abs(f2)
        f2 = f2 - k16
        f3 = cy
        f3 = f3 * 0.8660254037844386
        f4 = cx
        f4 = f4 * (-0.5)
        f3 = f4 - f3
        f3 = abs(f3)
        f3 = f3 - k16
        cw = f3
        cz = f2
        cy = f1
        cx = f0
    }
}

formula "_HopSqrtX" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _HopSqrtX. Sqrt for x as defined in Hopalong attractor + some bells & whistles"
    de numeric
    transform
    alias "_HopSqrtX"
    param o0_fixx "fixX" = 0.0 [-2.0, 2.0] 
    param o1_fixsq "fixSq" = 0.0 [-2.0, 2.0] 
    param o2_mul "Mul" = 1.0 [-1.0, 3.0] 
    param o3_div "Div" = 1.0 [-1.0, 3.0] 
    init {
        let k40 = o3_div
        let k32 = o2_mul
        let k24 = o1_fixsq
        let k16 = o0_fixx
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let fc_a = 0.0
        let fc_b = 0.0
        let ft = 0.0
        f0 = x
        f0 = f0 * k32
        f0 = f0 + k16
        f1 = f0
        f1 = abs(f1)
        f1 = sqrt(f1)
        ft = f1
        f1 = f0
        f0 = ft
        f2 = 0.0
        fc_a = f2
        fc_b = f1
        if fc_a <= fc_b {
        } else {
            f0 = -f0
        }
        f0 = f0 / k40
        f0 = f0 + k24
        x = f0
    }
}

