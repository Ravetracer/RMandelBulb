        let k76 = round(o6_apply_scale_add)
        let k72 = o5_amplitude
        let k64 = o4_x_add
        let k56 = o3_y_add
        let k48 = o2_z_add
        let k32 = o1_scale
        let k24 = o1_scale
        let k16 = o0_frequency
    }
    iter {
        let f0 = 0.0
