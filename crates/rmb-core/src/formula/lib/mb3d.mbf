formula "_rossler" {
    category "MB3D transforms"
    description "Mandelbulb3D formula _rossler. Rossler hyperchaotic system in 4D - variation with four parameters and strength"
    de numeric
    transform
    alias "_rossler"
    param o0_strength "Strength" = 1.0 [-1.0, 3.0] 
    param o1_alpha "Alpha" = 0.5 [-1.5, 2.5] 
    param o2_beta "Beta" = 1.0 [-1.0, 3.0] 
    param o3_gamma "Gamma" = 1.5 [-1.5, 4.5] 
    param o4_delta "Delta" = 1.0 [-1.0, 3.0] 
    init {
        let k48 = o4_delta
        let k40 = o3_gamma
        let k32 = o2_beta
        let k24 = o1_alpha
        let k16 = o0_strength
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        f0 = y
        f0 = f0 + z
        f0 = -f0
        f0 = f0 * k16
        f1 = x
        f2 = y
        f2 = f2 * k24
        f1 = f1 + f2
        f1 = f1 + dr
        f1 = f1 * k16
        f2 = k32
        f3 = x
        f3 = f3 * z
        f2 = f2 + f3
        f2 = f2 * k16
        f3 = k40
        f3 = f3 * z
        f3 = -f3
        f4 = k48
        f4 = f4 * dr
        f3 = f3 + f4
        f3 = f3 * k16
        dr = f3
        z = f2
        y = f1
        x = f0
    }
}

