        f1 = m62
        f1 = f1 * 6.0
        f0 = f0 + f1
        f0 = cos(f0)
        f0 = f0 * k72
        fc_a = f0
        fc_b = 0.0
        if fc_a >= fc_b {
            f0 = f0 + m46
            m46 = f0
        } else {
