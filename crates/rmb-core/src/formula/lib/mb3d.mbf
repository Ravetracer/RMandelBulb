            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
            f2 = -f2
            fc_a = f2
            fc_b = f0
            if fc_a < fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
            fc_a = f2
            fc_b = f1
            if fc_a >= fc_b {
            } else {
                ft = f2
                f2 = f1
                f1 = ft
            }
            fc_a = f2
            fc_b = f0
            if fc_a >= fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            ft = f2
            f2 = f1
            f1 = ft
            fc_a = f2
            fc_b = f0
            if fc_a >= fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
        } else {
            ft = f2
            f2 = f1
            f1 = ft
            fc_a = f2
            fc_b = f1
            if fc_a >= fc_b {
            } else {
                ft = f2
                f2 = f1
                f1 = ft
            }
            fc_a = f2
            fc_b = f0
            if fc_a >= fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            ft = f2
            f2 = f1
            f1 = ft
            fc_a = f2
            fc_b = f0
            if fc_a >= fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            f2 = -f2
            fc_a = f2
            fc_b = f1
            if fc_a < fc_b {
            } else {
                ft = f2
                f2 = f1
                f1 = ft
            }
            fc_a = f2
            fc_b = f0
            if fc_a < fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            f2 = -f2
            ft = f2
            f2 = f1
            f1 = ft
            f2 = -f2
            fc_a = f2
            fc_b = f0
            if fc_a < fc_b {
            } else {
                ft = f2
                f2 = f0
                f0 = ft
            }
            f2 = -f2
        }
        f3 = k120
        f4 = 0.0
        fc_a = f4
        fc_b = f3
        if fc_a >= fc_b {
        } else {
            f3 = f3 - f1
            f3 = abs(f3)
            f3 = -f3
            f3 = f3 + k120
            ft = f3
            f3 = f1
            f1 = ft
        }
        f3 = k128
        f4 = 0.0
        fc_a = f4
        fc_b = f3
        if fc_a >= fc_b {
        } else {
            f3 = f3 - f2
            f3 = abs(f3)
            f3 = -f3
            f3 = f3 + k128
            ft = f3
            f3 = f2
            f2 = ft
        }
        f3 = f2
        f3 = f3 * k104
        f4 = f1
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f2
        f4 = f4 * k80
        f5 = f1
        f5 = f5 * k84
        f4 = f4 + f5
        f5 = f0
        f5 = f5 * k88
        f4 = f4 + f5
        ft = f4
        f4 = f2
        f2 = ft
        f4 = f4 * k92
        ft = f4
        f4 = f1
        f1 = ft
        f4 = f4 * k96
        f1 = f1 + f4
        ft = f3
        f3 = f0
        f0 = ft
        f3 = f3 * k100
        f1 = f1 + f3
        f3 = k16
