            f2 = f0
            f0 = ft
        }
        ft = f2
        f2 = f1
        f1 = ft
        f3 = f1
        f3 = f3 * k104
        f4 = f2
        f4 = f4 * k108
        f3 = f3 + f4
        f4 = f0
        f4 = f4 * k112
        f3 = f3 + f4
        f4 = f1
