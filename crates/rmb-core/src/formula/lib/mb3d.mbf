formula "Magnet4D" {
    category "MB3D 4D"
    description "Mandelbulb3D formula Magnet4D. Magnetic 3D Mandelbulb set, based on D. White's new 'triplex formulas'."
    de numeric
    alias "Magnet4D"
    param o0_z_mul "Z mul" = -1.0 [-3.0, 1.0] 
    param o1_c_mul_up "c Mul up" = 1.0 [-1.0, 3.0] 
    param o2_c_mul_down "c Mul down" = 1.0 [-1.0, 3.0] 
    param o3_x_add "x Add" = -1.0 [-3.0, 1.0] 
    param o4_fix_z_zero "Fix z zero" = 0.0 [-2.0, 2.0] int
    init {
        let k44 = round(o4_fix_z_zero)
        let k40 = o3_x_add
