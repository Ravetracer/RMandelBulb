    param o7_fix_ballfold "Fix (BallFold)" = 0.3 [-1.7, 2.3] 
    param o8_rotation1_x "Rotation1 X" = 0.0 [-180.0, 180.0] angle
    param o9_rotation1_y "Rotation1 Y" = 0.0 [-180.0, 180.0] angle
    param o10_rotation1_z "Rotation1 Z" = 0.0 [-180.0, 180.0] angle
    init {
        let k108 = single(cos(o8_rotation1_x * pi / 180.0) * cos(o9_rotation1_y * pi / 180.0))
        let k104 = single(cos(o8_rotation1_x * pi / 180.0) * sin(o9_rotation1_y * pi / 180.0) * sin(o10_rotation1_z * pi / 180.0) + sin(o8_rotation1_x * pi / 180.0) * cos(o10_rotation1_z * pi / 180.0))
        let k100 = single(sin(o8_rotation1_x * pi / 180.0) * sin(o10_rotation1_z * pi / 180.0) - cos(o8_rotation1_x * pi / 180.0) * sin(o9_rotation1_y * pi / 180.0) * cos(o10_rotation1_z * pi / 180.0))
