formula "TetraFolding Pow2" {
    category "MB3D 3D"
    description "Mandelbulb3D formula TetraFolding Pow2. Combination of ATetra's folding and Quadratic3D formulas. The final result is"
    de numeric
    alias "TetraFolding Pow2"
    param o0_x_mul "X mul" = 1.0 [-1.0, 3.0] 
    param o1_y_mul "Y mul" = 2.0 [-2.0, 6.0] 
    param o2_z_mul "Z mul" = -2.0 [-6.0, 2.0] 
    param o3_hradius "HRadius" = 0.0 [-2.0, 2.0] 
    param o4_zradius "ZRadius" = 1.0 [-1.0, 3.0] 
    param o5_fold "Fold" = 0.8660254037844386 [-1.1339745962155614, 2.8660254037844384] 
    param o6_fold_rotation_x "Fold rotation X" = 45.0 [-180.0, 180.0] angle
    param o7_fold_rotation_y "Fold rotation Y" = 45.0 [-180.0, 180.0] angle
    param o8_fold_rotation_z "Fold rotation Z" = 45.0 [-180.0, 180.0] angle
    param o9_modes_0_to_3 "Modes (0 to 3)" = 0.0 [-2.0, 2.0] int
    param o10_tglad_folding "Tglad folding" = 0.0 [-2.0, 2.0] int
    param o11_z_mul_2 "Z mul 2" = 1.0 [-1.0, 3.0] 
    init {
        let k108 = o11_z_mul_2
        let k100 = round(o10_tglad_folding)
        let k96 = round(o9_modes_0_to_3)
        let k92 = single(cos(o6_fold_rotation_x * pi / 180.0) * cos(o7_fold_rotation_y * pi / 180.0))
        let k88 = single(cos(o6_fold_rotation_x * pi / 180.0) * sin(o7_fold_rotation_y * pi / 180.0) * sin(o8_fold_rotation_z * pi / 180.0) + sin(o6_fold_rotation_x * pi / 180.0) * cos(o8_fold_rotation_z * pi / 180.0))
        let k84 = single(sin(o6_fold_rotation_x * pi / 180.0) * sin(o8_fold_rotation_z * pi / 180.0) - cos(o6_fold_rotation_x * pi / 180.0) * sin(o7_fold_rotation_y * pi / 180.0) * cos(o8_fold_rotation_z * pi / 180.0))
        let k80 = single(-sin(o6_fold_rotation_x * pi / 180.0) * cos(o7_fold_rotation_y * pi / 180.0))
        let k76 = single(cos(o6_fold_rotation_x * pi / 180.0) * cos(o8_fold_rotation_z * pi / 180.0) - sin(o6_fold_rotation_x * pi / 180.0) * sin(o7_fold_rotation_y * pi / 180.0) * sin(o8_fold_rotation_z * pi / 180.0))
        let k72 = single(sin(o6_fold_rotation_x * pi / 180.0) * sin(o7_fold_rotation_y * pi / 180.0) * cos(o8_fold_rotation_z * pi / 180.0) + cos(o6_fold_rotation_x * pi / 180.0) * sin(o8_fold_rotation_z * pi / 180.0))
        let k68 = single(sin(o7_fold_rotation_y * pi / 180.0))
        let k64 = single(-cos(o7_fold_rotation_y * pi / 180.0) * sin(o8_fold_rotation_z * pi / 180.0))
        let k60 = single(cos(o7_fold_rotation_y * pi / 180.0) * cos(o8_fold_rotation_z * pi / 180.0))
        let k56 = o5_fold
        let k48 = o4_zradius
        let k40 = o3_hradius
        let k32 = o2_z_mul
        let k24 = o1_y_mul
        let k16 = o0_x_mul
    }
    iter {
        let f0 = 0.0
        let f1 = 0.0
        let f2 = 0.0
        let f3 = 0.0
        let f4 = 0.0
        let f5 = 0.0
