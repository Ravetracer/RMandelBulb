// Four-dimensional algebras. The 3D slice shown is chosen with the W slice of the render settings.

formula "Quaternion" {
    category "Hypercomplex"
    description "Quaternion z^2 + c (non-commutative). Best in Julia mode."
    de log
    iter {
        let r = sqrt(x * x + y * y + z * z + w * w)
        dr = 2.0 * r * dr + 1.0
        let nx = x * x - y * y - z * z - w * w
        let t = 2.0 * x
        y = t * y + cy
        z = t * z + cz
        w = t * w + cw
        x = nx + cx
    }
}

formula "Quaternion cubic" {
    category "Hypercomplex"
    description "Quaternion z^3 + c."
    de log
    iter {
        let r2 = x * x + y * y + z * z + w * w
        dr = 3.0 * r2 * dr + 1.0
        let v2 = y * y + z * z + w * w
        let a = x * x - 3.0 * v2
        let b = 3.0 * x * x - v2
        x = x * a + cx
        y = y * b + cy
        z = z * b + cz
        w = w * b + cw
    }
}

formula "Hypercomplex" {
    category "Hypercomplex"
    description "Commutative (bicomplex) hypercomplex z^2 + c."
    de log
    iter {
        let r = sqrt(x * x + y * y + z * z + w * w)
        dr = 2.0 * r * dr + 1.0
        let nx = x * x - y * y - z * z + w * w
        let ny = 2.0 * (x * y - z * w)
        let nz = 2.0 * (x * z - y * w)
        w = 2.0 * (x * w + y * z) + cw
        x = nx + cx
        y = ny + cy
        z = nz + cz
    }
}

formula "Mandelbrot 2D" {
    category "Hypercomplex"
    description "The plain Mandelbrot set in the xy plane, extruded along z (useful in hybrids)."
    de log
    iter {
        let r = sqrt(x * x + y * y)
        dr = 2.0 * r * dr + 1.0
        let nx = x * x - y * y + cx
        y = 2.0 * x * y + cy
        x = nx
    }
}

formula "Quaternion (MB3D)" {
    category "Hypercomplex"
    description "Mandelbulb3D's quaternion variant with a YW multiplier and a W offset."
    de log
    alias "Quaternion"
    alias "Quat"
    param yw_mul "YW multiplier" = -1 [-2, 2]
    param w_add "W add" = 0 [-2, 2]
    iter {
        let r = sqrt(x * x + y * y + z * z + w * w)
        dr = 2.0 * r * dr + 1.0
        let nx = x * x - y * y - z * z - w * w
        let ny = 2.0 * (x * y + z * w)
        let nz = 2.0 * (x * z + yw_mul * y * w)
        w = 2.0 * (x * w + y * z) + w_add + cw
        x = nx + cx
        y = ny + cy
        z = nz + cz
    }
}
