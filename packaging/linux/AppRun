#!/bin/sh
# RMandelbulb3D AppImage entry point. Without arguments (or with a scene file) it starts the
# program; "cli" as the first argument runs the command line tool instead:
#   ./RMandelbulb3D-x86_64.AppImage cli render scene.rmb -o out.png
#   ./RMandelbulb3D-x86_64.AppImage cli --network
HERE="$(dirname "$(readlink -f "$0")")"
if [ "$1" = "cli" ]; then
    shift
    exec "$HERE/usr/bin/rmb-cli" "$@"
fi
case "$(basename "${ARGV0:-$0}")" in
    rmb-cli*) exec "$HERE/usr/bin/rmb-cli" "$@" ;;
esac
exec "$HERE/usr/bin/rmb-app" "$@"
